INCLUDE "include/modules/uxsqlite.uxmh"
INCLUDE "include/modules/uxjson.uxmh"
INCLUDE "include/modules/uxregex.uxmh"
INCLUDE "include/modules/uxcompress.uxmh"
INCLUDE "include/modules/uxcrypto.uxmh"

MAIN
    DIM db AS U64
    DIM stmt AS U64
    DIM doc AS U64
    DIM jsonRoot AS U64
    DIM value AS U64
    DIM rx AS U64
    DIM packed AS U64
    DIM unpacked AS U64
    DIM text AS STRING
    DIM hashInput AS STRING
    DIM digest AS STRING

    db = uxsqlite.OpenMemory()
    ASSERT db <> 0
    ASSERT uxsqlite.Exec(db, "CREATE TABLE t(x INTEGER)") = uxsqlite.SQLITE_OK
    ASSERT uxsqlite.Exec(db, "INSERT INTO t VALUES(1),(2),(3)") = uxsqlite.SQLITE_OK
    stmt = uxsqlite.Prepare(db, "SELECT SUM(x) FROM t")
    ASSERT stmt <> 0
    ASSERT uxsqlite.Step(stmt) = uxsqlite.SQLITE_ROW
    ASSERT uxsqlite.ColumnI64(stmt, 0) = 6
    uxsqlite.Finalize(stmt)
    uxsqlite.Close(db)

    doc = uxjson.Parse("{""name"":""uXBasic"",""n"":3}")
    ASSERT doc <> 0
    jsonRoot = uxjson.Root(doc)
    value = uxjson.ObjectGet(jsonRoot, "name")
    ASSERT uxjson.GetString(value) = "uXBasic"
    value = uxjson.PointerGet(doc, "/n")
    ASSERT uxjson.GetI64(value) = 3
    uxjson.Free(doc)

    rx = uxregex.Compile("^[A-Z]+[0-9]+$", 0)
    ASSERT rx <> 0
    ASSERT uxregex.IsMatch(rx, "ABC123") = 1
    ASSERT uxregex.IsMatch(rx, "abc123") = 0
    uxregex.Free(rx)

    text = "uXBasic cbase smoke"
    packed = uxcompress.CompressText(text, 3)
    ASSERT packed <> 0
    unpacked = uxcompress.Decompress(uxcompress.BlobData(packed), uxcompress.BlobSize(packed), LEN(text))
    ASSERT unpacked <> 0
    ASSERT uxcompress.BlobSize(unpacked) = LEN(text)
    uxcompress.BlobFree(unpacked)
    uxcompress.BlobFree(packed)

    ASSERT uxcrypto.Initialize() = 1
    hashInput = "abc"
    digest = uxcrypto.Sha256Text(hashInput)
    ASSERT digest = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

    PRINT "UXB_CBASE_SMOKE_PASS"
END MAIN
