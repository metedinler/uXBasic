INCLUDE "include/modules/uxcapi.uxmh"
INCLUDE "include/modules/uxsqlite.uxmh"
INCLUDE "include/modules/uxhttp.uxmh"
INCLUDE "include/modules/uxjson.uxmh"
INCLUDE "include/modules/uxregex.uxmh"
INCLUDE "include/modules/uxcompress.uxmh"
INCLUDE "include/modules/uxarchive.uxmh"
INCLUDE "include/modules/uxcrypto.uxmh"

MAIN
    DIM c AS U64
    DIM va AS U64
    DIM cb AS U64
    DIM eventValue AS U64
    DIM buffer AS U64
    DIM rc AS I32
    DIM result64 AS I64

    ASSERT uxcapi.Version() >= 100

    ' ABI10'u aşan 12 parametreli gerçek C çağrısı.
    c = uxcapi.CallNew(
        "uxcapi_test.dll",
        "uxc_test_sum12",
        uxcapi.KIND_I64,
        0,
        12
    )
    ASSERT c <> 0
    ASSERT uxcapi.ArgI64(c, 1) = 1
    ASSERT uxcapi.ArgI64(c, 2) = 1
    ASSERT uxcapi.ArgI64(c, 3) = 1
    ASSERT uxcapi.ArgI64(c, 4) = 1
    ASSERT uxcapi.ArgI64(c, 5) = 1
    ASSERT uxcapi.ArgI64(c, 6) = 1
    ASSERT uxcapi.ArgI64(c, 7) = 1
    ASSERT uxcapi.ArgI64(c, 8) = 1
    ASSERT uxcapi.ArgI64(c, 9) = 1
    ASSERT uxcapi.ArgI64(c, 10) = 1
    ASSERT uxcapi.ArgI64(c, 11) = 1
    ASSERT uxcapi.ArgI64(c, 12) = 1
    ASSERT uxcapi.Invoke(c) = 1
    ASSERT uxcapi.ResultI64(c) = 78
    uxcapi.CallFree(c)

    ' Variadic C çağrısı.
    va = uxcapi.ArgsNew()
    ASSERT va <> 0
    ASSERT uxcapi.ArgsAddI64(va, 10) = 1
    ASSERT uxcapi.ArgsAddI64(va, 20) = 1
    ASSERT uxcapi.ArgsAddI64(va, 30) = 1

    c = uxcapi.CallNew(
        "uxcapi_test.dll",
        "uxc_test_variadic_sum",
        uxcapi.KIND_I64,
        1,
        1
    )
    ASSERT c <> 0
    ASSERT uxcapi.ArgI32(c, 3) = 1
    ASSERT uxcapi.CallAppendArgs(c, va) = 1
    ASSERT uxcapi.Invoke(c) = 1
    ASSERT uxcapi.ResultI64(c) = 60
    uxcapi.CallFree(c)
    uxcapi.ArgsFree(va)

    ' Generic callback closure ve olay kuyruğu.
    cb = uxcapi.CallbackNew(uxcapi.KIND_I32, 7, 0.0)
    ASSERT cb <> 0
    ASSERT uxcapi.CallbackAddArg(cb, uxcapi.KIND_I32) = 1
    ASSERT uxcapi.CallbackAddArg(cb, uxcapi.KIND_STRPTR) = 1
    ASSERT uxcapi.CallbackBuild(cb) = 1

    c = uxcapi.CallNew(
        "uxcapi_test.dll",
        "uxc_test_call_callback",
        uxcapi.KIND_I32,
        0,
        3
    )
    ASSERT c <> 0
    ASSERT uxcapi.ArgPtr(c, uxcapi.CallbackPointer(cb)) = 1
    ASSERT uxcapi.ArgI32(c, 42) = 1
    ASSERT uxcapi.ArgString(c, "callback") = 1
    ASSERT uxcapi.Invoke(c) = 1
    ASSERT uxcapi.ResultI32(c) = 7
    uxcapi.CallFree(c)

    ASSERT uxcapi.CallbackPending(cb) = 1
    eventValue = uxcapi.CallbackNext(cb)
    ASSERT eventValue <> 0
    ASSERT uxcapi.EventArgCount(eventValue) = 2
    ASSERT uxcapi.EventArgU64(eventValue, 0) = 42
    ASSERT uxcapi.EventArgString(eventValue, 1) = "callback"
    uxcapi.EventFree(eventValue)
    uxcapi.CallbackFree(cb)

    ' Vendor DLL'lerin gerçek full raw modülleri.
    ASSERT LEN(sqlite3.sqlite3_libversion()) > 0
    ASSERT LEN(curl.curl_version()) > 0
    ASSERT LEN(jsonc.json_c_version()) > 0
    ASSERT LEN(zstd.ZSTD_versionString()) > 0
    ASSERT LEN(archive.archive_version_string()) > 0
    ASSERT LEN(sodium.sodium_version_string()) > 0

    buffer = uxcapi.MemoryCalloc(1, 256)
    ASSERT buffer <> 0
    rc = pcre2.pcre2_config_8(pcre2.PCRE2_CONFIG_VERSION, buffer)
    ASSERT rc >= 0
    ASSERT LEN(uxcapi.MemoryReadString(buffer, 0)) > 0
    uxcapi.MemoryFree(buffer)

    PRINT "UXB_C_FULL_API_SMOKE_PASS"
END MAIN
