' UXGSL v104: owned complex output-value contract.
INCLUDE "include/modules/uxgsl.uxmh"

MAIN
    DIM z1 AS U64
    DIM z2 AS U64
    DIM outputValue AS U64

    ASSERT uxgsl.ApiVersion() >= 104
    z1 = uxgsl.ComplexCreate(1.0, 2.0)
    z2 = uxgsl.ComplexCreate(3.0, -4.0)
    outputValue = uxgsl.ComplexCreate(0.0, 0.0)
    ASSERT z1 <> 0
    ASSERT z2 <> 0
    ASSERT outputValue <> 0
    ASSERT uxgsl.ComplexAdd(z1, z2, outputValue) = 1
    ASSERT uxgsl.ComplexReal(outputValue) = 4.0
    ASSERT uxgsl.ComplexImaginary(outputValue) = -2.0
    ASSERT uxgsl.ComplexMultiply(z1, z2, outputValue) = 1
    ASSERT uxgsl.ComplexReal(outputValue) = 11.0
    ASSERT uxgsl.ComplexImaginary(outputValue) = 2.0
    ASSERT uxgsl.ComplexAdd(z1, z2, z1) = 0
    ASSERT uxgsl.LastStatus() = 1
    uxgsl.ComplexFree(outputValue)
    outputValue = 0
    uxgsl.ComplexFree(z2)
    z2 = 0
    uxgsl.ComplexFree(z1)
    z1 = 0
    PRINT "UXGSL_COMPLEX_SMOKE_PASS"
END MAIN
