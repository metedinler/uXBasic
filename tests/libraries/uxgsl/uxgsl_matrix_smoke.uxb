' UXGSL v103: owned gsl_matrix facade and output-buffer contract.
INCLUDE "include/modules/uxgsl.uxmh"

MAIN
    DIM leftMatrix AS U64
    DIM rightMatrix AS U64
    DIM productMatrix AS U64
    DIM wrongShape AS U64
    DIM failedValue AS F64

    ASSERT uxgsl.ApiVersion() >= 103
    leftMatrix = uxgsl.MatrixCreate(2, 2)
    rightMatrix = uxgsl.MatrixCreate(2, 2)
    productMatrix = uxgsl.MatrixCreate(2, 2)
    ASSERT leftMatrix <> 0
    ASSERT rightMatrix <> 0
    ASSERT productMatrix <> 0
    ASSERT uxgsl.MatrixRows(leftMatrix) = 2
    ASSERT uxgsl.MatrixColumns(leftMatrix) = 2

    ASSERT uxgsl.MatrixSet(leftMatrix, 0, 0, 1.0) = 1
    ASSERT uxgsl.MatrixSet(leftMatrix, 0, 1, 2.0) = 1
    ASSERT uxgsl.MatrixSet(leftMatrix, 1, 0, 3.0) = 1
    ASSERT uxgsl.MatrixSet(leftMatrix, 1, 1, 4.0) = 1
    ASSERT uxgsl.MatrixSet(rightMatrix, 0, 0, 5.0) = 1
    ASSERT uxgsl.MatrixSet(rightMatrix, 0, 1, 6.0) = 1
    ASSERT uxgsl.MatrixSet(rightMatrix, 1, 0, 7.0) = 1
    ASSERT uxgsl.MatrixSet(rightMatrix, 1, 1, 8.0) = 1
    ASSERT uxgsl.MatrixMultiply(leftMatrix, rightMatrix, productMatrix) = 1
    ASSERT uxgsl.MatrixGet(productMatrix, 0, 0) = 19.0
    ASSERT uxgsl.MatrixGet(productMatrix, 0, 1) = 22.0
    ASSERT uxgsl.MatrixGet(productMatrix, 1, 0) = 43.0
    ASSERT uxgsl.MatrixGet(productMatrix, 1, 1) = 50.0

    ASSERT uxgsl.MatrixMultiply(leftMatrix, rightMatrix, leftMatrix) = 0
    ASSERT uxgsl.LastStatus() = 8
    failedValue = uxgsl.MatrixGet(leftMatrix, 2, 0)
    ASSERT failedValue <> failedValue
    ASSERT uxgsl.LastStatus() = 4

    wrongShape = uxgsl.MatrixCreate(2, 3)
    ASSERT wrongShape <> 0
    ASSERT uxgsl.MatrixSetIdentity(wrongShape) = 0
    ASSERT uxgsl.LastStatus() = 8

    uxgsl.MatrixFree(wrongShape)
    wrongShape = 0
    uxgsl.MatrixFree(productMatrix)
    productMatrix = 0
    uxgsl.MatrixFree(rightMatrix)
    rightMatrix = 0
    uxgsl.MatrixFree(leftMatrix)
    leftMatrix = 0
    PRINT "UXGSL_MATRIX_SMOKE_PASS"
END MAIN
