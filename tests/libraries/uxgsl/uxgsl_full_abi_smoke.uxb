INCLUDE "include/modules/uxgsl.uxmh"

MAIN
    DIM callHandle AS U64
    DIM vectorHandle AS U64
    DIM result AS F64

    ' Directly exercise a GSL export not hidden behind the typed facade.
    callHandle = uxgsl.GslCallNew("gsl_sf_bessel_J0", uxcapi.KIND_F64, 0, 1)
    ASSERT callHandle <> 0
    ASSERT uxcapi.ArgF64(callHandle, 0.0) = 1
    ASSERT uxcapi.Invoke(callHandle) = 1
    result = uxcapi.ResultF64(callHandle)
    ASSERT ABS(result - 1.0) < 0.000000000001
    uxcapi.CallFree(callHandle)

    ' Raw opaque-pointer API: gsl_vector_alloc/set/get/free.
    callHandle = uxgsl.GslCallNew("gsl_vector_alloc", uxcapi.KIND_PTR, 0, 1)
    ASSERT callHandle <> 0
    ASSERT uxcapi.ArgU64(callHandle, 2) = 1
    ASSERT uxcapi.Invoke(callHandle) = 1
    vectorHandle = uxcapi.ResultPtr(callHandle)
    ASSERT vectorHandle <> 0
    uxcapi.CallFree(callHandle)

    callHandle = uxgsl.GslCallNew("gsl_vector_set", uxcapi.KIND_VOID, 0, 3)
    ASSERT callHandle <> 0
    ASSERT uxcapi.ArgPtr(callHandle, vectorHandle) = 1
    ASSERT uxcapi.ArgU64(callHandle, 0) = 1
    ASSERT uxcapi.ArgF64(callHandle, 42.5) = 1
    ASSERT uxcapi.Invoke(callHandle) = 1
    uxcapi.CallFree(callHandle)

    callHandle = uxgsl.GslCallNew("gsl_vector_get", uxcapi.KIND_F64, 0, 2)
    ASSERT callHandle <> 0
    ASSERT uxcapi.ArgPtr(callHandle, vectorHandle) = 1
    ASSERT uxcapi.ArgU64(callHandle, 0) = 1
    ASSERT uxcapi.Invoke(callHandle) = 1
    ASSERT ABS(uxcapi.ResultF64(callHandle) - 42.5) < 0.000000000001
    uxcapi.CallFree(callHandle)

    callHandle = uxgsl.GslCallNew("gsl_vector_free", uxcapi.KIND_VOID, 0, 1)
    ASSERT callHandle <> 0
    ASSERT uxcapi.ArgPtr(callHandle, vectorHandle) = 1
    ASSERT uxcapi.Invoke(callHandle) = 1
    uxcapi.CallFree(callHandle)

    ' CBlas is kept as a separate DLL and factory.
    ASSERT uxgsl.CblasSymbol("cblas_ddot") <> 0
    PRINT "UXGSL_FULL_ABI_SMOKE_PASS"
END MAIN
