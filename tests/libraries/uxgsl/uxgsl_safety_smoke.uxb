INCLUDE "include/modules/uxgsl.uxmh"

MAIN
    DIM values AS U64
    DIM rng AS U64
    DIM failedValue AS F64

    ' Invalid arguments never terminate the process. They set a documented
    ' status and a floating-point failure returns NaN.
    values = uxgsl.VectorCreate(-1)
    ASSERT values = 0
    ASSERT uxgsl.LastStatus() = 1
    ASSERT LEN(uxgsl.LastError()) > 0

    values = uxgsl.VectorCreate(2)
    ASSERT values <> 0
    ASSERT uxgsl.VectorSet(values, 2, 99.0) = 0
    ASSERT uxgsl.LastStatus() = 4
    failedValue = uxgsl.VectorGet(values, -1)
    ASSERT failedValue <> failedValue
    ASSERT uxgsl.LastStatus() = 4
    uxgsl.VectorFree(values)
    ASSERT uxgsl.LastStatus() = 0
    values = 0

    ' Null and wrong-type typed handles are rejected by the native facade.
    ' Clear every handle after Free; this also keeps AST token checking strict.
    ASSERT uxgsl.VectorSize(values) = 0
    ASSERT uxgsl.LastStatus() = 3
    uxgsl.VectorFree(values)
    ASSERT uxgsl.LastStatus() = 3

    failedValue = uxgsl.GaussianPdf(0.0, 0.0)
    ASSERT failedValue <> failedValue
    ASSERT uxgsl.LastStatus() = 1

    rng = uxgsl.RngCreate(7)
    ASSERT rng <> 0
    uxgsl.RngFree(rng)
    ASSERT uxgsl.LastStatus() = 0
    rng = 0
    failedValue = uxgsl.RngUniform(rng)
    ASSERT failedValue <> failedValue
    ASSERT uxgsl.LastStatus() = 3

    PRINT "UXGSL_SAFETY_SMOKE_PASS"
END MAIN
