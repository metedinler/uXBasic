INCLUDE "include/modules/uxgsl.uxmh"
INCLUDE "include/modules/uxgsl_generated/gsl_sf_airy.uxmh"
INCLUDE "include/modules/uxgsl_generated/gsl_sf_bessel.uxmh"
INCLUDE "include/modules/uxgsl_generated/gsl_sf_expint.uxmh"

MAIN
    DIM result AS F64

    ' These functions are generated from the installed public GSL headers,
    ' and each invokes its verified *_e counterpart inside uxgsl.dll.
    ASSERT ABS(uxgsl.SfBesselJn(2, 0.0)) < 0.000000000001
    ASSERT uxgsl.LastStatus() = 0

    result = uxgsl.SfAiryZeroAi(1)
    ASSERT result < -2.0
    ASSERT result > -2.5
    ASSERT uxgsl.LastStatus() = 0

    ASSERT uxgsl.SfChi(1.0) > 0.8
    ASSERT uxgsl.SfChi(1.0) < 0.9
    ASSERT uxgsl.LastStatus() = 0

    result = uxgsl.SfBesselY0_Gslsf_bessel_UpperY0(-1.0)
    ASSERT result <> result
    ASSERT uxgsl.LastStatus() = 5

    PRINT "UXGSL_GENERATED_SCALAR_SMOKE_PASS"
END MAIN
