INCLUDE "include/modules/uxgsl.uxmh"

MAIN
    DIM values AS U64
    DIM rng AS U64
    DIM randomValue AS F64

    ' uxgsl.c: uxgsl_api_version() = 106 (API 102'den buyudu; test bayat kalmisti)
    ASSERT uxgsl.ApiVersion() = 106
    ASSERT uxgsl.Available() = 1
    ASSERT LEN(uxgsl.GslVersion()) > 0
    ASSERT uxgsl.SelfTest() = 1

    ASSERT ABS(uxgsl.BesselJ0(0.0) - 1.0) < 0.000000000001
    ASSERT ABS(uxgsl.Gamma(5.0) - 24.0) < 0.000000000001
    ASSERT ABS(uxgsl.Erf(0.0)) < 0.000000000001
    ASSERT uxgsl.GaussianPdf(0.0, 1.0) > 0.39

    values = uxgsl.VectorCreate(4)
    ASSERT values <> 0
    ASSERT uxgsl.VectorSize(values) = 4
    ASSERT uxgsl.VectorSet(values, 0, 1.0) = 1
    ASSERT uxgsl.VectorSet(values, 1, 2.0) = 1
    ASSERT uxgsl.VectorSet(values, 2, 3.0) = 1
    ASSERT uxgsl.VectorSet(values, 3, 4.0) = 1
    ASSERT ABS(uxgsl.VectorGet(values, 2) - 3.0) < 0.000000000001
    ASSERT ABS(uxgsl.VectorMean(values) - 2.5) < 0.000000000001
    ASSERT ABS(uxgsl.VectorVariance(values) - 1.666666666666667) < 0.000000000001
    uxgsl.VectorFree(values)
    ASSERT uxgsl.LastStatus() = 0

    rng = uxgsl.RngCreate(12345)
    ASSERT rng <> 0
    randomValue = uxgsl.RngUniform(rng)
    ASSERT randomValue >= 0.0
    ASSERT randomValue < 1.0
    uxgsl.RngFree(rng)

    PRINT "UXGSL_UXBASIC_SMOKE_PASS"
END MAIN
