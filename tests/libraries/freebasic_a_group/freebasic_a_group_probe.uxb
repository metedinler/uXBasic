INCLUDE "include/modules/uxsystem.uxmh"
INCLUDE "include/modules/uxfs.uxmh"
INCLUDE "include/modules/uxpath.uxmh"

MAIN
 DIM base AS STRING
 PRINT "probe-start"
 ASSERT uxsystem.CpuCount() > 0
 PRINT "after-cpu-first"
 base = uxsystem.TempDirectory()
 PRINT base
 PRINT "after-temp"
 base = uxpath.Join(base, "uxb_fb_a_group_probe")
 PRINT base
 PRINT "after-join"
 ASSERT uxfs.CreateDirectories(base) = 1
 PRINT "probe-pass"
END MAIN
