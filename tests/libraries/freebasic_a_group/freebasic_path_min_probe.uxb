INCLUDE "include/modules/uxsystem.uxmh"

NAMESPACE pathmin
FUNCTION Join(a AS STRING, b AS STRING) AS STRING
    RETURN CALL(DLL, "uxpath.dll", "uxpath_join", STRPTR, CDECL, "STRPTR,STRPTR", a,b)
END FUNCTION
END NAMESPACE

MAIN
 DIM tempDir AS STRING
 DIM joined AS STRING
 PRINT "path-min-probe-start"
 tempDir = uxsystem.TempDirectory()
 PRINT tempDir
 PRINT "path-min-after-temp"
 joined = pathmin.Join(tempDir, "uxb_fb_path_probe")
 PRINT joined
 PRINT "path-min-probe-pass"
END MAIN
