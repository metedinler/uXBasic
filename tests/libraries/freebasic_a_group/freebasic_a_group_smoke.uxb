INCLUDE "include/modules/uxsystem.uxmh"
INCLUDE "include/modules/uxfs.uxmh"
INCLUDE "include/modules/uxpath.uxmh"
INCLUDE "include/modules/uxprocess.uxmh"
INCLUDE "include/modules/uxlog.uxmh"
INCLUDE "include/modules/uxconfig.uxmh"
INCLUDE "include/modules/uxdatetime.uxmh"
INCLUDE "include/modules/uxuuid.uxmh"
MAIN
 DIM base AS STRING
 DIM f AS STRING
 DIM logger AS U64
 DIM cfg AS U64
 DIM id AS STRING
 DIM tempDir AS STRING
 tempDir = uxsystem.TempDirectory()
 base = uxpath.Join(tempDir, "uxb_fb_a_group_test")
 ASSERT uxfs.CreateDirectories(base) = 1
 f = uxpath.Join(base, "sample.txt")
 ASSERT uxfs.WriteAllText(f, "uXBasic") = 1
 ASSERT uxfs.FileExists(f) = 1
 ASSERT uxfs.ReadAllText(f) = "uXBasic"
 logger = uxlog.Open(uxpath.Join(base,"test.log"), 0, 1048576)
 ASSERT logger <> 0
 ASSERT uxlog.Info(logger,"smoke") = 1
 uxlog.Close(logger)
 cfg = uxconfig.Open(uxpath.Join(base,"test.ini"))
 ASSERT cfg <> 0
 ASSERT uxconfig.SetString(cfg,"main","name","uXBasic") = 1
 ASSERT uxconfig.GetString(cfg,"main","name","") = "uXBasic"
 uxconfig.Close(cfg)
 id=uxuuid.NewUuid()
 ASSERT uxuuid.IsValid(id)=1
 ASSERT uxdatetime.UnixMillisecondsUtc()>0
 ASSERT uxsystem.CpuCount()>0
 PRINT "UXB_FREEBASIC_A_GROUP_SMOKE_PASS"
END MAIN
