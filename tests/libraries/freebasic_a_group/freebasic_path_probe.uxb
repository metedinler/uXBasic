INCLUDE "include/modules/uxsystem.uxmh"
INCLUDE "include/modules/uxpath.uxmh"

MAIN
 DIM tempDir AS STRING
 DIM joined AS STRING
 PRINT "path-probe-start"
 tempDir = uxsystem.TempDirectory()
 PRINT tempDir
 PRINT "path-probe-after-temp"
 joined = uxpath.Join(tempDir, "uxb_fb_path_probe")
 PRINT joined
 PRINT "path-probe-pass"
END MAIN
