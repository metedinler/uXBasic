INCLUDE "include/modules/uxconfig.uxmh"
MAIN
    DIM cfg AS U64
    DIM configPath AS STRING
    DIM value AS STRING
    configPath = "build\ffi_final_roundtrip.ini"
    cfg = uxconfig.Open(configPath)
    ASSERT cfg <> 0
    ASSERT uxconfig.SetString(cfg, "main", "name", "uXBasic") = 1
    value = uxconfig.GetString(cfg, "main", "name", "missing")
    ASSERT value = "uXBasic"
    ASSERT uxconfig.Path(cfg) = configPath
    uxconfig.Close(cfg)
    PRINT "UXB_FFI_FREEBASIC_ROUNDTRIP_PASS"
END MAIN
