INCLUDE "include/modules/uxjsruntime.uxmh"

DIM runtimeHandle AS I32
DIM contextHandle AS I32
DIM resultHandle AS I32
DIM resultJson AS STRING

runtimeHandle = JsRuntimeCreate()
ASSERT runtimeHandle > 0
ASSERT JsRuntimeMemoryLimitMb(runtimeHandle, 64) = 1
ASSERT JsRuntimeStackLimitKb(runtimeHandle, 1024) = 1
ASSERT JsRuntimeTimeLimitMs(runtimeHandle, 5000) = 1

contextHandle = JsContextCreate(runtimeHandle)
ASSERT contextHandle > 0
ASSERT JsBootstrapUxb(contextHandle, "runtime/js/common/ux_runtime_core.js", "runtime/js/quickjs/ux_runtime_quickjs.js") = 1
ASSERT JsEvalFile(contextHandle, "tests/libraries/uxjsruntime/smoke.js", JsEvalScriptFlag() + JsEvalDrainJobsFlag()) = 1

resultHandle = JsCallAwait(contextHandle, "uxbMain", "[]", 10000)
ASSERT resultHandle > 0
resultJson = JsResultJson(contextHandle, resultHandle)
PRINT resultJson
ASSERT INSTR(resultJson, "UXJSRT_GLOBALTHIS_UXB_PASS") > 0
ASSERT INSTR(resultJson, "quickjs") > 0
ASSERT INSTR(resultJson, "30") > 0

ASSERT JsResultFree(contextHandle, resultHandle) = 1
ASSERT JsContextFree(contextHandle) = 1
ASSERT JsRuntimeFree(runtimeHandle) = 1
PRINT "UXJSRT_UXBASIC_SMOKE_PASS"
