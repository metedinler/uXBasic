INCLUDE "include/modules/uxwasmrt.uxmh"

DIM sessionHandle AS I32
DIM resultValue AS I32

ASSERT WasmRuntimeApiVersion() = 100
ASSERT WasmRuntimeAvailable() = 1
ASSERT WasmValidateFile("tests\libraries\uxwasmrt\reference_26_07\add.wasm") = 1

sessionHandle = WasmOpenFile("tests\libraries\uxwasmrt\reference_26_07\add.wasm")
ASSERT sessionHandle <> 0
ASSERT WasmHasExport(sessionHandle, "ADD") = 1
resultValue = WasmCallI32_2(sessionHandle, "ADD", 10, 20)
ASSERT WasmLastOk(sessionHandle) = 1
ASSERT resultValue = 30
ASSERT WasmClose(sessionHandle) = 1
PRINT "UXWASMRT_UXBASIC_SMOKE_PASS"
