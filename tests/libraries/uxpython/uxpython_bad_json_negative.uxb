INCLUDE "include/modules/uxpython.uxmh"

MAIN
    DIM session AS U64
    DIM result AS U64

    session = PythonOpen("", "", "tests/libraries/uxpython", 0)
    ASSERT session <> 0

    result = PythonCallModule(session, "math", "sqrt", "not-json", "{}")
    ASSERT result = 0
    ASSERT LEN(PythonError(session)) > 0

    ASSERT PythonClose(session) = 1
    PRINT "PASS_UXPYTHON_NEGATIVE"
END MAIN
