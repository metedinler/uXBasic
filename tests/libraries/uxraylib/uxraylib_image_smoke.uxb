INCLUDE "include/modules/uxraylib.uxmh"

' uxraylib CPU-tarafi Image API'si (S-052): pencere/GL baglami GEREKTIRMEZ. Beklenen degerler raylib 5.5 anlamindan ELLE hesaplandi.
MAIN
    DIM img AS I32
    DIM img2 AS I32
    DIM cp AS I32
    DIM red AS U32
    DIM blue AS U32
    DIM white AS U32
    DIM c AS U32

    red = uxraylib.ColorRGBA(255, 0, 0, 255)
    blue = uxraylib.ColorRGBA(0, 0, 255, 255)
    white = uxraylib.ColorRGBA(255, 255, 255, 255)

    ' --- olusturma, boyut, piksel
    img = uxraylib.ImageGenColor(4, 3, red)
    ASSERT img <> 0
    ASSERT uxraylib.ImageValid(img) = 1
    ASSERT uxraylib.ImageWidth(img) = 4
    ASSERT uxraylib.ImageHeight(img) = 3
    ASSERT uxraylib.ImageGetColor(img, 0, 0) = red
    ASSERT uxraylib.ImageGetColor(img, 3, 2) = red
    ASSERT uxraylib.ImageGetColor(img, 4, 0) = 0
    ASSERT uxraylib.ImageGetColor(img, 0, 3) = 0
    ASSERT uxraylib.ImageGetColor(img, -1, 0) = 0

    ' --- cizim
    uxraylib.ImageDrawPixel(img, 1, 1, blue)
    ASSERT uxraylib.ImageGetColor(img, 1, 1) = blue
    ASSERT uxraylib.ImageGetColor(img, 0, 0) = red
    uxraylib.ImageDrawRectangle(img, 2, 0, 2, 2, blue)
    ASSERT uxraylib.ImageGetColor(img, 2, 0) = blue
    ASSERT uxraylib.ImageGetColor(img, 3, 1) = blue
    ASSERT uxraylib.ImageGetColor(img, 1, 0) = red
    ASSERT uxraylib.ImageGetColor(img, 3, 2) = red
    uxraylib.ImageClearBackground(img, red)
    ASSERT uxraylib.ImageGetColor(img, 2, 0) = red

    ' --- kopya bagimsizdir
    cp = uxraylib.ImageCopy(img)
    ASSERT cp <> 0
    ASSERT cp <> img
    uxraylib.ImageDrawPixel(img, 0, 0, blue)
    ASSERT uxraylib.ImageGetColor(cp, 0, 0) = red
    ASSERT uxraylib.ImageGetColor(img, 0, 0) = blue
    uxraylib.ImageUnload(cp)
    ASSERT uxraylib.ImageValid(cp) = 0
    ASSERT uxraylib.ImageWidth(cp) = 0
    uxraylib.ImageUnload(cp)

    ' --- cevirmeler (4x3, (0,0)=mavi, gerisi kirmizi)
    uxraylib.ImageFlipHorizontal(img)
    ASSERT uxraylib.ImageGetColor(img, 3, 0) = blue
    ASSERT uxraylib.ImageGetColor(img, 0, 0) = red
    uxraylib.ImageFlipVertical(img)
    ASSERT uxraylib.ImageGetColor(img, 3, 2) = blue
    ASSERT uxraylib.ImageGetColor(img, 3, 0) = red

    ' --- dondurme: (3,2)=mavi. Saat yonunde 90: yeni 3x4; (x,y) -> (H-1-y, x) = (0,3)
    uxraylib.ImageRotateCW(img)
    ASSERT uxraylib.ImageWidth(img) = 3
    ASSERT uxraylib.ImageHeight(img) = 4
    ASSERT uxraylib.ImageGetColor(img, 0, 3) = blue
    ASSERT uxraylib.ImageGetColor(img, 2, 3) = red
    ' Saat yonu tersine 90 onu geri alir: 4x3, (3,2)=mavi
    uxraylib.ImageRotateCCW(img)
    ASSERT uxraylib.ImageWidth(img) = 4
    ASSERT uxraylib.ImageHeight(img) = 3
    ASSERT uxraylib.ImageGetColor(img, 3, 2) = blue

    ' --- kirpma / boyutlandirma
    uxraylib.ImageCrop(img, 2, 1, 2, 2)
    ASSERT uxraylib.ImageWidth(img) = 2
    ASSERT uxraylib.ImageHeight(img) = 2
    ASSERT uxraylib.ImageGetColor(img, 1, 1) = blue
    ASSERT uxraylib.ImageGetColor(img, 0, 0) = red
    uxraylib.ImageResizeNN(img, 4, 4)
    ASSERT uxraylib.ImageWidth(img) = 4
    ASSERT uxraylib.ImageHeight(img) = 4
    ASSERT uxraylib.ImageGetColor(img, 3, 3) = blue
    ASSERT uxraylib.ImageGetColor(img, 0, 0) = red
    uxraylib.ImageResize(img, 8, 6)
    ASSERT uxraylib.ImageWidth(img) = 8
    ASSERT uxraylib.ImageHeight(img) = 6
    uxraylib.ImageUnload(img)

    ' --- renk islemleri (tek renkli 2x2 kirmizi)
    img = uxraylib.ImageGenColor(2, 2, red)
    uxraylib.ImageColorInvert(img)
    ASSERT uxraylib.ImageGetColor(img, 0, 0) = uxraylib.ColorRGBA(0, 255, 255, 255)
    uxraylib.ImageClearBackground(img, red)
    uxraylib.ImageColorGrayscale(img)
    c = uxraylib.ImageGetColor(img, 1, 1)
    ASSERT (c AND 255) = ((c >> 8) AND 255)
    ASSERT (c AND 255) = ((c >> 16) AND 255)
    ASSERT (c AND 255) > 0
    ' ImageColorGrayscale goruntuyu 1 kanalli GRAYSCALE bicimine cevirir (bicim 1); RGBA'ya (bicim 7) geri donmeden renk islemi yapilmaz
    ASSERT uxraylib.ImagePixelFormat(img) = 1
    uxraylib.ImageConvertFormat(img, 7)
    ASSERT uxraylib.ImagePixelFormat(img) = 7
    uxraylib.ImageClearBackground(img, red)
    uxraylib.ImageColorBrightness(img, 50)
    c = uxraylib.ImageGetColor(img, 0, 0)
    ASSERT (c AND 255) = 255
    ASSERT ((c >> 8) AND 255) = 50
    ASSERT ((c >> 16) AND 255) = 50
    uxraylib.ImageClearBackground(img, red)
    uxraylib.ImageColorTint(img, white)
    ASSERT uxraylib.ImageGetColor(img, 0, 0) = red
    uxraylib.ImageUnload(img)

    ' --- desenli uretim: 2'ser pikselik damalar
    img = uxraylib.ImageGenChecked(4, 4, 2, 2, red, blue)
    ASSERT uxraylib.ImageGetColor(img, 0, 0) = red
    ASSERT uxraylib.ImageGetColor(img, 1, 1) = red
    ASSERT uxraylib.ImageGetColor(img, 2, 0) = blue
    ASSERT uxraylib.ImageGetColor(img, 0, 2) = blue
    ASSERT uxraylib.ImageGetColor(img, 2, 2) = red
    uxraylib.ImageUnload(img)
    img = uxraylib.ImageGenGradientLinear(4, 4, 0, red, blue)
    ASSERT uxraylib.ImageGetColor(img, 0, 0) <> uxraylib.ImageGetColor(img, 0, 3)
    uxraylib.ImageUnload(img)

    ' --- dosyaya yaz / geri oku
    img = uxraylib.ImageGenColor(5, 4, blue)
    ASSERT uxraylib.ImageExport(img, "out/uxraylib_image_smoke.png") = 1
    img2 = uxraylib.ImageLoad("out/uxraylib_image_smoke.png")
    ASSERT img2 <> 0
    ASSERT uxraylib.ImageWidth(img2) = 5
    ASSERT uxraylib.ImageHeight(img2) = 4
    ASSERT uxraylib.ImageGetColor(img2, 2, 2) = blue
    uxraylib.ImageUnload(img2)
    uxraylib.ImageUnload(img)
    ASSERT uxraylib.ImageLoad("out/bu_dosya_yok.png") = 0

    ' --- gecersiz tutamac guvenli
    ASSERT uxraylib.ImageWidth(0) = 0
    ASSERT uxraylib.ImageValid(9999) = 0
    ASSERT uxraylib.ImageGenColor(0, 5, red) = 0
    uxraylib.ImageFlipVertical(9999)
    uxraylib.ImageDrawPixel(0, 1, 1, red)

    PRINT "UXRAYLIB_IMAGE_SMOKE_PASS"
END MAIN