INCLUDE "include/modules/uxraylib_3d.uxmh"

' uxraylib pencere gerektirmeyen 3B geometri (S-052, raylib Models/3D dilimi 2) duman testi. GENERATED by
' tools/library_tools/gen_uxraylib_3d_cpu_test.py: beklenen degerler raylib'in kendi islevlerini DOGRUDAN cagiran bir C programindan gelir.
FUNCTION Near(a AS F64, b AS F64) AS I32
    DIM d AS F64
    DIM tol AS F64
    d = a - b
    IF d < 0.0 THEN d = 0.0 - d
    tol = 0.0005
    IF b > 1000.0 THEN tol = 0.05
    IF d < tol THEN RETURN 1
    RETURN 0
END FUNCTION

MAIN
    DIM cam AS I32
    DIM m AS I32
    ASSERT uxraylib.MatrixLiveCount() = 0
    ' --- kure - kure
    ASSERT uxraylib.CheckCollisionSpheres(0, 0, 0, 1, 1.5, 0, 0, 1) = 1
    ASSERT uxraylib.CheckCollisionSpheres(0, 0, 0, 1, 3, 0, 0, 1) = 0
    ' --- kutu - kutu / kutu - kure
    uxraylib.VectorSlotSet(0, 0, 0, 0, 0)
    uxraylib.VectorSlotSet(1, 2, 2, 2, 0)
    uxraylib.VectorSlotSet(2, 1, 1, 1, 0)
    uxraylib.VectorSlotSet(3, 3, 3, 3, 0)
    uxraylib.VectorSlotSet(4, 5, 5, 5, 0)
    uxraylib.VectorSlotSet(5, 6, 6, 6, 0)
    ASSERT uxraylib.CheckCollisionBoxesSlots(0, 1, 2, 3) = 1
    ASSERT uxraylib.CheckCollisionBoxesSlots(0, 1, 4, 5) = 0
    ASSERT uxraylib.CheckCollisionBoxSphereSlots(0, 1, 3, 1, 1, 1.5) = 1
    ASSERT uxraylib.CheckCollisionBoxSphereSlots(0, 1, 3, 1, 1, 0.5) = 0
    ' --- isin - kure
    uxraylib.VectorSlotSet(0, 0, 0, -5, 0)
    uxraylib.VectorSlotSet(1, 0, 0, 1, 0)
    uxraylib.VectorSlotSet(2, 0, 3, -5, 0)
    ASSERT uxraylib.RayCollisionSphereSlots(0, 1, 0, 0, 0, 1) = 1
    ASSERT uxraylib.RayHit() = 1
    ASSERT Near(uxraylib.RayDistance(), 4) = 1
    ASSERT Near(uxraylib.RayPoint(0), 0) = 1
    ASSERT Near(uxraylib.RayPoint(1), 0) = 1
    ASSERT Near(uxraylib.RayPoint(2), -1) = 1
    ASSERT Near(uxraylib.RayNormal(0), 0) = 1
    ASSERT Near(uxraylib.RayNormal(1), 0) = 1
    ASSERT Near(uxraylib.RayNormal(2), -1) = 1
    ASSERT uxraylib.RayCollisionSphereSlots(2, 1, 0, 0, 0, 1) = 0
    ASSERT uxraylib.RayHit() = 0
    ' --- isin - kutu
    uxraylib.VectorSlotSet(0, 1, 1, -5, 0)
    uxraylib.VectorSlotSet(1, 0, 0, 1, 0)
    uxraylib.VectorSlotSet(2, 0, 0, 0, 0)
    uxraylib.VectorSlotSet(3, 2, 2, 2, 0)
    ASSERT uxraylib.RayCollisionBoxSlots(0, 1, 2, 3) = 1
    ASSERT Near(uxraylib.RayDistance(), 5) = 1
    ASSERT Near(uxraylib.RayPoint(2), 0) = 1
    ASSERT Near(uxraylib.RayNormal(2), -1) = 1
    ' --- isin - ucgen / dortgen
    uxraylib.VectorSlotSet(0, 0.5, 0.5, -3, 0)
    uxraylib.VectorSlotSet(1, 0, 0, 1, 0)
    uxraylib.VectorSlotSet(2, 0, 0, 0, 0)
    uxraylib.VectorSlotSet(3, 2, 0, 0, 0)
    uxraylib.VectorSlotSet(4, 0, 2, 0, 0)
    uxraylib.VectorSlotSet(5, 2, 2, 0, 0)
    ASSERT uxraylib.RayCollisionTriangleSlots(0, 1, 2, 3, 4) = 1
    ASSERT Near(uxraylib.RayDistance(), 3) = 1
    ASSERT Near(uxraylib.RayPoint(0), 0.5) = 1
    ASSERT Near(uxraylib.RayPoint(1), 0.5) = 1
    ASSERT Near(uxraylib.RayNormal(2), 1) = 1
    ASSERT uxraylib.RayCollisionQuadSlots(0, 1, 2, 3, 5, 4) = 1
    ASSERT Near(uxraylib.RayDistance(), 3) = 1
    ASSERT Near(uxraylib.RayNormal(2), 1) = 1
    ' --- kamera tutamaci ve donusumler
    uxraylib.VectorSlotSet(0, 0, 2, 5, 0)
    uxraylib.VectorSlotSet(1, 0, 0, 0, 0)
    uxraylib.VectorSlotSet(2, 0, 1, 0, 0)
    cam = uxraylib.CameraCreate(0, 1, 2, 45.0, 0)
    ASSERT uxraylib.CameraValid(cam) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 0, 1), 2) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 0, 2), 5) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 2, 1), 1) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 3, 0), 45) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 4, 0), 0) = 1
    ' --- kamera donusumleri
    uxraylib.WorldToScreen(cam, 0, 0, 0, 800, 600)
    ASSERT Near(uxraylib.ResX(), 400) = 1
    ASSERT Near(uxraylib.ResY(), 300) = 1
    ' --- kamera donusumleri 2
    uxraylib.WorldToScreen(cam, 1.5, 0.5, -1, 800, 600)
    ASSERT Near(uxraylib.ResX(), 577.285522) = 1
    ASSERT Near(uxraylib.ResY(), 201.23674) = 1
    ' --- ekrandan dunya isini
    uxraylib.ScreenToWorldRay(cam, 400, 300, 800, 600)
    ASSERT Near(uxraylib.ResGet(0, 0), 0) = 1
    ASSERT Near(uxraylib.ResGet(0, 1), 2) = 1
    ASSERT Near(uxraylib.ResGet(0, 2), 5) = 1
    ASSERT Near(uxraylib.ResGet(1, 0), 0) = 1
    ASSERT Near(uxraylib.ResGet(1, 1), -0.371385396) = 1
    ASSERT Near(uxraylib.ResGet(1, 2), -0.928478777) = 1
    ' --- UpdateCameraPro
    uxraylib.CameraUpdatePro(cam, 1.0, 0.5, 0.25, 10.0, 5.0, 0.0, 0.0)
    ASSERT Near(uxraylib.CameraGet(cam, 0, 0), 0.666052103) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 0, 1), 2.25) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 0, 2), 4.1020155) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 1, 0), 1.50072014) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 1, 1), -0.178168058) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 1, 2), -0.631621957) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 2, 0), 0) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 2, 1), 1) = 1
    ASSERT Near(uxraylib.CameraGet(cam, 2, 2), 0) = 1
    ' --- gorunum matrisi
    m = uxraylib.CameraMatrix(cam)
    ASSERT Near(uxraylib.MatrixElement(m, 0), 0.98480767) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 1), -0) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 2), 0.173648193) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 3), -1.36824083) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 4), 0.0782978833) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 5), 0.892574549) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 6), -0.444049299) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 7), -0.23894608) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 8), -0.154993981) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 9), 0.450899512) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 10), 0.879014432) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 11), -4.5170207) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(m, 15), 1) = 1
    uxraylib.MatrixRelease(m)
    uxraylib.CameraRelease(cam)
    ASSERT uxraylib.CameraValid(cam) = 0
    ASSERT uxraylib.MatrixLiveCount() = 0
    uxraylib.MathClearError()
    ASSERT Near(uxraylib.CameraGet(0, 3, 0), 45.0) = 1
    ASSERT uxraylib.MathLastError() = 4
    uxraylib.MathClearError()
    PRINT "RAY3DCPU_PASS"
END MAIN
