INCLUDE "include/modules/uxsdl3.uxmh"

' uxsdl3 ses API'si (S-052): uretilen tonlar, WAV yazma/okuma, calma/duraklatma/dongu/ses seviyesi, aygit ve surucu listeleri.
' SDL'in "dummy" ses surucusu kullanilir: gercek hoparlor gerekmez, ama veri gercek zamanla tuketilir (sure olcumleri gercektir).
MAIN
    DIM t AS I32
    DIM t2 AS I32
    DIM t3 AS I32
    DIM i AS I32
    DIM ok AS I32
    DIM snd(0 TO 199) AS I32
    uxsdl3.SetHint("SDL_AUDIO_DRIVER", "dummy")
    ASSERT uxsdl3.Init(uxsdl3.INIT_AUDIO) = 1
    ASSERT uxsdl3.CurrentAudioDriver() = "dummy"
    ASSERT uxsdl3.AudioDriverCount() >= 1
    ASSERT LEN(uxsdl3.AudioDriverName(0)) > 0
    ASSERT uxsdl3.AudioDriverName(99) = ""
    ASSERT uxsdl3.AudioDeviceCount(0) >= 1
    ASSERT LEN(uxsdl3.AudioDeviceName(0, 0)) > 0
    ASSERT uxsdl3.AudioDeviceName(0, 99) = ""
    ASSERT uxsdl3.AudioDeviceName(0, -1) = ""
    ASSERT uxsdl3.AudioDeviceCount(1) >= 0

    ' --- uretilen ton: 440 Hz, 200 ms, 0.5 genlik
    t = uxsdl3.CreateTone(440, 200, 0.5)
    ASSERT t > 0
    ASSERT uxsdl3.SoundLengthMs(t) = 200
    ASSERT uxsdl3.SoundFrequency(t) = 44100
    ASSERT uxsdl3.SoundChannels(t) = 1
    ASSERT uxsdl3.IsSoundPlaying(t) = 0
    ASSERT uxsdl3.IsSoundPaused(t) = 1
    ASSERT uxsdl3.SoundRemainingMs(t) = 0
    uxsdl3.PlaySound(t)
    ASSERT uxsdl3.IsSoundPaused(t) = 0
    ASSERT uxsdl3.IsSoundPlaying(t) = 1
    ASSERT uxsdl3.SoundRemainingMs(t) > 0
    ASSERT uxsdl3.SoundRemainingMs(t) <= 200
    ' sure dolunca kendiliginden biter
    uxsdl3.Delay(450)
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.SoundRemainingMs(t) = 0
    ASSERT uxsdl3.IsSoundPlaying(t) = 0
    ' yeniden calma
    uxsdl3.PlaySound(t)
    ASSERT uxsdl3.IsSoundPlaying(t) = 1
    uxsdl3.StopSound(t)
    ASSERT uxsdl3.IsSoundPlaying(t) = 0
    ASSERT uxsdl3.SoundRemainingMs(t) = 0

    ' --- ses seviyesi: sound x master, sinirlar 0..4
    ASSERT INT(uxsdl3.GetSoundVolume(t) * 100) = 100
    uxsdl3.SetSoundVolume(t, 0.5)
    ASSERT INT(uxsdl3.GetSoundVolume(t) * 100) = 50
    uxsdl3.SetSoundVolume(t, 9)
    ASSERT INT(uxsdl3.GetSoundVolume(t)) = 4
    uxsdl3.SetSoundVolume(t, -1)
    ASSERT uxsdl3.GetSoundVolume(t) = 0
    uxsdl3.SetSoundVolume(t, 1)
    ASSERT INT(uxsdl3.GetMasterVolume() * 100) = 100
    uxsdl3.SetMasterVolume(0.25)
    ASSERT INT(uxsdl3.GetMasterVolume() * 100) = 25
    uxsdl3.SetMasterVolume(100)
    ASSERT INT(uxsdl3.GetMasterVolume()) = 4
    uxsdl3.SetMasterVolume(-3)
    ASSERT uxsdl3.GetMasterVolume() = 0
    uxsdl3.SetMasterVolume(1)

    ' --- dongu: PumpEvents beslemeyi surdurur (500 ms > 200 ms ton)
    ASSERT uxsdl3.GetSoundLoop(t) = 0
    uxsdl3.SetSoundLoop(t, 1)
    ASSERT uxsdl3.GetSoundLoop(t) = 1
    uxsdl3.PlaySound(t)
    FOR i = 1 TO 10
        uxsdl3.Delay(50)
        uxsdl3.PumpEvents()
    NEXT
    ASSERT uxsdl3.IsSoundPlaying(t) = 1
    uxsdl3.StopSound(t)
    ASSERT uxsdl3.IsSoundPlaying(t) = 0
    ASSERT uxsdl3.GetSoundLoop(t) = 0

    ' --- duraklat / surdur
    t2 = uxsdl3.CreateTone(220, 2000, 0.3)
    ASSERT t2 > 0
    ASSERT uxsdl3.SoundLengthMs(t2) = 2000
    uxsdl3.PlaySound(t2)
    ASSERT uxsdl3.IsSoundPlaying(t2) = 1
    uxsdl3.PauseSound(t2)
    ASSERT uxsdl3.IsSoundPaused(t2) = 1
    ASSERT uxsdl3.IsSoundPlaying(t2) = 0
    ASSERT uxsdl3.SoundRemainingMs(t2) > 0
    uxsdl3.ResumeSound(t2)
    ASSERT uxsdl3.IsSoundPaused(t2) = 0
    ASSERT uxsdl3.IsSoundPlaying(t2) = 1
    uxsdl3.StopSound(t2)
    uxsdl3.UnloadSound(t2)

    ' --- WAV yaz / geri oku: ayni sure, ornekleme hizi ve kanal
    ASSERT uxsdl3.CreateDirectory("out") = 1
    ASSERT uxsdl3.SaveSoundWAV(t, "out/uxsdl3_tone.wav") = 1
    ASSERT uxsdl3.PathType("out/uxsdl3_tone.wav") = uxsdl3.PATH_FILE
    ASSERT uxsdl3.PathSize("out/uxsdl3_tone.wav") = 44 + 17640
    t3 = uxsdl3.LoadSound("out/uxsdl3_tone.wav")
    ASSERT t3 > 0
    ASSERT t3 <> t
    ASSERT uxsdl3.SoundLengthMs(t3) = 200
    ASSERT uxsdl3.SoundFrequency(t3) = 44100
    ASSERT uxsdl3.SoundChannels(t3) = 1
    uxsdl3.PlaySound(t3)
    ASSERT uxsdl3.IsSoundPlaying(t3) = 1
    uxsdl3.StopSound(t3)
    uxsdl3.UnloadSound(t3)
    ASSERT uxsdl3.RemovePath("out/uxsdl3_tone.wav") = 1
    ASSERT uxsdl3.SaveSoundWAV(t, "out/yok_klasor/x.wav") = 0
    ASSERT uxsdl3.SaveSoundWAV(0, "out/x.wav") = 0
    ASSERT uxsdl3.LoadSound("out/uxsdl3_bu_ses_yok.wav") = 0

    ' --- gecersiz tonlar ve tutamaclar
    ASSERT uxsdl3.CreateTone(19, 100, 1) = 0
    ASSERT uxsdl3.CreateTone(20001, 100, 1) = 0
    ASSERT uxsdl3.CreateTone(440, 0, 1) = 0
    ASSERT uxsdl3.CreateTone(440, 60001, 1) = 0
    uxsdl3.PlaySound(0)
    uxsdl3.PlaySound(9999)
    uxsdl3.StopSound(-1)
    uxsdl3.PauseSound(0)
    uxsdl3.ResumeSound(0)
    uxsdl3.SetSoundVolume(0, 1)
    uxsdl3.SetSoundLoop(0, 1)
    ASSERT uxsdl3.IsSoundPlaying(0) = 0
    ASSERT uxsdl3.IsSoundPaused(9999) = 0
    ASSERT uxsdl3.SoundLengthMs(9999) = 0
    ASSERT uxsdl3.SoundRemainingMs(0) = 0
    ASSERT uxsdl3.SoundFrequency(0) = 0
    ASSERT uxsdl3.GetSoundVolume(0) = 0
    ASSERT uxsdl3.GetSoundLoop(0) = 0

    ' --- kaldirma sonrasi tutamac gecersiz, ikinci kaldirma zararsiz
    uxsdl3.UnloadSound(t)
    ASSERT uxsdl3.IsSoundPlaying(t) = 0
    ASSERT uxsdl3.SoundLengthMs(t) = 0
    uxsdl3.UnloadSound(t)

    ' --- tutamac tablosu: 127 ses, sonrakisi 0; kaldirinca yer acilir
    ok = 0
    FOR i = 0 TO 199
        snd(i) = uxsdl3.CreateTone(300 + i, 5, 0.1)
        IF snd(i) > 0 THEN ok = ok + 1
    NEXT
    ASSERT ok = 127
    ASSERT snd(126) > 0
    ASSERT snd(127) = 0
    uxsdl3.UnloadSound(snd(50))
    t = uxsdl3.CreateTone(500, 5, 0.1)
    ASSERT t > 0
    ASSERT uxsdl3.CreateTone(500, 5, 0.1) = 0
    FOR i = 0 TO 126
        uxsdl3.UnloadSound(snd(i))
    NEXT
    uxsdl3.UnloadSound(t)

    uxsdl3.Quit()
    PRINT "UXSDL3_AUDIO_SMOKE_PASS"
END MAIN