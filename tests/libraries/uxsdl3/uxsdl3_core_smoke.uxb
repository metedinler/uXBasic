INCLUDE "include/modules/uxsdl3.uxmh"

' uxsdl3 cekirdek/sistem API'si (S-052): baslatma, ipuclari, uygulama bilgisi, zaman (yuksek cozunurluk + duvar saati),
' dosya sistemi, sistem bilgisi, guc, yerel ayar, dokunmatik. Pencere gerekmez.
MAIN
    DIM a AS I64
    DIM b AS I64
    DIM i AS I32
    DIM n AS I32
    DIM w AS I64
    DIM base AS STRING
    ASSERT uxsdl3.Init(uxsdl3.INIT_EVENTS) = 1
    ASSERT uxsdl3.WasInit(uxsdl3.INIT_EVENTS) = uxsdl3.INIT_EVENTS
    ASSERT uxsdl3.WasInit(uxsdl3.INIT_GAMEPAD) = 0

    ' --- alt sistemler ayri ayri acilir/kapanir
    ASSERT uxsdl3.InitSubSystem(uxsdl3.INIT_JOYSTICK) = 1
    ASSERT (uxsdl3.WasInit(uxsdl3.INIT_JOYSTICK) AND uxsdl3.INIT_JOYSTICK) <> 0
    uxsdl3.QuitSubSystem(uxsdl3.INIT_JOYSTICK)
    ASSERT (uxsdl3.WasInit(uxsdl3.INIT_JOYSTICK) AND uxsdl3.INIT_JOYSTICK) = 0
    ASSERT (uxsdl3.WasInit(uxsdl3.INIT_EVENTS) AND uxsdl3.INIT_EVENTS) <> 0

    ' --- surum ve platform
    ASSERT uxsdl3.RuntimeVersion() >= 3000000
    ASSERT LEN(uxsdl3.Revision()) > 0
    ASSERT uxsdl3.GetPlatform() = "Windows"
    ASSERT uxsdl3.AdapterVersion() = 100

    ' --- uygulama bilgisi ve ipuclari
    ASSERT uxsdl3.SetAppMetadata("uXBasic SDL3 sinavi", "1.2.3", "com.uxbasic.sdl3test") = 1
    ASSERT uxsdl3.GetAppMetadata(0) = "uXBasic SDL3 sinavi"
    ASSERT uxsdl3.GetAppMetadata(1) = "1.2.3"
    ASSERT uxsdl3.GetAppMetadata(2) = "com.uxbasic.sdl3test"
    ASSERT uxsdl3.SetHint("SDL_UXB_TEST_HINT", "abc") = 1
    ASSERT uxsdl3.GetHint("SDL_UXB_TEST_HINT") = "abc"
    ASSERT uxsdl3.SetHint("SDL_UXB_TEST_HINT", "") = 1
    ASSERT uxsdl3.GetHint("SDL_UXB_TEST_HINT") = ""
    ASSERT uxsdl3.GetHint("SDL_UXB_HIC_KURULMAMIS") = ""

    ' --- hata metni
    uxsdl3.ClearError()
    ASSERT uxsdl3.LastError() = ""
    ASSERT uxsdl3.LoadTexture(0, "out/yok.bmp") = 0
    ASSERT uxsdl3.OpenJoystick(0) = 0
    uxsdl3.ClearError()
    ASSERT uxsdl3.LastError() = ""

    ' --- zaman: milisaniye/nanosaniye/sayac tutarli
    a = uxsdl3.GetTicksNS()
    uxsdl3.Delay(30)
    b = uxsdl3.GetTicksNS()
    ASSERT b - a >= 25000000
    ASSERT b - a < 2000000000
    ASSERT uxsdl3.GetTicks() >= 0
    ASSERT uxsdl3.PerfFrequency() > 0
    a = uxsdl3.PerfCounter()
    uxsdl3.DelayNS(10000000)
    b = uxsdl3.PerfCounter()
    ASSERT b > a
    ASSERT (b - a) * 1000 / uxsdl3.PerfFrequency() >= 8
    a = uxsdl3.GetTicksNS()
    uxsdl3.DelayPreciseNS(5000000)
    b = uxsdl3.GetTicksNS()
    ASSERT b - a >= 4000000
    uxsdl3.DelayNS(-5)
    uxsdl3.Delay(-5)

    ' --- duvar saati ve takvim
    w = uxsdl3.CurrentTimeNS()
    ASSERT w > 0
    ASSERT uxsdl3.DatePart(w, 0, 0) >= 2026
    ASSERT uxsdl3.DatePart(w, 0, 1) >= 1
    ASSERT uxsdl3.DatePart(w, 0, 1) <= 12
    ' 1970-01-01 00:00:00 UTC, persembe
    ASSERT uxsdl3.DatePart(0, 0, 0) = 1970
    ASSERT uxsdl3.DatePart(0, 0, 1) = 1
    ASSERT uxsdl3.DatePart(0, 0, 2) = 1
    ASSERT uxsdl3.DatePart(0, 0, 3) = 0
    ASSERT uxsdl3.DatePart(0, 0, 7) = 4
    ' 2000-03-01 12:34:56 UTC = 951914096 s
    ASSERT uxsdl3.DatePart(951914096000000000, 0, 0) = 2000
    ASSERT uxsdl3.DatePart(951914096000000000, 0, 1) = 3
    ASSERT uxsdl3.DatePart(951914096000000000, 0, 2) = 1
    ASSERT uxsdl3.DatePart(951914096000000000, 0, 3) = 12
    ASSERT uxsdl3.DatePart(951914096000000000, 0, 4) = 34
    ASSERT uxsdl3.DatePart(951914096000000000, 0, 5) = 56
    ASSERT uxsdl3.DatePart(951914096000000000, 0, 7) = 3
    ASSERT uxsdl3.DaysInMonth(2024, 2) = 29
    ASSERT uxsdl3.DaysInMonth(2023, 2) = 28
    ASSERT uxsdl3.DaysInMonth(1900, 2) = 28
    ASSERT uxsdl3.DaysInMonth(2000, 2) = 29
    ASSERT uxsdl3.DaysInMonth(2026, 4) = 30
    ASSERT uxsdl3.DaysInMonth(2026, 12) = 31
    ASSERT uxsdl3.DaysInMonth(2026, 13) = -1
    ASSERT uxsdl3.DayOfYear(2024, 3, 1) = 60
    ASSERT uxsdl3.DayOfYear(2023, 3, 1) = 59
    ASSERT uxsdl3.DayOfYear(2026, 1, 1) = 0
    ASSERT uxsdl3.DayOfYear(2026, 12, 31) = 364

    ' --- yollar
    base = uxsdl3.BasePath()
    ASSERT LEN(base) > 0
    ASSERT RIGHT(base, 1) = "\" OR RIGHT(base, 1) = "/"
    ASSERT LEN(uxsdl3.CurrentDirectory()) > 0
    ASSERT uxsdl3.PathType(base) = uxsdl3.PATH_DIRECTORY
    ASSERT uxsdl3.PathType("out/uxsdl3_hic_yok_yol") = uxsdl3.PATH_NONE
    ASSERT uxsdl3.PathSize("out/uxsdl3_hic_yok_yol") = -1
    ASSERT uxsdl3.PathModifyTime("out/uxsdl3_hic_yok_yol") = 0
    ASSERT uxsdl3.PrefPath("uxbasic", "uxsdl3_sinav") <> ""
    ASSERT uxsdl3.PathType(uxsdl3.PrefPath("uxbasic", "uxsdl3_sinav")) = uxsdl3.PATH_DIRECTORY
    ' (bos metin bir FFI argumaninda motorlar arasi FARKLI davranir: yorumlayicilar NULL, native/legacy gercek bos metin gecirir -- S-145; testler bos metin argumanina dayanmaz)

    ' --- dosya islemleri: klasor olustur, dosya yaz (BMP), kopyala, adlandir, listele, sil
    ASSERT uxsdl3.CreateDirectory("out/uxsdl3_fs/alt") = 1
    ASSERT uxsdl3.PathType("out/uxsdl3_fs") = uxsdl3.PATH_DIRECTORY
    ASSERT uxsdl3.PathType("out/uxsdl3_fs/alt") = uxsdl3.PATH_DIRECTORY
    ASSERT uxsdl3.CreateDirectory("out/uxsdl3_fs/alt") = 1
    uxsdl3.SetHint("SDL_VIDEO_DRIVER", "dummy")
    ASSERT uxsdl3.InitSubSystem(uxsdl3.INIT_VIDEO) = 1
    w = uxsdl3.CreateWindow("dosya", 8, 8, uxsdl3.WINDOW_HIDDEN)
    a = uxsdl3.CreateRenderer(w, "software")
    ASSERT a <> 0
    ASSERT uxsdl3.RenderClear(a) = 1
    ASSERT uxsdl3.RenderSaveBMP(a, "out/uxsdl3_fs/ilk.bmp") = 1
    uxsdl3.DestroyRenderer(a)
    uxsdl3.DestroyWindow(w)
    ASSERT uxsdl3.PathType("out/uxsdl3_fs/ilk.bmp") = uxsdl3.PATH_FILE
    ASSERT uxsdl3.PathSize("out/uxsdl3_fs/ilk.bmp") = 8 * 8 * 3 + 54
    ASSERT uxsdl3.PathModifyTime("out/uxsdl3_fs/ilk.bmp") > 0
    ASSERT uxsdl3.CopyFile("out/uxsdl3_fs/ilk.bmp", "out/uxsdl3_fs/kopya.bmp") = 1
    ASSERT uxsdl3.PathSize("out/uxsdl3_fs/kopya.bmp") = 8 * 8 * 3 + 54
    ASSERT uxsdl3.CopyFile("out/uxsdl3_fs/yok.bmp", "out/uxsdl3_fs/x.bmp") = 0
    ASSERT uxsdl3.RenamePath("out/uxsdl3_fs/kopya.bmp", "out/uxsdl3_fs/alt/tasindi.png") = 1
    ASSERT uxsdl3.PathType("out/uxsdl3_fs/kopya.bmp") = uxsdl3.PATH_NONE
    ASSERT uxsdl3.PathType("out/uxsdl3_fs/alt/tasindi.png") = uxsdl3.PATH_FILE
    ASSERT uxsdl3.RenamePath("out/uxsdl3_fs/yok", "out/uxsdl3_fs/yok2") = 0
    ' listeleme: kalip ile suzme
    ' kalipsiz: klasorun ALTINDAKI HER SEY (alt klasor girdileri "alt\ad" olarak dahil)
    ASSERT uxsdl3.ListDirectory("out/uxsdl3_fs", "") = 3
    ASSERT uxsdl3.ListDirectory("out/uxsdl3_fs", "*") = 2
    ASSERT uxsdl3.ListDirectory("out/uxsdl3_fs", "*.bmp") = 1
    ASSERT uxsdl3.ListItem(0) = "ilk.bmp"
    ASSERT uxsdl3.ListItem(1) = ""
    ASSERT uxsdl3.ListItem(-1) = ""
    ASSERT uxsdl3.ListDirectory("out/uxsdl3_fs/alt", "*.png") = 1
    ASSERT uxsdl3.ListItem(0) = "tasindi.png"
    ASSERT uxsdl3.ListDirectory("out/uxsdl3_fs", "*.txt") = 0
    ASSERT uxsdl3.ListDirectory("out/uxsdl3_yok_klasor", "") = -1
    ASSERT uxsdl3.ListItem(0) = ""
    ' dolu klasor silinmez, bos klasor silinir
    ASSERT uxsdl3.RemovePath("out/uxsdl3_fs/alt") = 0
    ASSERT uxsdl3.RemovePath("out/uxsdl3_fs/alt/tasindi.png") = 1
    ASSERT uxsdl3.RemovePath("out/uxsdl3_fs/alt") = 1
    ASSERT uxsdl3.RemovePath("out/uxsdl3_fs/ilk.bmp") = 1
    ASSERT uxsdl3.RemovePath("out/uxsdl3_fs") = 1
    ' olmayan yolu silmek hata sayilmaz (SDL3 davranisi)
    ASSERT uxsdl3.RemovePath("out/uxsdl3_fs") = 1
    ASSERT uxsdl3.PathType("out/uxsdl3_fs") = uxsdl3.PATH_NONE

    ' --- sistem bilgisi
    ASSERT uxsdl3.CPUCount() >= 1
    ASSERT uxsdl3.SystemRAMMB() > 0
    ASSERT uxsdl3.CPUCacheLineSize() >= 16
    ASSERT uxsdl3.CPUFeature(2) = 1
    ASSERT uxsdl3.CPUFeature(9) = 0
    ASSERT uxsdl3.CPUFeature(99) = 0
    ASSERT uxsdl3.IsTablet() >= 0
    ASSERT uxsdl3.IsTV() >= 0
    ASSERT uxsdl3.PowerState() >= uxsdl3.POWER_ERROR
    ASSERT uxsdl3.PowerState() <= uxsdl3.POWER_CHARGED
    ASSERT uxsdl3.PowerPercent() >= -1
    ASSERT uxsdl3.PowerPercent() <= 100
    ASSERT uxsdl3.PowerSeconds() >= -1

    ' --- yerel ayarlar
    n = uxsdl3.LocaleCount()
    ASSERT n >= 0
    IF n > 0 THEN
        ASSERT LEN(uxsdl3.LocaleLanguage(0)) >= 2
    END IF
    ASSERT uxsdl3.LocaleLanguage(n + 5) = ""
    ASSERT uxsdl3.LocaleCountry(-1) = ""

    ' --- dokunmatik: aygit yoksa sifir, gecersiz kimlik guvenli
    ASSERT uxsdl3.TouchDeviceCount() >= 0
    ASSERT uxsdl3.TouchDeviceIdAt(-1) = 0
    ASSERT uxsdl3.TouchDeviceName(0) = ""
    ASSERT uxsdl3.TouchDeviceType(0) = -1
    ASSERT uxsdl3.TouchFingerCount(0) = 0
    ASSERT uxsdl3.TouchFinger(0, 0, 0) = 0

    uxsdl3.Quit()
    ASSERT uxsdl3.WasInit(0) = 0
    PRINT "UXSDL3_CORE_SMOKE_PASS"
END MAIN