INCLUDE "include/modules/uxsdl3.uxmh"

' uxsdl3 pano (clipboard) API'si (S-052). Pencere gerektirmez; video alt sistemi (SDL_VIDEODRIVER=dummy ile de) yeterli.
MAIN
    DIM longText AS STRING
    DIM i AS I32
    ASSERT uxsdl3.Init(uxsdl3.INIT_VIDEO) = 1

    ASSERT uxsdl3.SetClipboardText("uXBasic pano denemesi 123") = 1
    ASSERT uxsdl3.HasClipboardText() = 1
    ASSERT uxsdl3.GetClipboardText() = "uXBasic pano denemesi 123"
    ASSERT uxsdl3.GetClipboardText() = "uXBasic pano denemesi 123"

    ' uzerine yazma
    ASSERT uxsdl3.SetClipboardText("ikinci") = 1
    ASSERT uxsdl3.GetClipboardText() = "ikinci"

    ' uzun metin (400 bayt)
    longText = ""
    FOR i = 1 TO 40
        longText = longText + "0123456789"
    NEXT
    ASSERT uxsdl3.SetClipboardText(longText) = 1
    ASSERT LEN(uxsdl3.GetClipboardText()) = 400
    ASSERT uxsdl3.GetClipboardText() = longText

    ' UTF-8 (Turkce karakterler) baytlari korunur: 7 harf, 13 bayt
    ASSERT uxsdl3.SetClipboardText("ğüşiöçİ") = 1
    ASSERT LEN(uxsdl3.GetClipboardText()) = 13
    ASSERT uxsdl3.GetClipboardText() = "ğüşiöçİ"

    ' bos metin: pano metin icermez
    ASSERT uxsdl3.SetClipboardText("") = 1
    ASSERT uxsdl3.HasClipboardText() = 0
    ASSERT uxsdl3.GetClipboardText() = ""

    uxsdl3.Quit()
    PRINT "UXSDL3_CLIPBOARD_SMOKE_PASS"
END MAIN