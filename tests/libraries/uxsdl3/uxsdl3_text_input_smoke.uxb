INCLUDE "include/modules/uxsdl3.uxmh"

' uxsdl3 metin girisi (S-052). Gercek klavye yok: PushTextInput ayni yazi tamponuna yapay yazi koyar (PumpEvents ile teslim).
' SDL_VIDEODRIVER=dummy ile de calisir; pencere gorunmez.
MAIN
    DIM win AS I64
    DIM big AS STRING
    DIM i AS I32
    ASSERT uxsdl3.Init(uxsdl3.INIT_VIDEO) = 1
    win = uxsdl3.CreateWindow("uxsdl3 metin girisi", 320, 200, 0)
    ASSERT win <> 0

    ASSERT uxsdl3.TextInputActive(win) = 0
    ASSERT uxsdl3.TakeTextInput() = ""
    ASSERT uxsdl3.StartTextInput(win) = 1
    ASSERT uxsdl3.TextInputActive(win) = 1
    ASSERT uxsdl3.SetTextInputArea(win, 10, 10, 100, 20, 0) = 1

    ' PumpEvents cagrilmadan yazi gelmez; ardisik yapay yazilar birlesir, UTF-8 korunur (5 karakter, 6 bayt)
    ASSERT uxsdl3.PushTextInput("abc") = 1
    ASSERT uxsdl3.PushTextInput("dç") = 1
    ASSERT uxsdl3.TakeTextInput() = ""
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.TakeTextInput() = "abcdç"
    ' alinan yazi tampondan silinir
    ASSERT uxsdl3.TakeTextInput() = ""

    ' birden cok tur
    ASSERT uxsdl3.PushTextInput("x") = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.PushTextInput("y") = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.TakeTextInput() = "xy"

    ' bos yazi kuyruga girmez; tampon tasarsa parca bolunmeden reddedilir
    ASSERT uxsdl3.PushTextInput("") = 0
    big = ""
    FOR i = 1 TO 105
        big = big + "0123456789"
    NEXT
    ASSERT LEN(big) = 1050
    ASSERT uxsdl3.PushTextInput(big) = 0
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.TakeTextInput() = ""

    ' durdurma
    ASSERT uxsdl3.StopTextInput(win) = 1
    ASSERT uxsdl3.TextInputActive(win) = 0

    ' gecersiz pencere tutamagi guvenli
    ASSERT uxsdl3.StartTextInput(0) = 0
    ASSERT uxsdl3.StopTextInput(0) = 0
    ASSERT uxsdl3.TextInputActive(0) = 0
    ASSERT uxsdl3.SetTextInputArea(0, 0, 0, 1, 1, 0) = 0

    ' tus adlari ve degistirici tuslar
    ASSERT uxsdl3.GetScancodeName(4) = "A"
    ASSERT uxsdl3.GetScancodeName(41) = "Escape"
    ASSERT uxsdl3.GetScancodeName(44) = "Space"
    ASSERT uxsdl3.GetScancodeName(-5) = ""
    ' degistirici durumu gercek klavyeye (NumLock/CapsLock) baglidir: yalniz okunabildigi denetlenir
    ASSERT uxsdl3.GetModState() >= 0

    uxsdl3.DestroyWindow(win)
    uxsdl3.Quit()
    PRINT "UXSDL3_TEXT_INPUT_SMOKE_PASS"
END MAIN