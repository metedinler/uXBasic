INCLUDE "include/modules/uxsdl3.uxmh"

' uxsdl3 cizim (renderer/doku) API'si (S-052). Yazilim cizicisi + gorunmez pencere: ekran gerekmez.
' Beklenen pikseller ELLE hesaplandi; RenderReadPixel cizimi geri okuyarak dogrular.
MAIN
    DIM win AS I64
    DIM r AS I64
    DIM tex AS I64
    DIM tex2 AS I64
    DIM tgt AS I64
    DIM px AS U32
    DIM before AS U32
    DIM red AS U32
    DIM green AS U32
    DIM blue AS U32
    DIM white AS U32
    DIM black AS U32
    DIM magenta AS U32
    DIM x AS I32
    DIM y AS I32
    DIM lit AS I32
    uxsdl3.SetHint("SDL_VIDEO_DRIVER", "dummy")
    ASSERT uxsdl3.Init(uxsdl3.INIT_VIDEO) = 1
    red = uxsdl3.PackRGBA(255, 0, 0, 255)
    green = uxsdl3.PackRGBA(0, 255, 0, 255)
    blue = uxsdl3.PackRGBA(0, 0, 255, 255)
    white = uxsdl3.PackRGBA(255, 255, 255, 255)
    black = uxsdl3.PackRGBA(0, 0, 0, 255)
    magenta = uxsdl3.PackRGBA(255, 0, 255, 255)
    ' renk paketleme gidis-donus
    ASSERT red = 4278190335
    ASSERT uxsdl3.UnpackR(red) = 255
    ASSERT uxsdl3.UnpackG(green) = 255
    ASSERT uxsdl3.UnpackB(blue) = 255
    ASSERT uxsdl3.UnpackA(blue) = 255
    ASSERT uxsdl3.UnpackA(uxsdl3.PackRGBA(1, 2, 3, 4)) = 4
    ASSERT uxsdl3.UnpackB(uxsdl3.PackRGBA(1, 2, 3, 4)) = 3

    win = uxsdl3.CreateWindow("cizim sinavi", 64, 48, uxsdl3.WINDOW_HIDDEN)
    ASSERT win <> 0
    r = uxsdl3.CreateRenderer(win, "software")
    ASSERT r <> 0
    ASSERT uxsdl3.RendererName(r) = "software"
    ASSERT uxsdl3.RenderOutputWidth(r) = 64
    ASSERT uxsdl3.RenderOutputHeight(r) = 48

    ' --- temizleme ve cizim renkleri
    ASSERT uxsdl3.SetRenderDrawColor(r, 255, 0, 0, 255) = 1
    ASSERT uxsdl3.GetRenderDrawColor(r, uxsdl3.COMP_R) = 255
    ASSERT uxsdl3.GetRenderDrawColor(r, uxsdl3.COMP_G) = 0
    ASSERT uxsdl3.GetRenderDrawColor(r, uxsdl3.COMP_A) = 255
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 5, 5) = red
    ASSERT uxsdl3.RenderReadPixel(r, 0, 0) = red
    ASSERT uxsdl3.RenderReadPixel(r, 63, 47) = red
    ASSERT uxsdl3.RenderReadPixel(r, 64, 47) = 0
    ASSERT uxsdl3.RenderReadPixel(r, -1, 0) = 0

    ' --- dolu dikdortgen, ana hat, cizgi, nokta
    ASSERT uxsdl3.SetRenderDrawColorRGBA(r, green) = 1
    ASSERT uxsdl3.RenderFillRect(r, 10, 10, 20, 20) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 10, 10) = green
    ASSERT uxsdl3.RenderReadPixel(r, 29, 29) = green
    ASSERT uxsdl3.RenderReadPixel(r, 9, 10) = red
    ASSERT uxsdl3.RenderReadPixel(r, 30, 30) = red
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 0, 255, 255) = 1
    ASSERT uxsdl3.RenderRect(r, 40, 5, 10, 10) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 44, 5) = blue
    ASSERT uxsdl3.RenderReadPixel(r, 40, 9) = blue
    ASSERT uxsdl3.RenderReadPixel(r, 44, 9) = red
    ASSERT uxsdl3.SetRenderDrawColor(r, 255, 255, 255, 255) = 1
    ASSERT uxsdl3.RenderLine(r, 0, 40, 63, 40) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 30, 40) = white
    ASSERT uxsdl3.RenderReadPixel(r, 30, 41) = red
    ASSERT uxsdl3.RenderPoint(r, 2, 2) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 2, 2) = white

    ' --- karistirma kipi: yari saydam mavi kirmizinin ustune
    ASSERT uxsdl3.GetRenderDrawBlendMode(r) = uxsdl3.BLEND_NONE
    ASSERT uxsdl3.SetRenderDrawBlendMode(r, uxsdl3.BLEND_BLEND) = 1
    ASSERT uxsdl3.GetRenderDrawBlendMode(r) = uxsdl3.BLEND_BLEND
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 0, 255, 128) = 1
    ASSERT uxsdl3.RenderFillRect(r, 50, 20, 10, 10) = 1
    px = uxsdl3.RenderReadPixel(r, 55, 25)
    ASSERT uxsdl3.UnpackR(px) >= 125 AND uxsdl3.UnpackR(px) <= 130
    ASSERT uxsdl3.UnpackB(px) >= 125 AND uxsdl3.UnpackB(px) <= 130
    ASSERT uxsdl3.UnpackG(px) = 0
    ASSERT uxsdl3.SetRenderDrawBlendMode(r, uxsdl3.BLEND_NONE) = 1

    ' --- goruntu alani (viewport): ciziler goruntu alani icine oteleniyor
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.SetRenderViewport(r, 32, 16, 32, 32) = 1
    ASSERT uxsdl3.GetRenderViewport(r, uxsdl3.PART_X) = 32
    ASSERT uxsdl3.GetRenderViewport(r, uxsdl3.PART_Y) = 16
    ASSERT uxsdl3.GetRenderViewport(r, uxsdl3.PART_W) = 32
    ASSERT uxsdl3.GetRenderViewport(r, uxsdl3.PART_H) = 32
    ASSERT uxsdl3.SetRenderDrawColor(r, 255, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderFillRect(r, 0, 0, 4, 4) = 1
    ASSERT uxsdl3.ResetRenderViewport(r) = 1
    ASSERT uxsdl3.GetRenderViewport(r, uxsdl3.PART_W) = 64
    ASSERT uxsdl3.RenderReadPixel(r, 32, 16) = red
    ASSERT uxsdl3.RenderReadPixel(r, 35, 19) = red
    ASSERT uxsdl3.RenderReadPixel(r, 0, 0) = black
    ASSERT uxsdl3.RenderReadPixel(r, 31, 16) = black

    ' --- kirpma dikdortgeni
    ASSERT uxsdl3.RenderClipEnabled(r) = 0
    ASSERT uxsdl3.SetRenderClipRect(r, 0, 0, 10, 10) = 1
    ASSERT uxsdl3.RenderClipEnabled(r) = 1
    ASSERT uxsdl3.GetRenderClipRect(r, uxsdl3.PART_W) = 10
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 255, 0, 255) = 1
    ASSERT uxsdl3.RenderFillRect(r, 0, 0, 64, 48) = 1
    ASSERT uxsdl3.DisableRenderClip(r) = 1
    ASSERT uxsdl3.RenderClipEnabled(r) = 0
    ASSERT uxsdl3.RenderReadPixel(r, 9, 9) = green
    ASSERT uxsdl3.RenderReadPixel(r, 10, 9) = black
    ASSERT uxsdl3.RenderReadPixel(r, 9, 10) = black

    ' --- olcek
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.SetRenderScale(r, 2, 2) = 1
    ASSERT uxsdl3.GetRenderScale(r, 0) = 2
    ASSERT uxsdl3.GetRenderScale(r, 1) = 2
    ASSERT uxsdl3.SetRenderDrawColor(r, 255, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderFillRect(r, 5, 5, 5, 5) = 1
    ASSERT uxsdl3.SetRenderScale(r, 1, 1) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 10, 10) = red
    ASSERT uxsdl3.RenderReadPixel(r, 19, 19) = red
    ASSERT uxsdl3.RenderReadPixel(r, 20, 20) = black
    ASSERT uxsdl3.RenderReadPixel(r, 9, 9) = black

    ' --- mantiksal cozunurluk: 32x24 mantiksal, 64x48 cikis (2 kat)
    ASSERT uxsdl3.GetRenderLogicalMode(r) = uxsdl3.LOGICAL_DISABLED
    ASSERT uxsdl3.SetRenderLogicalPresentation(r, 32, 24, uxsdl3.LOGICAL_STRETCH) = 1
    ASSERT uxsdl3.GetRenderLogicalMode(r) = uxsdl3.LOGICAL_STRETCH
    ASSERT uxsdl3.GetRenderLogicalSize(r, 0) = 32
    ASSERT uxsdl3.GetRenderLogicalSize(r, 1) = 24
    ASSERT uxsdl3.RenderCoordsFromWindow(r, 32, 24, 0) = 16
    ASSERT uxsdl3.RenderCoordsFromWindow(r, 32, 24, 1) = 12
    ASSERT uxsdl3.RenderCoordsToWindow(r, 16, 12, 0) = 32
    ASSERT uxsdl3.SetRenderLogicalPresentation(r, 0, 0, uxsdl3.LOGICAL_DISABLED) = 1
    ASSERT uxsdl3.GetRenderLogicalMode(r) = uxsdl3.LOGICAL_DISABLED

    ' --- doku: bos doku, doldurma, tek piksel
    tex = uxsdl3.CreateTexture(r, 8, 8, uxsdl3.TEXTUREACCESS_STATIC)
    ASSERT tex <> 0
    ASSERT uxsdl3.GetTextureWidth(tex) = 8
    ASSERT uxsdl3.GetTextureHeight(tex) = 8
    ASSERT uxsdl3.TextureFill(tex, green) = 1
    ASSERT uxsdl3.TextureSetPixel(tex, 1, 1, magenta) = 1
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.RenderTexture(r, tex, 20, 20, 8, 8) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 20, 20) = green
    ASSERT uxsdl3.RenderReadPixel(r, 21, 21) = magenta
    ASSERT uxsdl3.RenderReadPixel(r, 27, 27) = green
    ASSERT uxsdl3.RenderReadPixel(r, 28, 28) = black
    ' olcekleme kipi
    ASSERT uxsdl3.TextureSetScaleMode(tex, uxsdl3.SCALEMODE_NEAREST) = 1
    ASSERT uxsdl3.TextureGetScaleMode(tex) = uxsdl3.SCALEMODE_NEAREST
    ' iki kat buyutulmus cizim: (1,1) magenta 2x2 piksel olur
    ASSERT uxsdl3.RenderTexture(r, tex, 0, 0, 16, 16) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 2, 2) = magenta
    ASSERT uxsdl3.RenderReadPixel(r, 3, 3) = magenta
    ASSERT uxsdl3.RenderReadPixel(r, 4, 4) = green

    ' --- renk/alfa carpani
    ASSERT uxsdl3.TextureSetColorMod(tex, 255, 0, 0) = 1
    ASSERT uxsdl3.TextureGetColorMod(tex, uxsdl3.COMP_R) = 255
    ASSERT uxsdl3.TextureGetColorMod(tex, uxsdl3.COMP_G) = 0
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.RenderTexture(r, tex, 20, 20, 8, 8) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 24, 24) = black
    ASSERT uxsdl3.TextureSetColorMod(tex, 255, 255, 255) = 1
    ASSERT uxsdl3.TextureGetBlendMode(tex) = uxsdl3.BLEND_BLEND
    ASSERT uxsdl3.TextureSetBlendMode(tex, uxsdl3.BLEND_BLEND) = 1
    ASSERT uxsdl3.TextureSetAlphaMod(tex, 128) = 1
    ASSERT uxsdl3.TextureGetAlphaMod(tex) = 128
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.RenderTexture(r, tex, 20, 20, 8, 8) = 1
    px = uxsdl3.RenderReadPixel(r, 24, 24)
    ASSERT uxsdl3.UnpackG(px) >= 125 AND uxsdl3.UnpackG(px) <= 130
    ASSERT uxsdl3.TextureSetAlphaMod(tex, 255) = 1

    ' --- kaynak dikdortgen ve sprite sayfasi (8x4 doku: sol 4x4 kirmizi, sag 4x4 mavi)
    tex2 = uxsdl3.CreateTexture(r, 8, 4, uxsdl3.TEXTUREACCESS_STATIC)
    ASSERT tex2 <> 0
    ASSERT uxsdl3.TextureFill(tex2, red) = 1
    FOR x = 4 TO 7
        FOR y = 0 TO 3
            ASSERT uxsdl3.TextureSetPixel(tex2, x, y, blue) = 1
        NEXT
    NEXT
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.RenderTextureRect(r, tex2, 4, 0, 4, 4, 30, 30, 4, 4) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 31, 31) = blue
    ASSERT uxsdl3.RenderTextureFrame(r, tex2, 4, 4, 0, 40, 30, 4, 4) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 41, 31) = red
    ASSERT uxsdl3.RenderTextureFrame(r, tex2, 4, 4, 1, 50, 30, 4, 4) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 51, 31) = blue
    ' sayfanin disindaki kare ve gecersiz olculer reddedilir
    ASSERT uxsdl3.RenderTextureFrame(r, tex2, 4, 4, 2, 0, 0, 4, 4) = 0
    ASSERT uxsdl3.RenderTextureFrame(r, tex2, 0, 4, 0, 0, 0, 4, 4) = 0
    ASSERT uxsdl3.RenderTextureFrame(r, tex2, 4, 4, -1, 0, 0, 4, 4) = 0
    uxsdl3.DestroyTexture(tex2)

    ' --- dondurme ve cevirme: 4x4 yesil doku, sol ust piksel eflatun
    uxsdl3.DestroyTexture(tex)
    tex = uxsdl3.CreateTexture(r, 4, 4, uxsdl3.TEXTUREACCESS_STATIC)
    ASSERT uxsdl3.TextureFill(tex, green) = 1
    ASSERT uxsdl3.TextureSetPixel(tex, 0, 0, magenta) = 1
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.RenderTextureRotated(r, tex, 8, 8, 4, 4, 0, 0, 0, uxsdl3.FLIP_NONE) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 8, 8) = magenta
    ASSERT uxsdl3.RenderTextureRotated(r, tex, 20, 8, 4, 4, 0, 0, 0, uxsdl3.FLIP_HORIZONTAL) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 23, 8) = magenta
    ASSERT uxsdl3.RenderReadPixel(r, 20, 8) = green
    ASSERT uxsdl3.RenderTextureRotated(r, tex, 32, 8, 4, 4, 0, 0, 0, uxsdl3.FLIP_VERTICAL) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 32, 11) = magenta
    ' 90 derece saat yonu: sol ust kose sag uste gider
    ASSERT uxsdl3.RenderTextureRotated(r, tex, 44, 8, 4, 4, 90, 0, 0, uxsdl3.FLIP_NONE) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 47, 8) = magenta
    ASSERT uxsdl3.RenderReadPixel(r, 44, 8) = green
    ' 180 derece: sol ust kose sag alta gider
    ASSERT uxsdl3.RenderTextureRotated(r, tex, 8, 24, 4, 4, 180, 0, 0, uxsdl3.FLIP_NONE) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 11, 27) = magenta
    uxsdl3.DestroyTexture(tex)

    ' --- cizim hedefi: dokuya ciz, sonra pencereye
    tgt = uxsdl3.CreateTexture(r, 16, 16, uxsdl3.TEXTUREACCESS_TARGET)
    ASSERT tgt <> 0
    ASSERT uxsdl3.SetRenderTarget(r, tgt) = 1
    ASSERT uxsdl3.RenderOutputWidth(r) = 16
    ASSERT uxsdl3.SetRenderDrawColor(r, 255, 255, 255, 255) = 1
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.SetRenderDrawColor(r, 255, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderFillRect(r, 0, 0, 8, 8) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 2, 2) = red
    ASSERT uxsdl3.RenderReadPixel(r, 12, 12) = white
    ASSERT uxsdl3.SetRenderTarget(r, 0) = 1
    ASSERT uxsdl3.RenderOutputWidth(r) = 64
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.RenderTexture(r, tgt, 30, 20, 16, 16) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 31, 21) = red
    ASSERT uxsdl3.RenderReadPixel(r, 42, 32) = white
    ASSERT uxsdl3.RenderReadPixel(r, 29, 19) = black
    uxsdl3.DestroyTexture(tgt)

    ' --- yerlesik hata ayiklama yazisi: siyah zeminde bir harf beyaz piksel birakir
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.SetRenderDrawColor(r, 255, 255, 255, 255) = 1
    ASSERT uxsdl3.RenderDebugText(r, 2, 2, "A") = 1
    lit = 0
    FOR y = 2 TO 9
        FOR x = 2 TO 9
            IF uxsdl3.RenderReadPixel(r, x, y) = white THEN lit = lit + 1
        NEXT
    NEXT
    ASSERT lit > 8
    ASSERT lit < 40
    ASSERT uxsdl3.RenderReadPixel(r, 30, 30) = black

    ' --- ekran goruntusu: kaydet, doku olarak geri yukle, ayni pikseller
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 255, 0, 255) = 1
    ASSERT uxsdl3.RenderFillRect(r, 10, 10, 20, 20) = 1
    before = uxsdl3.RenderReadPixel(r, 15, 15)
    ASSERT before = green
    ASSERT uxsdl3.CreateDirectory("out") = 1
    ASSERT uxsdl3.RenderSaveBMP(r, "out/uxsdl3_shot.bmp") = 1
    ASSERT uxsdl3.PathType("out/uxsdl3_shot.bmp") = uxsdl3.PATH_FILE
    ASSERT uxsdl3.PathSize("out/uxsdl3_shot.bmp") = 64 * 48 * 3 + 54
    tex = uxsdl3.LoadTexture(r, "out/uxsdl3_shot.bmp")
    ASSERT tex <> 0
    ASSERT uxsdl3.GetTextureWidth(tex) = 64
    ASSERT uxsdl3.GetTextureHeight(tex) = 48
    ASSERT uxsdl3.SetRenderDrawColor(r, 0, 0, 0, 255) = 1
    ASSERT uxsdl3.RenderClear(r) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 15, 15) = black
    ASSERT uxsdl3.RenderTexture(r, tex, 0, 0, 64, 48) = 1
    ASSERT uxsdl3.RenderReadPixel(r, 15, 15) = before
    ASSERT uxsdl3.RenderReadPixel(r, 5, 5) = black
    uxsdl3.DestroyTexture(tex)
    ASSERT uxsdl3.RemovePath("out/uxsdl3_shot.bmp") = 1

    ' --- bitis ve dikey esitleme
    ASSERT uxsdl3.RenderPresent(r) = 1
    ASSERT uxsdl3.SetRenderVSync(r, 0) >= 0
    ASSERT uxsdl3.GetRenderVSync(r) >= -2

    ' --- gecersiz tutamaclar guvenli
    ASSERT uxsdl3.RenderReadPixel(0, 0, 0) = 0
    ASSERT uxsdl3.SetRenderDrawColor(0, 1, 2, 3, 4) = 0
    ASSERT uxsdl3.RenderFillRect(0, 0, 0, 1, 1) = 0
    ASSERT uxsdl3.RenderOutputWidth(0) = 0
    ASSERT uxsdl3.RendererName(0) = ""
    ASSERT uxsdl3.GetRenderDrawBlendMode(0) = -1
    ASSERT uxsdl3.CreateTexture(0, 4, 4, 0) = 0
    ASSERT uxsdl3.CreateTexture(r, 0, 4, 0) = 0
    ASSERT uxsdl3.TextureFill(0, red) = 0
    ASSERT uxsdl3.TextureSetPixel(0, 0, 0, red) = 0
    ASSERT uxsdl3.TextureGetBlendMode(0) = -1
    ASSERT uxsdl3.TextureGetAlphaMod(0) = 0
    ASSERT uxsdl3.RenderTextureRect(r, 0, 0, 0, 1, 1, 0, 0, 1, 1) = 0
    ASSERT uxsdl3.RenderSaveBMP(0, "out/x.bmp") = 0

    uxsdl3.DestroyRenderer(r)
    uxsdl3.DestroyWindow(win)
    uxsdl3.Quit()
    PRINT "UXSDL3_RENDER_SMOKE_PASS"
END MAIN