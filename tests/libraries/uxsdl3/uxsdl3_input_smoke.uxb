INCLUDE "include/modules/uxsdl3.uxmh"

' uxsdl3 girdi olaylari (S-052): klavye/fare/tekerlek/birakma/cikis. Gercek aygit yok: PushKey/PushMouse*/PushQuit
' olaylari SDL'in gercek olay kuyruguna koyar, PumpEvents teslim eder; "basildi/birakildi" yalniz SON PumpEvents'i anlatir.
MAIN
    DIM i AS I32
    uxsdl3.SetHint("SDL_VIDEO_DRIVER", "dummy")
    ASSERT uxsdl3.Init(uxsdl3.INIT_VIDEO) = 1
    uxsdl3.FlushEvents()
    uxsdl3.PumpEvents()

    ' --- klavye: basma / tutma / birakma
    ASSERT uxsdl3.KeyDown(uxsdl3.SCANCODE_A) = 0
    ASSERT uxsdl3.PushKey(uxsdl3.SCANCODE_A, 1) = 1
    ASSERT uxsdl3.KeyDown(uxsdl3.SCANCODE_A) = 0
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.KeyDown(uxsdl3.SCANCODE_A) = 1
    ASSERT uxsdl3.KeyPressed(uxsdl3.SCANCODE_A) = 1
    ASSERT uxsdl3.KeyReleased(uxsdl3.SCANCODE_A) = 0
    ASSERT uxsdl3.LastKey() = uxsdl3.SCANCODE_A
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.KeyDown(uxsdl3.SCANCODE_A) = 1
    ASSERT uxsdl3.KeyPressed(uxsdl3.SCANCODE_A) = 0
    ASSERT uxsdl3.PushKey(uxsdl3.SCANCODE_A, 0) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.KeyDown(uxsdl3.SCANCODE_A) = 0
    ASSERT uxsdl3.KeyReleased(uxsdl3.SCANCODE_A) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.KeyReleased(uxsdl3.SCANCODE_A) = 0

    ' ayni turda iki tus
    ASSERT uxsdl3.PushKey(uxsdl3.SCANCODE_W, 1) = 1
    ASSERT uxsdl3.PushKey(uxsdl3.SCANCODE_SPACE, 1) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.KeyPressed(uxsdl3.SCANCODE_W) = 1
    ASSERT uxsdl3.KeyPressed(uxsdl3.SCANCODE_SPACE) = 1
    ASSERT uxsdl3.KeyPressed(uxsdl3.SCANCODE_S) = 0
    ASSERT uxsdl3.LastKey() = uxsdl3.SCANCODE_SPACE
    ASSERT uxsdl3.PushKey(uxsdl3.SCANCODE_W, 0) = 1
    ASSERT uxsdl3.PushKey(uxsdl3.SCANCODE_SPACE, 0) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.KeyDown(uxsdl3.SCANCODE_W) = 0
    ASSERT uxsdl3.KeyDown(uxsdl3.SCANCODE_SPACE) = 0
    ' gecersiz tus numaralari
    ASSERT uxsdl3.PushKey(0, 1) = 0
    ASSERT uxsdl3.PushKey(600, 1) = 0
    ASSERT uxsdl3.KeyDown(-1) = 0
    ASSERT uxsdl3.KeyPressed(-1) = 0
    ASSERT uxsdl3.KeyPressed(9999) = 0
    ASSERT uxsdl3.KeyReleased(0) = 0

    ' --- tus adlari ve kodlari
    ASSERT uxsdl3.GetScancodeName(uxsdl3.SCANCODE_A) = "A"
    ASSERT uxsdl3.GetScancodeName(uxsdl3.SCANCODE_ESCAPE) = "Escape"
    ASSERT uxsdl3.GetScancodeName(uxsdl3.SCANCODE_SPACE) = "Space"
    ASSERT uxsdl3.GetScancodeName(-5) = ""
    ASSERT uxsdl3.ScancodeFromName("Space") = uxsdl3.SCANCODE_SPACE
    ASSERT uxsdl3.ScancodeFromName("A") = uxsdl3.SCANCODE_A
    ASSERT uxsdl3.ScancodeFromName("bu-tus-yok") = 0
    ASSERT uxsdl3.KeyFromScancode(uxsdl3.SCANCODE_A) = 97
    ASSERT uxsdl3.KeyFromScancode(uxsdl3.SCANCODE_SPACE) = 32
    ASSERT uxsdl3.ScancodeFromKey(97) = uxsdl3.SCANCODE_A
    ASSERT uxsdl3.KeyName(97) = "A"
    ASSERT uxsdl3.KeyName(32) = "Space"
    ' degistirici tuslar (baslangic durumu gercek klavyeye baglidir: once sifirlanir)
    uxsdl3.SetModState(0)
    ASSERT uxsdl3.GetModState() = 0
    uxsdl3.SetModState(1)
    ASSERT uxsdl3.GetModState() = 1
    uxsdl3.SetModState(0)
    ASSERT uxsdl3.GetModState() = 0

    ' --- fare: konum ve bagil hareket
    ASSERT uxsdl3.PushMouseMotion(100, 50, 5, -3) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.GetMouseX() = 100
    ASSERT uxsdl3.GetMouseY() = 50
    ASSERT uxsdl3.MouseRelX() = 5
    ASSERT uxsdl3.MouseRelY() = -3
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.MouseRelX() = 0
    ASSERT uxsdl3.MouseRelY() = 0
    ASSERT uxsdl3.GetMouseX() = 100
    ' ayni turdaki iki hareket birikir, son konum kalir
    ASSERT uxsdl3.PushMouseMotion(10, 10, 1, 1) = 1
    ASSERT uxsdl3.PushMouseMotion(12, 14, 2, 3) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.MouseRelX() = 3
    ASSERT uxsdl3.MouseRelY() = 4
    ASSERT uxsdl3.GetMouseX() = 12
    ASSERT uxsdl3.GetMouseY() = 14

    ' --- fare dugmeleri
    ASSERT uxsdl3.MouseButtonDown(uxsdl3.MOUSE_LEFT) = 0
    ASSERT uxsdl3.PushMouseButton(uxsdl3.MOUSE_LEFT, 1, 20, 30) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.MouseButtonDown(uxsdl3.MOUSE_LEFT) = 1
    ASSERT uxsdl3.MouseButtonPressed(uxsdl3.MOUSE_LEFT) = 1
    ASSERT uxsdl3.MouseButtonReleased(uxsdl3.MOUSE_LEFT) = 0
    ASSERT uxsdl3.MouseButtonDown(uxsdl3.MOUSE_RIGHT) = 0
    ASSERT uxsdl3.GetMouseX() = 20
    ASSERT uxsdl3.GetMouseY() = 30
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.MouseButtonDown(uxsdl3.MOUSE_LEFT) = 1
    ASSERT uxsdl3.MouseButtonPressed(uxsdl3.MOUSE_LEFT) = 0
    ASSERT uxsdl3.PushMouseButton(uxsdl3.MOUSE_LEFT, 0, 20, 30) = 1
    ASSERT uxsdl3.PushMouseButton(uxsdl3.MOUSE_RIGHT, 1, 20, 30) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.MouseButtonDown(uxsdl3.MOUSE_LEFT) = 0
    ASSERT uxsdl3.MouseButtonReleased(uxsdl3.MOUSE_LEFT) = 1
    ASSERT uxsdl3.MouseButtonDown(uxsdl3.MOUSE_RIGHT) = 1
    ASSERT uxsdl3.PushMouseButton(uxsdl3.MOUSE_RIGHT, 0, 20, 30) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.MouseButtonDown(uxsdl3.MOUSE_RIGHT) = 0
    ASSERT uxsdl3.PushMouseButton(0, 1, 0, 0) = 0
    ASSERT uxsdl3.PushMouseButton(99, 1, 0, 0) = 0
    ASSERT uxsdl3.MouseButtonPressed(0) = 0
    ASSERT uxsdl3.MouseButtonDown(-2) = 0

    ' --- tekerlek: okununca silinir
    ASSERT uxsdl3.PushMouseWheel(1.5, -2) = 1
    uxsdl3.PumpEvents()
    ASSERT INT(uxsdl3.GetMouseWheelX() * 10) = 15
    ASSERT INT(uxsdl3.GetMouseWheelY() * 10) = -20
    ASSERT uxsdl3.GetMouseWheelX() = 0
    ASSERT uxsdl3.GetMouseWheelY() = 0
    ' birden cok kaydirma toplanir
    ASSERT uxsdl3.PushMouseWheel(0, 1) = 1
    ASSERT uxsdl3.PushMouseWheel(0, 1) = 1
    ASSERT uxsdl3.PushMouseWheel(0, 1) = 1
    uxsdl3.PumpEvents()
    ASSERT INT(uxsdl3.GetMouseWheelY()) = 3

    ' --- birakilan dosyalar: en eski once
    ASSERT uxsdl3.DropCount() = 0
    ASSERT uxsdl3.TakeDrop() = ""
    ASSERT uxsdl3.PushDrop("C:/oyun/a.txt") = 1
    ASSERT uxsdl3.PushDrop("C:/oyun/ç ğ.txt") = 1
    ASSERT uxsdl3.DropCount() = 2
    ASSERT uxsdl3.TakeDrop() = "C:/oyun/a.txt"
    ASSERT uxsdl3.DropCount() = 1
    ASSERT uxsdl3.TakeDrop() = "C:/oyun/ç ğ.txt"
    ASSERT uxsdl3.DropCount() = 0
    ASSERT uxsdl3.TakeDrop() = ""
    ASSERT uxsdl3.PushDrop("") = 0
    ' kuyruk sinirli (16): 17. reddedilir
    FOR i = 1 TO 16
        ASSERT uxsdl3.PushDrop("dosya" + STR(i)) = 1
    NEXT
    ASSERT uxsdl3.PushDrop("fazla") = 0
    ASSERT uxsdl3.DropCount() = 16
    FOR i = 1 TO 16
        ASSERT LEFT(uxsdl3.TakeDrop(), 5) = "dosya"
    NEXT
    ASSERT uxsdl3.DropCount() = 0

    ' --- cikis istegi
    ASSERT uxsdl3.ShouldQuit() = 0
    ASSERT uxsdl3.PushQuit() = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.ShouldQuit() = 1
    uxsdl3.ClearQuit()
    ASSERT uxsdl3.ShouldQuit() = 0

    ' --- cihaz baglama sayaclari okununca silinir; hicbir cihaz yokken 0
    FOR i = 0 TO 3
        ASSERT uxsdl3.TakeDeviceEvents(i) = 0
    NEXT
    ASSERT uxsdl3.TakeDeviceEvents(4) = 0
    ASSERT uxsdl3.TakeDeviceEvents(-1) = 0

    ' --- olay kuyrugunu bosaltma: itilen olay teslim edilmez
    ASSERT uxsdl3.PushKey(uxsdl3.SCANCODE_D, 1) = 1
    uxsdl3.FlushEvents()
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.KeyDown(uxsdl3.SCANCODE_D) = 0

    uxsdl3.Quit()
    PRINT "UXSDL3_INPUT_SMOKE_PASS"
END MAIN