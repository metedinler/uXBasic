INCLUDE "include/modules/uxsdl3.uxmh"

' uxsdl3 joystick/gamepad API'si (S-052). Gercek aygit gerekmez: SDL'in SANAL joystick/gamepad'i program tarafindan
' beslenir ve gercek donanim gibi numaralandirilir/acilir. Gercek bir gamepad takiliysa testler onu SAYARAK bagimsiz kalir
' (yalniz sanal aygitin kendi verilerini dogrular).
MAIN
    DIM n0 AS I32
    DIM g0 AS I32
    DIM id AS I32
    DIM gid AS I32
    DIM h AS I32
    DIM g AS I32
    DIM i AS I32
    DIM found AS I32
    DIM hs(0 TO 15) AS I32
    DIM v AS F64
    ASSERT uxsdl3.Init(uxsdl3.INIT_JOYSTICK + uxsdl3.INIT_GAMEPAD) = 1
    uxsdl3.PumpEvents()
    FOR i = 0 TO 3
        uxsdl3.TakeDeviceEvents(i)
    NEXT
    n0 = uxsdl3.JoystickCount()
    g0 = uxsdl3.GamepadCount()
    ASSERT n0 >= 0
    ASSERT g0 >= 0
    ASSERT uxsdl3.JoystickIdAt(-1) = 0
    ASSERT uxsdl3.JoystickIdAt(n0 + 5) = 0
    ASSERT uxsdl3.GamepadIdAt(g0 + 5) = 0
    ASSERT uxsdl3.OpenJoystick(0) = 0
    ASSERT uxsdl3.OpenJoystick(99999) = 0
    ASSERT uxsdl3.OpenGamepad(0) = 0
    ASSERT uxsdl3.OpenGamepad(99999) = 0
    ASSERT uxsdl3.IsGamepad(0) = 0
    ASSERT uxsdl3.IsGamepad(99999) = 0

    ' ==================== sanal joystick: 3 eksen, 5 dugme, 2 sapka ====================
    id = uxsdl3.AttachVirtualJoystick(3, 5, 2)
    ASSERT id > 0
    ASSERT uxsdl3.AttachVirtualJoystick(-1, 5, 2) = 0
    ASSERT uxsdl3.JoystickCount() = n0 + 1
    ASSERT uxsdl3.GamepadCount() = g0
    ASSERT uxsdl3.IsGamepad(id) = 0
    found = 0
    FOR i = 0 TO n0
        IF uxsdl3.JoystickIdAt(i) = id THEN found = 1
    NEXT
    ASSERT found = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.TakeDeviceEvents(uxsdl3.DEVICE_JOYSTICK_ADDED) = 1
    ASSERT uxsdl3.TakeDeviceEvents(uxsdl3.DEVICE_JOYSTICK_ADDED) = 0
    ASSERT uxsdl3.TakeDeviceEvents(uxsdl3.DEVICE_GAMEPAD_ADDED) = 0
    ASSERT uxsdl3.JoystickNameForId(id) = "uxsdl3 virtual joystick"
    ASSERT uxsdl3.JoystickTypeForId(id) = uxsdl3.JOYSTICK_TYPE_UNKNOWN
    ASSERT uxsdl3.JoystickVendorForId(id) = 0
    ASSERT uxsdl3.JoystickProductForId(id) = 0

    h = uxsdl3.OpenJoystick(id)
    ASSERT h > 0
    ASSERT uxsdl3.JoystickConnected(h) = 1
    ASSERT uxsdl3.JoystickInstanceId(h) = id
    ASSERT uxsdl3.JoystickName(h) = "uxsdl3 virtual joystick"
    ASSERT uxsdl3.JoystickNumAxes(h) = 3
    ASSERT uxsdl3.JoystickNumButtons(h) = 5
    ASSERT uxsdl3.JoystickNumHats(h) = 2
    ASSERT uxsdl3.JoystickNumBalls(h) = 0
    ASSERT LEN(uxsdl3.JoystickGuid(h)) = 32
    ASSERT uxsdl3.JoystickVendor(h) = 0
    ASSERT uxsdl3.JoystickProduct(h) = 0
    ASSERT uxsdl3.JoystickType(h) = uxsdl3.JOYSTICK_TYPE_UNKNOWN
    ASSERT uxsdl3.JoystickPlayerIndex(h) = -1
    ASSERT uxsdl3.JoystickSetPlayerIndex(h, 2) = 1
    ASSERT uxsdl3.JoystickPlayerIndex(h) = 2
    ASSERT uxsdl3.JoystickPowerPercent(h) >= -1
    ASSERT uxsdl3.JoystickRumble(h, 100, 100, 10) = 0

    ' baslangicta her sey sifir
    ASSERT uxsdl3.JoystickAxis(h, 0) = 0
    ASSERT uxsdl3.JoystickButton(h, 3) = 0
    ASSERT uxsdl3.JoystickHat(h, 1) = uxsdl3.HAT_CENTERED
    ' degerleri ver: sinirlar disi degerler sikistirilir
    ASSERT uxsdl3.SetVirtualJoystickAxis(h, 1, -20000) = 1
    ASSERT uxsdl3.SetVirtualJoystickAxis(h, 2, 40000) = 1
    ASSERT uxsdl3.SetVirtualJoystickAxis(h, 0, -40000) = 1
    ASSERT uxsdl3.SetVirtualJoystickButton(h, 3, 1) = 1
    ASSERT uxsdl3.SetVirtualJoystickHat(h, 1, uxsdl3.HAT_UP + uxsdl3.HAT_RIGHT) = 1
    ' PumpEvents'ten once eski deger kalir
    ASSERT uxsdl3.JoystickAxis(h, 1) = 0
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.JoystickAxis(h, 0) = -32768
    ASSERT uxsdl3.JoystickAxis(h, 1) = -20000
    ASSERT uxsdl3.JoystickAxis(h, 2) = 32767
    ASSERT uxsdl3.JoystickButton(h, 3) = 1
    ASSERT uxsdl3.JoystickButton(h, 0) = 0
    ASSERT uxsdl3.JoystickHat(h, 1) = 3
    ASSERT uxsdl3.JoystickHat(h, 0) = uxsdl3.HAT_CENTERED
    ' olmayan eksen/dugme/sapka
    ASSERT uxsdl3.SetVirtualJoystickAxis(h, 9, 1) = 0
    ASSERT uxsdl3.SetVirtualJoystickButton(h, 9, 1) = 0
    ASSERT uxsdl3.SetVirtualJoystickHat(h, 9, 1) = 0
    ASSERT uxsdl3.JoystickAxis(h, 9) = 0
    ASSERT uxsdl3.JoystickButton(h, 99) = 0
    ASSERT uxsdl3.JoystickHat(h, 9) = 0
    ' birakinca degerler sifira doner
    ASSERT uxsdl3.SetVirtualJoystickButton(h, 3, 0) = 1
    ASSERT uxsdl3.SetVirtualJoystickHat(h, 1, uxsdl3.HAT_CENTERED) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.JoystickButton(h, 3) = 0
    ASSERT uxsdl3.JoystickHat(h, 1) = uxsdl3.HAT_CENTERED

    uxsdl3.CloseJoystick(h)
    ASSERT uxsdl3.JoystickConnected(h) = 0
    ASSERT uxsdl3.JoystickName(h) = ""
    ASSERT uxsdl3.JoystickAxis(h, 0) = 0
    ASSERT uxsdl3.DetachVirtual(id) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.JoystickCount() = n0
    ASSERT uxsdl3.TakeDeviceEvents(uxsdl3.DEVICE_JOYSTICK_REMOVED) = 1
    ASSERT uxsdl3.DetachVirtual(id) = 0

    ' ==================== sanal gamepad ====================
    gid = uxsdl3.AttachVirtualGamepad()
    ASSERT gid > 0
    ASSERT uxsdl3.IsGamepad(gid) = 1
    ASSERT uxsdl3.GamepadCount() = g0 + 1
    ASSERT uxsdl3.JoystickCount() = n0 + 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.TakeDeviceEvents(uxsdl3.DEVICE_GAMEPAD_ADDED) = 1
    ASSERT uxsdl3.TakeDeviceEvents(uxsdl3.DEVICE_JOYSTICK_ADDED) = 1
    ASSERT uxsdl3.GamepadNameForId(gid) = "uxsdl3 virtual gamepad"
    found = 0
    FOR i = 0 TO g0
        IF uxsdl3.GamepadIdAt(i) = gid THEN found = 1
    NEXT
    ASSERT found = 1

    g = uxsdl3.OpenGamepad(gid)
    ASSERT g > 0
    ASSERT uxsdl3.GamepadConnected(g) = 1
    ASSERT uxsdl3.GamepadInstanceId(g) = gid
    ASSERT uxsdl3.GamepadName(g) = "uxsdl3 virtual gamepad"
    ASSERT uxsdl3.GamepadVendor(g) = 0
    ASSERT uxsdl3.GamepadProduct(g) = 0
    ASSERT uxsdl3.GamepadType(g) = 1
    ASSERT uxsdl3.GamepadTypeName(1) = "standard"
    ASSERT uxsdl3.GamepadTypeName(999) = ""
    ' standart harita: a:b0, leftx:a0, ...
    ASSERT INSTR(uxsdl3.GamepadMapping(g), "a:b0") > 0
    ASSERT INSTR(uxsdl3.GamepadMapping(g), "leftx:a0") > 0
    ASSERT INSTR(uxsdl3.GamepadMapping(g), "righttrigger:a5") > 0
    ASSERT uxsdl3.GamepadPlayerIndex(g) >= 0
    ASSERT uxsdl3.GamepadSetPlayerIndex(g, 1) = 1
    ASSERT uxsdl3.GamepadPlayerIndex(g) = 1
    ASSERT uxsdl3.GamepadPowerPercent(g) >= -1

    ' sanal aygitin yetenekleri yok: ses/isik/sensor/titresim desteklenmez (0), cokme yok
    ASSERT uxsdl3.GamepadRumble(g, 1000, 1000, 10) = 0
    ASSERT uxsdl3.GamepadRumbleTriggers(g, 1000, 1000, 10) = 0
    ASSERT uxsdl3.GamepadSetLED(g, 1, 2, 3) = 0
    ASSERT uxsdl3.GamepadHasSensor(g, uxsdl3.SENSOR_ACCEL) = 0
    ASSERT uxsdl3.GamepadHasSensor(g, uxsdl3.SENSOR_GYRO) = 0
    ASSERT uxsdl3.GamepadSetSensorEnabled(g, uxsdl3.SENSOR_ACCEL, 1) = 0
    ASSERT uxsdl3.GamepadSensorEnabled(g, uxsdl3.SENSOR_ACCEL) = 0
    ASSERT uxsdl3.GamepadSensor(g, uxsdl3.SENSOR_ACCEL, 0) = 0
    ' yuz etiketleri: A/B
    ASSERT uxsdl3.GamepadButtonLabel(g, uxsdl3.GAMEPAD_BUTTON_SOUTH) = 1
    ASSERT uxsdl3.GamepadButtonLabel(g, uxsdl3.GAMEPAD_BUTTON_EAST) = 2

    ' dugmeler ve eksenler
    ASSERT uxsdl3.SetVirtualGamepadAxis(g, uxsdl3.GAMEPAD_AXIS_LEFTX, 16384) = 1
    ASSERT uxsdl3.SetVirtualGamepadAxis(g, uxsdl3.GAMEPAD_AXIS_RIGHT_TRIGGER, 32767) = 1
    ASSERT uxsdl3.SetVirtualGamepadButton(g, uxsdl3.GAMEPAD_BUTTON_SOUTH, 1) = 1
    ASSERT uxsdl3.SetVirtualGamepadButton(g, uxsdl3.GAMEPAD_BUTTON_DPAD_RIGHT, 1) = 1
    ASSERT uxsdl3.GamepadButton(g, uxsdl3.GAMEPAD_BUTTON_SOUTH) = 0
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.GamepadAxis(g, uxsdl3.GAMEPAD_AXIS_LEFTX) = 16384
    ASSERT uxsdl3.GamepadAxis(g, uxsdl3.GAMEPAD_AXIS_RIGHT_TRIGGER) = 32767
    ASSERT uxsdl3.GamepadAxis(g, uxsdl3.GAMEPAD_AXIS_LEFTY) = 0
    ASSERT uxsdl3.GamepadButton(g, uxsdl3.GAMEPAD_BUTTON_SOUTH) = 1
    ASSERT uxsdl3.GamepadButton(g, uxsdl3.GAMEPAD_BUTTON_EAST) = 0
    ASSERT uxsdl3.GamepadButton(g, uxsdl3.GAMEPAD_BUTTON_DPAD_RIGHT) = 1
    ASSERT INT(uxsdl3.GamepadAxisNorm(g, uxsdl3.GAMEPAD_AXIS_LEFTX) * 1000) = 500
    ASSERT INT(uxsdl3.GamepadAxisNorm(g, uxsdl3.GAMEPAD_AXIS_RIGHT_TRIGGER) * 1000) = 1000
    ASSERT uxsdl3.SetVirtualGamepadButton(g, 99, 1) = 0
    ASSERT uxsdl3.SetVirtualGamepadAxis(g, 99, 1) = 0
    ' olu bolge: 0.15'ten kucuk 0; buyuk deger yeniden olceklenir, uc deger 1.0
    ASSERT uxsdl3.SetVirtualGamepadAxis(g, uxsdl3.GAMEPAD_AXIS_LEFTX, 3000) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.GamepadAxisDeadZone(g, uxsdl3.GAMEPAD_AXIS_LEFTX, 0.15) = 0
    ASSERT uxsdl3.SetVirtualGamepadAxis(g, uxsdl3.GAMEPAD_AXIS_LEFTX, 24575) = 1
    uxsdl3.PumpEvents()
    v = uxsdl3.GamepadAxisDeadZone(g, uxsdl3.GAMEPAD_AXIS_LEFTX, 0.5)
    ASSERT INT(v * 100) >= 49
    ASSERT INT(v * 100) <= 50
    ASSERT uxsdl3.GamepadAxisDeadZone(g, uxsdl3.GAMEPAD_AXIS_LEFTX, 0.9) = 0
    ASSERT uxsdl3.SetVirtualGamepadAxis(g, uxsdl3.GAMEPAD_AXIS_LEFTX, -32768) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.GamepadAxis(g, uxsdl3.GAMEPAD_AXIS_LEFTX) = -32768
    ASSERT uxsdl3.GamepadAxisNorm(g, uxsdl3.GAMEPAD_AXIS_LEFTX) = -1
    ASSERT uxsdl3.GamepadAxisDeadZone(g, uxsdl3.GAMEPAD_AXIS_LEFTX, 0.2) = -1
    ASSERT uxsdl3.SetVirtualGamepadButton(g, uxsdl3.GAMEPAD_BUTTON_SOUTH, 0) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.GamepadButton(g, uxsdl3.GAMEPAD_BUTTON_SOUTH) = 0

    ' dugme/eksen adlari (haritalama dosyalarinda kullanilan adlar)
    ASSERT uxsdl3.GamepadButtonName(uxsdl3.GAMEPAD_BUTTON_SOUTH) = "a"
    ASSERT uxsdl3.GamepadButtonName(uxsdl3.GAMEPAD_BUTTON_DPAD_UP) = "dpup"
    ASSERT uxsdl3.GamepadButtonName(99) = ""
    ASSERT uxsdl3.GamepadAxisName(uxsdl3.GAMEPAD_AXIS_LEFTX) = "leftx"
    ASSERT uxsdl3.GamepadAxisName(uxsdl3.GAMEPAD_AXIS_RIGHT_TRIGGER) = "righttrigger"
    ASSERT uxsdl3.GamepadButtonFromName("dpup") = uxsdl3.GAMEPAD_BUTTON_DPAD_UP
    ASSERT uxsdl3.GamepadButtonFromName("nope") = -1
    ASSERT uxsdl3.GamepadAxisFromName("lefttrigger") = uxsdl3.GAMEPAD_AXIS_LEFT_TRIGGER
    ASSERT uxsdl3.GamepadAxisFromName("nope") = -1

    ' harita ekleme: gecersiz -1, yeni 1, ayni GUID guncelleme 0
    ASSERT uxsdl3.AddGamepadMapping("invalid") = -1
    ASSERT uxsdl3.AddGamepadMapping("03000000ffffffff0000000000000000,uXBasic Test Pad,a:b0,b:b1,platform:Windows,") = 1
    ASSERT uxsdl3.AddGamepadMapping("03000000ffffffff0000000000000000,uXBasic Test Pad,a:b0,b:b1,platform:Windows,") = 0

    ' ayni gamepad birden cok kez acilabilir; tutamac tablosu 15 kayitla sinirli
    FOR i = 0 TO 15
        hs(i) = 0
    NEXT
    hs(0) = g
    FOR i = 1 TO 14
        hs(i) = uxsdl3.OpenGamepad(gid)
        ASSERT hs(i) > 0
    NEXT
    ASSERT uxsdl3.OpenGamepad(gid) = 0
    FOR i = 1 TO 14
        uxsdl3.CloseGamepad(hs(i))
    NEXT
    ASSERT uxsdl3.OpenGamepad(gid) > 0
    ASSERT uxsdl3.GamepadConnected(g) = 1

    uxsdl3.CloseGamepad(g)
    ASSERT uxsdl3.GamepadConnected(g) = 0
    ASSERT uxsdl3.GamepadName(g) = ""
    ASSERT uxsdl3.GamepadAxis(g, 0) = 0
    ASSERT uxsdl3.GamepadAxisNorm(g, 0) = 0
    ASSERT uxsdl3.GamepadAxisDeadZone(g, 0, 0.1) = 0
    ASSERT uxsdl3.GamepadMapping(g) = ""
    ASSERT uxsdl3.GamepadType(0) = 0
    ASSERT uxsdl3.GamepadPlayerIndex(0) = -1
    ASSERT uxsdl3.SetVirtualGamepadAxis(0, 0, 1) = 0
    ASSERT uxsdl3.GamepadPowerState(0) = uxsdl3.POWER_ERROR
    ASSERT uxsdl3.JoystickPowerState(0) = uxsdl3.POWER_ERROR
    ASSERT uxsdl3.JoystickGuid(0) = ""
    ASSERT uxsdl3.JoystickInstanceId(0) = 0
    ASSERT uxsdl3.JoystickPlayerIndex(0) = -1
    ASSERT uxsdl3.GamepadRumble(0, 1, 1, 1) = 0

    ' kalan acik tutamaci kapat, aygiti cikar
    FOR i = 1 TO 15
        uxsdl3.CloseGamepad(i)
    NEXT
    ASSERT uxsdl3.DetachVirtual(gid) = 1
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.GamepadCount() = g0
    ASSERT uxsdl3.TakeDeviceEvents(uxsdl3.DEVICE_GAMEPAD_REMOVED) = 1
    ASSERT uxsdl3.TakeDeviceEvents(uxsdl3.DEVICE_JOYSTICK_REMOVED) = 1

    uxsdl3.Quit()
    PRINT "UXSDL3_GAMEPAD_SMOKE_PASS"
END MAIN