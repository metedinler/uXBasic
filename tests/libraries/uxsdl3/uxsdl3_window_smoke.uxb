INCLUDE "include/modules/uxsdl3.uxmh"

' uxsdl3 ekran/pencere/imlec API'si (S-052). Baslik-suz calisir: SDL'in "dummy" video surucusu secilir.
' Bu surucu her pencere ozelligini gercek sistem gibi uygulamaz (kenarlik/yeniden boyutlanabilirlik/uste sabitleme/
' buyutme bayraklari degismez, saydamlik ve imlec yok); test yalniz dummy surucusunun gercekten uyguladigi
' davranislari denetler, ozellikle donen degerleri ve bayraklari.
MAIN
    DIM win AS I64
    DIM ren AS I64
    DIM d AS I32
    DIM flags AS I64
    DIM tex AS I64
    uxsdl3.SetHint("SDL_VIDEO_DRIVER", "dummy")
    ASSERT uxsdl3.Init(uxsdl3.INIT_VIDEO) = 1
    ASSERT uxsdl3.WasInit(uxsdl3.INIT_VIDEO) = uxsdl3.INIT_VIDEO
    ASSERT uxsdl3.CurrentVideoDriver() = "dummy"
    ASSERT uxsdl3.VideoDriverCount() >= 1
    ASSERT LEN(uxsdl3.VideoDriverName(0)) > 0
    ASSERT uxsdl3.VideoDriverName(99) = ""

    ' --- ekranlar
    d = uxsdl3.DisplayIdAt(0)
    ASSERT uxsdl3.DisplayCount() >= 1
    ASSERT d > 0
    ASSERT uxsdl3.PrimaryDisplay() > 0
    ASSERT uxsdl3.DisplayIdAt(99) = 0
    ASSERT LEN(uxsdl3.DisplayName(d)) > 0
    ASSERT uxsdl3.GetDisplayWidth(d) = 1024
    ASSERT uxsdl3.GetDisplayHeight(d) = 768
    ASSERT uxsdl3.DisplayBounds(d, uxsdl3.PART_X) = 0
    ASSERT uxsdl3.DisplayBounds(d, uxsdl3.PART_Y) = 0
    ASSERT uxsdl3.DisplayUsableBounds(d, uxsdl3.PART_W) > 0
    ASSERT uxsdl3.DisplayUsableBounds(d, uxsdl3.PART_H) > 0
    ASSERT uxsdl3.DisplayMode(d, 0) = 1024
    ASSERT uxsdl3.DisplayMode(d, 1) = 768
    ASSERT uxsdl3.DisplayMode(d, 3) = 100
    ASSERT uxsdl3.DisplayContentScale(d) > 0.5
    ASSERT uxsdl3.DisplayOrientation(d) >= 0
    ' bilinmeyen ekran kimligi guvenli
    ASSERT uxsdl3.DisplayName(0) = ""
    ASSERT uxsdl3.DisplayBounds(0, 2) = 0
    ASSERT uxsdl3.DisplayMode(0, 0) = 0
    ASSERT uxsdl3.DisplayContentScale(0) = 0

    ' --- pencere olusturma
    win = uxsdl3.CreateWindow("Pencere sinavi", 320, 200, uxsdl3.WINDOW_RESIZABLE + uxsdl3.WINDOW_HIDDEN)
    ASSERT win <> 0
    ASSERT uxsdl3.GetWindowTitle(win) = "Pencere sinavi"
    ASSERT uxsdl3.GetWindowWidth(win) = 320
    ASSERT uxsdl3.GetWindowHeight(win) = 200
    ASSERT uxsdl3.GetWindowPixelWidth(win) = 320
    ASSERT uxsdl3.GetWindowPixelHeight(win) = 200
    flags = uxsdl3.GetWindowFlags(win)
    ASSERT flags = 40
    ASSERT uxsdl3.HasWindowFlag(win, uxsdl3.WINDOW_HIDDEN) = 1
    ASSERT uxsdl3.HasWindowFlag(win, uxsdl3.WINDOW_RESIZABLE) = 1
    ASSERT uxsdl3.HasWindowFlag(win, uxsdl3.WINDOW_FULLSCREEN) = 0
    ASSERT uxsdl3.WindowId(win) > 0
    ASSERT uxsdl3.WindowFromId(uxsdl3.WindowId(win)) = win
    ASSERT uxsdl3.WindowFromId(0) = 0
    ASSERT uxsdl3.WindowFromId(99999) = 0
    ASSERT uxsdl3.WindowDisplay(win) = d
    ASSERT uxsdl3.WindowDisplayScale(win) > 0.5
    ASSERT uxsdl3.WindowPixelDensity(win) > 0.5

    ' --- baslik, boyut, konum, sinirlar
    ASSERT uxsdl3.SetWindowTitle(win, "Yeni baslik") = 1
    ASSERT uxsdl3.GetWindowTitle(win) = "Yeni baslik"
    ASSERT uxsdl3.SetWindowPosition(win, 50, 60) = 1
    ASSERT uxsdl3.SyncWindow(win) = 1
    ASSERT uxsdl3.GetWindowX(win) = 50
    ASSERT uxsdl3.GetWindowY(win) = 60
    ASSERT uxsdl3.GetWindowPosition(win, uxsdl3.PART_X) = 50
    ASSERT uxsdl3.SetWindowSize(win, 400, 300) = 1
    ASSERT uxsdl3.SyncWindow(win) = 1
    ASSERT uxsdl3.GetWindowWidth(win) = 400
    ASSERT uxsdl3.GetWindowHeight(win) = 300
    ASSERT uxsdl3.GetWindowPixelWidth(win) = 400
    ASSERT uxsdl3.SetWindowMinSize(win, 200, 150) = 1
    ASSERT uxsdl3.GetWindowMinSize(win, 0) = 200
    ASSERT uxsdl3.GetWindowMinSize(win, 1) = 150
    ASSERT uxsdl3.SetWindowMaxSize(win, 800, 600) = 1
    ASSERT uxsdl3.GetWindowMaxSize(win, 0) = 800
    ASSERT uxsdl3.GetWindowMaxSize(win, 1) = 600
    ' sinir disina boyutlandirma sinira oturur
    ASSERT uxsdl3.SetWindowSize(win, 1000, 100) = 1
    ASSERT uxsdl3.SyncWindow(win) = 1
    ASSERT uxsdl3.GetWindowWidth(win) = 800
    ASSERT uxsdl3.GetWindowHeight(win) = 150

    ' --- tam ekran
    ASSERT uxsdl3.SetWindowFullscreen(win, 1) = 1
    ASSERT uxsdl3.SyncWindow(win) = 1
    ASSERT uxsdl3.HasWindowFlag(win, uxsdl3.WINDOW_FULLSCREEN) = 1
    ASSERT uxsdl3.SetWindowFullscreen(win, 0) = 1
    ASSERT uxsdl3.SyncWindow(win) = 1
    ASSERT uxsdl3.HasWindowFlag(win, uxsdl3.WINDOW_FULLSCREEN) = 0

    ' --- kenarlik/yeniden boyutlanma/uste sabitleme/odaklanabilirlik cagrilari kabul edilir
    ASSERT uxsdl3.SetWindowBordered(win, 0) = 1
    ASSERT uxsdl3.SetWindowResizable(win, 1) = 1
    ASSERT uxsdl3.SetWindowAlwaysOnTop(win, 0) = 1
    ASSERT uxsdl3.SetWindowFocusable(win, 1) = 1
    ASSERT uxsdl3.RaiseWindow(win) = 1

    ' --- fare/klavye yakalama: bagimsiz calisan goreceli fare kipi gidis-donus yapar
    ASSERT uxsdl3.GetWindowRelativeMouse(win) = 0
    ASSERT uxsdl3.SetWindowRelativeMouse(win, 1) = 1
    ASSERT uxsdl3.GetWindowRelativeMouse(win) = 1
    ASSERT uxsdl3.HasWindowFlag(win, uxsdl3.WINDOW_MOUSE_RELATIVE_MODE) = 1
    ASSERT uxsdl3.SetWindowRelativeMouse(win, 0) = 1
    ASSERT uxsdl3.GetWindowRelativeMouse(win) = 0
    ASSERT uxsdl3.SetWindowMouseGrab(win, 0) = 1
    ASSERT uxsdl3.SetWindowKeyboardGrab(win, 0) = 1
    ASSERT uxsdl3.GetWindowMouseGrab(win) = 0
    ASSERT uxsdl3.GetWindowKeyboardGrab(win) = 0

    ' --- pencere olaylari: goster/gizle bit olarak gelir
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.ShowWindow(win) = 1
    uxsdl3.PumpEvents()
    ASSERT (uxsdl3.WindowEvents() AND uxsdl3.WINDOWEVT_SHOWN) <> 0
    ASSERT uxsdl3.HasWindowFlag(win, uxsdl3.WINDOW_HIDDEN) = 0
    uxsdl3.PumpEvents()
    ASSERT uxsdl3.WindowEvents() = 0
    ASSERT uxsdl3.HideWindow(win) = 1
    uxsdl3.PumpEvents()
    ASSERT (uxsdl3.WindowEvents() AND uxsdl3.WINDOWEVT_HIDDEN) <> 0
    ASSERT uxsdl3.HasWindowFlag(win, uxsdl3.WINDOW_HIDDEN) = 1
    ' boyut degisikligi yeniden-boyutlandi bayragini kurar ve okununca silinir
    ASSERT uxsdl3.WindowResized() = 1
    ASSERT uxsdl3.WindowResized() = 0
    ASSERT uxsdl3.SetWindowSize(win, 500, 400) = 1
    ASSERT uxsdl3.SyncWindow(win) = 1
    uxsdl3.PumpEvents()
    ASSERT (uxsdl3.WindowEvents() AND uxsdl3.WINDOWEVT_RESIZED) <> 0
    ASSERT uxsdl3.WindowResized() = 1

    ' --- simge: yazilan BMP'den (ekran goruntusu) pencere simgesi
    ren = uxsdl3.CreateRenderer(win, "software")
    ASSERT ren <> 0
    ASSERT uxsdl3.SetRenderDrawColor(ren, 10, 120, 240, 255) = 1
    ASSERT uxsdl3.RenderClear(ren) = 1
    ASSERT uxsdl3.CreateDirectory("out") = 1
    ASSERT uxsdl3.RenderSaveBMP(ren, "out/uxsdl3_icon.bmp") = 1
    ' dummy surucu simge ayarlamayi desteklemez (0 doner); yazilan BMP'nin gecerli oldugu dokuyla kanitlanir
    ASSERT uxsdl3.PathType("out/uxsdl3_icon.bmp") = uxsdl3.PATH_FILE
    ASSERT uxsdl3.PathSize("out/uxsdl3_icon.bmp") = 600054
    ASSERT uxsdl3.SetWindowIconBMP(win, "out/uxsdl3_icon.bmp") >= 0
    tex = uxsdl3.LoadTexture(ren, "out/uxsdl3_icon.bmp")
    ASSERT tex <> 0
    ASSERT uxsdl3.GetTextureWidth(tex) = 500
    ASSERT uxsdl3.GetTextureHeight(tex) = 400
    uxsdl3.DestroyTexture(tex)
    ASSERT uxsdl3.SetWindowIconBMP(win, "out/uxsdl3_bu_dosya_yok.bmp") = 0
    ASSERT uxsdl3.SetWindowIconBMP(0, "out/uxsdl3_icon.bmp") = 0
    ASSERT uxsdl3.RemovePath("out/uxsdl3_icon.bmp") = 1
    uxsdl3.DestroyRenderer(ren)

    ' --- imlec ve fare
    ASSERT uxsdl3.HideCursor() = 1
    ASSERT uxsdl3.CursorVisible() = 0
    ASSERT uxsdl3.ShowCursor() = 1
    ASSERT uxsdl3.CursorVisible() = 1
    ASSERT uxsdl3.SetSystemCursor(-1) = 0
    ASSERT uxsdl3.SetSystemCursor(99) = 0
    ASSERT uxsdl3.WarpMouseInWindow(win, 10, 10) = 1
    ASSERT uxsdl3.WarpMouseInWindow(0, 10, 10) = 0
    ASSERT uxsdl3.GlobalMouse(0) >= 0
    ASSERT uxsdl3.MouseCount() >= 0
    ASSERT uxsdl3.KeyboardCount() >= 0
    ASSERT uxsdl3.HasScreenKeyboard() >= 0

    ' --- ekran koruyucu durumu
    ASSERT uxsdl3.ScreenSaverEnabled() = 0
    uxsdl3.SetScreensaver(1)
    ASSERT uxsdl3.ScreenSaverEnabled() = 1
    uxsdl3.SetScreensaver(0)
    ASSERT uxsdl3.ScreenSaverEnabled() = 0
    ASSERT uxsdl3.SystemTheme() >= 0

    ' --- gecersiz pencere tutamagi guvenli
    ASSERT uxsdl3.GetWindowTitle(0) = ""
    ASSERT uxsdl3.GetWindowFlags(0) = 0
    ASSERT uxsdl3.GetWindowX(0) = 0
    ASSERT uxsdl3.GetWindowPixelWidth(0) = 0
    ASSERT uxsdl3.SetWindowPosition(0, 1, 1) = 0
    ASSERT uxsdl3.SetWindowMinSize(0, 1, 1) = 0
    ASSERT uxsdl3.SetWindowFullscreen(0, 1) = 0
    ASSERT uxsdl3.SetWindowBordered(0, 1) = 0
    ASSERT uxsdl3.SyncWindow(0) = 0
    ASSERT uxsdl3.WindowId(0) = 0
    ASSERT uxsdl3.WindowDisplay(0) = 0
    ASSERT uxsdl3.HasWindowFlag(0, uxsdl3.WINDOW_HIDDEN) = 0
    ASSERT uxsdl3.GetWindowOpacity(0) < 0
    ASSERT uxsdl3.FlashWindow(0, 1) = 0

    uxsdl3.DestroyWindow(win)
    uxsdl3.Quit()
    PRINT "UXSDL3_WINDOW_SMOKE_PASS"
END MAIN