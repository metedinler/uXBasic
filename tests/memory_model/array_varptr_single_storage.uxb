DIM a(0 TO 3) AS I32
DIM b(0 TO 3) AS I32
a(0) = 10
a(1) = 456
a(2) = 30
a(3) = 40
PRINT "peek_a1="; PEEKD(NATIVE, VARPTR(a) + 4)
POKED NATIVE, VARPTR(a) + 4, 123
PRINT "a1_after_poke="; a(1)
MEMCOPYD NATIVE, VARPTR(b), VARPTR(a), 4
PRINT "copy_dst_src_b0_b1_b3="; b(0); ","; b(1); ","; b(3)
DIM x AS I32
DIM y AS I32
x = 7
y = 0
MEMCOPYD NATIVE, VARPTR(y), VARPTR(x), 1
PRINT "y_after_copy_dst_src="; y
