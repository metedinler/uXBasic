DIM f AS F64
DIM p AS PTR
f = 1.5
p = VARPTR(f)
PRINT "f64_bits="; PEEKQ(p)
POKEQ p, 4611686018427387904
PRINT "f64_after="; f
DIM s AS F32
s = F32(1.5)
p = VARPTR(s)
PRINT "f32_bits="; PEEKD(p)
POKED p, 1073741824
PRINT "f32_after="; s
DIM u AS U64
u = 5
p = VARPTR(u)
PRINT "u64_peek="; PEEKQ(p)
POKEQ p, 77
PRINT "u64_after="; u
DIM b AS I8
b = I8(3)
p = VARPTR(b)
PRINT "i8_peek="; PEEKB(p)
POKEB p, 9
PRINT "i8_after="; b



