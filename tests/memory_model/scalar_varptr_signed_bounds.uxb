DIM p AS PTR
DIM x AS I32
x = -1
p = VARPTR(x)
PRINT "x_start="; x
POKED p, 5
PRINT "x_after_poke5="; x
POKED p, -2
PRINT "x_after_poke_minus2="; x
x = 300
PRINT "peek_after_assign="; PEEKD(p)
DIM y AS I8
y = I8(-1)
p = VARPTR(y)
PRINT "y_peek="; PEEKB(p)
POKEB p, 200
PRINT "y_after_poke200="; y
DIM z AS I16
z = I16(7)
p = VARPTR(z)
x = 4
PRINT "z_peek="; PEEKW(p)
z = I16(z + 1)
PRINT "z_peek_after_incr="; PEEKW(p)

