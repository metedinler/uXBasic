DIM p AS PTR
DIM a AS I64
a = 9
p = VARPTR(a)
PRINT "i64_peek="; PEEKQ(p)
POKEQ p, 55
PRINT "i64_after="; a
DIM b AS U32
b = 9
p = VARPTR(b)
PRINT "u32_peek="; PEEKD(p)
POKED p, 55
PRINT "u32_after="; b
DIM c AS U16
c = U16(9)
p = VARPTR(c)
PRINT "u16_peek="; PEEKW(p)
POKEW p, 55
PRINT "u16_after="; c
DIM e AS PTR
e = VARPTR(a)
p = VARPTR(e)
DIM u AS U64
u = 5
p = VARPTR(u)
PRINT "u64_peek="; PEEKQ(p)
POKEQ p, 77
PRINT "u64_after="; u

