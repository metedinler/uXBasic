' S-125: bir metodun BILDIRILEN donus tipi MIR cagri sonucuna islenir. Native x64'te PRINT eskiden STRING donen metodun
' sonucunu tamsayi (isaretci) olarak yaziyordu; legacy AST-x64 de ayni hatayi yapiyor ve tek argumanli metot cagrisini
' dizi-alan okumasi sanip derlemiyordu. Parametreli, sanal ve kalitilmis cagrilar (arayuz: interface_method_return_type).
CLASS Base
    PUBLIC
    VIRTUAL METHOD Name() AS STRING
        RETURN "base"
    END METHOD
    METHOD Shout(n AS I32) AS STRING
        RETURN "hey"
    END METHOD
    METHOD Twice(n AS I32) AS I32
        RETURN n * 2
    END METHOD
END CLASS
CLASS Kid EXTENDS Base
    PUBLIC
    OVERRIDE METHOD Name() AS STRING
        RETURN "kid"
    END METHOD
END CLASS
DIM b AS Base = NEW Kid()
DIM k AS Kid = NEW Kid()
PRINT b.Name()
PRINT k.Name()
PRINT k.Shout(3)
PRINT k.Twice(4)
