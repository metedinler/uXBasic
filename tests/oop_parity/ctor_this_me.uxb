' S-037: kurucu argümanları, THIS/ME alan erişimi, yöntem.
CLASS Pt
    PUBLIC
    X AS I32
    Y AS I32
    CONSTRUCTOR(ax AS I32, ay AS I32)
        THIS.X = ax
        ME.Y = ay
    END CONSTRUCTOR
    METHOD Sum() AS I32
        RETURN THIS.X + ME.Y
    END METHOD
END CLASS
DIM p AS Pt = NEW Pt(3, 4)
PRINT p.Sum()
