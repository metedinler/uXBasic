' S-037 olumsuz: atanmamis nesne ALANI uzerinden yontem cagrisi (null alici) -- anlamli calisma zamani hatasi, sessiz deger/cokme degil.
CLASS Leaf
    PUBLIC
    METHOD Value() AS I32
        RETURN 11
    END METHOD
END CLASS
CLASS Holder
    PUBLIC
    child AS Leaf
END CLASS
DIM obj AS Holder = NEW Holder()
PRINT obj.child.Value()
