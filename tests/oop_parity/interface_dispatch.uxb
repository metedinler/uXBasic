' S-037: arayüz tipli değişken üzerinden çağrı. (Legacy AST-x64 arayüz dağıtımını henüz üretmiyor: S-105.)
INTERFACE IAnimal
    METHOD Speak() AS I32
END INTERFACE
CLASS Dog IMPLEMENTS IAnimal
    PUBLIC
    METHOD Speak() AS I32
        RETURN 7
    END METHOD
END CLASS
DIM i AS IAnimal
i = NEW Dog()
PRINT i.Speak()
