' S-125: arayuz uzerinden cagrilan metodun bildirilen STRING donus tipi PRINT'te metin olarak yazilir.
' (Legacy AST-x64 arayuz dagitimini uretmiyor: bkz. interface_dispatch.)
INTERFACE ITag
    METHOD Tag(n AS I32) AS STRING
END INTERFACE
CLASS Kid IMPLEMENTS ITag
    PUBLIC
    METHOD Tag(n AS I32) AS STRING
        RETURN "tag"
    END METHOD
END CLASS
DIM t AS ITag = NEW Kid()
PRINT t.Tag(1)
