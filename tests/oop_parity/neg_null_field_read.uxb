' S-108 (Mete karari 2026-09-20): CLASS degiskeni REFERANSTIR; DIM yalniz NULL referans olusturur, nesne NEW ile dogar.
' Atanmamis nesne degiskeninin ALANINI okuma -> dort motorda anlamli hata (eskiden sessizce 0).
CLASS Animal
    PUBLIC
    legs AS I32
    VIRTUAL METHOD Speak() AS I32
        RETURN 1
    END METHOD
END CLASS
DIM pet AS Animal
PRINT "before"PRINT pet.legs
PRINT "hic gelmez"
