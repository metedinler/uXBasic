' S-037: taban tipli değişken + NEW türev = SANAL dağıtım (türevin override'ı çalışır).
CLASS Animal
    PUBLIC
    VIRTUAL METHOD Speak() AS I32
        RETURN 1
    END METHOD
END CLASS
CLASS Dog EXTENDS Animal
    PUBLIC
    OVERRIDE METHOD Speak() AS I32
        RETURN 2
    END METHOD
END CLASS
DIM a AS Animal
a = NEW Dog()
PRINT a.Speak()
