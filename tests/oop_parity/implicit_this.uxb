' S-119: sinif govdesinde CIPLAK alan/metot adi THIS.<ad> anlamina gelir (FreeBASIC kurali); cozum sirasi:
' yerel/parametre -> sinifin (ve taban siniflarin) alani/metodu -> genel. Tum motorlar ayni sonucu verir.
FUNCTION Helper() AS I32
    RETURN 100
END FUNCTION
CLASS Base
    PROTECTED
    total AS I32
    PUBLIC
    METHOD Add(amount AS I32)
        total = total + amount
    END METHOD
    METHOD Sum() AS I32
        RETURN total
    END METHOD
END CLASS
CLASS Counter EXTENDS Base
    PUBLIC
    n AS I32
    stride AS I32
    CONSTRUCTOR()
        n = 0
        stride = 2
    END CONSTRUCTOR
    METHOD Bump()
        n = n + stride
        Add(stride)
    END METHOD
    METHOD Helper() AS I32
        RETURN 7
    END METHOD
    METHOD UseHelper() AS I32
        RETURN Helper() + n
    END METHOD
    METHOD Shadow(stride AS I32) AS I32
        DIM n AS I32
        n = stride * 10
        RETURN n
    END METHOD
    METHOD Incr()
        n++
        n += 5
    END METHOD
END CLASS
DIM c AS Counter = NEW Counter()
c.Bump()
c.Bump()
PRINT c.n
PRINT c.Sum()
PRINT c.UseHelper()
PRINT c.Shadow(3)
PRINT c.n
c.Incr()
PRINT c.n
PRINT Helper()
