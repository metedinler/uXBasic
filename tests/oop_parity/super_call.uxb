' S-037: SUPER.m() tabanın uygulamasını DOĞRUDAN çağırır (sanal değil; sonsuz özyineleme yok).
CLASS Animal
    PUBLIC
    VIRTUAL METHOD Speak() AS I32
        RETURN 1
    END METHOD
END CLASS
CLASS Dog EXTENDS Animal
    PUBLIC
    OVERRIDE METHOD Speak() AS I32
        RETURN SUPER.Speak() + 10
    END METHOD
END CLASS
DIM d AS Dog = NEW Dog()
PRINT d.Speak()
