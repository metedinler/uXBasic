' S-130: sinif alanina bilesik atama (+= -= *=) ve ++/--: dis erisimde, THIS ile ve ciplak adla (S-119) ayni sonuc.
' Eskiden canonical-MIR ve native yazmayi SESSIZCE dusuruyordu; AST/legacy/native ++ hata veriyordu.
CLASS K
    PUBLIC
    n AS I32
    total AS I32
    METHOD Go()
        n += 5
        n++
        THIS.total -= 2
        THIS.total--
    END METHOD
END CLASS
TYPE P
    x AS I32
    y AS I32
END TYPE
DIM c AS K = NEW K()
c.n = 1
c.total = 10
c.Go()
PRINT c.n
PRINT c.total
c.n *= 3
PRINT c.n
c.n++
c.n--
c.n--
PRINT c.n
DIM p AS P
p.x = 1
p.y = 2
p.x += 4
p.y++
PRINT p.x
PRINT p.y
DIM r AS I32
r = c.n++
PRINT r
PRINT c.n
r = ++c.n
PRINT r
