' S-108 (Mete karari 2026-09-20): CLASS degiskeni REFERANSTIR; DIM yalniz NULL referans olusturur, nesne NEW ile dogar.
' DIM sonra NEW: degisken NEW ile atanan nesneyi gosterir; sanal cagri NEW'lenen sinifa gider; ikinci NEW referansi yeniden atar.
CLASS Animal
    PUBLIC
    n AS I32
    VIRTUAL METHOD Speak() AS I32
        RETURN 1
    END METHOD
END CLASS
CLASS Dog EXTENDS Animal
    PUBLIC
    OVERRIDE METHOD Speak() AS I32
        RETURN 2
    END METHOD
END CLASS
DIM a AS Animal
a = NEW Dog()
a.n = 7
PRINT a.Speak()
PRINT a.n
a = NEW Animal()
PRINT a.Speak()
PRINT a.n
