' S-124: yan etkisi olan ifade (metot cagrisi) PRINT / STR icinde YALNIZ BIR KEZ degerlendirilir.
' AST motoru eskiden PRINT icin nesne-alici kesfi yaparken metodu bir kez calistirip sonra yine calistiriyordu (2 | 5 yerine 4 | 10).
CLASS Counter
    PUBLIC
    v AS I32
    METHOD Bump(n AS I32) AS I32
        THIS.v = THIS.v + n
        RETURN THIS.v
    END METHOD
    METHOD Label() AS STRING
        THIS.v = THIS.v + 1
        RETURN "c"
    END METHOD
END CLASS
DIM a AS Counter = NEW Counter()
PRINT a.Bump(2)
PRINT a.Bump(3)
PRINT a.v
PRINT a.Label()
PRINT a.v
PRINT STR(a.Bump(1))
PRINT a.v
PRINT a.Bump(1) + a.Bump(1)
PRINT a.v
