' S-037: SUPER.m() bir değişkene atanabilir (tip çıkarımı taban sınıfın dönüş tipini bilir).
CLASS Animal
    PUBLIC
    VIRTUAL METHOD Speak() AS I32
        RETURN 1
    END METHOD
END CLASS
CLASS Dog EXTENDS Animal
    PUBLIC
    OVERRIDE METHOD Speak() AS I32
        DIM r AS I32
        r = SUPER.Speak()
        RETURN r + 10
    END METHOD
END CLASS
DIM d AS Dog = NEW Dog()
PRINT d.Speak()
