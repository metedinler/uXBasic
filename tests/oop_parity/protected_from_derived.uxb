' S-037: PROTECTED yöntem türev sınıftan çağrılabilir.
CLASS Base1
    PROTECTED
    METHOD Core() AS I32
        RETURN 9
    END METHOD
END CLASS
CLASS Derived1 EXTENDS Base1
    PUBLIC
    METHOD Use() AS I32
        RETURN THIS.Core() + 1
    END METHOD
END CLASS
DIM d AS Derived1 = NEW Derived1()
PRINT d.Use()
