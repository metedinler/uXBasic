' S-037: türevin, taban sınıftaki virtual OLMAYAN yöntemi çağırabilmesi (temel kalıtım).
CLASS A
    PUBLIC
    METHOD F() AS I32
        RETURN 1
    END METHOD
END CLASS
CLASS B EXTENDS A
    PUBLIC
    METHOD G() AS I32
        RETURN 2
    END METHOD
END CLASS
DIM obj AS B = NEW B()
PRINT obj.F()
PRINT obj.G()
