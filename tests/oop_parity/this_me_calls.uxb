' S-037: THIS.m() / ME.m() aynı sınıfın yöntemini çağırır ve sonuç değişkene atanabilir.
CLASS K
    PUBLIC
    METHOD A() AS I32
        RETURN 3
    END METHOD
    METHOD B() AS I32
        DIM r AS I32
        r = THIS.A()
        RETURN r + ME.A()
    END METHOD
END CLASS
DIM obj AS K = NEW K()
PRINT obj.B()
