' S-131: sinif alanlari kendi genisliginde yazilir/okunur. Native x64 her alani 8 baytlik hucre sayiyordu:
' `o.b = 10 : o.a = -1` (iki I32 alan) b'yi sifirliyor / bire dolduruyordu. Alan sirasindan bagimsiz sonuc.
CLASS Cell
    PUBLIC
    a AS I32
    b AS I32
    c AS I64
    d AS U32
    e AS F64
    f AS I32
END CLASS
DIM o AS Cell = NEW Cell()
o.b = 10
o.a = -1
o.c = 5000000000
o.d = 4000000000
o.e = 2.5
o.f = 7
o.a = 3
PRINT o.a
PRINT o.b
PRINT o.c
PRINT o.d
PRINT o.e
PRINT o.f
o.b += 1
o.f--
PRINT o.b
PRINT o.f
PRINT o.a
o.a = -5
PRINT o.a
PRINT o.b
