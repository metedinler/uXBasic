' S-107 (Mete karari 2026-09-20): FOR EACH/DO EACH bir STRING/WSTRING uzerinde UNICODE KOD NOKTASI
' (byte veya UTF-16 birimi DEGIL) bazinda dolasir; ikinci degisken 0 tabanli KARAKTER sirasidir.
' "aüb": a (1 bayt), ü (UTF-8'de 2 bayt), b (1 bayt) -> 3 kod noktasi. Legacy AST-x64: net red (aşağıda ayrı test).
DIM s AS STRING
s = "aüb"
DIM c AS STRING
DIM i AS I32
DIM n AS I32
n = 0
FOR EACH c, i IN s
    PRINT c
    PRINT i
    n = n + 1
NEXT
PRINT n
' bos dize: sifir gecis
DIM e AS STRING
DIM ec AS I32
ec = 0
FOR EACH c IN e
    ec = ec + 1
NEXT
PRINT ec
' DO EACH da ayni yolu izler
DIM dc AS I32
dc = 0
DO EACH c IN s
    dc = dc + 1
LOOP
PRINT dc
' EXIT FOR calisir (kaynak deger bir kez okunur, degisir degismez)
DIM x AS STRING
x = "abcdef"
DIM xn AS I32
xn = 0
FOR EACH c IN x
    IF c = "d" THEN
        EXIT FOR
    END IF
    xn = xn + 1
NEXT
PRINT xn
