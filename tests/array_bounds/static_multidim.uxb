' S-101: cok boyutlu dizide LBOUND/UBOUND(dizi, boyut): boyut 1'den baslar, varsayilan 1.
DIM m(1 TO 3, 0 TO 4) AS I32
DIM t(2, 3, 1 TO 2) AS I32
PRINT LBOUND(m)
PRINT UBOUND(m)
PRINT LBOUND(m, 1)
PRINT UBOUND(m, 1)
PRINT LBOUND(m, 2)
PRINT UBOUND(m, 2)
PRINT LBOUND(t, 1)
PRINT UBOUND(t, 1)
PRINT LBOUND(t, 2)
PRINT UBOUND(t, 2)
PRINT LBOUND(t, 3)
PRINT UBOUND(t, 3)
