' S-101: LBOUND/UBOUND - derleme zamani sinirlari sabit, tek boyutlu diziler (bir kez bildirilmis).
DIM a(1 TO 5) AS I32
DIM b(3) AS I32
DIM g(-2 TO 2) AS I32
PRINT LBOUND(a)
PRINT UBOUND(a)
PRINT LBOUND(b)
PRINT UBOUND(b)
PRINT LBOUND(g)
PRINT UBOUND(g)
PRINT UBOUND(a) - LBOUND(a) + 1
DIM i AS I32
DIM total AS I32
total = 0
FOR i = LBOUND(a) TO UBOUND(a)
    a(i) = i * 10
    total = total + a(i)
NEXT i
PRINT total
