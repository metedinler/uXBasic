' S-101: dizi parametresi kendi (cagiranin dizisinin) gercek sinirlarini ogrenir; baska parametreye aktarilabilir.
FUNCTION Count(arr AS I32[]) AS I32
    RETURN UBOUND(arr) - LBOUND(arr) + 1
END FUNCTION
FUNCTION SumAll(arr AS I32[]) AS I32
    DIM s AS I32
    DIM i AS I32
    s = 0
    FOR i = LBOUND(arr) TO UBOUND(arr)
        s = s + arr(i)
    NEXT i
    RETURN s
END FUNCTION
FUNCTION Forward(arr AS I32[]) AS I32
    RETURN Count(arr) * 100 + SumAll(arr)
END FUNCTION
DIM v(1 TO 4) AS I32
v(1) = 1
v(2) = 2
v(3) = 3
v(4) = 4
DIM w(0 TO 2) AS I32
w(0) = 10
w(1) = 20
w(2) = 30
PRINT SumAll(v)
PRINT SumAll(w)
PRINT Count(v)
PRINT Count(w)
PRINT Forward(w)
