' S-068: bir dizi parametresi başka bir dizi parametresine aynen aktarılabilir
' (tutucu ve alt sınır korunur); yazma en dıştaki diziyi değiştirir.
FUNCTION Inner(arr AS I32[], k AS I32) AS I32
    RETURN arr(k) + 1
END FUNCTION

SUB Store(arr AS I32[], k AS I32, v AS I32)
    arr(k) = v
END SUB

FUNCTION Outer(arr AS I32[], k AS I32) AS I32
    Store(arr, k, 500)
    RETURN Inner(arr, k) * 2
END FUNCTION

DIM r(1 TO 3) AS I32
r(1) = 21 : r(2) = 22 : r(3) = 23
PRINT Outer(r, 3)
PRINT r(3)
PRINT r(1)