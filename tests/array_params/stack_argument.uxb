' S-068: dizi parametresi 4. sıradan sonra (yığın argümanı olarak) da çalışır.
FUNCTION Pick5(a AS I32, b AS I32, c AS I32, d AS I32, arr AS I32[]) AS I32
    RETURN arr(a + b + c + d - 8) + a
END FUNCTION

DIM x(3) AS I32
x(0) = 10 : x(1) = 20 : x(2) = 30 : x(3) = 40
PRINT Pick5(1, 2, 2, 3, x)
PRINT Pick5(2, 2, 2, 2, x)