' S-068: bir dizi parametresi (`arr AS I32[]`) çağıranın dizisine REFERANSTIR:
' gövdede indekslenir, okunur ve yazılır; yazılanı çağıran görür.
FUNCTION SumArr(arr AS I32[], n AS I32) AS I32
    DIM s AS I32
    DIM i AS I32
    s = 0
    FOR i = 0 TO n - 1
        s = s + arr(i)
    NEXT i
    RETURN s
END FUNCTION

SUB FillArr(arr AS I32[], n AS I32)
    DIM i AS I32
    FOR i = 0 TO n - 1
        arr(i) = (i + 1) * 10
    NEXT i
END SUB

DIM a(3) AS I32
a(0) = 1 : a(1) = 2 : a(2) = 3 : a(3) = 4
PRINT SumArr(a, 4)
FillArr(a, 4)
PRINT a(0)
PRINT a(3)
PRINT SumArr(a, 4)