' S-068: dizi parametresi çağıran dizisinin GERÇEK alt sınırını kullanır.
FUNCTION Pick(arr AS I32[], k AS I32) AS I32
    RETURN arr(k)
END FUNCTION

SUB Bump(arr AS I32[], k AS I32)
    arr(k) = arr(k) + 100
END SUB

DIM r(1 TO 3) AS I32
r(1) = 21 : r(2) = 22 : r(3) = 23
PRINT Pick(r, 1)
PRINT Pick(r, 3)
Bump(r, 2)
PRINT r(2)

DIM n(-2 TO 2) AS I32
n(-2) = 5 : n(0) = 6 : n(2) = 7
PRINT Pick(n, -2)
PRINT Pick(n, 0)
PRINT Pick(n, 2)

DIM z(0 TO 3) AS I32
z(0) = 8 : z(1) = 9
PRINT Pick(z, 0)
PRINT Pick(z, 1)