' S-068: her yerleşik eleman türü için dizi parametresi (hücre genişliği türden gelir).
FUNCTION SumI8(arr AS I8[]) AS I32
    RETURN arr(0) + arr(1) + arr(2)
END FUNCTION
FUNCTION SumU8(arr AS U8[]) AS I32
    RETURN arr(0) + arr(1) + arr(2)
END FUNCTION
FUNCTION SumI16(arr AS I16[]) AS I32
    RETURN arr(0) + arr(1) + arr(2)
END FUNCTION
FUNCTION SumU16(arr AS U16[]) AS I32
    RETURN arr(0) + arr(1) + arr(2)
END FUNCTION
FUNCTION SumI64(arr AS I64[]) AS I64
    RETURN arr(0) + arr(1) + arr(2)
END FUNCTION
FUNCTION SumF64(arr AS F64[]) AS F64
    RETURN arr(0) + arr(1) + arr(2)
END FUNCTION

DIM a8(2) AS I8
a8(0) = I8(-3) : a8(1) = I8(4) : a8(2) = I8(100)
PRINT SumI8(a8)
DIM b8(2) AS U8
b8(0) = U8(250) : b8(1) = U8(1) : b8(2) = U8(2)
PRINT SumU8(b8)
DIM a16(2) AS I16
a16(0) = I16(-300) : a16(1) = I16(400) : a16(2) = I16(1000)
PRINT SumI16(a16)
DIM b16(2) AS U16
b16(0) = U16(60000) : b16(1) = U16(1) : b16(2) = U16(2)
PRINT SumU16(b16)
DIM a64(2) AS I64
a64(0) = 5000000000 : a64(1) = 6 : a64(2) = 7
PRINT SumI64(a64)
DIM d(2) AS F64
d(0) = 1.5 : d(1) = 2.25 : d(2) = 3
PRINT SumF64(d)