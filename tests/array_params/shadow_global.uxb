' S-068: parametre adı, aynı adlı bir genel diziyi gölgeler.
DIM arr(2) AS I32
arr(0) = 1 : arr(1) = 2 : arr(2) = 3

FUNCTION FirstOf(arr AS I32[]) AS I32
    RETURN arr(0)
END FUNCTION

FUNCTION GlobalFirst() AS I32
    RETURN arr(0)
END FUNCTION

DIM other(2) AS I32
other(0) = 900 : other(1) = 901 : other(2) = 902
PRINT FirstOf(other)
PRINT FirstOf(arr)
PRINT GlobalFirst()