' S-068: bir rutinin YEREL dizisi de dizi parametresine geçirilebilir.
SUB Fill(arr AS I32[], n AS I32)
    DIM i AS I32
    FOR i = 0 TO n - 1
        arr(i) = i * i
    NEXT i
END SUB

FUNCTION Total(arr AS I32[], n AS I32) AS I32
    DIM i AS I32
    DIM s AS I32
    s = 0
    FOR i = 0 TO n - 1
        s = s + arr(i)
    NEXT i
    RETURN s
END FUNCTION

FUNCTION Work() AS I32
    DIM t(4) AS I32
    Fill(t, 5)
    RETURN Total(t, 5)
END FUNCTION

PRINT Work()