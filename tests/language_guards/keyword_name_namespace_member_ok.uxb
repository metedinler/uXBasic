' S-128: NAMESPACE icindeki rutin adlari anahtar sozcuk olabilir (uxsqlite.Open gibi) ve nokta ile cagrilir.
NAMESPACE lg
    FUNCTION Open(v AS I32) AS I32
        RETURN v + 1
    END FUNCTION
    FUNCTION Close(v AS I32) AS I32
        RETURN v + 2
    END FUNCTION
END NAMESPACE
PRINT lg.Open(1)
PRINT lg.Close(1)
