' S-144: bir ikili ifadenin sol islenenini `push` ile tutarken sag islenende FFI cagrisi yapilirsa yigin hizasi bozulurdu (legacy AST-x64).
' Hizali SSE erisimi kullanan C islevleri (strtod, snprintf ...) bu durumda cokerdi.
DIM hit AS I32
hit = 0
IF CALL(DLL, "ucrtbase.dll", "strtod", F64, CDECL, "STRPTR,PTR", "1.5", 0) > 9 OR CALL(DLL, "ucrtbase.dll", "strtod", F64, CDECL, "STRPTR,PTR", "2.5", 0) > 2 THEN hit = 1
PRINT hit
DIM total AS F64
total = 1.0 + CALL(DLL, "ucrtbase.dll", "strtod", F64, CDECL, "STRPTR,PTR", "2.25", 0) * 2.0
PRINT total
DIM n AS U64
n = CALL(DLL, "ucrtbase.dll", "strlen", U64, CDECL, "STRPTR", "hello") + CALL(DLL, "ucrtbase.dll", "strlen", U64, CDECL, "STRPTR", "ab")
PRINT n
PRINT "n=" + STR(n)
