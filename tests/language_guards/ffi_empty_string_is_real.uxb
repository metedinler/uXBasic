' S-145: bos uXBasic metni ("") her motorda GERCEK bos C metnidir (gecerli, sonlandirilmis 1 bayt);
' NULL ayri bir seydir ve yalniz PTR 0 ile verilir. IsBadStringPtrA gecersiz isaretci icin 1, gecerli metin icin 0 doner.
DIM emptyText AS STRING
emptyText = ""
DIM bad AS I32
bad = CALL(DLL, "kernel32.dll", "IsBadStringPtrA", I32, STDCALL, "STRPTR,U64", emptyText, 16)
PRINT bad
bad = CALL(DLL, "kernel32.dll", "IsBadStringPtrA", I32, STDCALL, "STRPTR,U64", "", 16)
PRINT bad
bad = CALL(DLL, "kernel32.dll", "IsBadStringPtrA", I32, STDCALL, "PTR,U64", 0, 16)
PRINT bad
DIM n AS U64
n = CALL(DLL, "ucrtbase.dll", "strlen", U64, CDECL, "STRPTR", "")
PRINT n
