LIBTYPE "owned_text.library_type.json"
FUNCTION FailWithPayload(x AS TEXT_VALUE) AS TEXT_VALUE
    DIM items(1) AS TEXT_VALUE
    DIM divisor AS I32
    items(0) = x
    divisor = 0
    PRINT 1 \ divisor
    RETURN x
END FUNCTION
MAIN
    DIM a AS TEXT_VALUE
    a = TEXT_VALUE.CONSTRUCT("error_cleanup")
    a = FailWithPayload(a)
END MAIN
