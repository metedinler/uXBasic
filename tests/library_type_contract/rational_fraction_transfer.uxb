LIBTYPE "uxmath/rational.library_type.json"

FUNCTION CopyFraction(x AS RATIONAL) AS RATIONAL
    DIM localCopy AS RATIONAL
    localCopy = x
    x = 8
    RETURN localCopy
END FUNCTION

MAIN
    DIM numerator AS RATIONAL
    DIM denominator AS RATIONAL
    DIM fraction AS RATIONAL
    DIM saved AS RATIONAL
    DIM items(1) AS RATIONAL
    numerator = 3
    denominator = 2
    fraction = numerator / denominator
    saved = CopyFraction(fraction)
    items(0) = saved
    saved = 4
    fraction = 9
    PRINT items(0)
    saved = CopyFraction(items(0))
    PRINT saved
    PRINT items(1)
    items(1) = 5
    PRINT items(1)
    REDIM PRESERVE items(3) AS RATIONAL
    PRINT items(0)
    PRINT items(3)
    REDIM items(1) AS RATIONAL
    PRINT items(0)
END MAIN
