LIBTYPE "measure.library_type.json"
FUNCTION EchoMeasure(x AS MEASURE_VALUE) AS MEASURE_VALUE
    RETURN x
END FUNCTION
MAIN
    DIM firstMeasure AS MEASURE_VALUE
    DIM secondMeasure AS MEASURE_VALUE
    DIM measures(1) AS MEASURE_VALUE
    secondMeasure = EchoMeasure(firstMeasure)
    measures(0) = secondMeasure
    PRINT "MANIFEST_TYPE_OK"
END MAIN
