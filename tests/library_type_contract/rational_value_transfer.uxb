LIBTYPE "uxmath/rational.library_type.json"

FUNCTION Changed(x AS RATIONAL) AS RATIONAL
    DIM incrementValue AS RATIONAL
    incrementValue = 1
    x = x + incrementValue
    RETURN x
END FUNCTION

MAIN
    DIM a AS RATIONAL
    DIM b AS RATIONAL
    DIM c AS RATIONAL
    DIM values(2) AS RATIONAL
    a = 3
    b = a
    a = 9
    PRINT b
    c = Changed(b)
    PRINT b
    PRINT c
    values(0) = b
    values(1) = c
    b = 7
    c = values(0)
    PRINT c
    c = values(1)
    PRINT c
    PRINT a
END MAIN
