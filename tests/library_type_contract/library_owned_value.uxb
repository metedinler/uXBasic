LIBTYPE "owned_text.library_type.json"
FUNCTION ChangeCopy(x AS TEXT_VALUE) AS TEXT_VALUE
    DIM localItems(1) AS TEXT_VALUE
    localItems(0) = x
    x = TEXT_VALUE.NORMALIZE(x)
    PRINT localItems(0)
    RETURN x
END FUNCTION
MAIN
    DIM a AS TEXT_VALUE
    DIM b AS TEXT_VALUE
    DIM c AS TEXT_VALUE
    DIM items(1) AS TEXT_VALUE
    a = TEXT_VALUE.CONSTRUCT("hello")
    b = a
    c = ChangeCopy(a)
    PRINT a
    PRINT b
    PRINT c
    items(0) = a
    a = TEXT_VALUE.NORMALIZE(a)
    PRINT items(0)
    b = b
    PRINT b
    REDIM PRESERVE items(2) AS TEXT_VALUE
    PRINT items(0)
    CALL TEXT_VALUE.DROP(a)
    CALL TEXT_VALUE.DROP(a)
    PRINT b
    REDIM items(1) AS TEXT_VALUE
END MAIN
