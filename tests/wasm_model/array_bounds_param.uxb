' S-101: dizi parametresinin LBOUND/UBOUND'u calisma zamaninda cagiranin dizisinin gercek sinirlarini verir
' (WASM: dizi host tutamagi, host_call4 83 = alt sinir, 84 = ust sinir).
FUNCTION SumAll(arr AS I32[]) AS I32
    DIM s AS I32
    DIM i AS I32
    s = 0
    FOR i = LBOUND(arr) TO UBOUND(arr)
        s = s + arr(i)
    NEXT i
    RETURN s
END FUNCTION
FUNCTION Span(arr AS I32[]) AS I32
    RETURN UBOUND(arr) - LBOUND(arr) + 1
END FUNCTION
DIM v(1 TO 3) AS I32
v(1) = 1
v(2) = 2
v(3) = 3
DIM w(5 TO 9) AS I32
PRINT SumAll(v)
PRINT Span(v)
PRINT Span(w)
PRINT LBOUND(w)
