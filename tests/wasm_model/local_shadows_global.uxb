' Fonksiyonun kendi yerel/parametresi ayni adli globali GOLGELER; global etkilenmez.
DIM x AS I32
x = 1
FUNCTION UseLocal() AS I32
    DIM x AS I32
    x = 10
    RETURN x
END FUNCTION
FUNCTION UseParam(x AS I32) AS I32
    x = x + 100
    RETURN x
END FUNCTION
PRINT UseLocal()
PRINT UseParam(5)
PRINT x