' S-101: derleme zamani sinirli dizinin LBOUND/UBOUND'u sabite katlanir (WASM dahil her hedefte calisir).
DIM a(1 TO 4) AS I32
DIM i AS I32
DIM s AS I32
FOR i = LBOUND(a) TO UBOUND(a)
    a(i) = i * i
NEXT i
s = 0
FOR i = LBOUND(a) TO UBOUND(a)
    s = s + a(i)
NEXT i
PRINT LBOUND(a)
PRINT UBOUND(a)
PRINT s
