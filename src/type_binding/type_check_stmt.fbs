#ifndef UXB_TYPE_CHECK_STMT_FBS
#define UXB_TYPE_CHECK_STMT_FBS
Function UXBStep3CheckStatementType(ByVal nodeKind As String, ByRef errText As String) As Integer
    Dim k As String = UCase(Trim(nodeKind))
    If k = "" Then errText = "statement: empty kind": Return 0
    If InStr(k, "_EXPR") > 0 Then errText = "statement: expression used as statement without wrapper": Return 0
    errText = ""
    Return 1
End Function
#endif
