#ifndef UXB_TYPE_CHECK_CALL_FBS
#define UXB_TYPE_CHECK_CALL_FBS
#include once "type_rules.fbs"
#include once "type_builtin_registry.fbs"

Function UXBStep3CheckCallArgCount(ByVal expectedCount As Integer, ByVal actualCount As Integer, ByRef errText As String) As Integer
    If expectedCount >= 0 AndAlso expectedCount <> actualCount Then errText = "call: argument count mismatch": Return 0
    errText = "": Return 1
End Function

Function UXBStep3BuiltinReturnType(ByVal callName As String, ByRef returnTypeOut As String) As Integer
    If UXBBuiltinTypeReturnType(callName, returnTypeOut) <> 0 Then Return 1
    returnTypeOut = ""
    Return 0
End Function
#endif
