#ifndef UXB_TYPE_FFI_SIGNATURE_FBS
#define UXB_TYPE_FFI_SIGNATURE_FBS
#include once "type_rules.fbs"

Private Function UXBStep3TextReplaceAll(ByVal srcText As String, ByVal findText As String, ByVal replText As String) As String
    If findText = "" Then Return srcText
    Dim outText As String
    outText = ""
    Dim startPos As Integer
    startPos = 1
    Do
        Dim hitPos As Integer
        hitPos = InStr(startPos, srcText, findText)
        If hitPos = 0 Then
            outText &= Mid(srcText, startPos)
            Exit Do
        End If
        outText &= Mid(srcText, startPos, hitPos - startPos)
        outText &= replText
        startPos = hitPos + Len(findText)
    Loop
    Return outText
End Function

Private Function UXBStep3FFITypeTokenValid(ByVal tokenText As String) As Integer
    Dim t As String = UCase(Trim(tokenText))
    If t = "" Then Return 0
    If InStr(t, " AS ") > 0 Then t = Trim(Mid(t, InStr(t, " AS ") + 4))
    If Left(t, 1) = "*" Then t = "PTR"
    If Right(t, 1) = "*" Then t = "PTR"
    Dim c As String = UXBStep3TypeCanonical(t)
    If UXBStep3TypeIsBlocked(c) <> 0 Then Return 0
    If UXBStep3TypeIsKnownScalar(c) <> 0 Then Return 1
    Return 0
End Function

Function UXBStep3CheckFFISignature(ByVal signatureText As String, ByRef errText As String) As Integer
    Dim s As String = Trim(signatureText)
    If s = "" Then errText = "ffi: signature required": Return 0
    Dim cleaned As String = s
    cleaned = UXBStep3TextReplaceAll(cleaned, "(", ",")
    cleaned = UXBStep3TextReplaceAll(cleaned, ")", ",")
    cleaned = UXBStep3TextReplaceAll(cleaned, "->", ",")
    cleaned = UXBStep3TextReplaceAll(cleaned, ":", ",")
    Dim startPos As Integer = 1
    Do
        Dim commaPos As Integer = InStr(startPos, cleaned, ",")
        Dim part As String
        If commaPos = 0 Then
            part = Trim(Mid(cleaned, startPos))
        Else
            part = Trim(Mid(cleaned, startPos, commaPos - startPos))
        End If
        If part <> "" Then
            If UXBStep3FFITypeTokenValid(part) = 0 Then errText = "ffi: invalid signature token " & part: Return 0
        End If
        If commaPos = 0 Then Exit Do
        startPos = commaPos + 1
    Loop
    errText = ""
    Return 1
End Function
#endif
