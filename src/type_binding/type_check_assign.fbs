#ifndef UXB_TYPE_CHECK_ASSIGN_FBS
#define UXB_TYPE_CHECK_ASSIGN_FBS
#include once "type_coercion.fbs"

Function UXBStep3CheckAssignment(ByVal targetType As String, ByVal valueType As String, ByRef errText As String) As Integer
    Dim t As String
    Dim v As String
    t = UCase(Trim(targetType))
    v = UCase(Trim(valueType))
    If t = "TYPE_PTR" Or t = "PTR" Then
        Select Case v
        Case "TYPE_I32", "TYPE_U32", "TYPE_I64", "TYPE_U64", "I32", "U32", "I64", "U64", "TYPE_PTR", "PTR"
            errText = ""
            Return 1
        End Select
    End If
    Return UXBStep3RequireImplicitAssignment(valueType, targetType, errText)
End Function

Function UXBStep3CheckAssignableNodeKind(ByVal nodeKind As String, ByRef errText As String) As Integer
    Dim k As String = UCase(Trim(nodeKind))
    Select Case k
    Case "IDENT", "IDENTIFIER", "FIELD_EXPR", "MEMBER_EXPR", "INDEX_EXPR"
        errText = "": Return 1
    End Select
    errText = "assign: left side is not writable: " & k
    Return 0
End Function
#endif
