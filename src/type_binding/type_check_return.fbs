#ifndef UXB_TYPE_CHECK_RETURN_FBS
#define UXB_TYPE_CHECK_RETURN_FBS
#include once "type_coercion.fbs"
Function UXBStep3CheckReturnType(ByVal expectedType As String, ByVal actualType As String, ByRef errText As String) As Integer
    If UXBStep3TypeCanonical(expectedType) = TYPE_VOID Then
        If UXBStep3TypeCanonical(actualType) = TYPE_VOID Then errText = "": Return 1
        errText = "return: value returned from void routine": Return 0
    End If
    Return UXBStep3RequireCoercion(actualType, expectedType, errText)
End Function
#endif
