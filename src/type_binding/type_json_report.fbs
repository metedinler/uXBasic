#ifndef UXB_TYPE_JSON_REPORT_FBS
#define UXB_TYPE_JSON_REPORT_FBS
Function UXBStep3TypeJsonEscape(ByRef s As String) As String
    Dim t As String
    t = ""
    Dim i As Integer
    For i = 1 To Len(s)
        Select Case Mid(s, i, 1)
        Case "\"
            t &= "\\"
        Case Chr(34)
            t &= "\" & Chr(34)
        Case Else
            t &= Mid(s, i, 1)
        End Select
    Next i
    Return t
End Function
Function UXBStep3TypeJsonSummary(ByRef statusText As String) As String
    Return "{" & Chr(34) & "type_status" & Chr(34) & ":" & Chr(34) & UXBStep3TypeJsonEscape(statusText) & Chr(34) & "}"
End Function
#endif
