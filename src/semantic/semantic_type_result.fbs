#ifndef UXB_SEMANTIC_TYPE_RESULT_FBS
#define UXB_SEMANTIC_TYPE_RESULT_FBS

Type UXBSemanticTypeFact
    astNode As Integer
    symbolIndex As Integer
    scopeId As Integer
    name As String
    kind As String
    typeName As String
    typeStatus As String
    diagnostic As String
End Type

Type UXBSemanticTypeTable
    facts(Any) As UXBSemanticTypeFact
    factCount As Integer
End Type

Sub UXBSemanticTypeTableInit(ByRef t As UXBSemanticTypeTable, ByVal countValue As Integer)
    t.factCount = countValue
    If countValue > 0 Then ReDim t.facts(countValue - 1)
    Dim i As Integer
    For i = 0 To countValue - 1
        t.facts(i).astNode = i
        t.facts(i).symbolIndex = -1
        t.facts(i).scopeId = 0
        t.facts(i).name = ""
        t.facts(i).kind = ""
        t.facts(i).typeName = ""
        t.facts(i).typeStatus = "UNRESOLVED"
        t.facts(i).diagnostic = ""
    Next i
End Sub

#endif
