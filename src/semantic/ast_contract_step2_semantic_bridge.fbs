' Step 2 semantic binding bridge.
#ifndef UXBASIC_AST_CONTRACT_STEP2_SEMANTIC_BRIDGE_FBS
#define UXBASIC_AST_CONTRACT_STEP2_SEMANTIC_BRIDGE_FBS

#include once "../parser/ast_contract_layer_bindings.fbs"

Function SemStep2ContractStatus(ByRef astNodeKind As String) As String
    Return UXBAstContractLayerStatusForNode(astNodeKind, "SEMANTIC")
End Function

Function SemStep2ContractHandler(ByRef astNodeKind As String) As String
    Return UXBAstContractSemanticHandlerForNode(astNodeKind)
End Function

Function SemStep2ExprContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    If SemStep2ContractStatus(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "semantic expression contract blocked for " & astNodeKind
    Return 0
End Function

Function SemStep2TypeObjectContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    If SemStep2ContractStatus(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "semantic type/object contract blocked for " & astNodeKind
    Return 0
End Function

Function SemStep2ControlContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    If SemStep2ContractStatus(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "semantic control-flow contract blocked for " & astNodeKind
    Return 0
End Function

Function SemStep2ErrorContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    If SemStep2ContractStatus(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "semantic error-flow contract blocked for " & astNodeKind
    Return 0
End Function

Function SemStep2RuntimeContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    If SemStep2ContractStatus(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "semantic runtime contract blocked for " & astNodeKind
    Return 0
End Function

Function SemStep2NativeContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    errText = "native-only AST node is not a portable semantic execution node: " & astNodeKind
    Return 0
End Function

Function SemStep2StatementContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    If SemStep2ContractStatus(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "semantic statement contract blocked for " & astNodeKind
    Return 0
End Function

#endif
