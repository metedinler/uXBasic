#ifndef UXB_MIR_SOURCE_MAPPING_ADIM16_FBS
#define UXB_MIR_SOURCE_MAPPING_ADIM16_FBS

#include once "../common/source_mapping.fbs"

Function UXBMIRSourceMapAddInstruction(ByRef smap As UXBSourceMapList, ByRef surfaceText As String, ByRef opcodeText As String, ByRef srcLocation As SourceLocation, ByRef mirIdText As String) As Integer
    Return UXBSourceMapAdd(smap, surfaceText, "ast", "mir", "instruction", opcodeText, srcLocation, mirIdText, "OK")
End Function

Function UXBMIRSourceMapAddMissing(ByRef smap As UXBSourceMapList, ByRef surfaceText As String, ByRef opcodeText As String, ByRef mirIdText As String) As Integer
    Dim srcLocation As SourceLocation
    srcLocation = UXBSourceLocationMake("", 0, 0, 0, "")
    Return UXBSourceMapAdd(smap, surfaceText, "ast", "mir", "instruction", opcodeText, srcLocation, mirIdText, "MISSING_LOCATION")
End Function

#endif
