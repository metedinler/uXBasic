' Step 2 layout binding bridge.
#ifndef UXBASIC_LAYOUT_AST_CONTRACT_BRIDGE_FBS
#define UXBASIC_LAYOUT_AST_CONTRACT_BRIDGE_FBS

#include once "../parser/ast_contract_layer_bindings.fbs"

Function LayoutStep2Status(ByRef astNodeKind As String) As String
    Return UXBAstContractLayerStatusForNode(astNodeKind, "LAYOUT")
End Function

Function LayoutStep2Handler(ByRef astNodeKind As String) As String
    Return UXBAstContractLayoutHandlerForNode(astNodeKind)
End Function

Function LayoutStep2Contract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    Dim st As String = LayoutStep2Status(astNodeKind)
    If st = "IMPLEMENTED" Or st = "NOT_APPLICABLE" Then errText = "": Return 1
    errText = "layout contract blocked for " & astNodeKind
    Return 0
End Function

#endif
