' Step 2 type binding bridge.
#ifndef UXBASIC_TYPE_BINDING_AST_CONTRACT_BRIDGE_FBS
#define UXBASIC_TYPE_BINDING_AST_CONTRACT_BRIDGE_FBS

#include once "../parser/ast_contract_layer_bindings.fbs"
#include once "type_binding.fbs"

Function TypeBindingStep2Status(ByRef astNodeKind As String) As String
    Return UXBAstContractLayerStatusForNode(astNodeKind, "TYPE_BINDING")
End Function

Function TypeBindingStep2Handler(ByRef astNodeKind As String) As String
    Return UXBAstContractTypeBindingHandlerForNode(astNodeKind)
End Function

Function TypeBindingStep2ExprContract(ByRef astNodeKind As String, ByRef inferredType As String, ByRef errText As String) As Integer
    If TypeBindingStep2Status(astNodeKind) <> "IMPLEMENTED" Then errText = "type binding not executable for " & astNodeKind: Return 0
    If Trim(inferredType) = "" Then inferredType = "VARIANT"
    If TypeBindingResolve(inferredType, errText) = -1 Then Return 0
    errText = ""
    Return 1
End Function

Function TypeBindingStep2ObjectContract(ByRef astNodeKind As String, ByRef typeName As String, ByRef errText As String) As Integer
    If TypeBindingStep2Status(astNodeKind) <> "IMPLEMENTED" Then errText = "type/object binding not executable for " & astNodeKind: Return 0
    If Trim(typeName) = "" Then errText = "": Return 1
    If TypeBindingResolve(typeName, errText) = -1 Then Return 0
    errText = ""
    Return 1
End Function

Function TypeBindingStep2RuntimeContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    If TypeBindingStep2Status(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "runtime type binding not executable for " & astNodeKind
    Return 0
End Function

Function TypeBindingStep2FlowContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    If TypeBindingStep2Status(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "flow type binding not executable for " & astNodeKind
    Return 0
End Function

Function TypeBindingStep2StatementContract(ByRef astNodeKind As String, ByRef errText As String) As Integer
    If TypeBindingStep2Status(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "statement type binding not executable for " & astNodeKind
    Return 0
End Function

#endif
