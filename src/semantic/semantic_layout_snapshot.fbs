#ifndef UXB_SEMANTIC_LAYOUT_SNAPSHOT_FBS
#define UXB_SEMANTIC_LAYOUT_SNAPSHOT_FBS

Type UXBSemanticLayoutFact
    astNode As Integer
    symbolIndex As Integer
    name As String
    layoutKind As String
    typeName As String
    sizeBytes As Integer
    alignBytes As Integer
    fieldCount As Integer
    status As String
    diagnostic As String
End Type

Type UXBSemanticLayoutSnapshot
    facts(Any) As UXBSemanticLayoutFact
    factCount As Integer
End Type

Sub UXBSemanticLayoutSnapshotInit(ByRef s As UXBSemanticLayoutSnapshot, ByVal countValue As Integer)
    s.factCount = countValue
    If countValue > 0 Then ReDim s.facts(countValue - 1)
    Dim i As Integer
    For i = 0 To countValue - 1
        s.facts(i).astNode = -1
        s.facts(i).symbolIndex = -1
        s.facts(i).name = ""
        s.facts(i).layoutKind = ""
        s.facts(i).typeName = ""
        s.facts(i).sizeBytes = 0
        s.facts(i).alignBytes = 1
        s.facts(i).fieldCount = 0
        s.facts(i).status = "UNRESOLVED"
        s.facts(i).diagnostic = ""
    Next i
End Sub

Function UXBStep5TypeSizeBytes(ByRef typeText As String) As Integer
    Dim t As String = UCase(Trim(typeText))
    Select Case t
    Case "I8", "U8", "BYTE", "BOOLEAN": Return 1
    Case "I16", "U16": Return 2
    Case "I32", "U32", "INTEGER", "F32", "SINGLE": Return 4
    Case "I64", "U64", "LONG", "LONGINT", "F64", "DOUBLE", "STRING", "PTR", "POINTER", "REF": Return 8
    Case "F80": Return 10
    Case "F128": Return 16
    Case "BIGF", "BIGD", "BALL", "BIGINT": Return 8
    End Select
    Return 8
End Function

Function UXBStep5TypeAlignBytes(ByRef typeText As String) As Integer
    Dim s As Integer = UXBStep5TypeSizeBytes(typeText)
    If s <= 1 Then Return 1
    If s <= 2 Then Return 2
    If s <= 4 Then Return 4
    Return 8
End Function

#endif
