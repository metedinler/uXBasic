#ifndef UXB_MIR_SYMBOL_STORAGE_BRIDGE_FBS
#define UXB_MIR_SYMBOL_STORAGE_BRIDGE_FBS

#include once "mir_function_storage.fbs"

Function MIRVarInfoFromAstNode(ByRef ps As ParseState, ByVal astNode As Integer, ByVal storageClassValue As Integer) As MIRVarInfo
    Dim vi As MIRVarInfo
    vi.name = ""
    vi.rawName = ""
    vi.typeName = "I64"
    vi.typeInfo = MIRTypeInfoFromName("I64")
    vi.symbolIndex = -1
    vi.scopeId = 0
    vi.astNode = astNode
    vi.storageClass = storageClassValue
    vi.isParam = IIf(storageClassValue = MIR_STORAGE_PARAM, 1, 0)
    vi.paramIdx = -1
    vi.isArray = 0
    vi.elementType = ""
    vi.elementCount = 0
    If astNode < 0 Or astNode >= ps.ast.count Then Return vi
    Dim n As ASTNode Ptr = @ps.ast.nodes(astNode)
    vi.name = UCase(Trim(n->symbolName))
    If vi.name = "" Then vi.name = UCase(Trim(n->value))
    vi.rawName = n->value
    If Trim(n->typeName) <> "" Then vi.typeName = MIRCanonicalTypeName2(n->typeName)
    vi.typeInfo = MIRTypeInfoFromName(vi.typeName)
    vi.source = UXBSourceLocationMake(n->sourceFile, n->lineNo, n->colNo, n->sourceLength, n->lexemeSnippet)
    Return vi
End Function

Function MIRAddLocalFromAst(ByRef ps As ParseState, ByRef fn As MIRFunction, ByVal astNode As Integer) As Integer
    Dim vi As MIRVarInfo
    vi = MIRVarInfoFromAstNode(ps, astNode, MIR_STORAGE_LOCAL)
    If Trim(vi.name) = "" Then Return -1
    Return MIRFunctionAddLocalInfo(fn, vi)
End Function

Function MIRAddParamFromAst(ByRef ps As ParseState, ByRef fn As MIRFunction, ByVal astNode As Integer) As Integer
    Dim vi As MIRVarInfo
    vi = MIRVarInfoFromAstNode(ps, astNode, MIR_STORAGE_PARAM)
    If Trim(vi.name) = "" Then Return -1
    Return MIRFunctionAddParamInfo(fn, vi)
End Function

#endif
