#ifndef UXB_MIR_VERIFICATION_GATE_FBS
#define UXB_MIR_VERIFICATION_GATE_FBS

#include once "mir_verifier.fbs"
#include once "mir_builder_gate.fbs"
#include once "mir_storage_gate.fbs"

Type UXBMIRGateResult
    ok As Integer
    builderOk As Integer
    storageOk As Integer
    verifierOk As Integer
    errorCount As Integer
    warningCount As Integer
    errorsText As String
    warningsText As String
    verifyResult As UXBMIRVerifyResult
    builderResult As MIRBuilderGateResult
    storageResult As MIRStorageGateResult
End Type

Sub UXBMIRGateInit(ByRef r As UXBMIRGateResult)
    r.ok = 0
    r.builderOk = 0
    r.storageOk = 0
    r.verifierOk = 0
    r.errorCount = 0
    r.warningCount = 0
    r.errorsText = ""
    r.warningsText = ""
    UXBMIRVerifyInit r.verifyResult
    MIRBuilderGateInit r.builderResult
    MIRStorageGateInit r.storageResult
End Sub

Private Sub UXBMIRGateAppendError(ByRef r As UXBMIRGateResult, ByVal msg As String)
    r.errorCount += 1
    If Len(r.errorsText) > 0 Then r.errorsText &= Chr(10)
    r.errorsText &= msg
End Sub

Private Sub UXBMIRGateAppendWarning(ByRef r As UXBMIRGateResult, ByVal msg As String)
    r.warningCount += 1
    If Len(r.warningsText) > 0 Then r.warningsText &= Chr(10)
    r.warningsText &= msg
End Sub

Function UXBMIRMandatoryGate(ByRef m As MIRModule, ByRef r As UXBMIRGateResult, ByRef errText As String) As Integer
    UXBMIRGateInit r
    errText = ""

    If MIRBuilderGateCheckModule(m, r.builderResult) = 0 Then
        r.builderOk = 0
        UXBMIRGateAppendError r, "MIR builder gate failed:"
        UXBMIRGateAppendError r, r.builderResult.errorText
    Else
        r.builderOk = 1
    End If

    If MIRStorageGateCheckModule(m, r.storageResult) = 0 Then
        r.storageOk = 0
        UXBMIRGateAppendError r, "MIR storage gate failed:"
        UXBMIRGateAppendError r, r.storageResult.errorText
    Else
        r.storageOk = 1
    End If

    Dim verifyErr As String
    If UXBMIRVerifyModule(m, r.verifyResult, verifyErr) = 0 Then
        r.verifierOk = 0
        UXBMIRGateAppendError r, "MIR verifier internal failure:"
        UXBMIRGateAppendError r, verifyErr
    ElseIf r.verifyResult.ok = 0 Then
        r.verifierOk = 0
        UXBMIRGateAppendError r, "MIR verifier failed:"
        UXBMIRGateAppendError r, r.verifyResult.errorsText
    Else
        r.verifierOk = 1
        If Trim(r.verifyResult.warningsText) <> "" Then UXBMIRGateAppendWarning r, r.verifyResult.warningsText
    End If

    If r.builderOk <> 0 And r.storageOk <> 0 And r.verifierOk <> 0 Then
        r.ok = 1
        Return 1
    End If

    errText = r.errorsText
    r.ok = 0
    Return 0
End Function

#endif
