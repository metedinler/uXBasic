#ifndef UXB_MIR_BUILDER_GATE_FBS
#define UXB_MIR_BUILDER_GATE_FBS

#include once "mir_opcode_signature.fbs"

Type MIRBuilderGateResult
    ok As Integer
    checkedCount As Integer
    errorCount As Integer
    warningCount As Integer
    errorText As String
End Type

Sub MIRBuilderGateInit(ByRef r As MIRBuilderGateResult)
    r.ok = 0
    r.checkedCount = 0
    r.errorCount = 0
    r.warningCount = 0
    r.errorText = ""
End Sub

Private Sub MIRBuilderGateAddError(ByRef r As MIRBuilderGateResult, ByVal msg As String)
    r.errorCount += 1
    If Len(r.errorText) > 0 Then r.errorText &= Chr(10)
    r.errorText &= msg
End Sub

Function MIRBuilderGateCheckInstruction(ByRef inst As MIRIRInstruction, ByRef errText As String) As Integer
    Dim sig As MIROpcodeSignature
    If MIROpcodeGetSignature(inst.opcode, sig) = 0 Then
        errText = "unknown MIR opcode signature: " & inst.opcode
        Return 0
    End If
    If inst.operandCount < sig.minOps Or inst.operandCount > sig.maxOps Then
        errText = "invalid operand count for " & inst.opcode & " got=" & LTrim(Str(inst.operandCount)) & " expected=" & LTrim(Str(sig.minOps)) & ".." & LTrim(Str(sig.maxOps))
        Return 0
    End If
    If sig.resultRequired <> 0 And Trim(inst.result) = "" Then
        errText = "missing result for " & inst.opcode
        Return 0
    End If
    errText = ""
    Return 1
End Function

Function MIRBuilderGateCheckModule(ByRef module As MIRModule, ByRef result As MIRBuilderGateResult) As Integer
    MIRBuilderGateInit result
    Dim fi As Integer, bi As Integer, ii As Integer
    For fi = 0 To module.functionCount - 1
        For bi = 0 To module.functions(fi).blockCount - 1
            For ii = 0 To module.functions(fi).blocks(bi).instructionCount - 1
                result.checkedCount += 1
                Dim e As String
                If MIRBuilderGateCheckInstruction(module.functions(fi).blocks(bi).instructions(ii), e) = 0 Then
                    MIRBuilderGateAddError result, e
                End If
            Next ii
        Next bi
    Next fi
    result.ok = IIf(result.errorCount = 0, 1, 0)
    Return result.ok
End Function

#endif
