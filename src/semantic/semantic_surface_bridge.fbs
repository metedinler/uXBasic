#ifndef UXB_SEMANTIC_SURFACE_BRIDGE_FBS
#define UXB_SEMANTIC_SURFACE_BRIDGE_FBS

#include once "../surface/uxb_surface_layer_bridge.fbs"

Function SemSurfaceDecision(ByRef surfaceText As String) As String
    Return UXBSurfaceLayerStatus(surfaceText, "SEMANTIC")
End Function

Function TypeBindingSurfaceDecision(ByRef surfaceText As String) As String
    Return UXBSurfaceLayerStatus(surfaceText, "TYPE_BINDING")
End Function

Function LayoutSurfaceDecision(ByRef surfaceText As String) As String
    Return UXBSurfaceLayerStatus(surfaceText, "LAYOUT")
End Function

Function MIRSurfaceDecision(ByRef surfaceText As String) As String
    Return UXBSurfaceLayerStatus(surfaceText, "MIR")
End Function

Function X64SurfaceDecision(ByRef surfaceText As String) As String
    Return UXBSurfaceLayerStatus(surfaceText, "X64_MIR")
End Function

Function SemSurfaceAllows(ByRef surfaceText As String, ByRef errText As String) As Integer
    Dim st As String = SemSurfaceDecision(surfaceText)
    Select Case st
    Case "IMPLEMENTED", "COMPILE_TIME_ONLY", "NOT_APPLICABLE", "RUNTIME_CALL", "NATIVE_ONLY", "JS_ONLY", "BROWSER_ONLY", "WASM_UNSUPPORTED", "WASM_ONLY"
        errText = ""
        Return 1
    End Select
    errText = "surface semantic bridge blocked: " & UCase(Trim(surfaceText)) & " status=" & st
    Return 0
End Function

#endif
