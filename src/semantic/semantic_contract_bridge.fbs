#ifndef UXB_SEMANTIC_CONTRACT_BRIDGE_FBS
#define UXB_SEMANTIC_CONTRACT_BRIDGE_FBS
#include once "semantic_registry.fbs"
#include once "semantic_surface_bridge.fbs"
Function SemStep3ContractAllowsNode(ByVal astNodeKind As String, ByRef errText As String) As Integer
    Dim st As String = SemStep3DecisionForNode(astNodeKind)
    Select Case st
    Case "IMPLEMENTED", "COMPILE_TIME_ONLY", "NOT_APPLICABLE", "RUNTIME_CALL", "NATIVE_ONLY", "JS_ONLY", "BROWSER_ONLY", "WASM_UNSUPPORTED", "WASM_ONLY"
        errText = "": Return 1
    Case "RESERVED", "REMOVED", "DIAGNOSTIC_ONLY"
        errText = "semantic contract blocked: " & astNodeKind & " status=" & st: Return 0
    End Select
    errText = "semantic contract missing: " & astNodeKind & " status=" & st
    Return 0
End Function
#endif
