#ifndef UXB_SEMANTIC_DIAGNOSTICS_FBS
#define UXB_SEMANTIC_DIAGNOSTICS_FBS
#include once "semantic_error_codes.fbs"
Type UXBSemanticDiagnostic
    code As String
    message As String
    astNode As Integer
    severity As String
End Type
Function UXBSemanticMakeDiagnostic(ByRef codeText As String, ByRef msgText As String, ByVal nodeIdx As Integer, ByRef sevText As String) As UXBSemanticDiagnostic
    Dim d As UXBSemanticDiagnostic
    d.code = codeText
    d.message = msgText
    d.astNode = nodeIdx
    d.severity = sevText
    Return d
End Function
Function UXBSemanticFail(ByRef codeText As String, ByRef msgText As String, ByRef errText As String) As Integer
    errText = codeText & ": " & msgText
    Return 0
End Function
#endif
