#ifndef UXB_MIR_VAR_INFO_FBS
#define UXB_MIR_VAR_INFO_FBS

#include once "../common/source_location.fbs"

Enum MIRStorageClass
    MIR_STORAGE_UNKNOWN = 0
    MIR_STORAGE_GLOBAL
    MIR_STORAGE_LOCAL
    MIR_STORAGE_PARAM
    MIR_STORAGE_TEMP
    MIR_STORAGE_FIELD
    MIR_STORAGE_STATIC
End Enum

Enum MIRAbiClass
    MIR_ABI_UNKNOWN = 0
    MIR_ABI_INT
    MIR_ABI_FLOAT
    MIR_ABI_PTR
    MIR_ABI_STRING
    MIR_ABI_AGGREGATE
End Enum

Type MIRTypeInfo
    typeName As String
    sizeBytes As Integer
    alignBytes As Integer
    abiClass As Integer
    isSigned As Integer
    isFloat As Integer
    isString As Integer
    isPointer As Integer
End Type

Type MIRVarInfo
    name As String
    rawName As String
    typeName As String
    typeInfo As MIRTypeInfo
    symbolIndex As Integer
    scopeId As Integer
    astNode As Integer
    storageClass As Integer
    isParam As Integer
    paramIdx As Integer
    isArray As Integer
    elementType As String
    elementCount As Integer
    source As SourceLocation
    flags As Integer
End Type

Function MIRStorageClassName(ByVal classValue As Integer) As String
    Select Case classValue
    Case MIR_STORAGE_GLOBAL: Return "GLOBAL"
    Case MIR_STORAGE_LOCAL: Return "LOCAL"
    Case MIR_STORAGE_PARAM: Return "PARAM"
    Case MIR_STORAGE_TEMP: Return "TEMP"
    Case MIR_STORAGE_FIELD: Return "FIELD"
    Case MIR_STORAGE_STATIC: Return "STATIC"
    End Select
    Return "UNKNOWN"
End Function

#endif
