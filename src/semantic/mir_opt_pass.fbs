#ifndef UXB_MIR_OPT_PASS_FBS
#define UXB_MIR_OPT_PASS_FBS

#include once "mir_opt_const_fold.fbs"
#include once "mir_opt_dead_block.fbs"

Type MIROptPassReport
    ok As Integer
    constFoldChanged As Integer
    constFoldCount As Integer
    deadBlockChanged As Integer
    deadBlockRemoved As Integer
    errorText As String
End Type

Dim Shared gMIROptLastReport As MIROptPassReport

Sub MIROptPassReportInit(ByRef r As MIROptPassReport)
    r.ok = 0
    r.constFoldChanged = 0
    r.constFoldCount = 0
    r.deadBlockChanged = 0
    r.deadBlockRemoved = 0
    r.errorText = ""
End Sub

Function MIRRunOptimizationPasses(ByRef module As MIRModule, ByRef errText As String) As Integer
    errText = ""
    MIROptPassReportInit gMIROptLastReport

    Dim cf As MIROptConstFoldResult
    If MIROptConstFoldModule(module, cf) = 0 Then
        errText = "MIR const-fold pass failed"
        gMIROptLastReport.errorText = errText
        Return 0
    End If
    gMIROptLastReport.constFoldChanged = cf.changed
    gMIROptLastReport.constFoldCount = cf.foldedCount

    Dim db As MIROptDeadBlockResult
    If MIROptDeadBlockModule(module, db) = 0 Then
        errText = "MIR dead-block pass failed"
        gMIROptLastReport.errorText = errText
        Return 0
    End If
    gMIROptLastReport.deadBlockChanged = db.changed
    gMIROptLastReport.deadBlockRemoved = db.removedCount

    gMIROptLastReport.ok = 1
    Return 1
End Function

Function MIROptLastReportToJson() As String
    Dim j As String
    j = "{" & Chr(34) & "ok" & Chr(34) & ":" & IIf(gMIROptLastReport.ok <> 0, "true", "false")
    j &= "," & Chr(34) & "const_fold_changed" & Chr(34) & ":" & LTrim(Str(gMIROptLastReport.constFoldChanged))
    j &= "," & Chr(34) & "const_fold_count" & Chr(34) & ":" & LTrim(Str(gMIROptLastReport.constFoldCount))
    j &= "," & Chr(34) & "dead_block_changed" & Chr(34) & ":" & LTrim(Str(gMIROptLastReport.deadBlockChanged))
    j &= "," & Chr(34) & "dead_block_removed" & Chr(34) & ":" & LTrim(Str(gMIROptLastReport.deadBlockRemoved))
    j &= "," & Chr(34) & "error" & Chr(34) & ":" & Chr(34) & gMIROptLastReport.errorText & Chr(34) & "}"
    Return j
End Function

#endif
