#ifndef UXB_SEMANTIC_STEP5_JSON_FBS
#define UXB_SEMANTIC_STEP5_JSON_FBS

#include once "semantic_step5_gate.fbs"
#include once "../common/report_writer.fbs"

Private Function UXBStep5ReplaceAll(ByVal srcText As String, ByVal findText As String, ByVal replText As String) As String
    If findText = "" Then Return srcText
    Dim outText As String
    outText = ""
    Dim startPos As Integer
    startPos = 1
    Do
        Dim hitPos As Integer
        hitPos = InStr(startPos, srcText, findText)
        If hitPos = 0 Then
            outText &= Mid(srcText, startPos)
            Exit Do
        End If
        outText &= Mid(srcText, startPos, hitPos - startPos)
        outText &= replText
        startPos = hitPos + Len(findText)
    Loop
    Return outText
End Function

Private Function UXBStep5JsonEsc(ByVal s As String) As String
    s = UXBStep5ReplaceAll(s, "\", "\\")
    s = UXBStep5ReplaceAll(s, Chr(34), "\" & Chr(34))
    s = UXBStep5ReplaceAll(s, Chr(13), "")
    s = UXBStep5ReplaceAll(s, Chr(10), "\n")
    Return s
End Function

Private Function UXBStep5Q() As String
    Return Chr(34)
End Function

Function UXBSemanticStep5ToJson(ByRef r As UXBSemanticStep5Result, ByRef g As UXBSemanticStep5GateResult) As String
    Dim q As String = UXBStep5Q()
    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & q & "ok" & q & ": " & IIf(g.ok <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & q & "symbol_count" & q & ": " & LTrim(Str(r.symbolCount)) & "," & Chr(10)
    j &= "  " & q & "scope_count" & q & ": " & LTrim(Str(r.scopeCount)) & "," & Chr(10)
    j &= "  " & q & "type_fact_count" & q & ": " & LTrim(Str(r.typeFactCount)) & "," & Chr(10)
    j &= "  " & q & "layout_fact_count" & q & ": " & LTrim(Str(r.layoutFactCount)) & "," & Chr(10)
    j &= "  " & q & "hir_fact_count" & q & ": " & LTrim(Str(r.hirFactCount)) & "," & Chr(10)
    j &= "  " & q & "missing_type_count" & q & ": " & LTrim(Str(g.missingTypeCount)) & "," & Chr(10)
    j &= "  " & q & "missing_hir_fact_count" & q & ": " & LTrim(Str(g.missingHIRFactCount)) & "," & Chr(10)
    j &= "  " & q & "errors" & q & ": " & q & UXBStep5JsonEsc(g.errorsText & r.errorsText) & q & Chr(10)
    j &= "}" & Chr(10)
    Return j
End Function

Function UXBStep5WriteTextFile(ByRef pathText As String, ByRef contentText As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(pathText) = "" Then Return 1
    Return UXBReportWriteText(pathText, contentText, errText)
End Function

Function UXBSemanticStep5WriteGateJson(ByRef r As UXBSemanticStep5Result, ByRef g As UXBSemanticStep5GateResult, ByRef outPath As String, ByRef errText As String) As Integer
    Dim txt As String = UXBSemanticStep5ToJson(r, g)
    Return UXBStep5WriteTextFile(outPath, txt, errText)
End Function

Function UXBSemanticStep5WriteGateMarkdown(ByRef r As UXBSemanticStep5Result, ByRef g As UXBSemanticStep5GateResult, ByRef outPath As String, ByRef errText As String) As Integer
    Dim txt As String
    txt = "# ADIM5 Semantic Type HIR Layout Gate" & Chr(10) & Chr(10)
    txt &= "status: " & IIf(g.ok <> 0, "PASS", "FAIL") & Chr(10)
    txt &= "symbol_count: " & LTrim(Str(r.symbolCount)) & Chr(10)
    txt &= "scope_count: " & LTrim(Str(r.scopeCount)) & Chr(10)
    txt &= "type_fact_count: " & LTrim(Str(r.typeFactCount)) & Chr(10)
    txt &= "layout_fact_count: " & LTrim(Str(r.layoutFactCount)) & Chr(10)
    txt &= "hir_fact_count: " & LTrim(Str(r.hirFactCount)) & Chr(10)
    txt &= "missing_type_count: " & LTrim(Str(g.missingTypeCount)) & Chr(10)
    txt &= Chr(10) & "## Errors" & Chr(10) & g.errorsText & r.errorsText & Chr(10)
    Return UXBStep5WriteTextFile(outPath, txt, errText)
End Function

Function UXBSemanticStep5WriteTypeCsv(ByRef r As UXBSemanticStep5Result, ByRef outPath As String, ByRef errText As String) As Integer
    Dim txt As String
    txt = "astNode,kind,name,typeName,typeStatus,symbolIndex,scopeId,diagnostic" & Chr(10)
    Dim i As Integer
    For i = 0 To r.typeTable.factCount - 1
        txt &= LTrim(Str(r.typeTable.facts(i).astNode)) & "," & r.typeTable.facts(i).kind & "," & r.typeTable.facts(i).name & "," & r.typeTable.facts(i).typeName & "," & r.typeTable.facts(i).typeStatus & "," & LTrim(Str(r.typeTable.facts(i).symbolIndex)) & "," & LTrim(Str(r.typeTable.facts(i).scopeId)) & "," & UXBStep5ReplaceAll(r.typeTable.facts(i).diagnostic, ",", ";") & Chr(10)
    Next i
    Return UXBStep5WriteTextFile(outPath, txt, errText)
End Function

Function UXBSemanticStep5WriteLayoutCsv(ByRef r As UXBSemanticStep5Result, ByRef outPath As String, ByRef errText As String) As Integer
    Dim txt As String
    txt = "astNode,layoutKind,name,typeName,sizeBytes,alignBytes,fieldCount,status,diagnostic" & Chr(10)
    Dim i As Integer
    For i = 0 To r.layoutSnapshot.factCount - 1
        txt &= LTrim(Str(r.layoutSnapshot.facts(i).astNode)) & "," & r.layoutSnapshot.facts(i).layoutKind & "," & r.layoutSnapshot.facts(i).name & "," & r.layoutSnapshot.facts(i).typeName & "," & LTrim(Str(r.layoutSnapshot.facts(i).sizeBytes)) & "," & LTrim(Str(r.layoutSnapshot.facts(i).alignBytes)) & "," & LTrim(Str(r.layoutSnapshot.facts(i).fieldCount)) & "," & r.layoutSnapshot.facts(i).status & "," & UXBStep5ReplaceAll(r.layoutSnapshot.facts(i).diagnostic, ",", ";") & Chr(10)
    Next i
    Return UXBStep5WriteTextFile(outPath, txt, errText)
End Function

#endif
