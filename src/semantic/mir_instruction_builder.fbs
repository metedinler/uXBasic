#ifndef UXB_MIR_INSTRUCTION_BUILDER_FBS
#define UXB_MIR_INSTRUCTION_BUILDER_FBS

#include once "mir_model.fbs"
#include once "mir_operand_role.fbs"
#include once "mir_opcode_signature.fbs"

Type MIRInstrBuilder
    opcode As String
    resultName As String
    resultType As String
    ops(0 To 15) As MIROperandInfo
    opCount As Integer
    srcLoc As SourceLocation
    astNode As Integer
    comment As String
    flags As Integer
    errorText As String
End Type

Sub MIRBuilderInit(ByRef b As MIRInstrBuilder, ByVal opcodeText As String, ByVal resultText As String = "", ByVal resultTypeText As String = "")
    b.opcode = UCase(Trim(opcodeText))
    b.resultName = resultText
    b.resultType = resultTypeText
    b.opCount = 0
    b.astNode = -1
    b.comment = ""
    b.flags = 0
    b.errorText = ""
    Dim i As Integer
    For i = 0 To 15
        b.ops(i) = MIROperandMake("", MIR_OPR_UNKNOWN, "", -1, -1)
    Next i
End Sub

Sub MIRBuilderSetSource(ByRef b As MIRInstrBuilder, ByRef srcLocation As SourceLocation)
    b.srcLoc = srcLocation
End Sub

Sub MIRBuilderSetAstNode(ByRef b As MIRInstrBuilder, ByVal astIdx As Integer)
    b.astNode = astIdx
End Sub

Function MIRBuilderAddOperand(ByRef b As MIRInstrBuilder, ByRef opInfo As MIROperandInfo) As Integer
    If b.opCount >= 16 Then
        b.errorText = "MIR builder: operand limit exceeded for " & b.opcode
        Return 0
    End If
    b.ops(b.opCount) = opInfo
    b.opCount += 1
    Return 1
End Function

Function MIRBuilderAddText(ByRef b As MIRInstrBuilder, ByVal textValue As String, ByVal roleValue As Integer = MIR_OPR_VALUE, ByVal typeText As String = "", ByVal symbolIdx As Integer = -1) As Integer
    Dim o As MIROperandInfo
    o = MIROperandMake(textValue, roleValue, typeText, symbolIdx, b.astNode)
    Return MIRBuilderAddOperand(b, o)
End Function

Function MIRBuilderValidate(ByRef b As MIRInstrBuilder, ByRef errText As String) As Integer
    errText = ""
    Dim sig As MIROpcodeSignature
    If MIROpcodeGetSignature(b.opcode, sig) = 0 Then
        errText = "MIR builder: unknown opcode signature: " & b.opcode
        Return 0
    End If
    If b.opCount < sig.minOps Or b.opCount > sig.maxOps Then
        errText = "MIR builder: opcode " & b.opcode & " operand count invalid. got=" & LTrim(Str(b.opCount)) & " expected=" & LTrim(Str(sig.minOps)) & ".." & LTrim(Str(sig.maxOps))
        Return 0
    End If
    If sig.resultRequired <> 0 And Trim(b.resultName) = "" Then
        errText = "MIR builder: opcode " & b.opcode & " requires result"
        Return 0
    End If
    Return 1
End Function

Function MIRBuilderToInstruction(ByRef b As MIRInstrBuilder, ByRef inst As MIRIRInstruction, ByRef errText As String) As Integer
    If MIRBuilderValidate(b, errText) = 0 Then Return 0
    inst.opcode = b.opcode
    inst.result = b.resultName
    inst.operandCount = b.opCount
    inst.srcLoc = b.srcLoc
    inst.comment = b.comment
    inst.flags = b.flags
    Dim i As Integer
    For i = 0 To 15
        inst.operands(i) = ""
    Next i
    For i = 0 To b.opCount - 1
        inst.operands(i) = b.ops(i).text
    Next i
    Return 1
End Function

#endif
