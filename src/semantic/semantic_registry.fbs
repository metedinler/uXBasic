#ifndef UXB_SEMANTIC_REGISTRY_FBS
#define UXB_SEMANTIC_REGISTRY_FBS
#include once "../parser/ast_contract_layer_bindings.fbs"
Function SemStep3HandlerForNode(ByRef astNodeKind As String) As String
    Return UXBAstContractSemanticHandlerForNode(astNodeKind)
End Function
Function SemStep3DecisionForNode(ByRef astNodeKind As String) As String
    Return UXBAstContractLayerStatusForNode(astNodeKind, "SEMANTIC")
End Function
#endif
