#ifndef UXB_MIR_RUNTIME_BRIDGE_FBS
#define UXB_MIR_RUNTIME_BRIDGE_FBS

#include once "mir_model.fbs"
#include once "../runtime/runtime_dispatch_strict.fbs"

Function UXBMIRRuntimeServiceFromInstruction(ByRef inst As MIRIRInstruction) As String
    Dim op As String = UCase(Trim(inst.opcode))
    If op = "CALL_RUNTIME" Or op = "MIR_CALL_RUNTIME" Or op = "RUNTIME_CALL" Then
        If inst.operandCount > 0 Then Return UCase(Trim(inst.operands(0)))
    End If
    If op = "PRINT" Or op = "MIR_PRINT" Then Return RT_PRINT
    If op = "INPUT" Or op = "MIR_INPUT" Then Return RT_INPUT
    If op = "CLS" Or op = "MIR_CLS" Then Return RT_CLS
    If op = "COLOR" Or op = "MIR_COLOR" Then Return RT_COLOR
    If op = "LOCATE" Or op = "MIR_LOCATE" Then Return RT_LOCATE
    If op = "RND" Or op = "MIR_RND" Then Return RT_RND
    If op = "TIMER" Or op = "MIR_TIMER" Then Return RT_TIMER
    Return ""
End Function

Function UXBMIRRuntimeBuildArgListFromInstruction( _
    ByRef inst As MIRIRInstruction, _
    ByVal firstArgIndex As Integer, _
    ByRef args As UXBRuntimeArgList _
) As Integer
    UXBRuntimeArgListInit args
    Dim i As Integer
    For i = firstArgIndex To inst.operandCount - 1
        Dim raw As String = Trim(inst.operands(i))
        Dim v As UXBInterpValue = UXBInterpValueFromLiteral(raw)
        If Left(raw, 1) = Chr(34) And Right(raw, 1) = Chr(34) And Len(raw) >= 2 Then
            v = UXBInterpValueString(Mid(raw, 2, Len(raw) - 2))
        End If
        UXBRuntimeArgListAdd args, v
    Next i
    Return 1
End Function

Function UXBMIRRuntimeDispatchInstruction( _
    ByRef rt As UXBRuntimeContext, _
    ByRef inst As MIRIRInstruction, _
    ByRef outValue As UXBInterpValue, _
    ByRef errText As String _
) As Integer
    errText = ""
    Dim sid As String = UXBMIRRuntimeServiceFromInstruction(inst)
    If sid = "" Then
        errText = "MIR runtime service route missing for opcode: " & inst.opcode
        outValue = UXBRuntimeSetError(rt, UXB_RT_ERR_SERVICE_NOT_FOUND, errText)
        Return 0
    End If

    Dim firstArg As Integer = 0
    If UCase(Trim(inst.opcode)) = "CALL_RUNTIME" Or UCase(Trim(inst.opcode)) = "MIR_CALL_RUNTIME" Or UCase(Trim(inst.opcode)) = "RUNTIME_CALL" Then firstArg = 1

    Dim args As UXBRuntimeArgList
    UXBMIRRuntimeBuildArgListFromInstruction inst, firstArg, args

    Dim dr As UXBRuntimeStrictDispatchResult
    If UXBRuntimeDispatchStrict(rt, sid, args, dr) = 0 Then
        errText = dr.errorText
        outValue = dr.value
        Return 0
    End If

    outValue = dr.value
    Return 1
End Function

#endif
