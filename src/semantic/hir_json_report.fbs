#ifndef UXB_HIR_JSON_REPORT_FBS
#define UXB_HIR_JSON_REPORT_FBS

#include once "hir_builder.fbs"

Private Function HIRJsonEsc(ByVal s As String) As String
    Dim outText As String
    outText = ""
    Dim i As Integer
    For i = 1 To Len(s)
        Dim ch As Integer
        ch = Asc(Mid(s, i, 1))
        Select Case ch
        Case 92
            outText &= "\\"
        Case 34
            outText &= "\" & Chr(34)
        Case 13
            ' skip CR
        Case 10
            outText &= "\n"
        Case 9
            outText &= "\t"
        Case Else
            If ch < 32 Then
                outText &= "?"
            Else
                outText &= Chr(ch)
            End If
        End Select
    Next i
    Return outText
End Function

Function HIRBridgeToJson(ByRef b As HIRBridge) As String
    Dim q As String = Chr(34)
    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & q & "ok" & q & ": " & IIf(b.ok <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & q & "scope_count" & q & ": " & LTrim(Str(b.scopeMap.scopeCount)) & "," & Chr(10)
    j &= "  " & q & "fact_count" & q & ": " & LTrim(Str(b.facts.factCount)) & "," & Chr(10)
    j &= "  " & q & "warnings" & q & ": " & LTrim(Str(b.warningCount)) & "," & Chr(10)
    j &= "  " & q & "errors" & q & ": " & LTrim(Str(b.errorCount)) & "," & Chr(10)
    j &= "  " & q & "diagnostic" & q & ": " & q & HIRJsonEsc(b.diagnosticText) & q & Chr(10)
    j &= "}" & Chr(10)
    Return j
End Function

Function HIRBridgeWriteJson(ByRef b As HIRBridge, ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then Return 1
    Dim f As Integer = FreeFile
    Open outPath For Output As #f
    If Err <> 0 Then errText = "hir bridge json open failed: " & outPath: Return 0
    Print #f, HIRBridgeToJson(b);
    Close #f
    Return 1
End Function

#endif
