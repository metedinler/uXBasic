#ifndef UXB_LIBRARY_MODULE_CONTRACT_FBS
#define UXB_LIBRARY_MODULE_CONTRACT_FBS

' UXBc external library module contract.
' This does not load libraries by itself; it gives compiler/IDE/tools a stable vocabulary.

Type UXBLibraryModuleInfo
    moduleName As String
    sourceDir As String
    headerPath As String
    runtimeDir As String
    testsDir As String
    docsDir As String
    buildScript As String
    smokeScript As String
    externalDeps As String
    status As String
End Type

Sub UXBLibraryModuleInfoInit(ByRef m As UXBLibraryModuleInfo)
    m.moduleName = ""
    m.sourceDir = ""
    m.headerPath = ""
    m.runtimeDir = ""
    m.testsDir = ""
    m.docsDir = ""
    m.buildScript = ""
    m.smokeScript = ""
    m.externalDeps = ""
    m.status = "unknown"
End Sub

Function UXBLibraryModuleStatusName(ByRef statusText As String) As String
    Dim As String s
    s = LCase(Trim(statusText))
    Select Case s
    Case "installed", "ok"
        Return "installed"
    Case "runtime_pending"
        Return "runtime_pending"
    Case "toolchain_or_dep_missing"
        Return "toolchain_or_dep_missing"
    Case "diagnostic"
        Return "diagnostic"
    Case Else
        Return "unknown"
    End Select
End Function

#endif
