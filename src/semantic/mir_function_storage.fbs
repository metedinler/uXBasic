#ifndef UXB_MIR_FUNCTION_STORAGE_FBS
#define UXB_MIR_FUNCTION_STORAGE_FBS

#include once "mir_model.fbs"
#include once "mir_var_info.fbs"
#include once "mir_type_layout_bridge.fbs"

Private Function MIRNormalizeVarName2(ByVal nameText As String) As String
    Return UCase(Trim(nameText))
End Function

Private Sub MIRFunctionEnsureLocalInfo(ByRef fn As MIRFunction, ByVal needCount As Integer)
    If needCount <= 0 Then Exit Sub
    If fn.localVarCount = 0 Then ReDim fn.localVars(7): ReDim fn.localVarTypes(7)
    If UBound(fn.localVars) + 1 >= needCount Then Exit Sub
    Dim cap As Integer = UBound(fn.localVars) + 1
    Do While cap < needCount
        cap *= 2
    Loop
    ReDim Preserve fn.localVars(cap - 1)
    ReDim Preserve fn.localVarTypes(cap - 1)
End Sub

Private Sub MIRFunctionEnsureParamInfo(ByRef fn As MIRFunction, ByVal needCount As Integer)
    If needCount <= 0 Then Exit Sub
    If fn.paramVarCount = 0 Then ReDim fn.paramVars(7): ReDim fn.paramVarTypes(7)
    If UBound(fn.paramVars) + 1 >= needCount Then Exit Sub
    Dim cap As Integer = UBound(fn.paramVars) + 1
    Do While cap < needCount
        cap *= 2
    Loop
    ReDim Preserve fn.paramVars(cap - 1)
    ReDim Preserve fn.paramVarTypes(cap - 1)
End Sub

Function MIRFunctionFindLocalInfo(ByRef fn As MIRFunction, ByVal nameText As String) As Integer
    Dim key As String = MIRNormalizeVarName2(nameText)
    Dim i As Integer
    For i = 0 To fn.localVarCount - 1
        If MIRNormalizeVarName2(fn.localVars(i)) = key Then Return i
    Next i
    Return -1
End Function

Function MIRFunctionFindParamInfo(ByRef fn As MIRFunction, ByVal nameText As String) As Integer
    Dim key As String = MIRNormalizeVarName2(nameText)
    Dim i As Integer
    For i = 0 To fn.paramVarCount - 1
        If MIRNormalizeVarName2(fn.paramVars(i)) = key Then Return i
    Next i
    Return -1
End Function

Function MIRFunctionAddLocalInfo(ByRef fn As MIRFunction, ByRef vi As MIRVarInfo) As Integer
    Dim key As String = MIRNormalizeVarName2(vi.name)
    If key = "" Then Return -1
    Dim existing As Integer = MIRFunctionFindLocalInfo(fn, key)
    If existing <> -1 Then Return existing
    MIRFunctionEnsureLocalInfo fn, fn.localVarCount + 1
    Dim idx As Integer = fn.localVarCount
    fn.localVarCount += 1
    fn.localVars(idx) = key
    fn.localVarTypes(idx) = UCase(Trim(vi.typeName))
    Return idx
End Function

Function MIRFunctionAddParamInfo(ByRef fn As MIRFunction, ByRef vi As MIRVarInfo) As Integer
    Dim key As String = MIRNormalizeVarName2(vi.name)
    If key = "" Then Return -1
    Dim existing As Integer = MIRFunctionFindParamInfo(fn, key)
    If existing <> -1 Then Return existing
    MIRFunctionEnsureParamInfo fn, fn.paramVarCount + 1
    Dim idx As Integer = fn.paramVarCount
    fn.paramVarCount += 1
    fn.paramVars(idx) = key
    fn.paramVarTypes(idx) = UCase(Trim(vi.typeName))
    Return idx
End Function

#endif
