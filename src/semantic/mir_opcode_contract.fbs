#ifndef UXB_MIR_OPCODE_CONTRACT_FBS
#define UXB_MIR_OPCODE_CONTRACT_FBS

#include once "../mir/mir_registry.fbs"

Const UXB_MIR_OP_UNKNOWN = 0
Const UXB_MIR_OP_VALUE = 1
Const UXB_MIR_OP_MEMORY = 2
Const UXB_MIR_OP_FLOW = 3
Const UXB_MIR_OP_CALL = 4
Const UXB_MIR_OP_TYPE = 5
Const UXB_MIR_OP_FP = 6
Const UXB_MIR_OP_EXTFP = 7
Const UXB_MIR_OP_RUNTIME = 8
Const UXB_MIR_OP_DIAGNOSTIC = 9

Function UXBMIRNormalizeOpcode(ByRef opcodeText As String) As String
    Return UXBMIRStep4NormalizeOpcode(opcodeText)
End Function

Function UXBMIROpCategory(ByRef opcodeText As String) As Integer
    Dim g As String
    g = UXBMIRStep4OpcodeGroup(opcodeText)
    Select Case g
    Case "MIR_ARITH", "MIR_EXPR", "MIR_STORAGE"
        Return UXB_MIR_OP_VALUE
    Case "MIR_MEMORY", "MIR_OBJECT"
        Return UXB_MIR_OP_MEMORY
    Case "MIR_CONTROL"
        Return UXB_MIR_OP_FLOW
    Case "MIR_CALL"
        Return UXB_MIR_OP_CALL
    Case "MIR_STRING"
        Return UXB_MIR_OP_TYPE
    Case "MIR_RUNTIME", "MIR_FILE"
        Return UXB_MIR_OP_RUNTIME
    Case "MIR_TARGET"
        Return UXB_MIR_OP_EXTFP
    Case "MIR_FAIL_CLOSED"
        Return UXB_MIR_OP_DIAGNOSTIC
    End Select
    Return UXB_MIR_OP_UNKNOWN
End Function

Function UXBMIROpCategoryName(ByVal categoryId As Integer) As String
    Select Case categoryId
    Case UXB_MIR_OP_VALUE: Return "value"
    Case UXB_MIR_OP_MEMORY: Return "memory"
    Case UXB_MIR_OP_FLOW: Return "flow"
    Case UXB_MIR_OP_CALL: Return "call"
    Case UXB_MIR_OP_TYPE: Return "type_object"
    Case UXB_MIR_OP_FP: Return "native_fp"
    Case UXB_MIR_OP_EXTFP: Return "target_bridge"
    Case UXB_MIR_OP_RUNTIME: Return "runtime"
    Case UXB_MIR_OP_DIAGNOSTIC: Return "diagnostic"
    End Select
    Return "invalid"
End Function

Function UXBMIRKnownOpcode(ByRef opcodeText As String) As Integer
    Return UXBMIRStep4OpcodeKnown(opcodeText)
End Function

Function UXBMIRRequiresRuntimeCall(ByRef opcodeText As String) As Integer
    Return UXBMIRStep4OpcodeRequiresRuntime(opcodeText)
End Function

Function UXBMIRRequiresAddressableStorage(ByRef opcodeText As String) As Integer
    Return UXBMIRStep4OpcodeRequiresLayout(opcodeText)
End Function

Function UXBMIRCanBePureScalar(ByRef opcodeText As String) As Integer
    Dim rule As String
    rule = UXBMIRStep4VerifyRuleForOpcode(opcodeText)
    Select Case rule
    Case "verify_arith", "verify_expr"
        Return 1
    End Select
    Return 0
End Function

Function UXBMIRVerifyRuleName(ByRef opcodeText As String) As String
    Return UXBMIRStep4VerifyRuleForOpcode(opcodeText)
End Function

#endif
