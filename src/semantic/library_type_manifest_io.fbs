#ifndef UXB_LIBRARY_TYPE_MANIFEST_IO_FBS
#define UXB_LIBRARY_TYPE_MANIFEST_IO_FBS

#include once "library_type_contract.fbs"

Private Function UXBLibraryTypePathDir(ByVal pathText As String) As String
    For i As Integer = Len(pathText) To 1 Step -1
        If Mid(pathText, i, 1) = "\" Or Mid(pathText, i, 1) = "/" Then Return Left(pathText, i - 1)
    Next i
    Return ""
End Function

Private Function UXBLibraryTypePathJoin(ByVal directory As String, ByVal relativePath As String) As String
    If directory = "" Then Return relativePath
    If Right(directory, 1) = "\" Or Right(directory, 1) = "/" Then Return directory & relativePath
    Return directory & "\" & relativePath
End Function

Function UXBLibraryTypeResolveManifestPath(ByVal manifestPath As String, ByVal sourceFilePath As String) As String
    Dim p As String = Trim(manifestPath)
    If p = "" Then Return p
    If Dir(p) <> "" Then Return p
    Dim sourceDir As String = UXBLibraryTypePathDir(Trim(sourceFilePath))
    Dim candidate As String
    If sourceDir <> "" Then
        candidate = UXBLibraryTypePathJoin(sourceDir, p)
        If Dir(candidate) <> "" Then Return candidate
    End If
    Dim roots(0 To 3) As String = {"manifests\library_types", "manifests", "libs", "include\modules"}
    For i As Integer = 0 To 3
        candidate = UXBLibraryTypePathJoin(roots(i), p)
        If Dir(candidate) <> "" Then Return candidate
    Next i
    If sourceDir <> "" Then Return UXBLibraryTypePathJoin(sourceDir, p)
    Return p
End Function

Function UXBLibraryTypeReadManifestForSource(ByVal manifestPath As String, ByVal sourceFilePath As String, ByRef c As UXBLibraryTypeContract, ByRef errText As String) As Integer
    Dim resolved As String = UXBLibraryTypeResolveManifestPath(manifestPath, sourceFilePath)
    Dim jsonText As String
    If UXBLibraryTypeReadAllText(resolved, jsonText, errText) = 0 Then Return 0
    Return UXBLibraryTypeContractFromJson(jsonText, c, errText)
End Function

#endif
