#ifndef UXB_MIR_OPERAND_ROLE_FBS
#define UXB_MIR_OPERAND_ROLE_FBS

Enum MIROperandRole
    MIR_OPR_UNKNOWN = 0
    MIR_OPR_VALUE
    MIR_OPR_CONST
    MIR_OPR_VAR
    MIR_OPR_TEMP
    MIR_OPR_LABEL
    MIR_OPR_TARGET
    MIR_OPR_SOURCE
    MIR_OPR_CONDITION
    MIR_OPR_FUNCTION
    MIR_OPR_RUNTIME_SERVICE
    MIR_OPR_DLL_NAME
    MIR_OPR_API_NAME
    MIR_OPR_ABI
    MIR_OPR_SIGNATURE
    MIR_OPR_TYPE_NAME
    MIR_OPR_FIELD_NAME
    MIR_OPR_INDEX
    MIR_OPR_ARRAY_NAME
    MIR_OPR_OBJECT_NAME
    MIR_OPR_MEMORY_REF
End Enum

Type MIROperandInfo
    text As String
    role As Integer
    typeName As String
    symbolIndex As Integer
    astNode As Integer
End Type

Function MIROperandMake(ByVal textValue As String, ByVal roleValue As Integer = MIR_OPR_VALUE, ByVal typeText As String = "", ByVal symbolIdx As Integer = -1, ByVal astIdx As Integer = -1) As MIROperandInfo
    Dim o As MIROperandInfo
    o.text = textValue
    o.role = roleValue
    o.typeName = typeText
    o.symbolIndex = symbolIdx
    o.astNode = astIdx
    Return o
End Function

#endif
