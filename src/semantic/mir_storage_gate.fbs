#ifndef UXB_MIR_STORAGE_GATE_FBS
#define UXB_MIR_STORAGE_GATE_FBS

#include once "mir_model.fbs"

Type MIRStorageGateResult
    ok As Integer
    functionCount As Integer
    checkedGlobalCount As Integer
    checkedLocalCount As Integer
    checkedParamCount As Integer
    missingLocalInfo As Integer
    missingParamInfo As Integer
    missingTypeCount As Integer
    errorText As String
End Type

Sub MIRStorageGateInit(ByRef r As MIRStorageGateResult)
    r.ok = 0
    r.functionCount = 0
    r.checkedGlobalCount = 0
    r.checkedLocalCount = 0
    r.checkedParamCount = 0
    r.missingLocalInfo = 0
    r.missingParamInfo = 0
    r.missingTypeCount = 0
    r.errorText = ""
End Sub

Private Function MIRStorageGateHasLocalName(ByRef fn As MIRFunction, ByVal nameText As String) As Integer
    Dim key As String = UCase(Trim(nameText))
    Dim i As Integer
    For i = 0 To fn.localVarCount - 1
        If UCase(Trim(fn.localVars(i))) = key Then Return 1
    Next i
    Return 0
End Function

Private Function MIRStorageGateHasParamName(ByRef fn As MIRFunction, ByVal nameText As String) As Integer
    Dim key As String = UCase(Trim(nameText))
    Dim i As Integer
    For i = 0 To fn.paramVarCount - 1
        If UCase(Trim(fn.paramVars(i))) = key Then Return 1
    Next i
    Return 0
End Function

Function MIRStorageGateCheckFunction(ByRef fn As MIRFunction, ByRef r As MIRStorageGateResult) As Integer
    r.functionCount += 1
    Dim i As Integer
    For i = 0 To fn.localVarCount - 1
        r.checkedLocalCount += 1
        If MIRStorageGateHasLocalName(fn, fn.localVars(i)) = 0 Then
            r.missingLocalInfo += 1
            r.errorText &= "local missing typed info: " & fn.name & "." & fn.localVars(i) & Chr(10)
        End If
        If i > UBound(fn.localVarTypes) Then
            r.missingTypeCount += 1
            r.errorText &= "local missing type: " & fn.name & "." & fn.localVars(i) & Chr(10)
        ElseIf Trim(fn.localVarTypes(i)) = "" Then
            r.missingTypeCount += 1
            r.errorText &= "local missing type: " & fn.name & "." & fn.localVars(i) & Chr(10)
        End If
    Next i
    For i = 0 To fn.paramVarCount - 1
        r.checkedParamCount += 1
        If MIRStorageGateHasParamName(fn, fn.paramVars(i)) = 0 Then
            r.missingParamInfo += 1
            r.errorText &= "param missing typed info: " & fn.name & "." & fn.paramVars(i) & Chr(10)
        End If
        If i > UBound(fn.paramVarTypes) Then
            r.missingTypeCount += 1
            r.errorText &= "param missing type: " & fn.name & "." & fn.paramVars(i) & Chr(10)
        ElseIf Trim(fn.paramVarTypes(i)) = "" Then
            r.missingTypeCount += 1
            r.errorText &= "param missing type: " & fn.name & "." & fn.paramVars(i) & Chr(10)
        End If
    Next i
    Return 1
End Function

Function MIRStorageGateCheckModule(ByRef m As MIRModule, ByRef r As MIRStorageGateResult) As Integer
    MIRStorageGateInit r
    Dim i As Integer
    For i = 0 To m.globalVarCount - 1
        r.checkedGlobalCount += 1
        If i > UBound(m.globalVarTypes) Then
            r.missingTypeCount += 1
            r.errorText &= "global missing type: " & m.globalVars(i) & Chr(10)
        ElseIf Trim(m.globalVarTypes(i)) = "" Then
            r.missingTypeCount += 1
            r.errorText &= "global missing type: " & m.globalVars(i) & Chr(10)
        End If
    Next i
    For i = 0 To m.functionCount - 1
        MIRStorageGateCheckFunction m.functions(i), r
    Next i
    If r.missingLocalInfo = 0 And r.missingParamInfo = 0 And r.missingTypeCount = 0 Then
        r.ok = 1
        Return 1
    End If
    r.ok = 0
    Return 0
End Function

#endif
