#ifndef UXB_HIR_AST_BRIDGE_FBS
#define UXB_HIR_AST_BRIDGE_FBS

Function HIRAstKind(ByRef ps As ParseState, ByVal nodeIdx As Integer) As String
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return ""
    Return UCase(Trim(ps.ast.nodes(nodeIdx).kind))
End Function

Function HIRAstIsBinaryLike(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim k As String = HIRAstKind(ps, nodeIdx)
    If k = "BINARY" Or k = "BINARY_EXPR" Then Return 1
    Return 0
End Function

Function HIRAstIsUnaryLike(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim k As String = HIRAstKind(ps, nodeIdx)
    If k = "UNARY" Or k = "UNARY_EXPR" Then Return 1
    Return 0
End Function

Function HIRAstChildAt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByVal childPos As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return -1

    If HIRAstIsBinaryLike(ps, nodeIdx) <> 0 Then
        If childPos = 0 Then Return ps.ast.nodes(nodeIdx).left
        If childPos = 1 Then Return ps.ast.nodes(nodeIdx).right
        Return -1
    End If

    If HIRAstIsUnaryLike(ps, nodeIdx) <> 0 Then
        If childPos = 0 Then
            If ps.ast.nodes(nodeIdx).left <> -1 Then Return ps.ast.nodes(nodeIdx).left
            Return ps.ast.nodes(nodeIdx).right
        End If
        Return -1
    End If

    Dim i As Integer = 0
    Dim ch As Integer = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        If i = childPos Then Return ch
        i += 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return -1
End Function

Function HIRAstChildCount(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim cnt As Integer = 0
    Do While HIRAstChildAt(ps, nodeIdx, cnt) <> -1
        cnt += 1
    Loop
    Return cnt
End Function

Function HIRAstFindChildByKind(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef kindText As String) As Integer
    Dim want As String = UCase(Trim(kindText))
    Dim i As Integer
    For i = 0 To HIRAstChildCount(ps, nodeIdx) - 1
        Dim ch As Integer = HIRAstChildAt(ps, nodeIdx, i)
        If ch <> -1 Then If HIRAstKind(ps, ch) = want Then Return ch
    Next i
    Return -1
End Function

Function HIRAstNodeValueOrSymbol(ByRef ps As ParseState, ByVal nodeIdx As Integer) As String
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return ""
    If Trim(ps.ast.nodes(nodeIdx).symbolName) <> "" Then Return UCase(Trim(ps.ast.nodes(nodeIdx).symbolName))
    Return UCase(Trim(ps.ast.nodes(nodeIdx).value))
End Function

#endif
