#ifndef UXB_SEMANTIC_CONTEXT_FBS
#define UXB_SEMANTIC_CONTEXT_FBS
Type UXBSemanticContext
    targetName As String
    currentModule As String
    currentClass As String
    currentRoutine As String
    currentScope As Integer
    errorCount As Integer
End Type
Sub UXBSemanticContextInit(ByRef ctx As UXBSemanticContext, ByRef targetText As String)
    ctx.targetName = UCase(Trim(targetText))
    If ctx.targetName = "" Then ctx.targetName = "X64"
    ctx.currentModule = ""
    ctx.currentClass = ""
    ctx.currentRoutine = ""
    ctx.currentScope = 0
    ctx.errorCount = 0
End Sub
#endif
