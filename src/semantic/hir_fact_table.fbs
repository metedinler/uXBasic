#ifndef UXB_HIR_FACT_TABLE_FBS
#define UXB_HIR_FACT_TABLE_FBS

#include once "../common/source_location.fbs"

Type HIRAstFact
    astNode As Integer
    astKind As String
    hirScopeId As Integer
    symbolIndex As Integer
    symbolName As String
    symbolKind As String
    typeName As String
    storageClass As String
    layoutKnown As Integer
    layoutKind As String
    sizeBytes As Integer
    alignBytes As Integer
    targetMask As Integer
    source As SourceLocation
    isRuntimeNode As Integer
    isCompileTimeNode As Integer
    isLowerableToMir As Integer
    status As String
    diagnostic As String
End Type

Type HIRFactTable
    facts(Any) As HIRAstFact
    factCount As Integer
End Type

Sub HIRFactTableInit(ByRef ft As HIRFactTable, ByVal astCount As Integer)
    ft.factCount = astCount
    If astCount > 0 Then ReDim ft.facts(astCount - 1)
    Dim i As Integer
    For i = 0 To astCount - 1
        ft.facts(i).astNode = i
        ft.facts(i).hirScopeId = 0
        ft.facts(i).symbolIndex = -1
        ft.facts(i).layoutKnown = 0
        ft.facts(i).targetMask = 0
        ft.facts(i).status = "UNRESOLVED"
        ft.facts(i).diagnostic = ""
    Next i
End Sub

Function HIRFactForNode(ByRef ft As HIRFactTable, ByVal nodeIdx As Integer) As HIRAstFact Ptr
    If nodeIdx < 0 Or nodeIdx >= ft.factCount Then Return 0
    Return @ft.facts(nodeIdx)
End Function

Function HIRInferStorageClass(ByRef astKind As String) As String
    Dim k As String = UCase(Trim(astKind))
    Select Case k
    Case "PARAM_DECL": Return "PARAM"
    Case "TYPE_FIELD": Return "TYPE_FIELD"
    Case "CLASS_FIELD", "CLASS_PROPERTY_DECL": Return "CLASS_FIELD"
    Case "CONST_DECL", "CONST_STMT": Return "CONST"
    Case "DIM_DECL", "DIM_STMT", "REDIM_DECL", "REDIM_STMT": Return "LOCAL_OR_GLOBAL"
    End Select
    Return ""
End Function

Sub HIRFactSetSourceFromAst(ByRef fact As HIRAstFact, ByRef n As ASTNode)
    fact.source = UXBSourceLocationMake(n.sourceFile, n.lineNo, n.colNo, n.sourceLength, n.lexemeSnippet)
End Sub

#endif
