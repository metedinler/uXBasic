#ifndef UXB_JS_CODEGEN_STEP6_FBS
#define UXB_JS_CODEGEN_STEP6_FBS

#include once "../../semantic/mir_model.fbs"
#include once "../../backend/common/backend_context.fbs"
#include once "../../backend/common/backend_result.fbs"
#include once "../../backend/common/backend_json_report.fbs"
#include once "js_expr_emit.fbs"
#include once "js_mir_runtime_emit.fbs"
#include once "js_wasm_bridge_emit.fbs"
#include once "js_stmt_emit.fbs"
#include once "js_emitter.fbs"
#include once "js_codegen_registry.fbs"
#include once "runtime/js_runtime_writer.fbs"

Function UXBJsBackendEmitModule(ByRef m As MIRModule, ByRef ctx As UXBBackendContext, ByRef result As UXBBackendResult) As Integer
    Dim errText As String
    result = UXBBackendResultMake(UXB_TARGET_JS)
    If UXBBackendContextReadyForEmit(ctx, errText) = 0 Then
        If ctx.verifyPassed = 0 Then
            result.status = UXB_BACKEND_STATUS_BLOCKED_VERIFY
            result.code = UXB_BACKEND_E_VERIFY_BLOCK
        Else
            result.status = UXB_BACKEND_STATUS_BLOCKED_INTERP
            result.code = UXB_BACKEND_E_INTERP_BLOCK
        End If
        result.errorText = errText
        Return 0
    End If
    ' A JS-only target must not import a WASM module merely because the output
    ' contract assigned a default WAT path.
    Dim noWasmManifest As String
    noWasmManifest = ""
    If UXBJsEmitFromMIR(m, ctx.sourcePath, ctx.jsOutPath, noWasmManifest, errText) = 0 Then
        UXBBackendResultFail result, UXB_BACKEND_E_EMIT, errText
        Return 0
    End If
    If UXBJsRuntimeWrite(ctx.jsRuntimeOutPath, errText) = 0 Then
        UXBBackendResultFail result, UXB_BACKEND_E_EMIT, errText
        Return 0
    End If
    UXBBackendResultPass result, ctx.jsOutPath, "JavaScript emitted"
    Return 1
End Function

#endif
