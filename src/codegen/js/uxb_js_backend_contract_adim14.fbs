#ifndef UXB_JS_BACKEND_CONTRACT_ADIM14_FBS
#define UXB_JS_BACKEND_CONTRACT_ADIM14_FBS

' Adım14 JS backend sözleşmesi.
' Bu dosya emitter üretmez; opcode/support kararlarını tek yerde toplar.

Const UXB_ADIM14_JS_OK As Integer = 1
Const UXB_ADIM14_JS_FAIL As Integer = 0

Type UXBAdim14BackendDiag
    ok As Integer
    errorCode As String
    message As String
    filePath As String
    layerName As String
End Type

Sub UXBAdim14DiagInit(ByRef d As UXBAdim14BackendDiag)
    d.ok = 1
    d.errorCode = ""
    d.message = ""
    d.filePath = ""
    d.layerName = "backend_web"
End Sub

Private Function UXBAdim14Upper(ByRef s As String) As String
    Return UCase(Trim(s))
End Function

Function UXBAdim14JsOpcodeSupported(ByRef opcodeText As String) As Integer
    Dim op As String
    op = UXBAdim14Upper(opcodeText)

    Select Case op
    Case "", "NOP", "LABEL", "COMMENT"
        Return 1
    Case "CONST", "LOAD_CONST", "LOAD_VAR", "STORE_VAR", "MOVE", "MOV"
        Return 1
    Case "ADD", "SUB", "MUL", "DIV", "MOD"
        Return 1
    Case "EQ", "NE", "LT", "LE", "GT", "GE", "ULT", "ULE", "UGT", "UGE", "AND", "OR", "NOT"
        Return 1
    Case "PRINT", "CALL_RUNTIME", "CALL_HOST", "RET", "RETURN", "MEMORY_REF", "ARRAY_SIZEOF", "ARRAY_LBOUND", "ARRAY_UBOUND"
        Return 1
    Case "JMP", "JZ", "JNZ", "BR", "BR_IF"
        Return 1
    Case Else
        Return 0
    End Select
End Function

Function UXBAdim14JsTypeName(ByRef typeText As String) As String
    Dim t As String
    t = UXBAdim14Upper(typeText)

    Select Case t
    Case "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64"
        Return "number"
    Case "F32", "F64", "F80", "F128", "BIGF", "BIGD", "BALL"
        Return "number"
    Case "BOOLEAN", "BOOL"
        Return "boolean"
    Case "STRING", "STR", "ZSTRING", "WSTRING"
        Return "string"
    Case "PTR", "STRPTR", "WSTRPTR", "ANY PTR"
        Return "number"
    Case Else
        Return "unknown"
    End Select
End Function

Function UXBAdim14JsValidateOutputPath(ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then
        errText = "JS output path is empty"
        Return 0
    End If
    Return 1
End Function

#endif
