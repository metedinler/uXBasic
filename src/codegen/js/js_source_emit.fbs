#ifndef UXB_JS_SOURCE_EMIT_FBS
#define UXB_JS_SOURCE_EMIT_FBS

' ADIM24 / ADIM23 continuation
' Purpose:
'   Keep JS source comments compatible with the current MIRIRInstruction model.
'   Current MIRIRInstruction does NOT have sourceFile/sourceLine/sourceColumn/sourceAstKind fields.
'   It has srcLoc As SourceLocation, comment As String, flags As Integer.
'
' Rule:
'   Do not add fake fields to MIRIRInstruction just to satisfy JS emitter.
'   Read source info through MIRGetSourceLine(), MIRInstructionHasSource(), and ins.srcLoc.

#include once "../../semantic/mir_model.fbs"

Function UXBJsSourceCommentEscape(ByRef rawText As String) As String
    Dim outText As String
    Dim i As Integer
    Dim ch As String

    outText = ""
    For i = 1 To Len(rawText)
        ch = Mid(rawText, i, 1)
        Select Case ch
        Case Chr(13), Chr(10), Chr(9)
            outText &= " "
        Case Chr(92)
            outText &= "\\"
        Case Else
            outText &= ch
        End Select
    Next i

    Return outText
End Function

Function UXBJsInstructionSourceComment(ByRef ins As MIRIRInstruction) As String
    Dim commentText As String
    Dim lineText As String

    commentText = ""
    lineText = MIRGetSourceLine(ins)

    If Trim(lineText) <> "" Then commentText &= Trim(lineText)

    If Trim(ins.comment) <> "" Then
        If commentText <> "" Then commentText &= " "
        commentText &= Trim(ins.comment)
    End If

    If Trim(ins.srcLoc.lexemeSnippet) <> "" Then
        If commentText <> "" Then commentText &= " "
        commentText &= "[" & Trim(ins.srcLoc.lexemeSnippet) & "]"
    End If

    If commentText = "" Then Return ""
    Return "      // src " & UXBJsSourceCommentEscape(commentText) & Chr(10)
End Function

Function UXBJsBlockSourceComment(ByRef blk As MIRBasicBlock) As String
    Dim i As Integer
    Dim lineText As String

    For i = 0 To blk.instructionCount - 1
        If MIRInstructionHasSource(blk.instructions(i)) <> 0 Then
            lineText = MIRGetSourceLine(blk.instructions(i))
            If Trim(lineText) <> "" Then
                Return "    // block " & Trim(Str(blk.id)) & " first-src " & UXBJsSourceCommentEscape(lineText) & Chr(10)
            End If
        End If
    Next i

    Return ""
End Function

#endif
