#ifndef UXB_JS_RUNTIME_HOST_BRIDGE_FBS
#define UXB_JS_RUNTIME_HOST_BRIDGE_FBS

#include once "../js_expr_emit.fbs"

Function UXBJsHostBridgeCallExpr(ByVal callName As String, ByVal argsText As String) As String
    Return "await ux.callHost(" & UXBJsQuote(callName) & ", [" & argsText & "])"
End Function

#endif
