#ifndef UXB_JS_RUNTIME_SERVICES_FBS
#define UXB_JS_RUNTIME_SERVICES_FBS

Function UXBJsRuntimeServiceName(ByVal serviceName As String) As String
    Dim s As String
    s = UCase(Trim(serviceName))
    Select Case s
    Case "PRINT", "RT_PRINT": Return "ux.print"
    Case "INPUT", "RT_INPUT": Return "ux.input"
    Case "CLS", "RT_CLS": Return "ux.cls"
    Case "COLOR", "RT_COLOR": Return "ux.color"
    Case "LOCATE", "RT_LOCATE": Return "ux.locate"
    Case "RND", "RT_RND": Return "ux.rnd"
    Case "RANDOMIZE", "RT_RANDOMIZE": Return "ux.randomize"
    Case "TIMER", "RT_TIMER": Return "ux.builtin"
    Case "ABS", "SQR", "SQRT", "SIN", "COS", "TAN", "ATN", "LOG", "EXP", "FIX", "INT", "SGN", "CINT", "CLNG", "CSNG", "CDBL"
        Return "ux.builtin"
    Case "LEN", "LEFT", "RIGHT", "MID", "INSTR", "ASC", "CHR", "VAL", "STR", "LCASE", "UCASE", "LTRIM", "RTRIM", "TRIM", "SPACE", "HEX", "OCT", "BIN"
        Return "ux.builtin"
    Case "ARRAY_NEW": Return "ux.arrayNew"
    Case "ARRAY_LOAD": Return "ux.arrayLoad"
    Case "ARRAY_STORE": Return "ux.arrayStore"
    Case "MEMORY_REF_ARRAY": Return "ux.memoryRefArray"
    Case "MEMORY_LOAD": Return "ux.memoryLoad"
    Case "MEMORY_STORE": Return "ux.memoryStore"
    Case "MEMORY_COPY": Return "ux.memoryCopy"
    Case "MEMORY_FILL": Return "ux.memoryFill"
    Case "MEMORY_READ_SEQUENCE": Return "ux.memoryReadSequence"
    Case "MEMORY_WRITE_SEQUENCE": Return "ux.memoryWriteSequence"
    Case "OBJECT_NEW": Return "ux.objectNew"
    Case "FIELD_LOAD": Return "ux.fieldLoad"
    Case "FIELD_STORE": Return "ux.fieldStore"
    End Select
    Return "ux.callHost"
End Function

#endif
