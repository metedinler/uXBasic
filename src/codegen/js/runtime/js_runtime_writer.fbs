#ifndef UXB_JS_RUNTIME_WRITER_FBS
#define UXB_JS_RUNTIME_WRITER_FBS

#include once "js_runtime_embedded_generated.fbs"

Function UXBJsRuntimeText() As String
    ' UXJSRT_GLOBALTHIS_UXB_CONTRACT_V1_20260726
    ' The generated runtime is sourced from runtime/js/common/ux_runtime_core.js.
    Return UXBJsEmbeddedRuntimeText()
End Function

Private Sub UXBJsRuntimeEnsureParentDir(ByVal filePath As String)
    Dim i As Integer
    For i = Len(filePath) To 1 Step -1
        Dim ch As String
        ch = Mid(filePath, i, 1)
        If ch = "/" Or ch = Chr(92) Then
            Dim parentPath As String
            parentPath = Left(filePath, i - 1)
            If Trim(parentPath) <> "" Then Shell "cmd /d /c if not exist " & Chr(34) & parentPath & Chr(34) & " mkdir " & Chr(34) & parentPath & Chr(34)
            Exit Sub
        End If
    Next i
End Sub

Function UXBJsRuntimeWrite(ByVal filePath As String, ByRef errText As String) As Integer
    Dim ff As Integer
    errText = ""
    If Trim(filePath) = "" Then Return 1
    UXBJsRuntimeEnsureParentDir filePath
    ff = FreeFile
    Open filePath For Output As #ff
    If Err <> 0 Then
        errText = "JS runtime output cannot be opened: " & filePath
        Return 0
    End If
    Print #ff, UXBJsRuntimeText();
    Close #ff
    Return 1
End Function

#endif
