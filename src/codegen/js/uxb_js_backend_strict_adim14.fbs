#ifndef UXB_JS_BACKEND_STRICT_ADIM14_FBS
#define UXB_JS_BACKEND_STRICT_ADIM14_FBS

#include once "js_codegen.fbs"
#include once "uxb_js_backend_contract_adim14.fbs"
#include once "uxb_js_emit_buffer_adim14.fbs"

' Strict adapter: mevcut JS emitter varsa onu çağırır, yoksa integration hata verir.
' Amaç doğrudan başarı demek değil; unsupported path'i açık raporlamak.

Function UXBAdim14JsBackendEmitStrict(ByRef moduleValue As MIRModule, ByRef ctx As UXBBackendContext, ByRef result As UXBBackendResult) As Integer
    Dim errText As String
    errText = ""

    If UXBAdim14JsValidateOutputPath(ctx.jsOutPath, errText) = 0 Then
        UXBBackendResultFail result, UXB_BACKEND_E_TARGET, errText
        Return 0
    End If

    ' Mevcut repo emitter'ına bağlanır. Bu fonksiyon yoksa compile gate FAIL üretir.
    ' Copilot burada yeni fake emitter yazmayacak; mevcut emitter yoksa error classification'a MISSING_EXISTING_EMITTER yazacak.
    If UXBJsBackendEmitModule(moduleValue, ctx, result) = 0 Then
        If Trim(result.errorText) = "" Then
            UXBBackendResultFail result, UXB_BACKEND_E_EMIT, "JS backend emit failed without error text"
        End If
        Return 0
    End If

    If Trim(ctx.backendReportOutPath) <> "" Then
        Dim reportText As String
        reportText = "{" & Chr(10)
        reportText &= "  " & Chr(34) & "target" & Chr(34) & ": " & Chr(34) & "js" & Chr(34) & "," & Chr(10)
        reportText &= "  " & Chr(34) & "ok" & Chr(34) & ": true," & Chr(10)
        reportText &= "  " & Chr(34) & "out" & Chr(34) & ": " & Chr(34) & UXBAdim14JsEscape(ctx.jsOutPath) & Chr(34) & Chr(10)
        reportText &= "}" & Chr(10)
        UXBAdim14WriteTextFile ctx.backendReportOutPath, reportText, errText
    End If

    Return 1
End Function

#endif
