#ifndef UXB_JS_CODEGEN_REGISTRY_FBS
#define UXB_JS_CODEGEN_REGISTRY_FBS

#include once "../../backend/common/backend_emit_policy.fbs"

Function UXBJsEmitDecisionForOpcode(ByVal opcodeText As String) As String
    Return UXBBackendTargetDecisionForOpcode(opcodeText, UXB_TARGET_JS)
End Function

Function UXBJsOpcodeHasEmitter(ByVal opcodeText As String) As Integer
    Dim d As String
    d = UXBJsEmitDecisionForOpcode(opcodeText)
    If d = UXB_EMIT_IMPLEMENTED Or d = UXB_EMIT_RUNTIME_CALL Then Return 1
    Return 0
End Function

#endif
