#ifndef UXB_JS_EMIT_BUFFER_ADIM14_FBS
#define UXB_JS_EMIT_BUFFER_ADIM14_FBS

Type UXBAdim14TextBuffer
    text As String
    indentLevel As Integer
End Type

Sub UXBAdim14BufferInit(ByRef b As UXBAdim14TextBuffer)
    b.text = ""
    b.indentLevel = 0
End Sub

Sub UXBAdim14BufferIndent(ByRef b As UXBAdim14TextBuffer)
    b.indentLevel += 1
End Sub

Sub UXBAdim14BufferDedent(ByRef b As UXBAdim14TextBuffer)
    If b.indentLevel > 0 Then b.indentLevel -= 1
End Sub

Private Function UXBAdim14IndentText(ByVal n As Integer) As String
    Dim s As String
    Dim i As Integer
    s = ""
    For i = 1 To n
        s &= "  "
    Next i
    Return s
End Function

Sub UXBAdim14BufferLine(ByRef b As UXBAdim14TextBuffer, ByRef lineText As String)
    b.text &= UXBAdim14IndentText(b.indentLevel) & lineText & Chr(10)
End Sub

Function UXBAdim14JsEscape(ByRef s As String) As String
    Dim resultText As String
    Dim i As Integer
    resultText = ""
    For i = 1 To Len(s)
        Dim ch As String
        ch = Mid(s, i, 1)
        Select Case Asc(ch)
        Case 10
            resultText &= "\n"
        Case 13
            resultText &= "\r"
        Case 9
            resultText &= "\t"
        Case 34
            resultText &= "\" & Chr(34)
        Case 92
            resultText &= "\\"
        Case Else
            If Asc(ch) < 32 Then
                resultText &= "?"
            Else
                resultText &= ch
            End If
        End Select
    Next i
    Return resultText
End Function

Function UXBAdim14WriteTextFile(ByRef outPath As String, ByRef contentText As String, ByRef errText As String) As Integer
    errText = ""
    Dim f As Integer
    f = FreeFile
    Open outPath For Output As #f
    If Err <> 0 Then
        errText = "write open failed: " & outPath
        Return 0
    End If
    Print #f, contentText;
    Close #f
    Return 1
End Function

#endif
