#ifndef UXB_JS_EMIT_FAIL_CLOSED_FBS
#define UXB_JS_EMIT_FAIL_CLOSED_FBS

#include once "js_codegen_registry.fbs"

Function UXBJsFailClosedReason(ByVal opcodeText As String) As String
    Dim d As String
    d = UXBJsEmitDecisionForOpcode(opcodeText)
    If d = UXB_EMIT_IMPLEMENTED Or d = UXB_EMIT_RUNTIME_CALL Then Return ""
    Return "JS emit blocked for opcode " & opcodeText & " decision " & d
End Function

#endif
