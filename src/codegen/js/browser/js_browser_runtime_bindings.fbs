#ifndef UXB_JS_BROWSER_RUNTIME_BINDINGS_FBS
#define UXB_JS_BROWSER_RUNTIME_BINDINGS_FBS

Function UXBJsBrowserRuntimeBindings() As String
    Dim s As String
    s = "if (typeof document !== 'undefined') {" & Chr(10)
    s &= "  globalThis.uxbHostCall = globalThis.uxbHostCall || ((id) => 0);" & Chr(10)
    s &= "}" & Chr(10)
    Return s
End Function

#endif
