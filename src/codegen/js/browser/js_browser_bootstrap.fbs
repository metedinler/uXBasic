#ifndef UXB_JS_BROWSER_BOOTSTRAP_FBS
#define UXB_JS_BROWSER_BOOTSTRAP_FBS

Function UXBJsBrowserBootstrapHtml(ByVal scriptPath As String) As String
    Dim s As String
    s = "<!doctype html>" & Chr(10)
    s &= "<meta charset=" & Chr(34) & "utf-8" & Chr(34) & ">" & Chr(10)
    s &= "<pre id=" & Chr(34) & "uxb_out" & Chr(34) & "></pre>" & Chr(10)
    s &= "<script type=" & Chr(34) & "module" & Chr(34) & " src=" & Chr(34) & scriptPath & Chr(34) & "></script>" & Chr(10)
    Return s
End Function

#endif
