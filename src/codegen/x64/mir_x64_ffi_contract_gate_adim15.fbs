#ifndef UXB_MIR_X64_FFI_CONTRACT_GATE_ADIM15_FBS
#define UXB_MIR_X64_FFI_CONTRACT_GATE_ADIM15_FBS

Function MIRX64FfiContractGateAdim15(ByRef symbolName As String, ByRef signatureText As String, ByRef conventionText As String, ByRef errText As String) As Integer
    errText = ""
    Dim sig As UXBFFISignature
    If UXBFFIParseSignature(signatureText, sig) = 0 Then
        errText = sig.errorText
        Return 0
    End If

    ' UXB_FFI_CONTRACT_FIX_20260728: executable CALL(DLL/API) uses ABI10.
    If sig.argCount > 10 Then
        errText = "x64 ffi gate: too many args for ABI10"
        Return 0
    End If

    Select Case UCase(Trim(sig.returnType.name))
    Case "VOID", "I32", "U32", "I64", "U64", "F64", "PTR", "STRPTR"
    Case Else
        errText = "x64 ffi gate: unsupported ABI10 return type " & sig.returnType.name
        Return 0
    End Select

    Dim argIndex As Integer
    For argIndex = 0 To sig.argCount - 1
        Select Case UCase(Trim(sig.args(argIndex).name))
        Case "I32", "U32", "I64", "U64", "F64", "PTR", "STRPTR"
        Case Else
            errText = "x64 ffi gate: unsupported ABI10 argument type " & sig.args(argIndex).name
            Return 0
        End Select
    Next argIndex

    If UXBFFICallingConventionValid(conventionText, "X64", errText) = 0 Then Return 0

    If Trim(symbolName) = "" Then
        errText = "x64 ffi gate: symbol is empty"
        Return 0
    End If

    Return 1
End Function

#endif
