#ifndef UXB_MIR_X64_TYPE_CLASS_FFI_CONTRACT_FBS
#define UXB_MIR_X64_TYPE_CLASS_FFI_CONTRACT_FBS

' MIR x64 backend contract for TYPE / CLASS / FFI.
' This file maps MIR opcodes to backend route families.

Const UXB_MIRX64_ROUTE_UNKNOWN = 0
Const UXB_MIRX64_ROUTE_TYPE_FIELD = 1
Const UXB_MIRX64_ROUTE_CLASS_DIRECT = 2
Const UXB_MIRX64_ROUTE_OBJECT_RUNTIME = 3
Const UXB_MIRX64_ROUTE_FFI_CALL = 4
Const UXB_MIRX64_ROUTE_IMPORT_MANIFEST = 5
Const UXB_MIRX64_ROUTE_INLINE_GUARDED = 6
Const UXB_MIRX64_ROUTE_DIAGNOSTIC = 7
Const UXB_MIRX64_ROUTE_VIRTUAL_DISPATCH = 8

Function MIRX64TCFFIRouteForOpcode(ByRef opcodeText As String) As Integer
    Dim As String op
    op = UCase(Trim(opcodeText))

    Select Case op
    Case "LOAD_FIELD", "STORE_FIELD", "FIELD_ADDR"
        Return UXB_MIRX64_ROUTE_TYPE_FIELD
    Case "METHOD_CALL", "THIS", "DIRECT_METHOD"
        Return UXB_MIRX64_ROUTE_CLASS_DIRECT
    Case "NEW", "DELETE", "CTOR", "DTOR"
        Return UXB_MIRX64_ROUTE_OBJECT_RUNTIME
    Case "CALL_DLL", "CALL_API"
        Return UXB_MIRX64_ROUTE_FFI_CALL
    Case "IMPORT"
        Return UXB_MIRX64_ROUTE_IMPORT_MANIFEST
    Case "INLINE"
        Return UXB_MIRX64_ROUTE_INLINE_GUARDED
    Case "VIRTUAL_DISPATCH", "INHERITANCE_DISPATCH"
        Return UXB_MIRX64_ROUTE_VIRTUAL_DISPATCH
    Case Else
        Return UXB_MIRX64_ROUTE_UNKNOWN
    End Select
End Function

Function MIRX64TCFFIRouteName(ByVal routeId As Integer) As String
    Select Case routeId
    Case UXB_MIRX64_ROUTE_TYPE_FIELD
        Return "type_field"
    Case UXB_MIRX64_ROUTE_CLASS_DIRECT
        Return "class_direct"
    Case UXB_MIRX64_ROUTE_OBJECT_RUNTIME
        Return "object_runtime"
    Case UXB_MIRX64_ROUTE_FFI_CALL
        Return "ffi_call"
    Case UXB_MIRX64_ROUTE_IMPORT_MANIFEST
        Return "import_manifest"
    Case UXB_MIRX64_ROUTE_INLINE_GUARDED
        Return "inline_guarded"
    Case UXB_MIRX64_ROUTE_DIAGNOSTIC
        Return "diagnostic"
    Case UXB_MIRX64_ROUTE_VIRTUAL_DISPATCH
        Return "virtual_dispatch"
    Case Else
        Return "unknown"
    End Select
End Function

Function MIRX64TCFFIRequiresWin64ABI(ByRef opcodeText As String) As Integer
    Select Case MIRX64TCFFIRouteForOpcode(opcodeText)
    Case UXB_MIRX64_ROUTE_FFI_CALL, UXB_MIRX64_ROUTE_INLINE_GUARDED, UXB_MIRX64_ROUTE_OBJECT_RUNTIME
        Return 1
    Case Else
        Return 0
    End Select
End Function

#endif
