#ifndef UXB_X64_EXTFP_CALL_EMIT_FBS
#define UXB_X64_EXTFP_CALL_EMIT_FBS

Function UXBX64ExtFpRuntimeReady(ByRef typeName As String, ByRef errText As String) As Integer
    errText = ""

    Dim As String runtimeErr
    runtimeErr = ""
    If UXBExternalFloatRuntimeStatus(typeName, runtimeErr) = 0 Then
        errText = "x64-codegen: " & runtimeErr
        Return 0
    End If

    Return 1
End Function

Function UXBX64ExtFpRuntimeBinaryName(ByRef typeName As String, ByRef opName As String) As String
    Dim As String fam = UXBExternalFloatRuntimeFamily(typeName)
    Dim As String op = UCase(Trim(opName))
    If fam = "" Then Return ""
    Select Case op
    Case "ADD", "+": Return fam & "_add"
    Case "SUB", "-": Return fam & "_sub"
    Case "MUL", "*": Return fam & "_mul"
    Case "DIV", "/": Return fam & "_div"
    Case Else: Return ""
    End Select
End Function

Function UXBX64ExtFpRuntimeUnaryName(ByRef typeName As String, ByRef opName As String) As String
    Dim As String fam = UXBExternalFloatRuntimeFamily(typeName)
    Dim As String op = UCase(Trim(opName))
    If fam = "" Then Return ""
    Select Case op
    Case "NEG", "-": Return fam & "_neg"
    Case "ABS": Return fam & "_abs"
    Case "SQRT": Return fam & "_sqrt"
    Case Else: Return ""
    End Select
End Function

Function UXBX64ExtFpRuntimeCopyName(ByRef typeName As String) As String
    Dim As String fam = UXBExternalFloatRuntimeFamily(typeName)
    If fam = "" Then Return ""
    Return fam & "_copy"
End Function

Function UXBX64ExtFpRuntimeToStringName(ByRef typeName As String) As String
    Dim As String fam = UXBExternalFloatRuntimeFamily(typeName)
    If fam = "" Then Return ""
    Return fam & "_to_str"
End Function

Sub UXBX64EmitLeaArg(ByRef asmText As String, ByRef regName As String, ByRef addressExpr As String)
    asmText &= "    lea " & regName & ", " & addressExpr & Chr(10)
End Sub

Function UXBX64EmitExtFpUnaryCall(ByRef asmText As String, ByRef typeName As String, ByRef opName As String, ByRef inAddress As String, ByRef outAddress As String, ByRef errText As String) As Integer
    errText = ""

    If UXBX64ExtFpRuntimeReady(typeName, errText) = 0 Then
        Return 0
    End If

    Dim As String fnName = UXBX64ExtFpRuntimeUnaryName(typeName, opName)
    If fnName = "" Then
        errText = "x64-codegen: external FP runtime unary op not supported yet: type=" & typeName & " op=" & opName
        Return 0
    End If

    UXBX64EmitLeaArg asmText, "rcx", inAddress
    UXBX64EmitLeaArg asmText, "rdx", outAddress
    asmText &= "    sub rsp, 32" & Chr(10)
    asmText &= "    call " & fnName & Chr(10)
    asmText &= "    add rsp, 32" & Chr(10)
    Return 1
End Function

Function UXBX64EmitExtFpBinaryCall(ByRef asmText As String, ByRef typeName As String, ByRef opName As String, ByRef leftAddress As String, ByRef rightAddress As String, ByRef outAddress As String, ByRef errText As String) As Integer
    errText = ""

    If UXBX64ExtFpRuntimeReady(typeName, errText) = 0 Then
        Return 0
    End If

    Dim As String fnName = UXBX64ExtFpRuntimeBinaryName(typeName, opName)
    If fnName = "" Then
        errText = "x64-codegen: external FP runtime binary op not supported yet: type=" & typeName & " op=" & opName
        Return 0
    End If
    UXBX64EmitLeaArg asmText, "rcx", leftAddress
    UXBX64EmitLeaArg asmText, "rdx", rightAddress
    UXBX64EmitLeaArg asmText, "r8", outAddress
    asmText &= "    sub rsp, 32" & Chr(10)
    asmText &= "    call " & fnName & Chr(10)
    asmText &= "    add rsp, 32" & Chr(10)
    Return 1
End Function

Function UXBX64EmitExtFpCopyCall(ByRef asmText As String, ByRef typeName As String, ByRef srcAddress As String, ByRef dstAddress As String, ByRef errText As String) As Integer
    errText = ""

    If UXBX64ExtFpRuntimeReady(typeName, errText) = 0 Then
        Return 0
    End If

    Dim As String fnName = UXBX64ExtFpRuntimeCopyName(typeName)
    If fnName = "" Then
        errText = "x64-codegen: external FP runtime copy op not supported yet: type=" & typeName
        Return 0
    End If

    UXBX64EmitLeaArg asmText, "rcx", srcAddress
    UXBX64EmitLeaArg asmText, "rdx", dstAddress
    asmText &= "    sub rsp, 32" & Chr(10)
    asmText &= "    call " & fnName & Chr(10)
    asmText &= "    add rsp, 32" & Chr(10)
    Return 1
End Function

Function UXBX64EmitExtFpToStringCall(ByRef asmText As String, ByRef typeName As String, ByRef inAddress As String, ByRef bufferAddress As String, ByVal bufferLen As Integer, ByRef errText As String) As Integer
    errText = ""

    If UXBX64ExtFpRuntimeReady(typeName, errText) = 0 Then
        Return 0
    End If

    Dim As String fnName = UXBX64ExtFpRuntimeToStringName(typeName)
    If fnName = "" Then
        errText = "x64-codegen: external FP runtime to-string op not supported yet: type=" & typeName
        Return 0
    End If

    UXBX64EmitLeaArg asmText, "rcx", inAddress
    UXBX64EmitLeaArg asmText, "rdx", bufferAddress
    asmText &= "    mov r8d, " & LTrim(Str(bufferLen)) & Chr(10)
    asmText &= "    sub rsp, 32" & Chr(10)
    asmText &= "    call " & fnName & Chr(10)
    asmText &= "    add rsp, 32" & Chr(10)
    Return 1
End Function

Function UXBX64ExtFpRuntimeFromStringName(ByRef typeName As String) As String
    Dim As String fam = UXBExternalFloatRuntimeFamily(typeName)
    If fam = "" Then Return ""
    Return fam & "_from_str"
End Function

Function UXBX64EmitExtFpFromStringCall(ByRef asmText As String, ByRef typeName As String, ByRef literalLabel As String, ByRef dstAddress As String, ByRef errText As String) As Integer
    errText = ""

    If UXBX64ExtFpRuntimeReady(typeName, errText) = 0 Then
        Return 0
    End If

    Dim As String fnName = UXBX64ExtFpRuntimeFromStringName(typeName)
    If fnName = "" Then
        errText = "x64-codegen: external FP runtime from_str op not supported yet: type=" & typeName
        Return 0
    End If

    asmText &= "    lea rcx, [" & literalLabel & "]" & Chr(10)
    asmText &= "    lea rdx, " & dstAddress & Chr(10)
    asmText &= "    sub rsp, 32" & Chr(10)
    asmText &= "    call " & fnName & Chr(10)
    asmText &= "    add rsp, 32" & Chr(10)
    Return 1
End Function



' Handle-backed external FP helper names for BIGF/BIGD/BALL.
Function UXBX64ExtFpRuntimeInitName(ByRef typeName As String) As String
    Dim As String fam = UXBExternalFloatRuntimeFamily(typeName)
    If fam = "" Then Return ""
    Return fam & "_init"
End Function

Function UXBX64ExtFpRuntimeFreeName(ByRef typeName As String) As String
    Dim As String fam = UXBExternalFloatRuntimeFamily(typeName)
    If fam = "" Then Return ""
    Return fam & "_free"
End Function

Function UXBX64ExtFpIsHandleBackedRuntime(ByRef typeName As String) As Integer
    Return UXBExtFpIsHandleType(typeName)
End Function

#endif
