#ifndef UXB_MIR_X64_SURFACE_CLOSURE_FBS
#define UXB_MIR_X64_SURFACE_CLOSURE_FBS

#include once "../../surface/uxb_surface_layer_bridge.fbs"

Function MIRX64SurfaceEmitKind(ByRef surfaceText As String) As String
    Return UXBSurfaceX64EmitKind(surfaceText)
End Function

Function MIRX64SurfaceRuntimeService(ByRef surfaceText As String) As String
    Return UXBSurfaceRuntimeService(surfaceText)
End Function

Function MIRX64SurfaceMirOpcode(ByRef surfaceText As String) As String
    Return UXBSurfaceMirOpcode(surfaceText)
End Function

Function MIRX64SurfaceCanAccept(ByRef surfaceText As String) As Integer
    Dim k As String = MIRX64SurfaceEmitKind(surfaceText)
    Select Case k
    Case "NATIVE_EMIT", "RUNTIME_CALL", "HOST_CALL", "NO_EMIT", "NATIVE"
        Return 1
    End Select
    Return 0
End Function

Function MIRX64SurfaceDiagnostic(ByRef surfaceText As String) As String
    If MIRX64SurfaceCanAccept(surfaceText) <> 0 Then Return ""
    Return "x64 surface not closed: " & UCase(Trim(surfaceText))
End Function

#endif
