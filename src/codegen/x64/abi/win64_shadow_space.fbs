#ifndef UXB_X64_WIN64_SHADOW_SPACE_FBS
#define UXB_X64_WIN64_SHADOW_SPACE_FBS

#include once "win64_abi.fbs"

Function UXBWin64ShadowSpaceProlog() As String
    Return "    sub rsp, " & Str(UXB_WIN64_SHADOW_SPACE_BYTES) & Chr(10)
End Function

Function UXBWin64ShadowSpaceEpilog() As String
    Return "    add rsp, " & Str(UXB_WIN64_SHADOW_SPACE_BYTES) & Chr(10)
End Function

#endif
