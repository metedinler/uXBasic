#ifndef UXB_X64_WIN64_CALLING_CONVENTION_FBS
#define UXB_X64_WIN64_CALLING_CONVENTION_FBS

#include once "win64_abi.fbs"

Function UXBWin64CallArgLocation(ByVal argIndex As Integer, ByVal typeText As String) As String
    Dim t As String
    t = UCase(Trim(typeText))
    If t = "F32" Or t = "F64" Or t = "TYPE_F32" Or t = "TYPE_F64" Then
        If UXBWin64FloatArgReg(argIndex) <> "" Then Return UXBWin64FloatArgReg(argIndex)
    Else
        If UXBWin64IntegerArgReg(argIndex) <> "" Then Return UXBWin64IntegerArgReg(argIndex)
    End If
    Return "stack+" & Str((argIndex - 4) * 8 + UXB_WIN64_SHADOW_SPACE_BYTES)
End Function

#endif
