#ifndef UXB_X64_WIN64_ABI_FBS
#define UXB_X64_WIN64_ABI_FBS

Const UXB_WIN64_SHADOW_SPACE_BYTES As Integer = 32
Const UXB_WIN64_STACK_ALIGN_BYTES As Integer = 16

Function UXBWin64IntegerArgReg(ByVal indexValue As Integer) As String
    Select Case indexValue
    Case 0: Return "rcx"
    Case 1: Return "rdx"
    Case 2: Return "r8"
    Case 3: Return "r9"
    End Select
    Return ""
End Function

Function UXBWin64FloatArgReg(ByVal indexValue As Integer) As String
    Select Case indexValue
    Case 0: Return "xmm0"
    Case 1: Return "xmm1"
    Case 2: Return "xmm2"
    Case 3: Return "xmm3"
    End Select
    Return ""
End Function

Function UXBWin64AlignStackBytes(ByVal rawBytes As Integer) As Integer
    Dim n As Integer
    n = rawBytes
    If n < UXB_WIN64_SHADOW_SPACE_BYTES Then n = UXB_WIN64_SHADOW_SPACE_BYTES
    If (n Mod UXB_WIN64_STACK_ALIGN_BYTES) <> 0 Then n += UXB_WIN64_STACK_ALIGN_BYTES - (n Mod UXB_WIN64_STACK_ALIGN_BYTES)
    Return n
End Function

Function UXBWin64ReturnRegister(ByVal typeText As String) As String
    Dim t As String
    t = UCase(Trim(typeText))
    Select Case t
    Case "F32", "F64", "TYPE_F32", "TYPE_F64", "SINGLE", "DOUBLE"
        Return "xmm0"
    End Select
    Return "rax"
End Function

#endif
