#ifndef UXB_X64_WIN64_STACK_FRAME_FBS
#define UXB_X64_WIN64_STACK_FRAME_FBS

#include once "win64_abi.fbs"

Type UXBWin64StackFramePlan
    localBytes As Integer
    shadowBytes As Integer
    totalBytes As Integer
End Type

Function UXBWin64MakeStackFramePlan(ByVal localCount As Integer) As UXBWin64StackFramePlan
    Dim p As UXBWin64StackFramePlan
    p.localBytes = localCount * 8
    p.shadowBytes = UXB_WIN64_SHADOW_SPACE_BYTES
    p.totalBytes = UXBWin64AlignStackBytes(p.localBytes + p.shadowBytes)
    Return p
End Function

#endif
