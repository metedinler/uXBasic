#ifndef UXB_X64_NASM_DATA_FBS
#define UXB_X64_NASM_DATA_FBS

Private Function UXBNasmStringLiteralCanUseQuotedDb(ByVal textValue As String) As Integer
    Dim i As Integer
    For i = 1 To Len(textValue)
        Dim chCode As Integer
        chCode = Asc(Mid(textValue, i, 1))
        If chCode < 32 Or chCode > 126 Then Return 0
        If chCode = 34 Then Return 0      ' çift tırnak: byte listesi gerekir
        If chCode = 92 Then Return 0      ' ters slash: NASM kaçış yorumu farklarını önle
    Next i
    Return 1
End Function

Private Function UXBNasmByteListLiteral(ByVal labelName As String, ByVal textValue As String) As String
    Dim outText As String
    outText = labelName & " db "

    Dim i As Integer
    If Len(textValue) > 0 Then
        For i = 1 To Len(textValue)
            If i > 1 Then outText &= ","
            outText &= LTrim(Str(Asc(Mid(textValue, i, 1))))
        Next i
        outText &= ",0" & Chr(10)
    Else
        outText &= "0" & Chr(10)
    End If

    Return outText
End Function

Function UXBNasmStringLiteral(ByVal labelName As String, ByVal textValue As String) As String
    ' Veri kaybı yok: çift tırnak, CR/LF, ters slash ve kontrol karakterleri
    ' silinmez; gerekiyorsa NASM byte listesi olarak yazılır.
    If UXBNasmStringLiteralCanUseQuotedDb(textValue) <> 0 Then
        Return labelName & " db " & Chr(34) & textValue & Chr(34) & ",0" & Chr(10)
    End If

    Return UXBNasmByteListLiteral(labelName, textValue)
End Function

#endif
