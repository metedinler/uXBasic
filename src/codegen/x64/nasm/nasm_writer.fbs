#ifndef UXB_X64_NASM_WRITER_FBS
#define UXB_X64_NASM_WRITER_FBS

#include once "../../../common/report_writer.fbs"

Private Function UXBNasmReplaceAll(ByVal srcText As String, ByVal findText As String, ByVal replText As String) As String
    If findText = "" Then Return srcText
    Dim outText As String
    outText = ""
    Dim startPos As Integer
    startPos = 1
    Do
        Dim hitPos As Integer
        hitPos = InStr(startPos, srcText, findText)
        If hitPos = 0 Then
            outText &= Mid(srcText, startPos)
            Exit Do
        End If
        outText &= Mid(srcText, startPos, hitPos - startPos)
        outText &= replText
        startPos = hitPos + Len(findText)
    Loop
    Return outText
End Function

Function UXBNasmEscapeComment(ByVal textValue As String) As String
    Dim outText As String
    outText = UXBNasmReplaceAll(textValue, Chr(13), " ")
    outText = UXBNasmReplaceAll(outText, Chr(10), " ")
    Return outText
End Function

Private Function UXBNasmSectionHasContent(ByRef sectionText As String) As Integer
    If Trim(sectionText) = "" Then Return 0
    Return 1
End Function

Function UXBNasmBuildModuleText(ByVal externText As String, ByVal dataText As String, ByVal codeText As String, ByVal bssText As String = "") As String
    Dim outText As String
    outText = "bits 64" & Chr(10)
    outText &= "default rel" & Chr(10) & Chr(10)

    If UXBNasmSectionHasContent(externText) <> 0 Then
        outText &= externText
        If Right(outText, 1) <> Chr(10) Then outText &= Chr(10)
        outText &= Chr(10)
    End If

    outText &= "section .data" & Chr(10)
    If UXBNasmSectionHasContent(dataText) <> 0 Then
        outText &= dataText
        If Right(outText, 1) <> Chr(10) Then outText &= Chr(10)
    End If
    outText &= Chr(10)

    If UXBNasmSectionHasContent(bssText) <> 0 Then
        outText &= "section .bss" & Chr(10)
        outText &= bssText
        If Right(outText, 1) <> Chr(10) Then outText &= Chr(10)
        outText &= Chr(10)
    End If

    outText &= "section .text" & Chr(10)
    outText &= "global main" & Chr(10)
    If UXBNasmSectionHasContent(codeText) <> 0 Then
        outText &= codeText
        If Right(outText, 1) <> Chr(10) Then outText &= Chr(10)
    End If
    Return outText
End Function

Function UXBNasmWriteFile(ByVal filePath As String, ByVal asmText As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(filePath) = "" Then
        errText = "ASM output path is empty"
        Return 0
    End If
    Return UXBReportWriteText(filePath, asmText, errText)
End Function

#endif
