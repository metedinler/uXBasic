#ifndef UXB_X64_NASM_SECTIONS_FBS
#define UXB_X64_NASM_SECTIONS_FBS

Function UXBNasmHeader() As String
    Return "bits 64" & Chr(10) & "default rel" & Chr(10)
End Function

Function UXBNasmTextSection() As String
    Return "section .text" & Chr(10) & "global main" & Chr(10)
End Function

Function UXBNasmDataSection() As String
    Return "section .data" & Chr(10)
End Function

#endif
