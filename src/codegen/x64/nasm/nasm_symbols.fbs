#ifndef UXB_X64_NASM_SYMBOLS_FBS
#define UXB_X64_NASM_SYMBOLS_FBS

Function UXBNasmSafeSymbol(ByVal rawName As String) As String
    Dim outText As String
    Dim i As Integer
    Dim c As String
    outText = ""
    For i = 1 To Len(rawName)
        c = Mid(rawName, i, 1)
        If (c >= "A" And c <= "Z") Or (c >= "a" And c <= "z") Or (c >= "0" And c <= "9") Or c = "_" Then
            outText &= c
        Else
            outText &= "_"
        End If
    Next i
    If outText = "" Then outText = "uxb_sym"
    If Left(outText, 1) >= "0" And Left(outText, 1) <= "9" Then outText = "_" & outText
    Return outText
End Function

#endif
