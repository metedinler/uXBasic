#ifndef UXB_X64_NASM_TEXT_FBS
#define UXB_X64_NASM_TEXT_FBS

Function UXBNasmMainProlog(ByVal stackBytes As Integer) As String
    Dim s As String
    s = "main:" & Chr(10)
    s &= "    push rbp" & Chr(10)
    s &= "    mov rbp, rsp" & Chr(10)
    If stackBytes > 0 Then s &= "    sub rsp, " & Str(stackBytes) & Chr(10)
    Return s
End Function

Function UXBNasmMainEpilog(ByVal stackBytes As Integer) As String
    Dim s As String
    If stackBytes > 0 Then s &= "    add rsp, " & Str(stackBytes) & Chr(10)
    s &= "    xor eax, eax" & Chr(10)
    s &= "    pop rbp" & Chr(10)
    s &= "    ret" & Chr(10)
    Return s
End Function

#endif
