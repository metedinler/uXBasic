#ifndef UXB_MIR_X64_ABI_GATE_FBS
#define UXB_MIR_X64_ABI_GATE_FBS

#include once "../../semantic/mir_model.fbs"
#include once "abi/win64_abi.fbs"

Function UXBMIRX64AbiGateCheckFunction(ByRef fn As MIRFunction, ByRef errText As String) As Integer
    errText = ""

    If fn.paramVarCount > 0 Then
        Dim i As Integer
        For i = 0 To fn.paramVarCount - 1
            If Trim(fn.paramVars(i)) = "" Then
                errText = "x64 ABI gate: param name missing: " & fn.name & "[" & LTrim(Str(i)) & "]"
                Return 0
            End If
        Next i
    End If

    If UXB_WIN64_SHADOW_SPACE_BYTES <> 32 Then
        errText = "x64 ABI gate: Win64 shadow space 32 byte olmali"
        Return 0
    End If

    Return 1
End Function

Function UXBMIRX64AbiGateCheckModule(ByRef m As MIRModule, ByRef errText As String) As Integer
    errText = ""
    Dim i As Integer
    For i = 0 To m.functionCount - 1
        If UXBMIRX64AbiGateCheckFunction(m.functions(i), errText) = 0 Then Return 0
    Next i
    Return 1
End Function

#endif
