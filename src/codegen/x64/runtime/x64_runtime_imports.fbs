#ifndef UXB_X64_RUNTIME_IMPORTS_FBS
#define UXB_X64_RUNTIME_IMPORTS_FBS

#include once "x64_runtime_symbols.fbs"

Function UXBX64RuntimeImportsText() As String
    Return UXBX64RuntimeExternBlock()
End Function

Sub UXBX64EmitRuntimeImports(ByRef cg As MIRX64Context)
    Dim blockText As String
    blockText = UXBX64RuntimeExternBlock()
    Dim lines(Any) As String
    Dim cnt As Integer
    Dim i As Integer
    cnt = 0
    ReDim lines(0)
    Dim current As String
    current = ""
    For i = 1 To Len(blockText)
        Dim ch As String
        ch = Mid(blockText, i, 1)
        If ch = Chr(10) Then
            If Trim(current) <> "" Then MIRX64EmitExtern cg, current
            current = ""
        Else
            current &= ch
        End If
    Next i
    If Trim(current) <> "" Then MIRX64EmitExtern cg, current
End Sub

#endif
