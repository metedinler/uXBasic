#ifndef UXB_X64_RUNTIME_LINK_PLAN_FBS
#define UXB_X64_RUNTIME_LINK_PLAN_FBS

Type UXBX64RuntimeLinkPlan
    required As Integer
    importBlock As String
    noteText As String
End Type

Function UXBX64RuntimeMakeLinkPlan(ByVal requiresRuntime As Integer) As UXBX64RuntimeLinkPlan
    Dim p As UXBX64RuntimeLinkPlan
    p.required = requiresRuntime
    If requiresRuntime <> 0 Then
        p.importBlock = UXBX64RuntimeExternBlock()
        p.noteText = "x64 runtime library is required"
    Else
        p.importBlock = ""
        p.noteText = "x64 runtime library is not required"
    End If
    Return p
End Function

#endif
