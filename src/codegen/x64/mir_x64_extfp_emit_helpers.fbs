#ifndef UXB_MIR_X64_EXTFP_EMIT_HELPERS_FBS
#define UXB_MIR_X64_EXTFP_EMIT_HELPERS_FBS

#include once "../../semantic/extfp_lowering_contract.fbs"

' Helper routines for emitting external FP runtime calls from MIR x64 backend.
' Win64 ABI: RCX, RDX, R8, R9 + 32-byte shadow space.

Sub MIRX64EmitExtFpExtern(ByRef cg As MIRX64Context, ByRef symbolName As String)
    If Trim(symbolName) = "" Then Exit Sub
    MIRX64Emit cg, "extern " & symbolName
End Sub

Function MIRX64EmitExtFpCallFromString( _
    ByRef cg As MIRX64Context, _
    ByRef typeName As String, _
    ByRef literalLabel As String, _
    ByRef outAddressText As String, _
    ByRef errText As String _
) As Integer
    Dim As UXBExtFpLoweringDecision d
    If UXBExtFpDecideLowering(typeName, "FROM_STR", d) = 0 Then
        errText = d.diagnosticCode & ": " & d.diagnosticText
        MIRX64AddError cg, errText
        Return 0
    End If

    MIRX64EmitExtFpExtern cg, d.runtimeSymbol
    MIRX64Emit cg, "    lea rcx, [rel " & literalLabel & "]"
    MIRX64Emit cg, "    lea rdx, " & outAddressText
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & d.runtimeSymbol
    MIRX64Emit cg, "    add rsp, 32"
    Return 1
End Function

Function MIRX64EmitExtFpCallBinary( _
    ByRef cg As MIRX64Context, _
    ByRef typeName As String, _
    ByRef opName As String, _
    ByRef leftAddressText As String, _
    ByRef rightAddressText As String, _
    ByRef outAddressText As String, _
    ByRef errText As String _
) As Integer
    Dim As UXBExtFpLoweringDecision d
    If UXBExtFpDecideLowering(typeName, opName, d) = 0 Then
        errText = d.diagnosticCode & ": " & d.diagnosticText
        MIRX64AddError cg, errText
        Return 0
    End If

    MIRX64EmitExtFpExtern cg, d.runtimeSymbol
    MIRX64Emit cg, "    lea rcx, " & leftAddressText
    MIRX64Emit cg, "    lea rdx, " & rightAddressText
    MIRX64Emit cg, "    lea r8, " & outAddressText
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & d.runtimeSymbol
    MIRX64Emit cg, "    add rsp, 32"
    Return 1
End Function

Function MIRX64EmitExtFpCallToString( _
    ByRef cg As MIRX64Context, _
    ByRef typeName As String, _
    ByRef valueAddressText As String, _
    ByRef bufferLabel As String, _
    ByVal bufferBytes As Integer, _
    ByRef errText As String _
) As Integer
    Dim As UXBExtFpLoweringDecision d
    If UXBExtFpDecideLowering(typeName, "TO_STR", d) = 0 Then
        errText = d.diagnosticCode & ": " & d.diagnosticText
        MIRX64AddError cg, errText
        Return 0
    End If

    MIRX64EmitExtFpExtern cg, d.runtimeSymbol
    MIRX64Emit cg, "    lea rcx, " & valueAddressText
    MIRX64Emit cg, "    lea rdx, [rel " & bufferLabel & "]"
    MIRX64Emit cg, "    mov r8d, " & Str(bufferBytes)
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & d.runtimeSymbol
    MIRX64Emit cg, "    add rsp, 32"
    Return 1
End Function

Function MIRX64EmitExtFpDiagnostic(ByRef cg As MIRX64Context, ByRef codeText As String, ByRef detailText As String) As Integer
    MIRX64AddError cg, codeText & ": " & detailText
    Return 0
End Function

#endif
