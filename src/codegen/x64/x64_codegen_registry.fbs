#ifndef UXB_X64_CODEGEN_REGISTRY_FBS
#define UXB_X64_CODEGEN_REGISTRY_FBS

#include once "../../backend/common/backend_emit_policy.fbs"

Function UXBX64EmitDecisionForOpcode(ByVal opcodeText As String) As String
    Return UXBBackendTargetDecisionForOpcode(opcodeText, UXB_TARGET_X64)
End Function

Function UXBX64OpcodeHasEmitter(ByVal opcodeText As String) As Integer
    Dim d As String
    d = UXBX64EmitDecisionForOpcode(opcodeText)
    If d = UXB_EMIT_IMPLEMENTED Or d = UXB_EMIT_RUNTIME_CALL Then Return 1
    Return 0
End Function

Function UXBX64RequiresRuntime(ByVal opcodeText As String) As Integer
    Dim fam As String
    fam = UXBBackendOpcodeFamily(opcodeText)
    Select Case fam
    Case "RUNTIME", "FILE", "HOST", "STRING", "OBJECT"
        Return 1
    End Select
    Return 0
End Function

#endif
