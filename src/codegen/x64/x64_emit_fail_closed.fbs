#ifndef UXB_X64_EMIT_FAIL_CLOSED_FBS
#define UXB_X64_EMIT_FAIL_CLOSED_FBS

#include once "x64_codegen_registry.fbs"

Function UXBX64FailClosedReason(ByVal opcodeText As String) As String
    Dim d As String
    d = UXBX64EmitDecisionForOpcode(opcodeText)
    If d = UXB_EMIT_IMPLEMENTED Or d = UXB_EMIT_RUNTIME_CALL Then Return ""
    Return "x64 emit blocked for opcode " & opcodeText & " decision " & d
End Function

#endif
