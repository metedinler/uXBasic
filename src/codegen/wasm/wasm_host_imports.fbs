#ifndef UXB_WASM_HOST_IMPORTS_FBS
#define UXB_WASM_HOST_IMPORTS_FBS

Public Function UXBWasmEmitHostImports() As String
    Dim outText As String
    outText = ""
    outText &= "  (import " & Chr(34) & "ux" & Chr(34) & " " & Chr(34) & "host_call4" & Chr(34) & " (func $uxb_host_call4 (param i32 i32 i32 i32 i32) (result i32)))" & Chr(10)
    outText &= "  (import " & Chr(34) & "ux" & Chr(34) & " " & Chr(34) & "host_call16" & Chr(34) & " (func $uxb_host_call16 (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32) (result i32)))" & Chr(10)
    outText &= "  (import " & Chr(34) & "ux" & Chr(34) & " " & Chr(34) & "print_i32" & Chr(34) & " (func $ux_print_i32 (param i32)))" & Chr(10)
    outText &= "  (import " & Chr(34) & "ux" & Chr(34) & " " & Chr(34) & "print_f64" & Chr(34) & " (func $ux_print_f64 (param f64)))" & Chr(10)
    Return outText
End Function

#endif
