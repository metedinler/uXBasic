#ifndef UXB_WAT_EMIT_BUFFER_ADIM14_FBS
#define UXB_WAT_EMIT_BUFFER_ADIM14_FBS

Type UXBAdim14WatBuffer
    text As String
    indentLevel As Integer
End Type

Sub UXBAdim14WatBufferInit(ByRef b As UXBAdim14WatBuffer)
    b.text = ""
    b.indentLevel = 0
End Sub

Private Function UXBAdim14WatIndentText(ByVal n As Integer) As String
    Dim s As String
    Dim i As Integer
    s = ""
    For i = 1 To n
        s &= "  "
    Next i
    Return s
End Function

Sub UXBAdim14WatLine(ByRef b As UXBAdim14WatBuffer, ByRef lineText As String)
    b.text &= UXBAdim14WatIndentText(b.indentLevel) & lineText & Chr(10)
End Sub

Sub UXBAdim14WatIndent(ByRef b As UXBAdim14WatBuffer)
    b.indentLevel += 1
End Sub

Sub UXBAdim14WatDedent(ByRef b As UXBAdim14WatBuffer)
    If b.indentLevel > 0 Then b.indentLevel -= 1
End Sub

Function UXBAdim14WatEscape(ByRef s As String) As String
    Dim resultText As String
    Dim i As Integer
    resultText = ""
    For i = 1 To Len(s)
        Dim ch As String
        ch = Mid(s, i, 1)
        Select Case Asc(ch)
        Case 34
            resultText &= "\" & Chr(34)
        Case 92
            resultText &= "\\"
        Case 10, 13, 9
            resultText &= " "
        Case Else
            If Asc(ch) < 32 Then resultText &= "?" Else resultText &= ch
        End Select
    Next i
    Return resultText
End Function

Function UXBAdim14WatWriteTextFile(ByRef outPath As String, ByRef contentText As String, ByRef errText As String) As Integer
    errText = ""
    Dim f As Integer
    f = FreeFile
    Open outPath For Output As #f
    If Err <> 0 Then
        errText = "WAT write open failed: " & outPath
        Return 0
    End If
    Print #f, contentText;
    Close #f
    Return 1
End Function

#endif
