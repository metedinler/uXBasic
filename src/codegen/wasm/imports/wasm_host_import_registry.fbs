#ifndef UXB_WASM_HOST_IMPORT_REGISTRY_FBS
#define UXB_WASM_HOST_IMPORT_REGISTRY_FBS

Function UXBWasmHostImportForOpcode(ByVal opcodeText As String) As String
    Dim op As String
    op = UCase(Trim(opcodeText))
    If Left(op, 4) = "MIR_" Then op = Mid(op, 5)
    Select Case op
    Case "PRINT", "INPUT", "CALL_RUNTIME", "HOST_CALL", "LIBRARY_CALL": Return "uxb_host_call"
    Case "TIMER": Return "uxb_timer"
    Case "RND", "RANDOMIZE": Return "uxb_rnd"
    End Select
    Return "uxb_host_call"
End Function

#endif
