#ifndef UXB_WASM_RUNTIME_IMPORTS_FBS
#define UXB_WASM_RUNTIME_IMPORTS_FBS

#include once "wasm_host_import_registry.fbs"

Function UXBWasmRuntimeImportBlock() As String
    Dim s As String
    s = ""
    s &= "  (import " & Chr(34) & "ux" & Chr(34) & " " & Chr(34) & "host_call4" & Chr(34) & " (func $uxb_host_call4 (param i32 i32 i32 i32 i32) (result i32)))" & Chr(10)
    s &= "  (import " & Chr(34) & "ux" & Chr(34) & " " & Chr(34) & "print_i32" & Chr(34) & " (func $ux_print_i32 (param i32)))" & Chr(10)
    s &= "  (import " & Chr(34) & "ux" & Chr(34) & " " & Chr(34) & "timer" & Chr(34) & " (func $uxb_timer (result i32)))" & Chr(10)
    s &= "  (import " & Chr(34) & "ux" & Chr(34) & " " & Chr(34) & "rnd" & Chr(34) & " (func $uxb_rnd (result i32)))" & Chr(10)
    Return s
End Function

#endif
