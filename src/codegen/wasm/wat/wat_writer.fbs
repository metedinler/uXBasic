#ifndef UXB_WAT_WRITER_FBS
#define UXB_WAT_WRITER_FBS

Function UXBWatWriteFile(ByVal filePath As String, ByVal watText As String, ByRef errText As String) As Integer
    Dim ff As Integer
    errText = ""
    If Trim(filePath) = "" Then
        errText = "WAT output path is empty"
        Return 0
    End If
    ff = FreeFile
    Open filePath For Output As #ff
    If Err <> 0 Then
        errText = "WAT output file cannot be opened: " & filePath
        Return 0
    End If
    Print #ff, watText;
    Close #ff
    Return 1
End Function

#endif
