#ifndef UXB_WASM_CODEGEN_STEP6_FBS
#define UXB_WASM_CODEGEN_STEP6_FBS

#include once "../../semantic/mir_model.fbs"
#include once "../../backend/common/backend_context.fbs"
#include once "../../backend/common/backend_result.fbs"
#include once "../../backend/common/backend_json_report.fbs"
#include once "wasm_type_emit.fbs"
#include once "wasm_host_imports.fbs"
#include once "wasm_instr_emit.fbs"
#include once "wasm_manifest_emit.fbs"
#include once "wasm_emitter.fbs"
#include once "wasm_codegen_registry.fbs"

Function UXBWasmBackendEmitModule(ByRef m As MIRModule, ByRef ctx As UXBBackendContext, ByRef result As UXBBackendResult) As Integer
    Dim errText As String
    result = UXBBackendResultMake(UXB_TARGET_WASM)
    If UXBBackendContextReadyForEmit(ctx, errText) = 0 Then
        If ctx.verifyPassed = 0 Then
            result.status = UXB_BACKEND_STATUS_BLOCKED_VERIFY
            result.code = UXB_BACKEND_E_VERIFY_BLOCK
        Else
            result.status = UXB_BACKEND_STATUS_BLOCKED_INTERP
            result.code = UXB_BACKEND_E_INTERP_BLOCK
        End If
        result.errorText = errText
        Return 0
    End If
    If UXBWasmEmitWatFromMIR(m, ctx.watOutPath, ctx.manifestOutPath, errText) = 0 Then
        UXBBackendResultFail result, UXB_BACKEND_E_EMIT, errText
        Return 0
    End If
    UXBBackendResultPass result, ctx.watOutPath, "WAT emitted"
    result.externalToolPath = ctx.wasmToolPath
    Return 1
End Function

#endif
