#ifndef UXB_WASM_CODEGEN_REGISTRY_FBS
#define UXB_WASM_CODEGEN_REGISTRY_FBS

#include once "../../backend/common/backend_emit_policy.fbs"

Function UXBWasmEmitDecisionForOpcode(ByVal opcodeText As String) As String
    Return UXBBackendTargetDecisionForOpcode(opcodeText, UXB_TARGET_WASM)
End Function

Function UXBWasmOpcodeHasEmitter(ByVal opcodeText As String) As Integer
    Dim d As String
    d = UXBWasmEmitDecisionForOpcode(opcodeText)
    If d = UXB_EMIT_IMPLEMENTED Or d = UXB_EMIT_WASM_IMPORT Or d = UXB_EMIT_RUNTIME_CALL Then Return 1
    Return 0
End Function

#endif
