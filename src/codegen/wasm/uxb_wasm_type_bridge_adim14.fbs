#ifndef UXB_WASM_TYPE_BRIDGE_ADIM14_FBS
#define UXB_WASM_TYPE_BRIDGE_ADIM14_FBS

Function UXBAdim14WasmValueType(ByRef typeText As String) As String
    Dim t As String
    t = UCase(Trim(typeText))
    Select Case t
    Case "I8", "U8", "I16", "U16", "I32", "U32", "BOOLEAN", "BOOL"
        Return "i32"
    Case "I64", "U64", "PTR", "STRPTR", "WSTRPTR", "ANY PTR"
        Return "i64"
    Case "F32"
        Return "f32"
    Case "F64", "F80", "F128", "BIGF", "BIGD", "BALL"
        Return "f64"
    Case "STRING", "STR", "ZSTRING", "WSTRING"
        Return "i32" ' string handle / linear memory offset
    Case Else
        Return ""
    End Select
End Function

Function UXBAdim14WasmOpcodeSupported(ByRef opcodeText As String) As Integer
    Dim op As String
    op = UCase(Trim(opcodeText))
    Select Case op
    Case "", "NOP", "LABEL", "COMMENT"
        Return 1
    Case "CONST", "LOAD_CONST", "LOAD_VAR", "STORE_VAR", "MOVE", "MOV"
        Return 1
    Case "ADD", "SUB", "MUL", "DIV", "MOD"
        Return 1
    Case "EQ", "NE", "LT", "LE", "GT", "GE", "ULT", "ULE", "UGT", "UGE", "AND", "OR", "NOT"
        Return 1
    Case "PRINT", "CALL_RUNTIME", "CALL_HOST", "RET", "RETURN"
        Return 1
    Case "JMP", "JZ", "JNZ", "BR", "BR_IF"
        Return 1
    Case Else
        Return 0
    End Select
End Function

Function UXBAdim14WasmRequireWatPath(ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then
        errText = "WAT output path is empty"
        Return 0
    End If
    Return 1
End Function

#endif
