#ifndef UXB_WASM_EMIT_FAIL_CLOSED_FBS
#define UXB_WASM_EMIT_FAIL_CLOSED_FBS

#include once "wasm_codegen_registry.fbs"
#include once "uxb_wasm_surface_contract.fbs"

Function UXBWasmFailClosedReason(ByVal opcodeText As String) As String
    Dim d As String
    d = UXBWasmEmitDecisionForOpcode(opcodeText)
    If d = UXB_EMIT_IMPLEMENTED Or d = UXB_EMIT_WASM_IMPORT Or d = UXB_EMIT_RUNTIME_CALL Then Return ""
    If d = UXB_EMIT_WASM_UNSUPPORTED Or d = UXB_EMIT_NATIVE_ONLY Then Return "UXB_WASM_OPCODE_UNSUPPORTED: " & UXBWasmSurfaceTargetStatus(opcodeText)
    Return "WASM emit blocked for opcode " & opcodeText & " decision " & d
End Function

#endif
