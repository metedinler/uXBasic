#ifndef UXB_WASM_BROWSER_LOADER_FBS
#define UXB_WASM_BROWSER_LOADER_FBS

Function UXBWasmBrowserLoaderJs(ByVal wasmPath As String) As String
    Dim p As String
    p = wasmPath
    If Trim(p) = "" Then p = "program.wasm"
    Return "import { uxbWasmImports } from './uxb_wasm_runtime.js';" & Chr(10) & _
           "export async function loadUxbWasm(){ const r=await fetch('" & p & "'); const b=await r.arrayBuffer(); const m=await WebAssembly.instantiate(b, uxbWasmImports); globalThis.uxbWasmInstance=m.instance; return m.instance.exports; }" & Chr(10)
End Function

#endif
