#ifndef UXB_WASM_SOURCE_EMIT_FBS
#define UXB_WASM_SOURCE_EMIT_FBS

Function UXBWasmCommentEscape(ByRef s As String) As String
    Dim outText As String
    Dim i As Integer
    Dim ch As String
    outText = ""
    For i = 1 To Len(s)
        ch = Mid(s, i, 1)
        Select Case ch
        Case Chr(13), Chr(10)
            outText &= " "
        Case ";"
            outText &= ","
        Case Else
            outText &= ch
        End Select
    Next i
    Return outText
End Function

Function UXBWasmInstructionSourceComment(ByRef ins As MIRIRInstruction) As String
    Dim c As String
    c = ""
    If Trim(ins.srcLoc.filePath) <> "" Then c &= Trim(ins.srcLoc.filePath)
    If ins.srcLoc.lineNo > 0 Then
        If c <> "" Then c &= ":"
        c &= LTrim(Str(ins.srcLoc.lineNo))
        If ins.srcLoc.colNo > 0 Then c &= ":" & LTrim(Str(ins.srcLoc.colNo))
    End If
    If Trim(ins.comment) <> "" Then
        If c <> "" Then c &= " "
        c &= Trim(ins.comment)
    End If
    If Trim(ins.srcLoc.lexemeSnippet) <> "" Then c &= " [" & Trim(ins.srcLoc.lexemeSnippet) & "]"
    If c = "" Then Return ""
    Return "      ;; src " & UXBWasmCommentEscape(c) & Chr(10)
End Function

Function UXBWasmBlockSourceComment(ByRef blk As MIRBasicBlock) As String
    Dim i As Integer
    For i = 0 To blk.instructionCount - 1
        If UXBSourceLocationHasData(blk.instructions(i).srcLoc) <> 0 Then
            Return "        ;; block " & Trim(Str(blk.id)) & " first-src " & UXBWasmCommentEscape(UXBSourceLocationLine(blk.instructions(i).srcLoc)) & Chr(10)
        End If
    Next i
    Return ""
End Function

#endif
