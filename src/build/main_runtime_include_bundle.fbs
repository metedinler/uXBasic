#ifndef UXB_MAIN_RUNTIME_INCLUDE_BUNDLE_FBS
#define UXB_MAIN_RUNTIME_INCLUDE_BUNDLE_FBS

' NOTE (found 2026-09-06): array_memory_ref.fbs used to be #include once'd right here,
' but this bundle runs before main_frontend_include_bundle.fbs defines ParseState/
' ASTNode, which array_memory_ref.fbs's functions take as parameters -- that made a
' from-scratch build fail immediately with cascading "not a CLASS/TYPE" parse errors.
' Nothing else in this bundle calls its functions (checked); the file is already
' #include once'd correctly, after the frontend bundle, from
' main_semantic_include_bundle.fbs / main_canonical_mir_include_bundle.fbs, and from
' src/parser/parser/parser_shared.fbs. Removed the misplaced early include here.
' Runtime/bootstrap bundle used by main.bas before the pipeline starts.
' Service-specific runtime files stay in main_runtime_service_include_bundle.fbs.

#include once "../runtime/diagnostics.fbs"
#include once "../runtime/hook_trace.fbs"
#include once "../runtime/console_output.fbs"
#include once "../runtime/project_output_policy.fbs"
#include once "../runtime/native/uxb_runtime_abi.fbs"
#include once "../runtime/native/uxb_runtime_loader.fbs"
#include once "../runtime/compiler_message_bus.fbs"
#include once "../runtime/layer_event_contract.fbs"
#include once "../runtime/error_localization.fbs"
#include once "../runtime/extfp_runtime_status.fbs"
#include once "../runtime/memory_vm.fbs"
#include once "../legacy/get_commands_port.fbs"

#endif
