#ifndef UXB_BUILD_ACTIVE_BIND_PLAN_WRITER_FBS
#define UXB_BUILD_ACTIVE_BIND_PLAN_WRITER_FBS

#include once "../common/active_bind_plan.fbs"
#include once "../common/report_writer.fbs"

Private Function UXBActiveBindTextPathFromJson(ByRef jsonPath As String) As String
    Dim p As String
    p = Trim(jsonPath)
    If p = "" Then Return ""
    If LCase(Right(p, 5)) = ".json" Then Return Left(p, Len(p) - 5) & ".txt"
    Return p & ".txt"
End Function

Function UXBActiveBindPlanToText(ByRef p As UXBActiveBindPlan) As String
    Dim t As String
    t = "uXBasic active bind plan" & Chr(10)
    t &= "entry_count=" & LTrim(Str(p.count)) & Chr(10) & Chr(10)
    t &= "bundle_include_list:" & Chr(10)
    t &= "- build/main_runtime_include_bundle.fbs" & Chr(10)
    t &= "- build/main_runtime_service_include_bundle.fbs" & Chr(10)
    t &= "- build/main_cli_include_bundle.fbs" & Chr(10)
    t &= "- build/main_preprocess_include_bundle.fbs" & Chr(10)
    t &= "- build/main_frontend_include_bundle.fbs" & Chr(10)
    t &= "- build/main_semantic_include_bundle.fbs" & Chr(10)
    t &= "- build/main_type_binding_include_bundle.fbs" & Chr(10)
    t &= "- build/main_layout_include_bundle.fbs" & Chr(10)
    t &= "- build/main_canonical_mir_include_bundle.fbs" & Chr(10)
    t &= "- build/main_interpreter_include_bundle.fbs" & Chr(10)
    t &= "- build/main_backend_include_bundle.fbs" & Chr(10)
    t &= "- build/main_x64_ast_include_bundle.fbs" & Chr(10)
    t &= "- build/main_x64_mir_include_bundle.fbs" & Chr(10)
    t &= "- build/main_web_backend_include_bundle.fbs" & Chr(10)
    t &= "- build/main_artifact_include_bundle.fbs" & Chr(10) & Chr(10)
    t &= "active_route_calls:" & Chr(10)
    Dim i As Integer
    For i = 0 To p.count - 1
        With p.entries(i)
            t &= LTrim(Str(i + 1)) & ". layer=" & .layerName & " gate=" & .gateName & " function=" & .functionName & " status=" & .statusText & " note=" & .noteText & Chr(10)
        End With
    Next i
    Return t
End Function

Function UXBActiveBindPlanWriteAll(ByRef p As UXBActiveBindPlan, ByRef jsonPath As String, ByRef errText As String) As Integer
    errText = ""
    If UXBActiveBindPlanWriteJson(p, jsonPath, errText) = 0 Then Return 0
    Dim txtPath As String
    txtPath = UXBActiveBindTextPathFromJson(jsonPath)
    If Trim(txtPath) = "" Then Return 1
    Return UXBReportWriteText(txtPath, UXBActiveBindPlanToText(p), errText)
End Function

#endif
