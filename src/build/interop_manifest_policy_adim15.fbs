#ifndef UXB_INTEROP_MANIFEST_POLICY_ADIM15_FBS
#define UXB_INTEROP_MANIFEST_POLICY_ADIM15_FBS

Type UXBInteropAdim15Report
    ok As Integer
    importCount As Integer
    includeCount As Integer
    unsafePathCount As Integer
    unsupportedLanguageCount As Integer
    errorsText As String
End Type

Sub UXBInteropAdim15ReportInit(ByRef r As UXBInteropAdim15Report)
    r.ok = 0
    r.importCount = 0
    r.includeCount = 0
    r.unsafePathCount = 0
    r.unsupportedLanguageCount = 0
    r.errorsText = ""
End Sub

Function UXBInteropAdim15IsUnsafePath(ByRef pathText As String) As Integer
    Dim p As String
    p = Trim(pathText)
    If p = "" Then Return 1
    If InStr(p, "..") > 0 Then Return 1
    If InStr(p, "|") > 0 Or InStr(p, "&") > 0 Or InStr(p, ";") > 0 Then Return 1
    If InStr(p, "<") > 0 Or InStr(p, ">") > 0 Then Return 1
    If Len(p) >= 2 Then If Mid(p, 2, 1) = ":" Then Return 1
    If Left(p, 1) = "\" Or Left(p, 1) = "/" Then Return 1
    Return 0
End Function

Function UXBInteropAdim15LanguageSupported(ByRef langText As String) As Integer
    Select Case UCase(Trim(langText))
    Case "C", "CPP", "CXX", "ASM", "NASM", "HEADER", "INCLUDE"
        Return 1
    End Select
    Return 0
End Function

Private Sub UXBInteropAdim15AppendError(ByRef r As UXBInteropAdim15Report, ByRef msg As String)
    If r.errorsText <> "" Then r.errorsText &= Chr(10)
    r.errorsText &= msg
End Sub

Function UXBInteropAdim15ValidateImport(ByRef langText As String, ByRef pathText As String, ByRef errText As String) As Integer
    errText = ""
    If UXBInteropAdim15LanguageSupported(langText) = 0 Then
        errText = "INTEROP_LANGUAGE_ERROR: unsupported import language '" & langText & "'"
        Return 0
    End If
    If UXBInteropAdim15IsUnsafePath(pathText) <> 0 Then
        errText = "INCLUDE_UNSAFE_PATH: " & pathText
        Return 0
    End If
    Return 1
End Function

Function UXBInteropAdim15ValidateManifest(ByRef m As InteropManifest, ByRef targetText As String, ByRef report As UXBInteropAdim15Report, ByRef errText As String) As Integer
    UXBInteropAdim15ReportInit report
    errText = ""
    report.importCount = m.importCount
    report.includeCount = m.includeCount

    Dim i As Integer
    For i = 0 To m.importCount - 1
        Dim e As String
        If UXBInteropAdim15LanguageSupported(m.imports(i).language) = 0 Then
            report.unsupportedLanguageCount += 1
            UXBInteropAdim15AppendError report, "unsupported import language: " & m.imports(i).language
        End If
        If UXBInteropAdim15IsUnsafePath(m.imports(i).importPath) <> 0 Then
            report.unsafePathCount += 1
            UXBInteropAdim15AppendError report, "unsafe import path: " & m.imports(i).importPath
        End If
    Next i

    For i = 0 To m.includeCount - 1
        If UXBInteropAdim15IsUnsafePath(m.includes(i).includePath) <> 0 Then
            report.unsafePathCount += 1
            UXBInteropAdim15AppendError report, "unsafe include path: " & m.includes(i).includePath
        End If
    Next i

    If report.unsafePathCount = 0 And report.unsupportedLanguageCount = 0 Then
        report.ok = 1
        Return 1
    End If

    errText = report.errorsText
    Return 0
End Function

#endif
