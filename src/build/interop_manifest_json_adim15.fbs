#ifndef UXB_INTEROP_MANIFEST_JSON_ADIM15_FBS
#define UXB_INTEROP_MANIFEST_JSON_ADIM15_FBS

Private Function UXBInteropJsonEscapeAdim15(ByRef textIn As String) As String
    Dim outText As String
    Dim i As Integer
    outText = ""
    For i = 1 To Len(textIn)
        Dim ch As String
        ch = Mid(textIn, i, 1)
        Select Case Asc(ch)
        Case 34
            outText &= """" & """"
        Case 92
            outText &= "\\"
        Case 10
            outText &= "\n"
        Case 13
            outText &= "\r"
        Case Else
            If Asc(ch) < 32 Then outText &= "?" Else outText &= ch
        End Select
    Next i
    Return outText
End Function

Function UXBInteropAdim15ManifestJson(ByRef m As InteropManifest, ByRef jsonOut As String) As Integer
    Dim i As Integer
    jsonOut = "{" & Chr(10)
    jsonOut &= "  ""import_count"": " & LTrim(Str(m.importCount)) & "," & Chr(10)
    jsonOut &= "  ""include_count"": " & LTrim(Str(m.includeCount)) & "," & Chr(10)
    jsonOut &= "  ""imports"": [" & Chr(10)
    For i = 0 To m.importCount - 1
        jsonOut &= "    {""language"":""" & UXBInteropJsonEscapeAdim15(m.imports(i).language) & """,""path"":""" & UXBInteropJsonEscapeAdim15(m.imports(i).importPath) & """,""source"":""" & UXBInteropJsonEscapeAdim15(m.imports(i).sourceFile) & """}"
        If i < m.importCount - 1 Then jsonOut &= ","
        jsonOut &= Chr(10)
    Next i
    jsonOut &= "  ]," & Chr(10)
    jsonOut &= "  ""includes"": [" & Chr(10)
    For i = 0 To m.includeCount - 1
        jsonOut &= "    {""path"":""" & UXBInteropJsonEscapeAdim15(m.includes(i).includePath) & """,""source"":""" & UXBInteropJsonEscapeAdim15(m.includes(i).sourceFile) & """}"
        If i < m.includeCount - 1 Then jsonOut &= ","
        jsonOut &= Chr(10)
    Next i
    jsonOut &= "  ]" & Chr(10)
    jsonOut &= "}" & Chr(10)
    Return 1
End Function

Function UXBInteropAdim15WriteManifestJson(ByRef m As InteropManifest, ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""
    Dim j As String
    UXBInteropAdim15ManifestJson m, j
    Dim f As Integer
    f = FreeFile
    Open outPath For Output As #f
    If Err <> 0 Then errText = "interop manifest json open failed: " & outPath: Return 0
    Print #f, j;
    Close #f
    Return 1
End Function

#endif
