' uXBasic ADIM4 AST node kind id bridge.
' Purpose: keep existing ASTNode.kind As String, but provide a stable integer id API.
#ifndef UXBASIC_AST_NODE_KIND_ID_FBS
#define UXBASIC_AST_NODE_KIND_ID_FBS

#include once "ast_node_kinds.fbs"

Private Function UXBAstKindIdIsValidIndex(ByRef p As ASTPool, ByVal nodeIdx As Integer) As Integer
    If nodeIdx < 0 Then Return 0
    If nodeIdx >= p.count Then Return 0
    Return 1
End Function

Enum UXBAstNodeKindId
    UXB_AST_KIND_UNKNOWN = 0
    UXB_AST_KIND_PROGRAM
    UXB_AST_KIND_BLOCK
    UXB_AST_KIND_IDENTIFIER
    UXB_AST_KIND_NUMBER
    UXB_AST_KIND_STRING
    UXB_AST_KIND_BOOLEAN
    UXB_AST_KIND_BINARY
    UXB_AST_KIND_UNARY
    UXB_AST_KIND_CALL_EXPR
    UXB_AST_KIND_CALL_STMT
    UXB_AST_KIND_INDEX_EXPR
    UXB_AST_KIND_MEMBER_EXPR
    UXB_AST_KIND_IF_STMT
    UXB_AST_KIND_FOR_STMT
    UXB_AST_KIND_FOR_EACH_STMT
    UXB_AST_KIND_DO_STMT
    UXB_AST_KIND_SELECT_STMT
    UXB_AST_KIND_CASE_BLOCK
    UXB_AST_KIND_SUB_STMT
    UXB_AST_KIND_FUNCTION_STMT
    UXB_AST_KIND_CLASS_STMT
    UXB_AST_KIND_TYPE_STMT
    UXB_AST_KIND_INTERFACE_STMT
    UXB_AST_KIND_DIM_STMT
    UXB_AST_KIND_DIM_DECL
    UXB_AST_KIND_CONST_STMT
    UXB_AST_KIND_CONST_DECL
    UXB_AST_KIND_ASSIGN_STMT
    UXB_AST_KIND_RETURN_STMT
    UXB_AST_KIND_PRINT_STMT
    UXB_AST_KIND_IMPORT_STMT
    UXB_AST_KIND_INCLUDE_STMT
    UXB_AST_KIND_ALIAS_STMT
    UXB_AST_KIND_USING_STMT
    UXB_AST_KIND_MODULE_STMT
    UXB_AST_KIND_NAMESPACE_STMT
    UXB_AST_KIND_MAIN_STMT
End Enum

Private Function UXBAstKindId_U(ByVal textIn As String) As String
    Return UCase(Trim(textIn))
End Function

Function UXBAstNodeKindIdFromName(ByVal kindName As String) As Integer
    Dim k As String
    k = UXBAstKindId_U(kindName)

    Select Case k
    Case ASTK_PROGRAM: Return UXB_AST_KIND_PROGRAM
    Case ASTK_BLOCK: Return UXB_AST_KIND_BLOCK
    Case ASTK_IDENTIFIER: Return UXB_AST_KIND_IDENTIFIER
    Case ASTK_NUMBER: Return UXB_AST_KIND_NUMBER
    Case ASTK_STRING: Return UXB_AST_KIND_STRING
    Case ASTK_BOOLEAN: Return UXB_AST_KIND_BOOLEAN
    Case ASTK_BINARY: Return UXB_AST_KIND_BINARY
    Case ASTK_UNARY: Return UXB_AST_KIND_UNARY
    Case ASTK_CALL_EXPR: Return UXB_AST_KIND_CALL_EXPR
    Case ASTK_CALL_STMT: Return UXB_AST_KIND_CALL_STMT
    Case ASTK_INDEX_EXPR: Return UXB_AST_KIND_INDEX_EXPR
    Case ASTK_MEMBER_EXPR: Return UXB_AST_KIND_MEMBER_EXPR
    Case ASTK_IF_STMT: Return UXB_AST_KIND_IF_STMT
    Case ASTK_FOR_STMT: Return UXB_AST_KIND_FOR_STMT
    Case ASTK_FOR_EACH_STMT: Return UXB_AST_KIND_FOR_EACH_STMT
    Case ASTK_DO_STMT: Return UXB_AST_KIND_DO_STMT
    Case ASTK_SELECT_STMT: Return UXB_AST_KIND_SELECT_STMT
    Case ASTK_CASE_BLOCK: Return UXB_AST_KIND_CASE_BLOCK
    Case ASTK_SUB_STMT: Return UXB_AST_KIND_SUB_STMT
    Case ASTK_FUNCTION_STMT: Return UXB_AST_KIND_FUNCTION_STMT
    Case ASTK_CLASS_STMT: Return UXB_AST_KIND_CLASS_STMT
    Case ASTK_TYPE_STMT: Return UXB_AST_KIND_TYPE_STMT
    Case ASTK_INTERFACE_STMT: Return UXB_AST_KIND_INTERFACE_STMT
    Case ASTK_DIM_STMT: Return UXB_AST_KIND_DIM_STMT
    Case ASTK_DIM_DECL: Return UXB_AST_KIND_DIM_DECL
    Case ASTK_CONST_STMT: Return UXB_AST_KIND_CONST_STMT
    Case ASTK_CONST_DECL: Return UXB_AST_KIND_CONST_DECL
    Case ASTK_ASSIGN_STMT: Return UXB_AST_KIND_ASSIGN_STMT
    Case ASTK_RETURN_STMT: Return UXB_AST_KIND_RETURN_STMT
    Case ASTK_PRINT_STMT: Return UXB_AST_KIND_PRINT_STMT
    Case ASTK_IMPORT_STMT: Return UXB_AST_KIND_IMPORT_STMT
    Case ASTK_INCLUDE_STMT: Return UXB_AST_KIND_INCLUDE_STMT
    Case ASTK_ALIAS_STMT: Return UXB_AST_KIND_ALIAS_STMT
    Case ASTK_USING_STMT: Return UXB_AST_KIND_USING_STMT
    Case ASTK_MODULE_STMT: Return UXB_AST_KIND_MODULE_STMT
    Case ASTK_NAMESPACE_STMT: Return UXB_AST_KIND_NAMESPACE_STMT
    Case ASTK_MAIN_STMT: Return UXB_AST_KIND_MAIN_STMT
    End Select

    Return UXB_AST_KIND_UNKNOWN
End Function

Function UXBAstNodeKindIdForNode(ByRef p As ASTPool, ByVal nodeIdx As Integer) As Integer
    If UXBAstKindIdIsValidIndex(p, nodeIdx) = 0 Then Return UXB_AST_KIND_UNKNOWN
    Return UXBAstNodeKindIdFromName(p.nodes(nodeIdx).kind)
End Function

#endif
