Private Function CanonicalIdentifier(ByVal word As String) As String
    Return LCase(Trim(word))
End Function

Private Function CanonicalKeyword(ByVal word As String) As String
    Return UCase(CanonicalIdentifier(word))
End Function

Private Function IsKeyword(ByVal word As String) As Integer
    Dim k As String
    k = CanonicalIdentifier(word)

    Select Case k
    Case "if", "then", "else", "elseif", "end", "select", "case", "is"
        Return 1
    Case "try", "catch", "finally", "throw", "assert"
        Return 1
    Case "event", "thread", "paralel", "pipe", "slot", "on", "off", "trigger"
        Return 1
    Case "spawn"
        Return 1
    Case "for", "to", "step", "next", "do", "loop", "while", "wend", "until", "exit", "each", "in"
        Return 1
    Case "sub", "function", "declare", "return", "goto", "gosub", "call"
        Return 1
    Case "type", "struct", "union", "abi", "pack", "align", "class", "interface", "enum", "implements", "method", "magic", "virtual", "override", "constructor", "destructor", "new", "delete", "dim", "redim", "as", "const", "include", "libtype", "import", "abstract", "final", "sealed", "static", "property", "operator", "mixin", "decorator"
        Return 1
    Case "public", "private", "protected", "restricted", "friend", "readonly", "mutable", "immutable"
        Return 1
    Case "main", "namespace", "module", "using", "alias"
        Return 1
    Case "defint", "deflng", "defsng", "defdbl", "defext", "defstr", "defbyt"
        Return 1
    Case "print", "input", "open", "close", "get", "put", "seek"
        Return 1
    Case "cls", "color", "locate"
        Return 1
    Case "and", "or", "andalso", "orelse", "not", "xor", "mod", "shl", "shr", "rol", "ror", "nand", "nor", "xnor", "nxor", "eqv", "eqa", "iff", "imp", "cimp", "nimp", "ncimp", "ida", "idb", "nota", "notb"
        Return 1
    Case "inline", "shell", "timeout", "outvar", "errvar", "codevar", "runpath", "outpath", "errpath"
        Return 1
    Case "i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "f32", "f64", "f80", "f128", "bigf", "bigd", "ball", "boolean", "string", "object", "ptr", "strptr", "byref", "byval", "cdecl", "stdcall", "true", "false", "zero", "one"
        Return 1
    Case "task", "taskgroup"
        Return 1
    Case "array", "list", "dict", "set"
        Return 1
    Case "setstringsize", "timer", "lof", "eof", "len", "mid", "str", "val", "abs", "int", "ucase", "lcase", "asc", "chr", "ltrim", "rtrim", "string", "space", "sgn", "sqrt", "sin", "cos", "tan", "atn", "exp", "log", "inkey", "getkey", "varptr", "sadd", "lptr", "codeptr", "sizeof", "offsetof"
        Return 1
    Case "cint", "clng", "cdbl", "csng", "fix", "sqr", "rnd", "randomize"
        Return 1
    Case "peek", "peeks", "peekb", "peekw", "peekd", "peekq", "native", "poke", "pokeb", "pokew", "poked", "pokeq", "pokes", "memcopyb", "memcopyw", "memcopyd", "memcopyq", "memfillb", "memfillw", "memfilld", "memfillq", "setnewoffset", "inc", "dec"
        Return 1
    Case Else
        Return 0
    End Select
End Function

Private Function KeywordRegistryLookup(ByVal word As String) As Integer
    Return IsKeyword(word)
End Function

Private Function KeywordRequiresIdentifierAfter(ByRef kwText As String) As Integer
    Dim k As String = UCase(Trim(kwText))
    Select Case k
    Case "DIM", "REDIM", "CONST", "FUNCTION", "SUB", "TYPE", "STRUCT", "UNION", "CLASS", "INTERFACE", "ENUM", "NAMESPACE", "MODULE", "ALIAS", "USING", "INCLUDE", "LIBTYPE", "PUBLIC", "PRIVATE", "PROTECTED", "FRIEND", "STATIC", "ABSTRACT", "FINAL", "SEALED", "PROPERTY", "METHOD", "OPERATOR"
        Return 1
    End Select
    Return 0
End Function

Private Function ShouldTreatAsKeyword(ByRef st As LexerState, ByRef identCanonical As String) As Integer
    If KeywordRegistryLookup(identCanonical) = 0 Then Return 0

    If st.tokens.count > 0 Then
        Dim prev As Token
        prev = st.tokens.items(st.tokens.count - 1)

        ' Dot member access allows keyword-like names as identifiers (obj.then, ns.print).
        If prev.kind = "OP" And prev.lexeme = "." Then Return 0

        ' Declaration contexts expect a new user identifier.
        ' Do NOT place AS/BYVAL/BYREF/DECLARE here: signature/type tokens must stay keywords.
        If prev.kind = "KEYWORD" Then
            Dim prevKw As String
            prevKw = UCase(Trim(prev.lexeme))
            Select Case prevKw
            Case "AS", "BYVAL", "BYREF", "DECLARE"
                Return 1
            End Select
            If KeywordRequiresIdentifierAfter(prev.lexeme) <> 0 Then Return 0
        End If

        ' Comma after a declaration list keeps identifier context for DIM a, b AS I32.
        If prev.kind = "OP" And prev.lexeme = "," Then
            Dim i As Integer
            For i = st.tokens.count - 2 To 0 Step -1
                If st.tokens.items(i).kind = "EOL" Then Exit For
                If st.tokens.items(i).kind = "KEYWORD" Then
                    If KeywordRequiresIdentifierAfter(st.tokens.items(i).lexeme) <> 0 Then Return 0
                    Exit For
                End If
            Next i
        End If
    End If

    Return 1
End Function
