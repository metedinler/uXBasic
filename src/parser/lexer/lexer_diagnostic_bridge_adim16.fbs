#ifndef UXB_LEXER_DIAGNOSTIC_BRIDGE_ADIM16_FBS
#define UXB_LEXER_DIAGNOSTIC_BRIDGE_ADIM16_FBS

#include once "../../common/diagnostic.fbs"

Function UXBLexerDiagnosticBridgePush(ByRef outList As UXBDiagnosticList, ByRef codeText As String, ByRef messageText As String, ByRef filePathText As String, ByVal lineNo As Integer, ByVal colNo As Integer, ByRef surfaceText As String = "") As Integer
    Dim srcLocation As SourceLocation
    srcLocation = UXBSourceLocationMake(filePathText, lineNo, colNo, 1, surfaceText)
    Return UXBDiagnosticPush(outList, codeText, UXB_DIAG_ERROR, "lexer", "lex", messageText, srcLocation, surfaceText, "lexer diagnostic bridge")
End Function


Function UXBLexerDiagnosticBridgePushAll(ByRef outList As UXBDiagnosticList, ByRef lexerDiags As LexerDiagnosticList) As Integer
    Dim i As Integer
    For i = 0 To lexerDiags.count - 1
        Dim codeText As String
        codeText = lexerDiags.items(i).code
        If Trim(codeText) = "" Then codeText = "LEXER_DIAGNOSTIC"
        UXBLexerDiagnosticBridgePush outList, codeText, lexerDiags.items(i).message, lexerDiags.items(i).sourceFile, lexerDiags.items(i).lineNo, lexerDiags.items(i).colNo, ""
    Next i
    Return lexerDiags.count
End Function

#endif
