#ifndef UXB_LEXER_NUMERIC_LITERAL_GATE_FBS
#define UXB_LEXER_NUMERIC_LITERAL_GATE_FBS

#include once "../../common/report_writer.fbs"

Function UXBLexerNumericLiteralExpectedBase(ByRef rawText As String) As String
    Dim r As String
    r = UCase(Trim(rawText))
    If Left(r, 2) = "&H" Or Left(r, 2) = "0X" Then Return "HEX"
    If Left(r, 2) = "&O" Or Left(r, 2) = "0O" Then Return "OCT"
    If Left(r, 2) = "&B" Or Left(r, 2) = "%B" Or Left(r, 2) = "0B" Then Return "BIN"
    Return "DEC"
End Function

Function UXBLexerNumericLiteralGate(ByRef tokens As TokenList, ByRef errText As String, ByRef csvOut As String) As Integer
    errText = ""
    csvOut = "index,raw,canonical,base,expected_base,suffix,offset,length,ok,reason" & Chr(10)

    Dim failCount As Integer
    failCount = 0

    Dim i As Integer
    For i = 0 To tokens.count - 1
        If UCase(Trim(tokens.items(i).kind)) = "NUMBER" Then
            Dim expectedBase As String
            expectedBase = UXBLexerNumericLiteralExpectedBase(tokens.items(i).rawLexeme)

            Dim rowOk As Integer
            Dim reasonText As String
            rowOk = 1
            reasonText = "ok"

            If Trim(tokens.items(i).rawLexeme) = "" Then
                rowOk = 0
                reasonText = "numeric rawLexeme is empty"
            ElseIf Trim(tokens.items(i).canonicalLexeme) = "" Then
                rowOk = 0
                reasonText = "numeric canonicalLexeme is empty"
            ElseIf tokens.items(i).length <= 0 Then
                rowOk = 0
                reasonText = "numeric token length is not positive"
            ElseIf Trim(tokens.items(i).numericBase) = "" Then
                rowOk = 0
                reasonText = "numericBase is empty"
            ElseIf UCase(Trim(tokens.items(i).numericBase)) <> expectedBase Then
                rowOk = 0
                reasonText = "numericBase does not match literal prefix"
            End If

            If rowOk = 0 Then failCount += 1

            csvOut &= LTrim(Str(i)) & "," & UXBReportCsvEscape(tokens.items(i).rawLexeme) & "," & UXBReportCsvEscape(tokens.items(i).canonicalLexeme) & "," & UXBReportCsvEscape(tokens.items(i).numericBase) & "," & expectedBase & "," & UXBReportCsvEscape(tokens.items(i).numericSuffix) & "," & LTrim(Str(tokens.items(i).offset)) & "," & LTrim(Str(tokens.items(i).length)) & "," & LTrim(Str(rowOk)) & "," & UXBReportCsvEscape(reasonText) & Chr(10)
        End If
    Next i

    If failCount > 0 Then
        errText = "UXB_LEXER_NUMERIC_LITERAL_GATE_FAIL: count=" & LTrim(Str(failCount))
        Return 0
    End If

    Return 1
End Function

Function UXBLexerNumericLiteralGateWrite(ByRef tokens As TokenList, ByRef outPath As String, ByRef errText As String) As Integer
    Dim csvText As String
    If UXBLexerNumericLiteralGate(tokens, errText, csvText) = 0 Then
        Dim writeErr As String
        writeErr = ""
        UXBReportWriteText outPath, csvText, writeErr
        Return 0
    End If
    Return UXBReportWriteText(outPath, csvText, errText)
End Function

#endif
