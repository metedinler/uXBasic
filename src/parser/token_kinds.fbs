#ifndef UXBASIC_TOKEN_KINDS_FBS
#define UXBASIC_TOKEN_KINDS_FBS

Enum TokKind
    TOK_UNKNOWN = 0
    TOK_EOF
    TOK_EOL
    TOK_KEYWORD
    TOK_IDENT
    TOK_NUMBER
    TOK_STRING
    TOK_OPERATOR
    TOK_COMMENT
End Enum

Function TokKindFromString(ByRef kindText As String) As Integer
    Dim k As String
    k = UCase(Trim(kindText))
    Select Case k
    Case "EOF": Return TOK_EOF
    Case "EOL": Return TOK_EOL
    Case "KEYWORD": Return TOK_KEYWORD
    Case "IDENT": Return TOK_IDENT
    Case "NUMBER": Return TOK_NUMBER
    Case "STRING": Return TOK_STRING
    Case "OP", "OPERATOR": Return TOK_OPERATOR
    Case "COMMENT": Return TOK_COMMENT
    End Select
    Return TOK_UNKNOWN
End Function

Function TokKindToString(ByVal kindValue As Integer) As String
    Select Case kindValue
    Case TOK_EOF: Return "EOF"
    Case TOK_EOL: Return "EOL"
    Case TOK_KEYWORD: Return "KEYWORD"
    Case TOK_IDENT: Return "IDENT"
    Case TOK_NUMBER: Return "NUMBER"
    Case TOK_STRING: Return "STRING"
    Case TOK_OPERATOR: Return "OP"
    Case TOK_COMMENT: Return "COMMENT"
    End Select
    Return "UNKNOWN"
End Function

Type Token
    kind As String                 ' legacy string kind, kept for parser compatibility
    tokKind As Integer             ' enum paralel field for new checks
    lexeme As String               ' legacy canonical lexeme
    rawLexeme As String            ' exact source lexeme when available
    canonicalLexeme As String      ' normalized spelling used by parser
    lineNo As Integer
    colNo As Integer
    sourceFile As String
    offset As Integer              ' 1-based source offset when available
    length As Integer              ' canonical token length
    lexemeLength As Integer        ' legacy alias of length
    numericBase As String          ' DEC/HEX/OCT/BIN for NUMBER tokens
    numericSuffix As String        ' type suffix when present
End Type

Type TokenList
    items(Any) As Token
    count As Integer
    capacity As Integer
End Type

Sub TokenListInit(ByRef t As TokenList)
    t.capacity = 8
    ReDim t.items(t.capacity - 1)
    t.count = 0
End Sub

Private Sub TokenListEnsureCapacity(ByRef t As TokenList, ByVal minSize As Integer)
    If t.capacity >= minSize Then Exit Sub
    Dim newCapacity As Integer
    newCapacity = t.capacity
    If newCapacity < 1 Then newCapacity = 1
    Do While newCapacity < minSize
        newCapacity *= 2
    Loop
    ReDim Preserve t.items(newCapacity - 1)
    t.capacity = newCapacity
End Sub

Sub TokenListPushEx( _
    ByRef t As TokenList, _
    ByVal k As String, _
    ByVal rawText As String, _
    ByVal canonicalText As String, _
    ByVal ln As Integer, _
    ByVal cn As Integer, _
    ByVal sourceFileText As String = "", _
    ByVal offsetValue As Integer = 0, _
    ByVal lengthValue As Integer = 0, _
    ByVal numericBaseText As String = "", _
    ByVal numericSuffixText As String = "" _
)
    TokenListEnsureCapacity t, t.count + 1

    If canonicalText = "" Then canonicalText = rawText
    If lengthValue <= 0 Then lengthValue = Len(rawText)

    t.items(t.count).kind = k
    t.items(t.count).tokKind = TokKindFromString(k)
    t.items(t.count).lexeme = canonicalText
    t.items(t.count).rawLexeme = rawText
    t.items(t.count).canonicalLexeme = canonicalText
    t.items(t.count).lineNo = ln
    t.items(t.count).colNo = cn
    t.items(t.count).sourceFile = sourceFileText
    t.items(t.count).offset = offsetValue
    t.items(t.count).length = lengthValue
    t.items(t.count).lexemeLength = lengthValue
    t.items(t.count).numericBase = numericBaseText
    t.items(t.count).numericSuffix = numericSuffixText
    t.count += 1
End Sub

Sub TokenListPush(ByRef t As TokenList, ByVal k As String, ByVal lx As String, ByVal ln As Integer, ByVal cn As Integer, ByVal sourceFileText As String = "")
    TokenListPushEx t, k, lx, lx, ln, cn, sourceFileText, 0, Len(lx)
End Sub

Sub TokenListClear(ByRef t As TokenList)
    t.count = 0
End Sub

Function TokenListAt(ByRef t As TokenList, ByVal idx As Integer) As Token
    Dim z As Token
    If idx < 0 Or idx >= t.count Then
        z.kind = "EOF"
        z.tokKind = TOK_EOF
        z.lexeme = ""
        z.rawLexeme = ""
        z.canonicalLexeme = ""
        z.lineNo = 0
        z.colNo = 0
        z.sourceFile = ""
        z.offset = 0
        z.length = 0
        z.lexemeLength = 0
        z.numericBase = ""
        z.numericSuffix = ""
        Return z
    End If
    Return t.items(idx)
End Function

#endif

