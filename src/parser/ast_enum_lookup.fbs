#ifndef UXB_AST_ENUM_LOOKUP_FBS
#define UXB_AST_ENUM_LOOKUP_FBS
#include once "ast.fbs"

' Consume values already resolved by the semantic gate, without inventing storage.
Function UXBAstResolveEnumConstant(ByRef ast As ASTPool, ByVal nodeIdx As Integer, ByRef valueOut As String, ByRef typeOut As String, ByRef handledOut As Integer, ByRef errText As String) As Integer
    handledOut = 0
    valueOut = ""
    typeOut = "I32"
    If nodeIdx < 0 Or nodeIdx >= ast.count Then Return 1
    If UCase(Trim(ast.nodes(nodeIdx).kind)) <> "FIELD_EXPR" Then Return 1
    Dim baseIdx As Integer = ast.nodes(nodeIdx).left
    If baseIdx < 0 Or baseIdx >= ast.count Then Return 1
    Dim baseKind As String = UCase(Trim(ast.nodes(baseIdx).kind))
    If baseKind <> "IDENT" And baseKind <> "IDENTIFIER" Then Return 1
    Dim rootName As String = UCase(Trim(ast.nodes(baseIdx).value))
    Dim rootType As String = UCase(Trim(ast.nodes(baseIdx).typeName))
    If rootType <> "" And rootType <> rootName Then Return 1
    Dim declIdx As Integer
    For declIdx = 0 To ast.count - 1
        If UCase(Trim(ast.nodes(declIdx).kind)) <> "ENUM_STMT" Then Continue For
        If UCase(Trim(ast.nodes(declIdx).value)) <> rootName Then Continue For
        handledOut = 1
        Dim memberIdx As Integer = -1
        Dim ch As Integer = ast.nodes(declIdx).firstChild
        Do While ch <> -1
            Dim k As String = UCase(Trim(ast.nodes(ch).kind))
            If k = "ENUM_BASE_TYPE" Then typeOut = ast.nodes(ch).value
            If k = "ENUM_ITEM" And UCase(Trim(ast.nodes(ch).value)) = UCase(Trim(ast.nodes(nodeIdx).value)) Then memberIdx = ch
            ch = ast.nodes(ch).nextSibling
        Loop
        If memberIdx = -1 Then
            errText = "enum: unknown member " & rootName & "." & ast.nodes(nodeIdx).value
            Return 0
        End If
        valueOut = Trim(ast.nodes(memberIdx).op)
        If valueOut = "" Then
            errText = "enum: unresolved constant " & rootName & "." & ast.nodes(nodeIdx).value
            Return 0
        End If
        Return 1
    Next declIdx
    Return 1
End Function
#endif
