' uXBasic ADIM4 AST child accessors.
' Canonical rule:
'   BINARY / UNARY use left/right shortcut.
'   Containers and statements use firstChild/nextSibling + role.
#ifndef UXBASIC_AST_CHILD_ACCESSORS_FBS
#define UXBASIC_AST_CHILD_ACCESSORS_FBS

#include once "ast_contract.fbs"
#include once "ast_node_kind_id.fbs"

Private Function UXBAstChildAccessorIsValidIndex(ByRef p As ASTPool, ByVal nodeIdx As Integer) As Integer
    If nodeIdx < 0 Then Return 0
    If nodeIdx >= p.count Then Return 0
    Return 1
End Function

Function UXBAstAdim04IsBinaryShortcutNode(ByRef p As ASTPool, ByVal nodeIdx As Integer) As Integer
    If UXBAstChildAccessorIsValidIndex(p, nodeIdx) = 0 Then Return 0
    If UCase(Trim(p.nodes(nodeIdx).kind)) = ASTK_BINARY Then Return 1
    Return 0
End Function

Function UXBAstAdim04IsUnaryShortcutNode(ByRef p As ASTPool, ByVal nodeIdx As Integer) As Integer
    If UXBAstChildAccessorIsValidIndex(p, nodeIdx) = 0 Then Return 0
    If UCase(Trim(p.nodes(nodeIdx).kind)) = ASTK_UNARY Then Return 1
    Return 0
End Function

Function UXBAstAdim04UsesShortcutChildren(ByRef p As ASTPool, ByVal nodeIdx As Integer) As Integer
    If UXBAstAdim04IsBinaryShortcutNode(p, nodeIdx) <> 0 Then Return 1
    If UXBAstAdim04IsUnaryShortcutNode(p, nodeIdx) <> 0 Then Return 1
    Return 0
End Function

Function UXBAstAdim04Left(ByRef p As ASTPool, ByVal nodeIdx As Integer) As Integer
    If UXBAstChildAccessorIsValidIndex(p, nodeIdx) = 0 Then Return AST_NULL
    If UXBAstChildAccessorIsValidIndex(p, p.nodes(nodeIdx).left) <> 0 Then Return p.nodes(nodeIdx).left
    Return AST_NULL
End Function

Function UXBAstAdim04Right(ByRef p As ASTPool, ByVal nodeIdx As Integer) As Integer
    If UXBAstChildAccessorIsValidIndex(p, nodeIdx) = 0 Then Return AST_NULL
    If UXBAstChildAccessorIsValidIndex(p, p.nodes(nodeIdx).right) <> 0 Then Return p.nodes(nodeIdx).right
    Return AST_NULL
End Function

Function UXBAstAdim04RoleChildAt(ByRef p As ASTPool, ByVal nodeIdx As Integer, ByRef roleName As String, ByVal ordinal As Integer = 0) As Integer
    If UXBAstChildAccessorIsValidIndex(p, nodeIdx) = 0 Then Return AST_NULL
    If ordinal < 0 Then Return AST_NULL

    Dim want As String
    want = UCase(Trim(roleName))

    Dim ordinalPos As Integer
    ordinalPos = 0

    Dim safety As Integer
    safety = 0

    Dim ch As Integer
    ch = p.nodes(nodeIdx).firstChild
    Do While UXBAstChildAccessorIsValidIndex(p, ch)
        If UCase(Trim(p.nodes(ch).role)) = want Then
            If ordinalPos = ordinal Then Return ch
            ordinalPos += 1
        End If
        ch = p.nodes(ch).nextSibling
        safety += 1
        If safety > p.count Then Exit Do
    Loop

    Return AST_NULL
End Function

Function UXBAstAdim04ListChildAt(ByRef p As ASTPool, ByVal nodeIdx As Integer, ByVal ordinal As Integer) As Integer
    If UXBAstChildAccessorIsValidIndex(p, nodeIdx) = 0 Then Return AST_NULL
    If ordinal < 0 Then Return AST_NULL

    Dim ordinalPos As Integer
    ordinalPos = 0

    Dim safety As Integer
    safety = 0

    Dim ch As Integer
    ch = p.nodes(nodeIdx).firstChild
    Do While UXBAstChildAccessorIsValidIndex(p, ch)
        If ordinalPos = ordinal Then Return ch
        ordinalPos += 1
        ch = p.nodes(ch).nextSibling
        safety += 1
        If safety > p.count Then Exit Do
    Loop

    Return AST_NULL
End Function

Function UXBAstAdim04ChildAt(ByRef p As ASTPool, ByVal nodeIdx As Integer, ByVal ordinal As Integer) As Integer
    If UXBAstChildAccessorIsValidIndex(p, nodeIdx) = 0 Then Return AST_NULL
    If ordinal < 0 Then Return AST_NULL

    If UXBAstAdim04IsBinaryShortcutNode(p, nodeIdx) <> 0 Then
        If ordinal = 0 Then Return UXBAstAdim04Left(p, nodeIdx)
        If ordinal = 1 Then Return UXBAstAdim04Right(p, nodeIdx)
        Return AST_NULL
    End If

    If UXBAstAdim04IsUnaryShortcutNode(p, nodeIdx) <> 0 Then
        If ordinal = 0 Then Return UXBAstAdim04Left(p, nodeIdx)
        Return AST_NULL
    End If

    Return UXBAstAdim04ListChildAt(p, nodeIdx, ordinal)
End Function

Function UXBAstAdim04ChildCount(ByRef p As ASTPool, ByVal nodeIdx As Integer) As Integer
    If UXBAstChildAccessorIsValidIndex(p, nodeIdx) = 0 Then Return 0

    If UXBAstAdim04IsBinaryShortcutNode(p, nodeIdx) <> 0 Then
        Return IIf(UXBAstAdim04Left(p, nodeIdx) <> AST_NULL, 1, 0) + IIf(UXBAstAdim04Right(p, nodeIdx) <> AST_NULL, 1, 0)
    End If

    If UXBAstAdim04IsUnaryShortcutNode(p, nodeIdx) <> 0 Then
        Return IIf(UXBAstAdim04Left(p, nodeIdx) <> AST_NULL, 1, 0)
    End If

    Dim cnt As Integer
    cnt = 0
    Dim ch As Integer
    ch = p.nodes(nodeIdx).firstChild
    Dim safety As Integer
    safety = 0
    Do While UXBAstChildAccessorIsValidIndex(p, ch)
        cnt += 1
        ch = p.nodes(ch).nextSibling
        safety += 1
        If safety > p.count Then Exit Do
    Loop
    Return cnt
End Function

#endif
