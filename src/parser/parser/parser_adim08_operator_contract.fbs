#ifndef UXB_PARSER_ADIM08_OPERATOR_CONTRACT_FBS
#define UXB_PARSER_ADIM08_OPERATOR_CONTRACT_FBS

' uXBasic operator contract - BASIC equality + Logic16 final surface.
' Larger precedence number binds tighter. "=" is context-sensitive:
' statement-lvalue context => ASSIGN_STMT, expression/condition context => EQ comparison.

Function ParserOpCanonical(ByRef opRaw As String) As String
    Dim op As String
    op = UCase(Trim(opRaw))
    Select Case op
    Case "==": Return "="
    Case "!=": Return "<>"
    Case "&&": Return "ANDALSO"
    Case "||": Return "ORELSE"
    Case "NXOR", "EQV", "EQA", "IFF": Return "XNOR"
    Case "ZERO": Return "FALSE"
    Case "ONE": Return "TRUE"
    Case "**": Return "**"
    Case "^": Return "XOR"
    Case Else
        Return op
    End Select
End Function

Function ParserOpPrecedence(ByRef opRaw As String, ByVal assignmentContext As Integer = 0) As Integer
    Dim op As String
    If Trim(opRaw) = "=" And assignmentContext <> 0 Then Return 10
    ' Preserve the source spelling: ^ and XOR share an operation, not precedence.
    If Trim(opRaw) = "^" Then Return 70
    op = ParserOpCanonical(opRaw)
    Select Case op
    Case ".", "CALL", "INDEX", "POST++", "POST--"
        Return 150
    Case "**"
        Return 140
    Case "++", "--", "+U", "-U", "@", "!", "~", "NOT"
        ' Preserve the documented parser behavior: -2 ** 2 is (-2) ** 2.
        Return 145
    Case "*", "/", "\", "%", "MOD"
        Return 120
    Case "+", "-"
        Return 110
    Case "<<", ">>", "SHL", "SHR", "ROL", "ROR"
        Return 100
    Case "=", "<>", "<", "<=", ">", ">="
        Return 90
    Case "&"
        Return 80
    Case "|"
        Return 60
    Case "AND", "ANDALSO", "NAND", "NIMP", "NCIMP"
        Return 50
    Case "XOR", "XNOR"
        Return 45
    Case "OR", "ORELSE", "NOR", "IMP", "CIMP", "IDA", "IDB", "NOTA", "NOTB"
        Return 40
    Case "|>"
        Return 30
    Case "?:"
        Return 20
    Case "+=", "-=", "*=", "/=", "\=", "%=", "&=", "|=", "^=", "<<=", ">>=", "**=", "ROL=", "ROR=", "=+", "=-"
        Return 10
    End Select
    Return 0
End Function

Function ParserOpIsRightAssociative(ByRef opRaw As String, ByVal assignmentContext As Integer = 0) As Integer
    Dim op As String
    op = UCase(Trim(opRaw))
    If op = "=" Then Return IIf(assignmentContext <> 0, 1, 0)
    Select Case op
    Case "**", "?:", "+=", "-=", "*=", "/=", "\=", "%=", "&=", "|=", "^=", "<<=", ">>=", "**=", "ROL=", "ROR=", "=+", "=-"
        Return 1
    End Select
    Return 0
End Function

Function ParserOpIsAssignment(ByRef opRaw As String) As Integer
    Dim op As String
    op = UCase(Trim(opRaw))
    Select Case op
    Case "=", "+=", "-=", "*=", "/=", "\=", "%=", "&=", "|=", "^=", "<<=", ">>=", "**=", "ROL=", "ROR=", "=+", "=-"
        Return 1
    End Select
    Return 0
End Function

Function ParserOpIsLogic16(ByRef opRaw As String) As Integer
    Dim op As String
    op = ParserOpCanonical(opRaw)
    Select Case op
    Case "NAND", "NOR", "XNOR", "IMP", "CIMP", "NIMP", "NCIMP", "IDA", "IDB", "NOTA", "NOTB"
        Return 1
    End Select
    Return 0
End Function

#endif
