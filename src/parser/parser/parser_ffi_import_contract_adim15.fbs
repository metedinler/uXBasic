#ifndef UXB_PARSER_FFI_IMPORT_CONTRACT_ADIM15_FBS
#define UXB_PARSER_FFI_IMPORT_CONTRACT_ADIM15_FBS

#include once "../../runtime/ffi_registry.fbs"

Private Function UXBParserAdim15PathUnsafe(ByRef pathText As String) As Integer
    Dim p As String
    p = Trim(pathText)
    If p = "" Then Return 1
    If InStr(p, "..") > 0 Then Return 1
    If InStr(p, "|") > 0 Or InStr(p, "&") > 0 Or InStr(p, ";") > 0 Then Return 1
    If InStr(p, "<") > 0 Or InStr(p, ">") > 0 Then Return 1
    If Len(p) >= 2 Then If Mid(p, 2, 1) = ":" Then Return 1
    If Left(p, 1) = "\" Or Left(p, 1) = "/" Then Return 1
    Return 0
End Function

Private Function UXBParserAdim15LanguageSupported(ByRef langText As String) As Integer
    Select Case UCase(Trim(langText))
    Case "C", "CPP", "CXX", "ASM", "NASM", "HEADER", "INCLUDE"
        Return 1
    End Select
    Return 0
End Function

Function UXBParserValidateImportIncludeAdim15(ByRef langText As String, ByRef pathText As String, ByRef errText As String) As Integer
    errText = ""
    If UXBParserAdim15LanguageSupported(langText) = 0 Then
        errText = "INTEROP_LANGUAGE_ERROR: unsupported import/include language '" & langText & "'"
        Return 0
    End If
    If UXBParserAdim15PathUnsafe(pathText) <> 0 Then
        errText = "INCLUDE_UNSAFE_PATH: " & pathText
        Return 0
    End If
    Return 1
End Function

Function UXBParserValidateCallFfiAdim15(ByRef kindText As String, ByRef libText As String, ByRef symText As String, ByRef sigText As String, ByRef convText As String, ByRef targetText As String, ByRef errText As String) As Integer
    Dim c As UXBFFIContract
    Return UXBFFIRegistryMakeContract(kindText, libText, symText, sigText, convText, targetText, c, errText)
End Function

#endif
