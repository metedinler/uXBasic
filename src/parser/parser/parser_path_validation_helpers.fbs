#ifndef UXB_PARSER_PATH_VALIDATION_HELPERS_FBS
#define UXB_PARSER_PATH_VALIDATION_HELPERS_FBS

Private Function ParserPathEndsWithCI(ByRef textValue As String, ByRef suffixValue As String) As Integer
    If Len(textValue) < Len(suffixValue) Then Return 0
    Return LCase(Right(textValue, Len(suffixValue))) = LCase(suffixValue)
End Function

Private Function ParserPathHasUnsafeChars(ByRef pathText As String) As Integer
    Dim i As Integer
    For i = 1 To Len(pathText)
        Dim ch As String
        ch = Mid(pathText, i, 1)
        If Asc(ch) < 32 Then Return 1
        Select Case ch
        Case "|", "&", ";", "`", "<", ">"
            Return 1
        End Select
    Next i
    Return 0
End Function

Function ParserPathIsValidIncludePath(ByRef pathText As String) As Integer
    Dim p As String
    p = Trim(pathText)
    If p = "" Then Return 0
    If ParserPathHasUnsafeChars(p) Then Return 0
    If InStr(p, ":") > 0 Then Return 0
    If Left(p, 1) = "\" Or Left(p, 1) = "/" Then Return 0
    Dim pNorm As String
    Dim i As Integer
    pNorm = ""
    For i = 1 To Len(p)
        Dim ch As String
        ch = Mid(p, i, 1)
        If ch = "\" Then ch = "/"
        pNorm &= ch
    Next i
    If InStr("/" & pNorm & "/", "/../") > 0 Then Return 0
    If ParserPathEndsWithCI(p, ".bas") <> 0 Then Return 1
    If ParserPathEndsWithCI(p, ".uxb") <> 0 Then Return 1
    If ParserPathEndsWithCI(p, ".uxbh") <> 0 Then Return 1
    If ParserPathEndsWithCI(p, ".uxmh") <> 0 Then Return 1
    If ParserPathEndsWithCI(p, ".bi") <> 0 Then Return 1
    If ParserPathEndsWithCI(p, ".inc") <> 0 Then Return 1
    Return 0
End Function

Function ParserPathIsValidLibraryTypeManifestPath(ByRef pathText As String) As Integer
    Dim p As String
    p = Trim(pathText)
    If p = "" Then Return 0
    If ParserPathHasUnsafeChars(p) Then Return 0
    If InStr(p, ":") > 0 Then Return 0
    If Left(p, 1) = "\" Or Left(p, 1) = "/" Then Return 0
    Dim pNorm As String
    Dim i As Integer
    pNorm = ""
    For i = 1 To Len(p)
        Dim ch As String
        ch = Mid(p, i, 1)
        If ch = "\" Then ch = "/"
        pNorm &= ch
    Next i
    If InStr("/" & pNorm & "/", "/../") > 0 Then Return 0
    Return ParserPathEndsWithCI(p, ".library_type.json")
End Function

Function ParserPathIsValidImportPath(ByRef langText As String, ByRef pathText As String) As Integer
    Dim p As String
    p = Trim(pathText)
    If p = "" Then Return 0
    If ParserPathHasUnsafeChars(p) Then Return 0
    If InStr(p, ":") > 0 Then Return 0
    If Left(p, 1) = "\" Or Left(p, 1) = "/" Then Return 0
    Select Case UCase(Trim(langText))
    Case "C"
        Return ParserPathEndsWithCI(p, ".c")
    Case "CPP", "CXX"
        Return ParserPathEndsWithCI(p, ".cpp") Or ParserPathEndsWithCI(p, ".cc") Or ParserPathEndsWithCI(p, ".cxx")
    Case "ASM", "NASM"
        Return ParserPathEndsWithCI(p, ".asm") Or ParserPathEndsWithCI(p, ".s")
    End Select
    Return 0
End Function

#endif
