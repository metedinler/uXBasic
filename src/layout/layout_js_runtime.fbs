#ifndef UXB_LAYOUT_JS_RUNTIME_FBS_FBS
#define UXB_LAYOUT_JS_RUNTIME_FBS_FBS
#include once "../type_binding/type_rules.fbs"
Function UXBStep3JsRuntimeType(ByVal typeText As String) As String
    Dim t As String = UXBStep3TypeCanonical(typeText)
    Select Case t
    Case TYPE_I64, TYPE_U64, TYPE_BIGINT
        Return "BigInt"
    Case TYPE_STRING, TYPE_WSTRING
        Return "String"
    Case TYPE_BOOL
        Return "Boolean"
    Case TYPE_F32, TYPE_F64, TYPE_F80, TYPE_F128, TYPE_BIGFLOAT, TYPE_I8, TYPE_U8, TYPE_I16, TYPE_U16, TYPE_I32, TYPE_U32
        Return "Number"
    Case TYPE_ARRAY
        Return "Array"
    Case TYPE_PTR, TYPE_STRPTR, TYPE_WSTRPTR, TYPE_FUNCTION_PTR, TYPE_DLL_HANDLE, TYPE_FILE_HANDLE
        Return "HostHandle"
    End Select
    Return "Object"
End Function
#endif
