#ifndef UXB_LAYOUT_ARRAY_FBS_FBS
#define UXB_LAYOUT_ARRAY_FBS_FBS
#include once "../type_binding/type_rules.fbs"
Function UXBStep3ArrayStride(ByVal elemType As String, ByRef sizeOut As Integer, ByRef alignOut As Integer) As Integer
    sizeOut = UXBStep3TypeSizeBytes(elemType)
    alignOut = UXBStep3TypeAlignBytes(elemType)
    If sizeOut < 1 Then sizeOut = 1
    If alignOut < 1 Then alignOut = 1
    Return 1
End Function
Function UXBStep3ArrayTotalBytes(ByVal elemSize As Integer, ByVal elemCount As Integer) As Integer
    If elemSize < 1 Then elemSize = 1
    If elemCount < 1 Then elemCount = 1
    Return elemSize * elemCount
End Function
#endif
