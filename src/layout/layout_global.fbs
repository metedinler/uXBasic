#ifndef UXB_LAYOUT_GLOBAL_FBS_FBS
#define UXB_LAYOUT_GLOBAL_FBS_FBS
Function UXBStep3GlobalAlign(ByVal rawSize As Integer) As Integer
    If rawSize <= 1 Then Return 1
    If rawSize <= 2 Then Return 2
    If rawSize <= 4 Then Return 4
    If rawSize <= 8 Then Return 8
    Return 16
End Function
Function UXBStep3GlobalStorageClass(ByVal nodeKind As String) As String
    Dim k As String = UCase(Trim(nodeKind))
    If k = "CONST_DECL" Or k = "CONST_STMT" Then Return "RODATA"
    If InStr(k, "STRING") > 0 Then Return "DATA"
    Return "BSS_OR_DATA"
End Function
#endif
