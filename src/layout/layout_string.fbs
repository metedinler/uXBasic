#ifndef UXB_LAYOUT_STRING_FBS_FBS
#define UXB_LAYOUT_STRING_FBS_FBS
Function UXBStep3StringLayout(ByRef sizeOut As Integer, ByRef alignOut As Integer) As Integer
    sizeOut = 8
    alignOut = 8
    Return 1
End Function
Function UXBStep3WStringLayout(ByRef sizeOut As Integer, ByRef alignOut As Integer) As Integer
    sizeOut = 8
    alignOut = 8
    Return 1
End Function
