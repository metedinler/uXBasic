#ifndef UXB_LAYOUT_ABI_WASM_FBS_FBS
#define UXB_LAYOUT_ABI_WASM_FBS_FBS
#include once "../type_binding/type_rules.fbs"
Function UXBStep3WasmValueType(ByVal typeText As String) As String
    Dim t As String = UXBStep3TypeCanonical(typeText)
    Select Case t
    Case TYPE_I64, TYPE_U64, TYPE_BIGINT: Return "i64"
    Case TYPE_F32: Return "f32"
    Case TYPE_F64, TYPE_F80, TYPE_F128, TYPE_BIGFLOAT: Return "f64"
    Case TYPE_STRING, TYPE_WSTRING, TYPE_PTR, TYPE_STRPTR, TYPE_WSTRPTR, TYPE_ARRAY, TYPE_OBJECT, TYPE_TYPEDEF, TYPE_CLASS, TYPE_INTERFACE, TYPE_FUNCTION_PTR, TYPE_DLL_HANDLE, TYPE_FILE_HANDLE
        Return "i32"
    Case TYPE_JS_OBJECT, TYPE_WASM_EXTERNREF
        Return "externref"
    End Select
    Return "i32"
End Function
Function UXBStep3WasmNeedsHostImport(ByVal typeText As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(typeText)
    Select Case t
    Case TYPE_STRING, TYPE_WSTRING, TYPE_OBJECT, TYPE_TYPEDEF, TYPE_CLASS, TYPE_INTERFACE, TYPE_JS_OBJECT, TYPE_WASM_EXTERNREF
        Return 1
    End Select
    Return 0
End Function
#endif
