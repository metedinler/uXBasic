#ifndef UXB_LAYOUT_REGISTRY_FBS
#define UXB_LAYOUT_REGISTRY_FBS
#include once "layout_record.fbs"
Dim Shared gUXBStep3LayoutRecords(Any) As UXBLayoutRecord
Dim Shared gUXBStep3LayoutCount As Integer
Sub UXBStep3LayoutReset()
    gUXBStep3LayoutCount = 0
    ReDim gUXBStep3LayoutRecords(0)
End Sub
Function UXBStep3LayoutRecordAdd(ByRef nameText As String, ByRef kindText As String, ByVal sizeBytes As Integer, ByVal alignBytes As Integer, ByRef storageText As String) As Integer
    If gUXBStep3LayoutCount >= UBound(gUXBStep3LayoutRecords) Then ReDim Preserve gUXBStep3LayoutRecords(gUXBStep3LayoutCount + 128)
    Dim idx As Integer = gUXBStep3LayoutCount
    gUXBStep3LayoutCount += 1
    gUXBStep3LayoutRecords(idx).name = UCase(Trim(nameText))
    gUXBStep3LayoutRecords(idx).layoutKind = UCase(Trim(kindText))
    gUXBStep3LayoutRecords(idx).sizeBytes = sizeBytes
    gUXBStep3LayoutRecords(idx).alignBytes = alignBytes
    gUXBStep3LayoutRecords(idx).storageClass = UCase(Trim(storageText))
    Return idx
End Function
#endif
