#ifndef UXB_LAYOUT_ABI_X64_WIN64_FBS_FBS
#define UXB_LAYOUT_ABI_X64_WIN64_FBS_FBS
#include once "../type_binding/type_rules.fbs"
Const UXB_WIN64_SHADOW_SPACE_BYTES As Integer = 32
Const UXB_WIN64_STACK_ALIGN_BYTES As Integer = 16
Function UXBStep3Win64ArgRegister(ByVal argIndex As Integer, ByVal isFloat As Integer) As String
    If isFloat <> 0 Then
        Select Case argIndex
        Case 0: Return "XMM0"
        Case 1: Return "XMM1"
        Case 2: Return "XMM2"
        Case 3: Return "XMM3"
        End Select
    Else
        Select Case argIndex
        Case 0: Return "RCX"
        Case 1: Return "RDX"
        Case 2: Return "R8"
        Case 3: Return "R9"
        End Select
    End If
    Return "STACK"
End Function
Function UXBStep3Win64ReturnRegister(ByVal typeText As String) As String
    If UXBStep3TypeIsFloat(typeText) <> 0 Then Return "XMM0"
    If UXBStep3TypeCanonical(typeText) = TYPE_VOID Then Return "NONE"
    Return "RAX"
End Function
Function UXBStep3Win64StackFrameSize(ByVal localBytes As Integer) As Integer
    If localBytes < 0 Then localBytes = 0
    Return ((localBytes + UXB_WIN64_SHADOW_SPACE_BYTES + UXB_WIN64_STACK_ALIGN_BYTES - 1) \ UXB_WIN64_STACK_ALIGN_BYTES) * UXB_WIN64_STACK_ALIGN_BYTES
End Function
#endif
