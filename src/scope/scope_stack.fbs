#ifndef UXB_SCOPE_STACK_FBS
#define UXB_SCOPE_STACK_FBS
Type UXBScopeRecord
    id As Integer
    parentId As Integer
    name As String
    kind As String
End Type
Dim Shared gUXBStep3Scopes(Any) As UXBScopeRecord
Dim Shared gUXBStep3ScopeCount As Integer
Dim Shared gUXBStep3CurrentScope As Integer
Sub UXBStep3ScopeReset()
    ReDim gUXBStep3Scopes(127)
    gUXBStep3ScopeCount = 1
    gUXBStep3CurrentScope = 0
    gUXBStep3Scopes(0).id = 0
    gUXBStep3Scopes(0).parentId = -1
    gUXBStep3Scopes(0).name = "GLOBAL"
    gUXBStep3Scopes(0).kind = "GLOBAL"
End Sub
Function UXBStep3ScopeCurrent() As Integer
    Return gUXBStep3CurrentScope
End Function
Function UXBStep3ScopePush(ByRef nameText As String, ByRef kindText As String) As Integer
    If gUXBStep3ScopeCount = 0 Then UXBStep3ScopeReset
    If gUXBStep3ScopeCount >= UBound(gUXBStep3Scopes) Then ReDim Preserve gUXBStep3Scopes(UBound(gUXBStep3Scopes) * 2 + 1)
    Dim id As Integer = gUXBStep3ScopeCount
    gUXBStep3ScopeCount += 1
    gUXBStep3Scopes(id).id = id
    gUXBStep3Scopes(id).parentId = gUXBStep3CurrentScope
    gUXBStep3Scopes(id).name = UCase(Trim(nameText))
    gUXBStep3Scopes(id).kind = UCase(Trim(kindText))
    gUXBStep3CurrentScope = id
    Return id
End Function
Sub UXBStep3ScopePop()
    If gUXBStep3CurrentScope > 0 Then gUXBStep3CurrentScope = gUXBStep3Scopes(gUXBStep3CurrentScope).parentId
End Sub
#endif
