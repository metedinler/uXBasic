#ifndef UXB_BACKEND_PIPELINE_GATE_FBS
#define UXB_BACKEND_PIPELINE_GATE_FBS

#include once "backend_cli_args.fbs"
#include once "common/backend_target.fbs"
#include once "../semantic/mir_model.fbs"
#include once "../semantic/mir_verification_gate.fbs"
#include once "../codegen/x64/mir_x64_abi_gate.fbs"
#include once "../codegen/x64/mir_x64_emit_registry_adim13.fbs"

Type UXBBackendPipelineGateResult
    ok As Integer
    mirOk As Integer
    targetOk As Integer
    x64AbiOk As Integer
    registryOk As Integer
    errorsText As String
    warningsText As String
    mirGate As UXBMIRGateResult
End Type

Sub UXBBackendPipelineGateInit(ByRef r As UXBBackendPipelineGateResult)
    r.ok = 0
    r.mirOk = 0
    r.targetOk = 0
    r.x64AbiOk = 0
    r.registryOk = 0
    r.errorsText = ""
    r.warningsText = ""
    UXBMIRGateInit r.mirGate
End Sub

Private Sub UXBBackendGateAppendError(ByRef r As UXBBackendPipelineGateResult, ByRef msg As String)
    If Len(r.errorsText) > 0 Then r.errorsText &= Chr(10)
    r.errorsText &= msg
End Sub

Private Sub UXBBackendGateAppendWarning(ByRef r As UXBBackendPipelineGateResult, ByRef msg As String)
    If Len(r.warningsText) > 0 Then r.warningsText &= Chr(10)
    r.warningsText &= msg
End Sub

Function UXBNativeBackendTargetGate(ByRef cli As UXBBackendCliArgs, ByRef errText As String) As Integer
    errText = ""
    Dim tgt As String
    tgt = UXBBackendNormalizeTarget(cli.target)

    ' Emeklilik kontrolu "bilinmeyen hedef" kontrolunden ONCE gelmeli: x86_retired
    ' UXBBackendTargetKnown icin zaten "bilinmeyen" sayiliyor, sira ters olursa
    ' kullanici dogru emeklilik mesaji yerine kafa karistirici "tanimsiz hedef" alir.
    If UXBBackendTargetIsRetired(tgt) <> 0 Then
        errText = UXBBackendRetiredTargetMessage(tgt)
        Return 0
    End If

    If UXBBackendTargetKnown(tgt) = 0 Then
        errText = "native backend target tanimsiz: " & cli.target
        Return 0
    End If

    If tgt <> UXB_TARGET_X64 Then
        errText = "Adim13 native backend sadece x64 icindir: " & tgt
        Return 0
    End If

    If UCase(Trim(cli.codegenSourceMode)) <> "MIR" Then
        If Not (tgt = UXB_TARGET_X64 And cli.allowAstX64Fallback <> 0) Then
            errText = "Adim13 native backend kanonik inputu MIR olmalidir"
            Return 0
        End If
    End If

    Return 1
End Function

Function UXBBackendRunMandatoryGates( _
    ByRef m As MIRModule, _
    ByRef cli As UXBBackendCliArgs, _
    ByRef gate As UXBBackendPipelineGateResult _
) As Integer

    UXBBackendPipelineGateInit gate
    Dim errText As String

    If cli.verifyAlreadyPassed <> 0 Then
        gate.mirOk = 1
    Else
        If UXBMIRMandatoryGate(m, gate.mirGate, errText) = 0 Then
            gate.mirOk = 0
            UXBBackendGateAppendError gate, "MIR mandatory gate basarisiz:"
            UXBBackendGateAppendError gate, errText
        Else
            gate.mirOk = 1
        End If
    End If

    If UXBNativeBackendTargetGate(cli, errText) = 0 Then
        gate.targetOk = 0
        UXBBackendGateAppendError gate, errText
    Else
        gate.targetOk = 1
    End If

    If UXBBackendNormalizeTarget(cli.target) = UXB_TARGET_X64 Then
        If UXBMIRX64AbiGateCheckModule(m, errText) = 0 Then
            gate.x64AbiOk = 0
            UXBBackendGateAppendError gate, errText
        Else
            gate.x64AbiOk = 1
        End If

        If UXBMIRX64RegistryGateCheckModule(m, errText) = 0 Then
            gate.registryOk = 0
            UXBBackendGateAppendError gate, errText
        Else
            gate.registryOk = 1
        End If
    End If

    If gate.mirOk <> 0 And gate.targetOk <> 0 And gate.x64AbiOk <> 0 And gate.registryOk <> 0 Then
        gate.ok = 1
        Return 1
    End If

    gate.ok = 0
    Return 0
End Function

#endif
