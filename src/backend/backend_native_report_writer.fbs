#ifndef UXB_BACKEND_NATIVE_REPORT_WRITER_FBS
#define UXB_BACKEND_NATIVE_REPORT_WRITER_FBS

#include once "backend_cli_args.fbs"
#include once "backend_pipeline_result.fbs"
#include once "common/backend_json_report.fbs"
#include once "common/backend_result.fbs"
#include once "../semantic/mir_model.fbs"
#include once "../codegen/x64/mir_x64_emit_registry_adim13.fbs"

Private Function UXBBackendAdim13SaveText(ByVal pathText As String, ByVal contentText As String) As Integer
    If Trim(pathText) = "" Then Return 1
    Dim ff As Integer
    ff = FreeFile
    Open pathText For Output As #ff
    Print #ff, contentText;
    Close #ff
    Return 1
End Function

Private Function UXBBackendAdim13JsonEscape(ByVal rawText As String) As String
    Return UXBBackendJsonEscape(rawText)
End Function

Function UXBBackendBuildNativeMatrixCsv(ByRef m As MIRModule) As String
    Dim outText As String
    outText = "opcode,x64_decision,x86_decision" & Chr(10)

    Dim seen As String
    seen = "|"

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim op As String
                op = UCase(Trim(m.functions(fi).blocks(bi).instructions(ii).opcode))
                If op = "" Then op = "NOP"
                If InStr(seen, "|" & op & "|") = 0 Then
                    seen &= op & "|"
                    outText &= op & "," & UXBMIRX64DecisionForOpcode(op) & ",X86_RETIRED" & Chr(10)
                End If
            Next ii
        Next bi
    Next fi

    Return outText
End Function

Function UXBBackendBuildX64RegistryCsv(ByRef m As MIRModule) As String
    Dim outText As String
    outText = "opcode,decision,reason" & Chr(10)
    Dim seen As String
    seen = "|"

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim op As String
                op = UCase(Trim(m.functions(fi).blocks(bi).instructions(ii).opcode))
                If op = "" Then op = "NOP"
                If InStr(seen, "|" & op & "|") = 0 Then
                    seen &= op & "|"
                    outText &= op & "," & UXBMIRX64DecisionForOpcode(op) & "," & UXBMIRX64ReasonForOpcode(op) & Chr(10)
                End If
            Next ii
        Next bi
    Next fi

    Return outText
End Function

Function UXBBackendBuildX86RegistryCsv(ByRef m As MIRModule) As String
    Dim outText As String
    outText = "opcode,decision,reason" & Chr(10)
    Dim seen As String
    seen = "|"

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim op As String
                op = UCase(Trim(m.functions(fi).blocks(bi).instructions(ii).opcode))
                If op = "" Then op = "NOP"
                If InStr(seen, "|" & op & "|") = 0 Then
                    seen &= op & "|"
                    outText &= op & ",X86_RETIRED,x86 backend emekli edildi; resmi native hedef x64" & Chr(10)
                End If
            Next ii
        Next bi
    Next fi

    Return outText
End Function

Sub UXBBackendWriteAdim13Reports( _
    ByRef m As MIRModule, _
    ByRef cli As UXBBackendCliArgs, _
    ByRef pipelineResult As UXBBackendPipelineResult _
)
    UXBBackendAdim13SaveText cli.nativeMatrixOutPath, UXBBackendBuildNativeMatrixCsv(m)
    UXBBackendAdim13SaveText cli.x64RegistryOutPath, UXBBackendBuildX64RegistryCsv(m)
    UXBBackendAdim13SaveText cli.x86RegistryOutPath, UXBBackendBuildX86RegistryCsv(m)

    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & Chr(34) & "ok" & Chr(34) & ": " & IIf(pipelineResult.ok <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & Chr(34) & "target" & Chr(34) & ": " & Chr(34) & UXBBackendAdim13JsonEscape(pipelineResult.target) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "asm_out" & Chr(34) & ": " & Chr(34) & UXBBackendAdim13JsonEscape(cli.asmOutPath) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "backend_status" & Chr(34) & ": " & Chr(34) & UXBBackendAdim13JsonEscape(pipelineResult.result.status) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "error" & Chr(34) & ": " & Chr(34) & UXBBackendAdim13JsonEscape(pipelineResult.errorsText) & Chr(34) & Chr(10)
    j &= "}" & Chr(10)
    UXBBackendAdim13SaveText cli.artifactJsonOutPath, j
    UXBBackendAdim13SaveText cli.backendReportOutPath, UXBBackendResultToJson(pipelineResult.result)
End Sub

#endif
