#ifndef UXB_BACKEND_DIAGNOSTIC_JSON_ADIM16_FBS
#define UXB_BACKEND_DIAGNOSTIC_JSON_ADIM16_FBS

#include once "../common/diagnostic.fbs"
#include once "../common/source_mapping.fbs"

Function UXBBackendDiagnosticPushNativeOnly(ByRef outList As UXBDiagnosticList, ByRef surfaceText As String, ByRef targetText As String, ByRef srcLocation As SourceLocation) As Integer
    Dim msg As String
    msg = surfaceText & " sadece native hedefte destekleniyor; hedef=" & targetText
    Return UXBDiagnosticPush(outList, "UXB_BACKEND_NATIVE_ONLY", UXB_DIAG_ERROR, "backend", targetText, msg, srcLocation, surfaceText, "JS/WASM hedefi icin host binding veya polyfill gerekir")
End Function

Function UXBBackendSourceMapAddArtifact(ByRef smap As UXBSourceMapList, ByRef surfaceText As String, ByRef backendText As String, ByRef srcLocation As SourceLocation, ByRef artifactText As String) As Integer
    Return UXBSourceMapAdd(smap, surfaceText, "mir", backendText, "artifact", artifactText, srcLocation, artifactText, "OK")
End Function

#endif
