#ifndef UXB_BACKEND_PIPELINE_FBS
#define UXB_BACKEND_PIPELINE_FBS

#include once "backend_cli_args.fbs"
#include once "backend_context_builder.fbs"
#include once "backend_pipeline_gate.fbs"
#include once "backend_pipeline_result.fbs"
#include once "backend_step6.fbs"
#include once "backend_native_report_writer.fbs"
#include once "common/backend_result.fbs"

Function UXBBackendRunPipeline( _
    ByRef mirModule As MIRModule, _
    ByRef cli As UXBBackendCliArgs, _
    ByRef outResult As UXBBackendPipelineResult _
) As Integer

    UXBBackendPipelineResultInit outResult
    outResult.target = UXBBackendNormalizeTarget(cli.target)

    If UXBBackendRunMandatoryGates(mirModule, cli, outResult.gate) = 0 Then
        outResult.ok = 0
        outResult.errorsText = outResult.gate.errorsText
        outResult.warningsText = outResult.gate.warningsText
        outResult.result = UXBBackendResultMake(outResult.target)
        UXBBackendResultFail outResult.result, UXB_BACKEND_E_VERIFY_BLOCK, outResult.errorsText
        UXBBackendWriteAdim13Reports mirModule, cli, outResult
        Return 0
    End If

    cli.verifyAlreadyPassed = 1
    Dim ctxErr As String
    If UXBBackendContextFromCliArgs(outResult.context, cli, ctxErr) = 0 Then
        outResult.ok = 0
        outResult.errorsText = ctxErr
        outResult.result = UXBBackendResultMake(outResult.target)
        UXBBackendResultFail outResult.result, UXB_BACKEND_E_TARGET, ctxErr
        UXBBackendWriteAdim13Reports mirModule, cli, outResult
        Return 0
    End If

    If UXBBackendEmitModuleStep6(mirModule, outResult.context, outResult.result) = 0 Then
        outResult.ok = 0
        outResult.errorsText = outResult.result.errorText
        UXBBackendWriteAdim13Reports mirModule, cli, outResult
        Return 0
    End If

    outResult.ok = 1
    UXBBackendWriteAdim13Reports mirModule, cli, outResult
    Return 1
End Function

#endif
