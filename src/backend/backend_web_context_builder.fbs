#ifndef UXB_BACKEND_WEB_CONTEXT_BUILDER_FBS
#define UXB_BACKEND_WEB_CONTEXT_BUILDER_FBS

#include once "backend_web_cli_args.fbs"
#include once "common/backend_context.fbs"
#include once "common/backend_target.fbs"

Function UXBBackendWebContextFromCliArgs( _
    ByRef ctx As UXBBackendContext, _
    ByRef cli As UXBBackendWebCliArgs, _
    ByRef errText As String _
) As Integer
    errText = ""
    UXBBackendWebCliArgsNormalizeTarget cli
    ctx = UXBBackendContextMake(cli.target)

    ctx.sourcePath = cli.sourcePath
    ctx.jsOutPath = cli.jsOutPath
    ctx.jsRuntimeOutPath = cli.jsRuntimeOutPath
    ctx.watOutPath = cli.watOutPath
    ctx.wasmOutPath = cli.wasmOutPath
    ctx.htmlOutPath = cli.htmlOutPath
    ctx.manifestOutPath = cli.manifestOutPath
    ctx.wasmToolPath = cli.wat2wasmPath
    ctx.backendReportOutPath = cli.backendReportOutPath
    ctx.verifyPassed = cli.verifyAlreadyPassed
    ctx.mirInterpreterPassed = cli.mirInterpreterPassed
    ctx.compareBackend = cli.compareBackend
    ctx.traceEnabled = cli.traceEnabled

    If ctx.target = "" Then
        errText = "web backend target secilmedi"
        Return 0
    End If
    If UXBBackendTargetIsRetired(ctx.target) <> 0 Then
        errText = UXBBackendRetiredTargetMessage(ctx.target)
        Return 0
    End If

    If UXBBackendTargetKnown(ctx.target) = 0 Then
        errText = "web backend target tanimsiz: " & cli.target
        Return 0
    End If
    If UXBBackendTargetIsWeb(ctx.target) = 0 Then
        errText = "web context native hedef alamaz: " & ctx.target
        Return 0
    End If

    If UCase(Trim(cli.codegenSourceMode)) <> "MIR" Then
        errText = "JS/WAT/WASM/BROWSER backend dogrulanmis MIR ister; AST fallback yasak"
        Return 0
    End If
    If cli.requireWasmBinary <> 0 Then
        If Trim(cli.wat2wasmPath) = "" Or Dir(cli.wat2wasmPath) = "" Then
            errText = "WASM binary zorunlu ama wat2wasm bulunamadi: " & cli.wat2wasmPath
            Return 0
        End If
    End If

    UXBBackendContextSetOutputDefaults ctx, "build\web\program"

    ' Output defaults are target conveniences, not proof that an artifact was
    ' requested or emitted. Keep browser manifests honest by clearing paths for
    ' formats that this invocation will not produce.
    If cli.browserEmitMode <> 0 Then
        If cli.watEmitMode = 0 Then ctx.watOutPath = ""
        If cli.wasmEmitMode = 0 Then ctx.wasmOutPath = ""
    End If
    Return 1
End Function

#endif
