#ifndef UXB_BACKEND_STEP6_FBS
#define UXB_BACKEND_STEP6_FBS

#include once "common/backend_context.fbs"
#include once "common/backend_result.fbs"
#include once "common/backend_json_report.fbs"
#include once "../semantic/mir_model.fbs"
#include once "../codegen/x64/x64_codegen.fbs"
#include once "../codegen/js/js_codegen.fbs"
#include once "../codegen/wasm/wasm_codegen.fbs"

Function UXBBackendEmitModuleStep6(ByRef moduleValue As MIRModule, ByRef ctx As UXBBackendContext, ByRef result As UXBBackendResult) As Integer
    Dim tgt As String
    tgt = UXBBackendNormalizeTarget(ctx.target)
    Select Case tgt
    Case UXB_TARGET_X64
        Return UXBX64EmitModuleStep6(moduleValue, ctx, result)
    Case UXB_TARGET_JS, UXB_TARGET_BROWSER
        Return UXBJsBackendEmitModule(moduleValue, ctx, result)
    Case UXB_TARGET_WASM
        Return UXBWasmBackendEmitModule(moduleValue, ctx, result)
    End Select
    result = UXBBackendResultMake(tgt)
    UXBBackendResultFail result, UXB_BACKEND_E_TARGET, "backend target is not mapped: " & tgt
    Return 0
End Function

#endif
