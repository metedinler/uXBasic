#ifndef UXB_BACKEND_NATIVE_ONLY_DIAGNOSTICS_ADIM15_FBS
#define UXB_BACKEND_NATIVE_ONLY_DIAGNOSTICS_ADIM15_FBS

Type UXBNativeOnlyDiagnosticAdim15
    ok As Integer
    code As String
    message As String
    target As String
    surface As String
End Type

Function UXBBackendTargetIsWebAdim15(ByRef targetText As String) As Integer
    Dim t As String
    t = UCase(Trim(targetText))
    If t = "JS" Or t = "WAT" Or t = "WASM" Or t = "BROWSER" Then Return 1
    Return 0
End Function

Function UXBBackendNativeOnlyDiagnosticAdim15(ByRef surfaceText As String, ByRef targetText As String, ByRef d As UXBNativeOnlyDiagnosticAdim15) As Integer
    d.ok = 1
    d.code = "OK"
    d.message = ""
    d.target = UCase(Trim(targetText))
    d.surface = UCase(Trim(surfaceText))

    If UXBBackendTargetIsWebAdim15(targetText) <> 0 Then
        Dim targetUpper As String
        targetUpper = UCase(Trim(targetText))
        d.ok = 0
        ' UXB_FIX: generic native-only code for backend target policy fail-close
        ' UXB_REASON: this gate covers all native-only surfaces, not only FFI.
        ' UXB_TEST: adim14 backend web gate + native-only negative suites.
        Dim surfaceUpper As String
        surfaceUpper = UCase(Trim(surfaceText))
        If (targetUpper = "BROWSER") And (InStr(surfaceUpper, "FFI") > 0 Or InStr(surfaceUpper, "DLL") > 0 Or InStr(surfaceUpper, "API") > 0 Or InStr(surfaceUpper, "DECLARE_EXTERNAL") > 0 Or InStr(surfaceUpper, "CALL_NATIVE") > 0) Then
            d.code = "FFI_NOT_AVAILABLE_ON_BROWSER"
        ElseIf targetUpper = "WASM" Or targetUpper = "WAT" Then
            d.code = "NATIVE_ONLY_UNSUPPORTED_ON_WASM"
        Else
            d.code = "NATIVE_ONLY_UNSUPPORTED_ON_JS"
        End If
        d.message = "surface '" & surfaceText & "' requires native backend and cannot be emitted for target " & targetText
        Return 0
    End If

    Return 1
End Function


Function UXBBackendNativeOnlyDiagnosticCodeForTargetAdim15(ByRef targetText As String) As String
    Dim t As String
    t = UCase(Trim(targetText))
    If t = "BROWSER" Then Return "FFI_NOT_AVAILABLE_ON_BROWSER"
    If t = "WASM" Or t = "WAT" Then Return "NATIVE_ONLY_UNSUPPORTED_ON_WASM"
    If t = "JS" Then Return "NATIVE_ONLY_UNSUPPORTED_ON_JS"
    Return "UXB_NATIVE_ONLY_TARGET"
End Function

Function UXBBackendNativeOnlyDiagnosticJsonAdim15(ByRef d As UXBNativeOnlyDiagnosticAdim15) As String
    Dim okText As String
    If d.ok <> 0 Then okText = "true" Else okText = "false"
    Return "{""ok"":" & okText & ",""code"":""" & d.code & """,""target"":""" & d.target & """,""surface"":""" & d.surface & """,""message"":""" & d.message & """}"
End Function

#endif
