#ifndef UXB_BACKEND_EMIT_POLICY_FBS
#define UXB_BACKEND_EMIT_POLICY_FBS

#include once "backend_target.fbs"
#include once "../../surface/uxb_surface_layer_bridge.fbs"

Const UXB_EMIT_IMPLEMENTED As String = "IMPLEMENTED"
Const UXB_EMIT_RUNTIME_CALL As String = "RUNTIME_CALL"
Const UXB_EMIT_NATIVE_ONLY As String = "NATIVE_ONLY"
Const UXB_EMIT_BROWSER_ONLY As String = "BROWSER_ONLY"
Const UXB_EMIT_WASM_IMPORT As String = "WASM_IMPORT"
Const UXB_EMIT_WASM_UNSUPPORTED As String = "WASM_UNSUPPORTED"
Const UXB_EMIT_BLOCKED As String = "BLOCKED"
Const UXB_EMIT_COMPILE_TIME_ONLY As String = "COMPILE_TIME_ONLY"

Function UXBBackendCanonicalOpcode(ByVal opcodeText As String) As String
    Dim op As String
    op = UCase(Trim(opcodeText))
    If Left(op, 4) = "MIR_" Then op = Mid(op, 5)

    Select Case op
    Case "NOP": Return "NOP"
    Case "LOAD_CONST": Return "CONST"
    Case "CONST": Return "CONST"
    Case "LOCAL_DECL", "GLOBAL_DECL", "PARAM_DECL", "DIM", "DECLARE", "AS": Return "DECL"
    Case "LOAD_LOCAL", "LOAD_GLOBAL", "LOAD_VAR", "LOAD": Return "LOAD"
    Case "STORE_LOCAL", "STORE_GLOBAL", "STORE_VAR", "STORE": Return "STORE"
    Case "+", "ADD": Return "ADD"
    Case "-", "SUB": Return "SUB"
    Case "*", "MUL": Return "MUL"
    Case "/", "DIV": Return "DIV"
    Case "\", "IDIV": Return "IDIV"
    Case "%", "MOD": Return "MOD"
    Case "&", "BAND", "BITAND": Return "AND"
    Case "++": Return "INC"
    Case "--": Return "DEC"
    Case "+=": Return "ADD_ASSIGN"
    Case "-=": Return "SUB_ASSIGN"
    Case "*=": Return "MUL_ASSIGN"
    Case "/=": Return "DIV_ASSIGN"
    Case "\=": Return "IDIV_ASSIGN"
    Case "%=": Return "MOD_ASSIGN"
    Case "<<", "SHL": Return "SHL"
    Case ">>", "SHR": Return "SHR"
    Case "<<=": Return "SHL_ASSIGN"
    Case ">>=": Return "SHR_ASSIGN"
    Case "&=": Return "AND_ASSIGN"
    Case "|", "BOR": Return "OR"
    Case "NAND": Return "NAND"
    Case "NOR": Return "NOR"
    Case "XNOR", "NXOR", "EQV", "EQA", "IFF": Return "XNOR"
    Case "IMP": Return "IMP"
    Case "CIMP": Return "CIMP"
    Case "NIMP": Return "NIMP"
    Case "NCIMP": Return "NCIMP"
    Case "IDA": Return "IDA"
    Case "IDB": Return "IDB"
    Case "NOTA": Return "NOTA"
    Case "NOTB": Return "NOTB"
    Case "|=": Return "OR_ASSIGN"
    Case "**", "POW": Return "POW"
    Case "^", "BXOR", "BITXOR": Return "XOR"
    Case "**=": Return "POW_ASSIGN"
    Case "^=": Return "XOR_ASSIGN"
    Case "=", "==": Return "EQ"
    Case "<>", "!=": Return "NE"
    Case "<": Return "LT"
    Case "<=": Return "LE"
    Case ">": Return "GT"
    Case ">=": Return "GE"
    Case "JMP_IF_FALSE", "JZ": Return "JZ"
    Case "JMP_IF_TRUE", "JNZ": Return "JNZ"
    Case "RETURN", "RET", "EXIT": Return "RET"
    Case "CALL_RUNTIME", "RUNTIME_CALL": Return "CALL_RUNTIME"
    Case "CALL_BUILTIN": Return "CALL_BUILTIN"
    Case "CALL_EXTERNAL": Return "CALL_EXTERNAL"
    Case "CALL_DLL": Return "CALL_DLL"
    Case "CALL_API": Return "CALL_API"
    Case "PRINT": Return "PRINT"
    Case "INPUT": Return "INPUT"
    Case "FILE_OPEN", "OPEN": Return "OPEN"
    Case "FILE_CLOSE", "CLOSE": Return "CLOSE"
    Case "FILE_READ", "GET": Return "GET"
    Case "FILE_WRITE", "PUT": Return "PUT"
    Case "FILE_SEEK", "SEEK": Return "SEEK"
    Case "FILE_DELETE": Return "DELETE_FILE"
    Case "FILE_EOF", "EOF": Return "EOF"
    Case "FILE_LOF", "LOF": Return "LOF"
    Case "MEM_LOAD", "PEEK", "PEEKS", "PEEKB", "PEEKW", "PEEKD", "PEEKQ", "MIR_MEMORY_LOAD", "MIR_MEMORY_READ_SEQUENCE": Return "MEMORY"
    Case "MEM_STORE", "POKE", "POKEB", "POKEW", "POKED", "POKEQ", "POKES", "MIR_MEMORY_STORE", "MIR_MEMORY_WRITE_SEQUENCE": Return "MEMORY"
    Case "MEM_COPY", "MEMCOPY", "MEMCOPYB", "MEMCOPYW", "MEMCOPYD", "MEMCOPYQ", "MIR_MEMORY_COPY": Return "MEMCOPY"
    Case "MEM_FILL", "MEMFILL", "MEMFILLB", "MEMFILLW", "MEMFILLD", "MEMFILLQ", "MIR_MEMORY_FILL": Return "MEMFILL"
    Case "ARRAY_LOAD": Return "LOAD_INDEXED"
    Case "ARRAY_STORE": Return "STORE_INDEXED"
    Case "ARRAY_NEW", "ARRAY", "REDIM": Return "REDIM"
    Case "FIELD_LOAD": Return "LOAD_FIELD"
    Case "FIELD_STORE": Return "STORE_FIELD"
    Case "OBJECT_NEW", "NEW": Return "NEW"
    Case "STR_LEN": Return "LEN"
    Case "STR_LEFT": Return "LEFT"
    Case "STR_RIGHT": Return "RIGHT"
    Case "STR_MID": Return "MID"
    Case "STR_COMPARE": Return "STR_COMPARE"
    Case "STRING_CONST": Return "CONST"
    Case "CONCAT", "STR_CONCAT": Return "STR_CONCAT"
    Case "@", "VARPTR", "SADD", "ADDR_OF": Return "ADDR_OF"
    Case "CODEPTR", "LPTR", "TYPEOF", "SIZEOF", "OFFSETOF": Return op
    Case "HOST_CALL", "LIBRARY_CALL", "JS_CALL", "BROWSER_CALL", "EXTFP_CALL": Return op
    Case "WASM_IMPORT", "WASM_EXPORT": Return op
    Case "TYPE_DECL", "CLASS_DECL", "METHOD_DECL", "INTERFACE_DECL", "PROPERTY_DECL", "OPERATOR_DECL", "CONSTRUCTOR_DECL", "DESTRUCTOR_DECL", "IMPLEMENTS_DECL", "CLASS", "TYPE", "INTERFACE", "METHOD", "PROPERTY", "OPERATOR", "CONSTRUCTOR", "DESTRUCTOR", "IMPLEMENTS": Return "METADATA_ONLY"
    Case "ABSTRACT", "ALIAS", "BYREF", "BYVAL", "CDECL", "FINAL", "FRIEND", "IMMUTABLE", "IMPORT", "INCLUDE", "MODULE", "MUTABLE", "NAMESPACE", "PRIVATE", "PROTECTED", "PUBLIC", "READONLY", "RESTRICTED", "SEALED", "STATIC", "STDCALL", "USING", "MAIN", "DEFBYT", "DEFDBL", "DEFEXT", "DEFINT", "DEFLNG", "DEFSNG", "DEFSTR": Return "METADATA_ONLY"
    Case "BOOLEAN", "BYTE", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64", "F80", "F128", "BALL", "BIGD", "BIGF", "BIGINT", "OBJECT", "PTR", "STRING", "STRPTR", "ANY", "VARIANT", "VOID", "LIST", "DICT", "SET": Return "METADATA_ONLY"
    Case "DECORATOR", "MAGIC", "MAGIC", "MIXIN", "OVERRIDE", "VIRTUAL", "PARALEL", "PARALEL", "THREAD": Return "METADATA_ONLY"
    Case "NATIVE_ONLY", "WASM_UNSUPPORTED", "DIAGNOSTIC_ONLY", "RESERVED_NODE", "BROKEN_NODE": Return op
    End Select

    If UXBSurfaceKnown(op) <> 0 Then
        Dim surfaceMir As String
        surfaceMir = UXBSurfaceMirOpcode(op)
        If surfaceMir <> "" Then
            If Left(surfaceMir, 4) = "MIR_" Then Return Mid(surfaceMir, 5)
            Return surfaceMir
        End If
    End If
    Return op
End Function

Function UXBBackendOpcodeFamily(ByVal opcodeText As String) As String
    Dim op As String
    op = UXBBackendCanonicalOpcode(opcodeText)
    Select Case op
    Case "NOP", "METADATA_ONLY": Return "META"
    Case "CONST", "DECL", "LOAD", "STORE": Return "STORAGE"
    Case "ADD", "SUB", "MUL", "DIV", "IDIV", "MOD", "NEG", "INC", "DEC", "FADD", "FSUB", "FMUL", "FDIV", "FNEG", "SHL", "SHR", "ROL", "ROR", "POW", "BAND", "BOR", "BXOR", "BNOT", "ADD_ASSIGN", "SUB_ASSIGN", "MUL_ASSIGN", "DIV_ASSIGN", "IDIV_ASSIGN", "MOD_ASSIGN", "SHL_ASSIGN", "SHR_ASSIGN", "AND_ASSIGN", "OR_ASSIGN", "XOR_ASSIGN", "POW_ASSIGN": Return "ARITH"
    Case "EQ", "NE", "LT", "LE", "GT", "GE", "AND", "OR", "XOR", "NAND", "NOR", "XNOR", "IMP", "CIMP", "NIMP", "NCIMP", "IDA", "IDB", "NOTA", "NOTB", "NOT", "CAST", "COERCE", "TYPEOF", "SIZEOF", "OFFSETOF", "CODEPTR", "LPTR", "ADDR_OF": Return "EXPR"
    Case "LABEL", "JMP", "JZ", "JNZ", "RET", "BREAK", "CONTINUE", "FOR_EACH_BEGIN", "FOR_EACH_NEXT", "UNTIL_CHECK", "GOTO", "GOSUB", "TRY", "CATCH", "FINALLY", "THROW", "ASSERT": Return "CONTROL"
    Case "CALL", "CALL_BUILTIN", "CALL_RUNTIME", "CALL_EXTERNAL", "CALL_DLL", "CALL_API", "METHOD_CALL", "VIRTUAL_CALL": Return "CALL"
    Case "PRINT", "INPUT", "CLS", "COLOR", "LOCATE", "TIMER", "RND", "RANDOMIZE", "GETKEY", "INKEY", "ON", "OFF": Return "RUNTIME"
    Case "STR_NEW", "STR_ASSIGN", "STR_CONCAT", "STR_CONCAT_ASSIGN", "LEN", "LEFT", "RIGHT", "MID", "STR_COMPARE", "ASC", "CHR", "VAL", "STR", "LCASE", "UCASE", "LTRIM", "RTRIM", "TRIM", "SPACE", "INSTR", "HEX", "OCT", "BIN": Return "STRING"
    Case "ABS", "SQR", "SQRT", "SIN", "COS", "TAN", "ATN", "LOG", "EXP", "FIX", "INT", "SGN", "CINT", "CLNG", "CSNG", "CDBL", "BIGINIT": Return "BUILTIN"
    Case "REDIM", "LOAD_INDEXED", "STORE_INDEXED", "NEW", "LOAD_FIELD", "STORE_FIELD", "DELETE_OBJECT": Return "OBJECT"
    Case "PEEK", "POKE", "MEMCOPY", "MEMFILL", "SETNEWOFFSET": Return "MEMORY"
    Case "OPEN", "CLOSE", "GET", "PUT", "SEEK", "DELETE", "DELETE_FILE", "EOF", "LOF", "PRINT_FILE", "INPUT_FILE", "LINE_INPUT_FILE": Return "FILE"
    Case "JS_CALL", "BROWSER_CALL", "WASM_IMPORT", "WASM_EXPORT", "HOST_CALL", "LIBRARY_CALL", "EXTFP_CALL", "JSON", "REGEX", "HTTP", "OS", "STRINGX", "LLAMA", "LUA", "PROLOG", "SQLITE", "CURL", "CRYPTO", "ARCHIVE", "IMAGE", "AUDIO", "MATH", "GRAPHICS", "SERVER", "ONNX", "WEBGPU", "BROWSER", "CANVAS", "EVENT", "THREAD", "PIPE", "SLOT", "TRIGGER": Return "HOST"
    Case "NATIVE_ONLY", "WASM_UNSUPPORTED", "DIAGNOSTIC_ONLY", "RESERVED_NODE", "BROKEN_NODE": Return "FAIL_CLOSED"
    End Select
    If UXBSurfaceKnown(op) <> 0 Then
        Dim sg As String
        sg = UXBSurfaceGroup(op)
        Select Case sg
        Case "OPERATOR": Return "ARITH"
        Case "BUILTIN": Return "BUILTIN"
        Case "IO": Return "RUNTIME"
        Case "MEMORY": Return "MEMORY"
        Case "LIBRARY": Return "HOST"
        Case "TYPE", "COLLECTION", "COMPILE_TIME", "FILE_TYPE", "MODULE": Return "META"
        End Select
    End If
    Return "HOST"
End Function

Function UXBBackendTargetDecisionForOpcode(ByVal opcodeText As String, ByVal targetText As String) As String
    Dim fam As String
    Dim op As String
    Dim tgt As String
    op = UXBBackendCanonicalOpcode(opcodeText)
    fam = UXBBackendOpcodeFamily(op)
    tgt = UXBBackendNormalizeTarget(targetText)

    If fam = "FAIL_CLOSED" Then Return UXB_EMIT_BLOCKED
    If fam = "META" Then Return UXB_EMIT_COMPILE_TIME_ONLY

    Select Case tgt
    Case UXB_TARGET_X64
        If op = "JS_CALL" Or op = "BROWSER_CALL" Or op = "WASM_EXPORT" Or op = "WASM_IMPORT" Then Return UXB_EMIT_BROWSER_ONLY
        If fam = "HOST" Or fam = "FILE" Or fam = "RUNTIME" Or fam = "STRING" Or fam = "BUILTIN" Then Return UXB_EMIT_RUNTIME_CALL
        Return UXB_EMIT_IMPLEMENTED

    Case UXB_TARGET_JS, UXB_TARGET_BROWSER
        If op = "CALL_DLL" Or op = "CALL_API" Or op = "NATIVE_ONLY" Then Return UXB_EMIT_NATIVE_ONLY
        Return UXB_EMIT_IMPLEMENTED

    Case UXB_TARGET_WASM
        If op = "CALL_DLL" Or op = "CALL_API" Or op = "NATIVE_ONLY" Or op = "PEEK" Or op = "POKE" Or op = "INLINE" Or op = "ASM" Then Return UXB_EMIT_WASM_UNSUPPORTED
        Select Case fam
        Case "STORAGE", "ARITH", "EXPR", "CONTROL"
            Return UXB_EMIT_IMPLEMENTED
        Case "MEMORY", "FILE"
            Return UXB_EMIT_WASM_UNSUPPORTED
        Case "RUNTIME", "STRING", "BUILTIN", "CALL", "HOST", "OBJECT"
            Return UXB_EMIT_WASM_IMPORT
        End Select
    End Select

    Return UXB_EMIT_BLOCKED
End Function

Function UXBBackendOpcodeCanEmit(ByVal opcodeText As String, ByVal targetText As String) As Integer
    Dim d As String
    d = UXBBackendTargetDecisionForOpcode(opcodeText, targetText)
    If d = UXB_EMIT_IMPLEMENTED Or d = UXB_EMIT_RUNTIME_CALL Or d = UXB_EMIT_WASM_IMPORT Or d = UXB_EMIT_COMPILE_TIME_ONLY Then Return 1
    Return 0
End Function

#endif

