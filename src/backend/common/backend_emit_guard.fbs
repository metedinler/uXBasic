#ifndef UXB_BACKEND_EMIT_GUARD_FBS
#define UXB_BACKEND_EMIT_GUARD_FBS

#include once "backend_emit_policy.fbs"

Function UXBBackendGuardCanEmit(ByVal opcodeText As String, ByVal targetText As String, ByRef decisionOut As String, ByRef reasonOut As String) As Integer
    decisionOut = UXBBackendTargetDecisionForOpcode(opcodeText, targetText)
    If decisionOut = UXB_EMIT_IMPLEMENTED Or decisionOut = UXB_EMIT_RUNTIME_CALL Or decisionOut = UXB_EMIT_WASM_IMPORT Or decisionOut = UXB_EMIT_COMPILE_TIME_ONLY Then
        reasonOut = ""
        Return 1
    End If
    reasonOut = "backend target cannot emit opcode=" & UXBBackendCanonicalOpcode(opcodeText) & " target=" & UXBBackendNormalizeTarget(targetText) & " decision=" & decisionOut
    Return 0
End Function

#endif
