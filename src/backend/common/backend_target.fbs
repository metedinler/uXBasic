#ifndef UXB_BACKEND_TARGET_FBS
#define UXB_BACKEND_TARGET_FBS

Const UXB_TARGET_X64 As String = "x64"
Const UXB_TARGET_X86 As String = "x86"
Const UXB_TARGET_X86_RETIRED As String = "x86_retired"
Const UXB_TARGET_JS As String = "js"
Const UXB_TARGET_WAT As String = "wat"
Const UXB_TARGET_WASM As String = "wasm"
Const UXB_TARGET_BROWSER As String = "browser"

Function UXBBackendUpper(ByVal textValue As String) As String
    Return UCase(Trim(textValue))
End Function

Function UXBBackendNormalizeTarget(ByVal targetText As String) As String
    Dim t As String
    t = LCase(Trim(targetText))
    Select Case t
    Case "", "native", "win64", "windows64", "amd64", "x86_64"
        Return UXB_TARGET_X64
    Case "x86", "win32", "windows32", "i386", "i686"
        Return UXB_TARGET_X86_RETIRED
    Case "javascript", "node", "nodejs", "ecmascript", "jsw"
        Return UXB_TARGET_JS
    Case "wat"
        Return UXB_TARGET_WAT
    Case "webassembly", "wasm"
        Return UXB_TARGET_WASM
    Case "web", "html", "browser-js"
        Return UXB_TARGET_BROWSER
    End Select
    Return t
End Function

Function UXBBackendTargetKnown(ByVal targetText As String) As Integer
    Dim t As String
    t = UXBBackendNormalizeTarget(targetText)
    Select Case t
    Case UXB_TARGET_X64, UXB_TARGET_JS, UXB_TARGET_WAT, UXB_TARGET_WASM, UXB_TARGET_BROWSER
        Return 1
    End Select
    Return 0
End Function

' x86 kod uretimi bilincli olarak emekli edildi (uXBasic resmi native hedefi x64).
' UXBBackendTargetKnown bunu "bilinmeyen hedef" olarak raporlar; cagiran taraflar
' once bu fonksiyonla kontrol edip dogru/dogrudan bir emeklilik mesaji vermeli.
Function UXBBackendTargetIsRetired(ByVal targetText As String) As Integer
    If UXBBackendNormalizeTarget(targetText) = UXB_TARGET_X86_RETIRED Then Return 1
    Return 0
End Function

Function UXBBackendRetiredTargetMessage(ByVal targetText As String) As String
    Return "x86 hedefi emekli edildi: uXBasic artik x86 (32-bit) kod uretmiyor. " & _
           "uXBasic'in resmi native hedefi x64'tur; --target x64 veya x64 verb'ini kullanin."
End Function

Function UXBBackendTargetIsWeb(ByVal targetText As String) As Integer
    Dim t As String
    t = UXBBackendNormalizeTarget(targetText)
    If t = UXB_TARGET_JS Or t = UXB_TARGET_WAT Or t = UXB_TARGET_WASM Or t = UXB_TARGET_BROWSER Then Return 1
    Return 0
End Function

Function UXBBackendTargetDefaultExtension(ByVal targetText As String) As String
    Dim t As String
    t = UXBBackendNormalizeTarget(targetText)
    Select Case t
    Case UXB_TARGET_X64: Return ".asm"
    Case UXB_TARGET_X86_RETIRED: Return ".x86.retired.txt"
    Case UXB_TARGET_JS: Return ".js"
    Case UXB_TARGET_WAT: Return ".wat"
    Case UXB_TARGET_WASM: Return ".wasm"
    Case UXB_TARGET_BROWSER: Return ".html"
    End Select
    Return ".out"
End Function

#endif
