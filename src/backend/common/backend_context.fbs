#ifndef UXB_BACKEND_CONTEXT_FBS
#define UXB_BACKEND_CONTEXT_FBS

#include once "backend_target.fbs"

Const UXB_BACKEND_STDOUT_JSON As String = "json"
Const UXB_BACKEND_STDOUT_BUFFER As String = "buffer"
Const UXB_BACKEND_STDOUT_SCREEN As String = "screen"
Const UXB_BACKEND_STDOUT_PRINTER As String = "printer"
Const UXB_BACKEND_STDOUT_HOST As String = "host"
Const UXB_BACKEND_STDOUT_SILENT As String = "silent"

Type UXBBackendContext
    target As String
    sourcePath As String
    asmOutPath As String
    objOutPath As String
    exeOutPath As String
    jsOutPath As String
    jsRuntimeOutPath As String
    watOutPath As String
    wasmOutPath As String
    htmlOutPath As String
    manifestOutPath As String
    wasmToolPath As String
    runtimeReportOutPath As String
    backendReportOutPath As String
    stdoutChannel As String
    verifyPassed As Integer
    mirInterpreterPassed As Integer
    compareBackend As Integer
    traceEnabled As Integer
    errorText As String
End Type

Function UXBBackendContextMake(ByVal targetText As String) As UXBBackendContext
    Dim ctx As UXBBackendContext
    ctx.target = UXBBackendNormalizeTarget(targetText)
    If ctx.target = "" Then ctx.target = UXB_TARGET_X64
    ctx.stdoutChannel = UXB_BACKEND_STDOUT_BUFFER
    ctx.verifyPassed = 0
    ctx.mirInterpreterPassed = 0
    ctx.compareBackend = 1
    ctx.traceEnabled = 0
    ctx.errorText = ""
    Return ctx
End Function

Sub UXBBackendContextSetOutputDefaults(ByRef ctx As UXBBackendContext, ByVal basePath As String)
    Dim b As String
    b = Trim(basePath)
    If b = "" Then b = "build\\program"
    If ctx.asmOutPath = "" Then ctx.asmOutPath = b & ".asm"
    If ctx.objOutPath = "" Then ctx.objOutPath = b & ".obj"
    If ctx.exeOutPath = "" Then ctx.exeOutPath = b & ".exe"
    If ctx.jsOutPath = "" Then ctx.jsOutPath = b & ".js"
    If ctx.jsRuntimeOutPath = "" Then ctx.jsRuntimeOutPath = b & ".runtime.js"
    If ctx.watOutPath = "" Then ctx.watOutPath = b & ".wat"
    If ctx.wasmOutPath = "" Then ctx.wasmOutPath = b & ".wasm"
    If ctx.backendReportOutPath = "" Then ctx.backendReportOutPath = b & ".backend.json"
End Sub

Function UXBBackendContextReadyForEmit(ByRef ctx As UXBBackendContext, ByRef errText As String) As Integer
    errText = ""
    If UXBBackendTargetIsRetired(ctx.target) <> 0 Then
        errText = UXBBackendRetiredTargetMessage(ctx.target)
        Return 0
    End If

    If UXBBackendTargetKnown(ctx.target) = 0 Then
        errText = "backend target is not mapped: " & ctx.target
        Return 0
    End If
    If ctx.verifyPassed = 0 Then
        errText = "MIR verify did not pass"
        Return 0
    End If
    If ctx.compareBackend <> 0 And ctx.mirInterpreterPassed = 0 Then
        errText = "MIR interpreter reference is required before backend compare"
        Return 0
    End If
    Return 1
End Function

#endif
