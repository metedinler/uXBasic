#ifndef UXB_BACKEND_RESULT_FBS
#define UXB_BACKEND_RESULT_FBS

#include once "backend_error_codes.fbs"
#include once "backend_target.fbs"

Const UXB_BACKEND_STATUS_PASS As String = "PASS"
Const UXB_BACKEND_STATUS_FAIL As String = "FAIL"
Const UXB_BACKEND_STATUS_EMITTED As String = "EMITTED"
Const UXB_BACKEND_STATUS_BLOCKED_VERIFY As String = "BLOCKED_BY_VERIFY"
Const UXB_BACKEND_STATUS_BLOCKED_INTERP As String = "BLOCKED_BY_INTERPRETER"
Const UXB_BACKEND_STATUS_EXTERNAL_TOOL_MISSING As String = "EXTERNAL_TOOL_MISSING"
Const UXB_BACKEND_STATUS_SKIPPED_EXTERNAL_TOOL As String = "SKIPPED_EXTERNAL_TOOL"

Type UXBBackendResult
    target As String
    status As String
    code As Integer
    emittedPath As String
    auxPath As String
    externalToolPath As String
    outputText As String
    errorText As String
    logText As String
End Type

Function UXBBackendResultMake(ByVal targetText As String) As UXBBackendResult
    Dim r As UXBBackendResult
    r.target = UXBBackendNormalizeTarget(targetText)
    r.status = UXB_BACKEND_STATUS_FAIL
    r.code = UXB_BACKEND_E_EMIT
    Return r
End Function

Sub UXBBackendResultPass(ByRef r As UXBBackendResult, ByVal outPath As String, ByVal logText As String = "")
    r.status = UXB_BACKEND_STATUS_PASS
    r.code = UXB_BACKEND_OK
    r.emittedPath = outPath
    r.logText = logText
    r.errorText = ""
End Sub

Sub UXBBackendResultFail(ByRef r As UXBBackendResult, ByVal codeValue As Integer, ByVal textValue As String)
    r.status = UXB_BACKEND_STATUS_FAIL
    r.code = codeValue
    r.errorText = textValue
End Sub

Function UXBBackendJsonEscape(ByVal rawText As String) As String
    Dim outText As String
    Dim i As Integer
    Dim c As String
    outText = ""
    For i = 1 To Len(rawText)
        c = Mid(rawText, i, 1)
        Select Case c
        Case Chr(34): outText &= "\" & Chr(34)
        Case "\": outText &= "\\"
        Case Chr(10): outText &= "\n"
        Case Chr(13): outText &= "\r"
        Case Chr(9): outText &= "\t"
        Case Else: outText &= c
        End Select
    Next i
    Return outText
End Function

Function UXBBackendResultToJson(ByRef r As UXBBackendResult) As String
    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & Chr(34) & "target" & Chr(34) & ": " & Chr(34) & UXBBackendJsonEscape(r.target) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "status" & Chr(34) & ": " & Chr(34) & UXBBackendJsonEscape(r.status) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "code" & Chr(34) & ": " & Str(r.code) & "," & Chr(10)
    j &= "  " & Chr(34) & "emitted_path" & Chr(34) & ": " & Chr(34) & UXBBackendJsonEscape(r.emittedPath) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "aux_path" & Chr(34) & ": " & Chr(34) & UXBBackendJsonEscape(r.auxPath) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "external_tool" & Chr(34) & ": " & Chr(34) & UXBBackendJsonEscape(r.externalToolPath) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "error" & Chr(34) & ": " & Chr(34) & UXBBackendJsonEscape(r.errorText) & Chr(34) & Chr(10)
    j &= "}"
    Return j
End Function

#endif
