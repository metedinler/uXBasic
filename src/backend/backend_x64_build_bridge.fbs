#ifndef UXB_BACKEND_X64_BUILD_BRIDGE_FBS
#define UXB_BACKEND_X64_BUILD_BRIDGE_FBS

#include once "backend_cli_args.fbs"

' Adim13 notu:
' Bu köprü ASM -> OBJ/EXE işini x64_build_pipeline.fbs içindeki mevcut
' build fonksiyonlarına bağlamak için ayrılmıştır. İlk geçişte ASM emit
' başarısını bozmaz; EXE build açıkça istenirse mevcut pipeline çağrılır.

Type UXBX64BuildBridgeResult
    ok As Integer
    asmPath As String
    objPath As String
    exePath As String
    errorText As String
End Type

Sub UXBX64BuildBridgeResultInit(ByRef r As UXBX64BuildBridgeResult)
    r.ok = 0
    r.asmPath = ""
    r.objPath = ""
    r.exePath = ""
    r.errorText = ""
End Sub

Function UXBX64BuildBridgeCheckAsm(ByRef cli As UXBBackendCliArgs, ByRef r As UXBX64BuildBridgeResult) As Integer
    UXBX64BuildBridgeResultInit r
    r.asmPath = cli.asmOutPath
    r.objPath = cli.objOutPath
    r.exePath = cli.exeOutPath

    If Trim(cli.asmOutPath) = "" Then
        r.errorText = "x64 build bridge: asm path bos"
        Return 0
    End If

    If Len(Dir(cli.asmOutPath)) = 0 Then
        r.errorText = "x64 build bridge: asm dosyasi bulunamadi: " & cli.asmOutPath
        Return 0
    End If

    r.ok = 1
    Return 1
End Function

#endif
