#ifndef UXB_BACKEND_TARGET_SUPPORT_RULES_FBS
#define UXB_BACKEND_TARGET_SUPPORT_RULES_FBS

#include once "../common/backend_emit_policy.fbs"

Function UXBBackendTargetSupportForMirOpcode(ByVal opcodeText As String, ByVal targetText As String) As String
    Return UXBBackendTargetDecisionForOpcode(opcodeText, targetText)
End Function

Function UXBBackendTargetSupportIsFailClosed(ByVal opcodeText As String, ByVal targetText As String) As Integer
    Dim d As String
    d = UXBBackendTargetDecisionForOpcode(opcodeText, targetText)
    If d = UXB_EMIT_NATIVE_ONLY Or d = UXB_EMIT_BROWSER_ONLY Or d = UXB_EMIT_WASM_UNSUPPORTED Or d = UXB_EMIT_BLOCKED Then Return 1
    Return 0
End Function

#endif
