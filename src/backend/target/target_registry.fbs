#ifndef UXB_BACKEND_TARGET_REGISTRY_FBS
#define UXB_BACKEND_TARGET_REGISTRY_FBS

#include once "../common/backend_target.fbs"

Function UXBBackendTargetRegistryStatus(ByVal targetText As String) As String
    If UXBBackendTargetIsRetired(targetText) <> 0 Then Return "RETIRED"
    If UXBBackendTargetKnown(targetText) = 0 Then Return "MISSING"
    Return "IMPLEMENTED"
End Function

Function UXBBackendTargetDescription(ByVal targetText As String) As String
    Dim t As String
    t = UXBBackendNormalizeTarget(targetText)
    Select Case t
    Case UXB_TARGET_X64: Return "MIR to x64 NASM"
    Case UXB_TARGET_JS: Return "MIR to JavaScript"
    Case UXB_TARGET_WASM: Return "MIR to WAT and external wasm tool"
    Case UXB_TARGET_BROWSER: Return "MIR to browser JavaScript runtime"
    Case UXB_TARGET_X86_RETIRED: Return "x86 (32-bit) - emekli edildi, artik uretilmiyor; x64 kullanin"
    End Select
    Return "target is not mapped"
End Function

#endif
