#ifndef UXB_BACKEND_CONTEXT_BUILDER_FBS
#define UXB_BACKEND_CONTEXT_BUILDER_FBS

#include once "backend_cli_args.fbs"
#include once "common/backend_context.fbs"
#include once "common/backend_target.fbs"

Function UXBBackendContextFromCliArgs( _
    ByRef ctx As UXBBackendContext, _
    ByRef cli As UXBBackendCliArgs, _
    ByRef errText As String _
) As Integer

    errText = ""
    ctx = UXBBackendContextMake(cli.target)

    ctx.sourcePath = cli.sourcePath
    ctx.asmOutPath = cli.asmOutPath
    ctx.objOutPath = cli.objOutPath
    ctx.exeOutPath = cli.exeOutPath
    ctx.backendReportOutPath = cli.backendReportOutPath

    ctx.verifyPassed = cli.verifyAlreadyPassed
    ctx.compareBackend = cli.compareBackend
    ctx.mirInterpreterPassed = cli.mirInterpreterPassed
    ctx.traceEnabled = cli.traceEnabled

    UXBBackendContextSetOutputDefaults ctx, "build\manual\native\program"

    If UXBBackendTargetIsRetired(ctx.target) <> 0 Then
        errText = UXBBackendRetiredTargetMessage(ctx.target)
        Return 0
    End If

    If UXBBackendTargetKnown(ctx.target) = 0 Then
        errText = "backend target tanimsiz: " & cli.target
        Return 0
    End If

    If UCase(Trim(cli.codegenSourceMode)) = "AST" Then
        If UXBBackendNormalizeTarget(cli.target) = UXB_TARGET_X64 And cli.allowAstX64Fallback <> 0 Then
            ' Explicit legacy fallback izni. Normal Adim13 yolu MIR'dir.
        Else
            errText = "native backend kanonik yolu dogrulanmis MIR olmali; AST fallback izinsiz"
            Return 0
        End If
    End If

    Return 1
End Function

#endif
