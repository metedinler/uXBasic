#ifndef UXB_BACKEND_WEB_COVERAGE_GATE_ADIM26_FBS
#define UXB_BACKEND_WEB_COVERAGE_GATE_ADIM26_FBS

#include once "../codegen/js/js_mir_opcode_coverage_adim26.fbs"
#include once "../codegen/wasm/wasm_mir_opcode_coverage_adim26.fbs"
#include once "common/backend_target.fbs"


Function UXBBackendWebCoverageDiagnosticCodeAdim26(ByRef targetText As String) As String
    Dim tgt As String
    tgt = UXBBackendNormalizeTarget(targetText)
    Select Case tgt
    Case UXB_TARGET_JS, UXB_TARGET_BROWSER
        Return "UXB_JS_OPCODE_UNSUPPORTED"
    Case UXB_TARGET_WAT, UXB_TARGET_WASM
        Return "UXB_WASM_OPCODE_UNSUPPORTED"
    End Select
    Return "UXB_WEB_OPCODE_UNSUPPORTED"
End Function

Function UXBBackendWebCoverageGateAdim26(ByRef m As MIRModule, ByRef targetText As String, ByRef reportBasePath As String, ByRef errText As String) As Integer
    Dim tgt As String
    Dim reportPath As String
    tgt = UXBBackendNormalizeTarget(targetText)
    errText = ""

    If Trim(reportBasePath) = "" Then
        errText = "ADIM26 web coverage report path is empty"
        Return 0
    Else
        reportPath = reportBasePath
    End If

    Select Case tgt
    Case UXB_TARGET_JS, UXB_TARGET_BROWSER
        Return UXBJsMirOpcodeCoverageGateAdim26(m, reportPath, errText)
    Case UXB_TARGET_WAT, UXB_TARGET_WASM
        Return UXBWasmMirOpcodeCoverageGateAdim26(m, reportPath, errText)
    End Select

    Return 1
End Function

#endif
