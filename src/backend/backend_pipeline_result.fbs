#ifndef UXB_BACKEND_PIPELINE_RESULT_FBS
#define UXB_BACKEND_PIPELINE_RESULT_FBS

#include once "backend_pipeline_gate.fbs"
#include once "common/backend_context.fbs"
#include once "common/backend_result.fbs"

Type UXBBackendPipelineResult
    ok As Integer
    target As String
    result As UXBBackendResult
    gate As UXBBackendPipelineGateResult
    context As UXBBackendContext
    errorsText As String
    warningsText As String
End Type

Sub UXBBackendPipelineResultInit(ByRef r As UXBBackendPipelineResult)
    r.ok = 0
    r.target = ""
    r.errorsText = ""
    r.warningsText = ""
End Sub

#endif
