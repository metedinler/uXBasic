#ifndef UXB_BACKEND_CLI_ARGS_FBS
#define UXB_BACKEND_CLI_ARGS_FBS

' Adim13 Native Backend CLI bridge.
' Bu yapı main_program_entry.fbs icindeki daginik boolean/path bilgisini
' backend pipeline'a tek paket olarak tasir. Eski CLI degiskenleri silinmez;
' sadece bu modele kopyalanir.

Type UXBBackendCliArgs
    sourcePath As String
    target As String              ' x64 / x86
    codegenSourceMode As String   ' MIR ana yoldur; AST fallback explicit izin ister

    x64EmitMode As Integer
    x64BuildMode As Integer
    x86EmitMode As Integer

    asmOutPath As String
    objOutPath As String
    exeOutPath As String
    buildDir As String

    backendReportOutPath As String
    nativeMatrixOutPath As String
    x64RegistryOutPath As String
    x86RegistryOutPath As String
    artifactJsonOutPath As String

    verifyAlreadyPassed As Integer
    compareBackend As Integer
    mirInterpreterPassed As Integer
    traceEnabled As Integer
    allowAstX64Fallback As Integer
End Type

Sub UXBBackendCliArgsInit(ByRef a As UXBBackendCliArgs)
    a.sourcePath = ""
    a.target = "x64"
    a.codegenSourceMode = "MIR"

    a.x64EmitMode = 0
    a.x64BuildMode = 0
    a.x86EmitMode = 0

    a.asmOutPath = "build\manual\asm\program.asm"
    a.objOutPath = "build\manual\obj\program.obj"
    a.exeOutPath = "build\manual\exe\program.exe"
    a.buildDir = "build\manual\native"

    a.backendReportOutPath = "build\manual\logs\adim8_backend_result.json"
    a.nativeMatrixOutPath = "build\manual\logs\adim8_native_backend_matrix.csv"
    a.x64RegistryOutPath = "build\manual\logs\adim8_x64_emit_registry.csv"
    a.x86RegistryOutPath = "build\manual\logs\adim8_x86_emit_registry.csv"
    a.artifactJsonOutPath = "build\manual\logs\adim8_x64_artifacts.json"

    a.verifyAlreadyPassed = 0
    a.compareBackend = 0
    ' S-027: default to "not verified" like every other gate flag here. A hardcoded
    ' 1 let this manifest field (and, had --compare-backend ever been wired to a
    ' CLI flag, the ReadyForEmit gate in backend_context.fbs) claim the MIR
    ' interpreter had run and passed when it never executed in this process.
    a.mirInterpreterPassed = 0
    a.traceEnabled = 0
    a.allowAstX64Fallback = 0
End Sub

Function UXBBackendCliArgsAnyNativeBackendRequested(ByRef a As UXBBackendCliArgs) As Integer
    If a.x64EmitMode <> 0 Then Return 1
    If a.x64BuildMode <> 0 Then Return 1
    If a.x86EmitMode <> 0 Then Return 1
    Return 0
End Function

#endif
