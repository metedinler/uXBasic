#ifndef UXB_BACKEND_WEB_REPORT_ADIM14_FBS
#define UXB_BACKEND_WEB_REPORT_ADIM14_FBS

#include once "uxb_backend_web_gate_adim14.fbs"

Private Function UXBAdim14ReportEscape(ByRef s As String) As String
    Dim resultText As String
    Dim i As Integer
    resultText = ""
    For i = 1 To Len(s)
        Dim ch As String
        ch = Mid(s, i, 1)
        Select Case Asc(ch)
        Case 34
            resultText &= "\" & Chr(34)
        Case 92
            resultText &= "\\"
        Case 10
            resultText &= "\n"
        Case 13
            resultText &= "\r"
        Case Else
            If Asc(ch) < 32 Then resultText &= "?" Else resultText &= ch
        End Select
    Next i
    Return resultText
End Function

Function UXBAdim14WebGateJson(ByRef g As UXBAdim14WebGateResult) As String
    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & Chr(34) & "ok" & Chr(34) & ": " & IIf(g.ok <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & Chr(34) & "target" & Chr(34) & ": " & Chr(34) & UXBAdim14ReportEscape(g.target) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "codegen_source" & Chr(34) & ": " & Chr(34) & UXBAdim14ReportEscape(g.codegenSourceMode) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "wat2wasm_found" & Chr(34) & ": " & IIf(g.wat2wasmFound <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & Chr(34) & "error" & Chr(34) & ": " & Chr(34) & UXBAdim14ReportEscape(g.errorText) & Chr(34) & "," & Chr(10)
    j &= "  " & Chr(34) & "warning" & Chr(34) & ": " & Chr(34) & UXBAdim14ReportEscape(g.warningText) & Chr(34) & Chr(10)
    j &= "}" & Chr(10)
    Return j
End Function

Function UXBAdim14WriteWebGateReport(ByRef outPath As String, ByRef g As UXBAdim14WebGateResult, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then Return 1
    Dim f As Integer
    f = FreeFile
    Open outPath For Output As #f
    If Err <> 0 Then
        errText = "cannot write adim14 web gate report: " & outPath
        Return 0
    End If
    Print #f, UXBAdim14WebGateJson(g);
    Close #f
    Return 1
End Function

#endif
