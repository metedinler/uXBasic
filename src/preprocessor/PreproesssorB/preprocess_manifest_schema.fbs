#ifndef UXB_PREPROCESS_MANIFEST_SCHEMA_FBS
#define UXB_PREPROCESS_MANIFEST_SCHEMA_FBS

' Standard manifest sections are flattened as key/value pairs in PreprocessResult.manifest.
' Browser/backends may later turn these into nested JSON.
'
' Canonical top-level sections:
'   schema, bundle, entries, files, assets, blocks, exports, api, routes,
'   capabilities, security, sandbox, wasm, hostImports, features, tests,
'   docs, diagnostics, pipeline.

Sub UXBPreManifestSet(ByRef r As PreprocessResult, ByRef keyText As String, ByRef valueText As String)
    PreprocessResultAddManifest r, Trim(keyText), Trim(valueText)
End Sub

Sub UXBPreSecuritySnapshot(ByRef r As PreprocessResult)
    UXBPreManifestSet r, "security.rawJs", IIf(r.allowRawJs <> 0, "true", "false")
    UXBPreManifestSet r, "security.rawWat", IIf(r.allowRawWat <> 0, "true", "false")
    UXBPreManifestSet r, "security.safePaths", IIf(r.safePaths <> 0, "true", "false")
    UXBPreManifestSet r, "security.requireHostBinding", IIf(r.requireHostBinding <> 0, "true", "false")
    If r.allowRawJs <> 0 Or r.allowRawWat <> 0 Or r.safePaths = 0 Or r.requireHostBinding = 0 Then
        UXBPreManifestSet r, "security.programmerResponsible", "true"
    Else
        UXBPreManifestSet r, "security.programmerResponsible", "false"
    End If
End Sub

Sub UXBPreManifestAddSecurityNote(ByRef r As PreprocessResult, ByRef noteText As String)
    UXBPreManifestSet r, "security.note." & LTrim(Str(r.manifestCount)), UXBPreStripQuotes(noteText)
End Sub

Sub UXBPreAddExportBasic(ByRef r As PreprocessResult, ByRef nameText As String, ByRef signatureText As String)
    Dim n As String
    n = Trim(nameText)
    If n = "" Then Exit Sub
    UXBPreManifestSet r, "exports." & n & ".target", "basic"
    UXBPreManifestSet r, "exports." & n & ".signature", UXBPreStripQuotes(signatureText)
    UXBPreManifestSet r, "exports." & n & ".callableFromJs", "true"
End Sub

Sub UXBPreAddApiEndpoint(ByRef r As PreprocessResult, ByRef aliasText As String, ByRef methodText As String, ByRef urlText As String)
    Dim a As String
    a = Trim(aliasText)
    If a = "" Then Exit Sub
    UXBPreManifestSet r, "api." & a & ".method", UCase(Trim(methodText))
    UXBPreManifestSet r, "api." & a & ".url", UXBPreStripQuotes(urlText)
End Sub

Sub UXBPreAddCapability(ByRef r As PreprocessResult, ByRef capText As String, ByRef valueText As String)
    Dim c As String
    c = Trim(capText)
    If c = "" Then Exit Sub
    UXBPreManifestSet r, "capabilities." & c, IIf(UXBPreOnOff(valueText, 1) <> 0, "true", "false")
End Sub

Sub UXBPreAddHostImport(ByRef r As PreprocessResult, ByRef nameText As String, ByRef aliasText As String, ByRef sigText As String)
    Dim n As String
    n = Trim(nameText)
    If n = "" Then Exit Sub
    UXBPreManifestSet r, "hostImports." & n & ".alias", UXBPreStripQuotes(aliasText)
    UXBPreManifestSet r, "hostImports." & n & ".signature", UXBPreStripQuotes(sigText)
End Sub

#endif
