#ifndef UXB_PREPROCESS_META_EVAL_ADIM34_FBS
#define UXB_PREPROCESS_META_EVAL_ADIM34_FBS

' ADIM34 — Small, deterministic compile-time expression evaluator for preprocessor.
' Scope: integer arithmetic, string helpers, macro lookup. No runtime uXBasic variable access.

Private Function UXBMetaTrimQuotes34(ByRef s As String) As String
    Dim t As String: t = Trim(s)
    If Len(t) >= 2 Then
        If Left(t, 1) = Chr(34) And Right(t, 1) = Chr(34) Then Return Mid(t, 2, Len(t) - 2)
    End If
    Return t
End Function

Private Function UXBMetaJsonEsc34(ByRef s As String) As String
    Dim r As String: r = ""
    Dim i As Integer
    For i = 1 To Len(s)
        Dim ch As String: ch = Mid(s, i, 1)
        Select Case ch
        Case Chr(34): r &= "\" & Chr(34)
        Case "\": r &= "\\"
        Case Chr(10): r &= "\n"
        Case Chr(13): r &= "\r"
        Case Chr(9): r &= "\t"
        Case Else: r &= ch
        End Select
    Next i
    Return r
End Function

Private Function UXBMetaHtmlEsc34(ByRef s As String) As String
    Dim r As String: r = ""
    Dim i As Integer
    For i = 1 To Len(s)
        Dim ch As String: ch = Mid(s, i, 1)
        Select Case ch
        Case "&": r &= "&amp;"
        Case "<": r &= "&lt;"
        Case ">": r &= "&gt;"
        Case Chr(34): r &= "&quot;"
        Case Else: r &= ch
        End Select
    Next i
    Return r
End Function

Private Function UXBMetaFnv1aFileHash34(ByRef filePath As String, ByRef hashOut As String) As Integer
    Dim f As Integer: f = FreeFile
    Open filePath For Binary Access Read As #f
    If Err <> 0 Then Return 0
    Dim h As UInteger: h = 2166136261u
    Dim n As LongInt: n = LOF(f)
    Dim i As LongInt
    For i = 1 To n
        Dim b As UByte
        Get #f, i, b
        h = (h Xor b) * 16777619u
    Next i
    Close #f
    hashOut = Hex(h, 8)
    Return 1
End Function

Private Function UXBMetaBase64Encode34(ByRef dataText As String) As String
    Dim tbl As String: tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    Dim outText As String: outText = ""
    Dim i As Integer: i = 1
    Do While i <= Len(dataText)
        Dim b0 As Integer: b0 = Asc(Mid(dataText, i, 1)) And 255
        Dim b1 As Integer: b1 = 0
        Dim b2 As Integer: b2 = 0
        Dim have1 As Integer: have1 = 0
        Dim have2 As Integer: have2 = 0
        If i + 1 <= Len(dataText) Then b1 = Asc(Mid(dataText, i + 1, 1)) And 255: have1 = 1
        If i + 2 <= Len(dataText) Then b2 = Asc(Mid(dataText, i + 2, 1)) And 255: have2 = 1
        outText &= Mid(tbl, ((b0 Shr 2) And 63) + 1, 1)
        outText &= Mid(tbl, (((b0 And 3) Shl 4) Or ((b1 Shr 4) And 15)) + 1, 1)
        If have1 <> 0 Then
            outText &= Mid(tbl, (((b1 And 15) Shl 2) Or ((b2 Shr 6) And 3)) + 1, 1)
        Else
            outText &= "="
        End If
        If have2 <> 0 Then
            outText &= Mid(tbl, (b2 And 63) + 1, 1)
        Else
            outText &= "="
        End If
        i = i + 3
    Loop
    Return outText
End Function

Private Function UXBMetaReadBinaryFile34(ByRef filePath As String, ByRef dataOut As String, ByVal maxBytes As LongInt = 1048576) As Integer
    Dim f As Integer: f = FreeFile
    Open filePath For Binary Access Read As #f
    If Err <> 0 Then Return 0
    Dim n As LongInt: n = LOF(f)
    If n > maxBytes Then Close #f: Return 0
    If n > 0 Then
        dataOut = Space(n)
        Get #f, 1, dataOut
    Else
        dataOut = ""
    End If
    Close #f
    Return 1
End Function

' A minimal integer evaluator interface. The full parser lives in lexer_preprocess helpers
' because it needs access to macro lookup arrays.

#endif
