#ifndef UXB_PREPROCESS_SELECTOR_FBS
#define UXB_PREPROCESS_SELECTOR_FBS

' Central selector for uXBasic preprocessor command sets.
' A = existing in-tree preprocessor.
' B = imported PreproesssorB command helpers.

Dim Shared gUXBPreprocessorDefaultSet As String

Function UXBPreprocessorNormalizeSet(ByRef setText As String) As String
    Dim s As String
    s = UCase(Trim(setText))
    If Left(s, 2) = "%%" Then s = Trim(Mid(s, 3))
    If Left(UCase(s), 2) = "PP" Then s = Trim(Mid(s, 3))
    If s = "" Then Return "A"
    If s = "A" Or s = "B" Then Return s
    Return ""
End Function

Function UXBPreprocessorSetDefault(ByRef setText As String) As Integer
    Dim s As String
    s = UXBPreprocessorNormalizeSet(setText)
    If s = "" Then Return 0
    gUXBPreprocessorDefaultSet = s
    Return 1
End Function

Function UXBPreprocessorGetDefault() As String
    If Trim(gUXBPreprocessorDefaultSet) = "" Then gUXBPreprocessorDefaultSet = "A"
    Return UCase(Trim(gUXBPreprocessorDefaultSet))
End Function

Function UXBPreprocessorIsBActive() As Integer
    Return IIf(UXBPreprocessorGetDefault() = "B", 1, 0)
End Function

Function UXBPreprocessorDetectSourcePragma(ByRef src As String) As String
    Dim cursor As Integer
    cursor = 1
    Dim scanned As Integer
    scanned = 0
    Do While cursor <= Len(src) And scanned < 80
        Dim lf As Integer
        lf = InStr(cursor, src, Chr(10))
        Dim lineText As String
        If lf = 0 Then
            lineText = Mid(src, cursor)
            cursor = Len(src) + 1
        Else
            lineText = Mid(src, cursor, lf - cursor)
            cursor = lf + 1
        End If
        If Right(lineText, 1) = Chr(13) Then lineText = Left(lineText, Len(lineText) - 1)
        scanned += 1
        Dim t As String
        t = UCase(Trim(lineText))
        If Left(t, 4) = "%%PP" Then
            Dim s As String
            s = UXBPreprocessorNormalizeSet(t)
            If s <> "" Then Return s
        End If
        If t <> "" And Left(t, 1) <> "'" And Left(t, 2) <> "%%" Then
            ' Once real source begins, no later PP switch is considered a startup selector.
            Exit Do
        End If
    Loop
    Return ""
End Function

#endif
