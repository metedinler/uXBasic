#ifndef UXB_SYMBOL_SCOPE_TABLE_FBS
#define UXB_SYMBOL_SCOPE_TABLE_FBS

#include once "../scope/scope_stack.fbs"

Function UXBScopeCount() As Integer
    Return gUXBStep3ScopeCount
End Function

Function UXBScopeIsValid(ByVal scopeId As Integer) As Integer
    If scopeId < 0 Then Return 0
    If scopeId >= gUXBStep3ScopeCount Then Return 0
    Return 1
End Function

Function UXBScopeParent(ByVal scopeId As Integer) As Integer
    If UXBScopeIsValid(scopeId) = 0 Then Return -1
    Return gUXBStep3Scopes(scopeId).parentId
End Function

Function UXBScopeName(ByVal scopeId As Integer) As String
    If UXBScopeIsValid(scopeId) = 0 Then Return ""
    Return gUXBStep3Scopes(scopeId).name
End Function

Function UXBScopeKind(ByVal scopeId As Integer) As String
    If UXBScopeIsValid(scopeId) = 0 Then Return ""
    Return gUXBStep3Scopes(scopeId).kind
End Function

Function UXBScopeDepth(ByVal scopeId As Integer) As Integer
    Dim d As Integer = 0
    Dim cur As Integer = scopeId
    Do While UXBScopeIsValid(cur) <> 0 And cur <> 0
        d += 1
        cur = UXBScopeParent(cur)
    Loop
    Return d
End Function

#endif
