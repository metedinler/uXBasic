#ifndef UXB_SYMBOL_INTEGRITY_GATE_FBS
#define UXB_SYMBOL_INTEGRITY_GATE_FBS

#include once "symbol_table.fbs"

Type UXBSymbolIntegrityResult
    ok As Integer
    checkedCount As Integer
    missingHashCount As Integer
    wrongHashCount As Integer
    errorText As String
End Type

Sub UXBSymbolIntegrityInit(ByRef r As UXBSymbolIntegrityResult)
    r.ok = 0
    r.checkedCount = 0
    r.missingHashCount = 0
    r.wrongHashCount = 0
    r.errorText = ""
End Sub

Function UXBSymbolIntegrityCheck(ByRef r As UXBSymbolIntegrityResult) As Integer
    UXBSymbolIntegrityInit r
    Dim i As Integer
    For i = 0 To gUXBStep3SymbolCount - 1
        r.checkedCount += 1
        If Trim(gUXBStep3Symbols(i).kind) <> "" Then
            Dim idx As Integer = UXBSymHashLookupExact(gUXBStep3Symbols(i).scopeId, gUXBStep3Symbols(i).name, gUXBStep3Symbols(i).kind)
            If idx = -1 Then
                r.missingHashCount += 1
            ElseIf idx <> i Then
                r.wrongHashCount += 1
            End If
        End If
    Next i
    If r.missingHashCount = 0 And r.wrongHashCount = 0 Then
        r.ok = 1
        Return 1
    End If
    r.errorText = "symbol integrity failed: missingHash=" & LTrim(Str(r.missingHashCount)) & " wrongHash=" & LTrim(Str(r.wrongHashCount))
    Return 0
End Function

#endif
