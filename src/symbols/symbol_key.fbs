#ifndef UXB_SYMBOL_KEY_FBS
#define UXB_SYMBOL_KEY_FBS

Function UXBSymNormalizeName(ByVal nameText As String) As String
    Return UCase(Trim(nameText))
End Function

Function UXBSymNormalizeKind(ByVal kindText As String) As String
    Return UCase(Trim(kindText))
End Function

Function UXBSymScopeText(ByVal scopeId As Integer) As String
    Return LTrim(Str(scopeId))
End Function

Function UXBSymMakeKey(ByVal scopeId As Integer, ByVal nameText As String, ByVal kindText As String) As String
    Return UXBSymScopeText(scopeId) & "::" & UXBSymNormalizeName(nameText) & "::" & UXBSymNormalizeKind(kindText)
End Function

Function UXBSymMakeSignatureKey(ByVal scopeId As Integer, ByVal nameText As String, ByVal kindText As String, ByVal signatureText As String) As String
    Return UXBSymMakeKey(scopeId, nameText, kindText) & "::" & UCase(Trim(signatureText))
End Function

#endif
