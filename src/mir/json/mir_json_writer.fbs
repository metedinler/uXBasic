#ifndef UXB_MIR_JSON_WRITER_FBS
#define UXB_MIR_JSON_WRITER_FBS

#include once "../mir_instruction.fbs"

Function UXBMIRStep4JsonEscape(ByRef textValue As String) As String
    Dim s As String
    Dim i As Integer
    Dim ch As String
    s = ""
    For i = 1 To Len(textValue)
        ch = Mid(textValue, i, 1)
        Select Case ch
        Case Chr(34)
            s &= "\" & Chr(34)
        Case "\"
            s &= "\\"
        Case Chr(10)
            s &= "\n"
        Case Chr(13)
            s &= "\r"
        Case Else
            s &= ch
        End Select
    Next i
    Return s
End Function

Function UXBMIRStep4InstructionToJson(ByRef ins As UXBMIRInstructionRecord) As String
    Dim j As String
    j = "{"
    j &= Chr(34) & "opcode" & Chr(34) & ":" & Chr(34) & UXBMIRStep4JsonEscape(ins.opcode) & Chr(34)
    j &= "," & Chr(34) & "result" & Chr(34) & ":" & Chr(34) & UXBMIRStep4JsonEscape(ins.resultName) & Chr(34)
    j &= "," & Chr(34) & "type" & Chr(34) & ":" & Chr(34) & UXBMIRStep4JsonEscape(ins.resultType) & Chr(34)
    j &= "," & Chr(34) & "operand_count" & Chr(34) & ":" & LTrim(Str(ins.operandCount))
    j &= "," & Chr(34) & "operands" & Chr(34) & ":["
    Dim oi As Integer
    For oi = 0 To ins.operandCount - 1
        If oi > 0 Then j &= ","
        j &= Chr(34) & UXBMIRStep4JsonEscape(ins.operands(oi)) & Chr(34)
    Next oi
    j &= "]"
    j &= "," & Chr(34) & "operand_types" & Chr(34) & ":["
    For oi = 0 To ins.operandCount - 1
        If oi > 0 Then j &= ","
        j &= Chr(34) & UXBMIRStep4JsonEscape(ins.operandTypes(oi)) & Chr(34)
    Next oi
    j &= "]"
    j &= "," & Chr(34) & "blockId" & Chr(34) & ":" & LTrim(Str(ins.blockId))
    j &= "," & Chr(34) & "verify_rule" & Chr(34) & ":" & Chr(34) & UXBMIRStep4JsonEscape(UXBMIRStep4VerifyRuleForOpcode(ins.opcode)) & Chr(34)
    j &= "," & Chr(34) & "source_file" & Chr(34) & ":" & Chr(34) & UXBMIRStep4JsonEscape(ins.sourceFile) & Chr(34)
    j &= "," & Chr(34) & "source_line" & Chr(34) & ":" & LTrim(Str(ins.sourceLine))
    j &= "," & Chr(34) & "source_column" & Chr(34) & ":" & LTrim(Str(ins.sourceColumn))
    j &= "," & Chr(34) & "offset" & Chr(34) & ":" & LTrim(Str(ins.sourceOffset))
    j &= "," & Chr(34) & "source_offset" & Chr(34) & ":" & LTrim(Str(ins.sourceOffset))
    j &= "," & Chr(34) & "source_length" & Chr(34) & ":" & LTrim(Str(ins.sourceLength))
    j &= "," & Chr(34) & "sourceAstNode" & Chr(34) & ":" & LTrim(Str(ins.sourceAstNode))
    j &= "," & Chr(34) & "source_ast_node" & Chr(34) & ":" & LTrim(Str(ins.sourceAstNode))
    j &= "," & Chr(34) & "mirInstructionId" & Chr(34) & ":" & LTrim(Str(ins.mirInstructionId))
    j &= "}"
    Return j
End Function

#endif
