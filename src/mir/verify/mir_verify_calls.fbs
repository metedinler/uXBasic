#ifndef UXB_STEP4_MIR_VERIFY_CALLS_FBS
#define UXB_STEP4_MIR_VERIFY_CALLS_FBS

Function UXBMIRStep4VerifyCalls(ByRef m As MIRModule, ByRef errText As String) As Integer
    errText = ""

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim inst As MIRIRInstruction Ptr
                inst = @m.functions(fi).blocks(bi).instructions(ii)

                Dim op As String
                op = UXBMIRStep4NormalizeOpcode(inst->opcode)

                If op = "MIR_CALL" Or op = "MIR_CALL_BUILTIN" Or op = "MIR_CALL_RUNTIME" Or op = "MIR_CALL_EXTERNAL" Or op = "MIR_CALL_DLL" Or op = "MIR_CALL_API" Or op = "CALL" Then
                    If inst->operandCount < 1 Then
                        errText = "step4 verify calls: call target missing"
                        Return 0
                    End If
                    If Trim(inst->operands(0)) = "" Then
                        errText = "step4 verify calls: call target empty"
                        Return 0
                    End If
                End If
            Next ii
        Next bi
    Next fi

    Return 1
End Function

#endif
