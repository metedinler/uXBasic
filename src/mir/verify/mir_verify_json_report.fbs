#ifndef UXB_STEP4_MIR_VERIFY_JSON_REPORT_FBS
#define UXB_STEP4_MIR_VERIFY_JSON_REPORT_FBS

Function UXBMIRStep4VerifySummaryJson(ByVal ok As Integer, ByRef errText As String) As String
    Dim j As String
    Dim escapedErr As String
    escapedErr = ""
    Dim i As Integer
    For i = 1 To Len(errText)
        If Mid(errText, i, 1) = Chr(34) Then
            escapedErr &= "'"
        Else
            escapedErr &= Mid(errText, i, 1)
        End If
    Next i
    j = "{"
    j &= Chr(34) & "schema_version" & Chr(34) & ":" & Chr(34) & "uxb-step4-verify-1" & Chr(34) & ","
    j &= Chr(34) & "status" & Chr(34) & ":" & Chr(34) & IIf(ok <> 0, "PASS", "FAIL") & Chr(34) & ","
    j &= Chr(34) & "error" & Chr(34) & ":" & Chr(34) & escapedErr & Chr(34)
    j &= "}"
    Return j
End Function

#endif
