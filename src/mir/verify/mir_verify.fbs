#ifndef UXB_MIR_VERIFY_CONTRACT_FBS
#define UXB_MIR_VERIFY_CONTRACT_FBS

#include once "../mir_instruction.fbs"
#include once "../mir_error_codes.fbs"

Function UXBMIRStep4VerifyInstructionRecord(ByRef ins As UXBMIRInstructionRecord, ByRef errText As String) As Integer
    errText = ""
    If Trim(ins.opcode) = "" Then
        errText = "MIR instruction opcode is empty"
        Return 0
    End If
    If UXBMIRStep4OpcodeKnown(ins.opcode) = 0 Then
        errText = "MIR instruction opcode is invalid: " & ins.opcode
        Return 0
    End If
    If UXBMIRStep4HasVerifyRule(ins.opcode) = 0 Then
        errText = "MIR verify rule is missing for opcode: " & ins.opcode
        Return 0
    End If
    If UXBMIRStep4OpcodeIsFailClosed(ins.opcode) <> 0 Then
        errText = "MIR fail-closed opcode reached executable path: " & ins.opcode
        Return 0
    End If
    If UXBMIRStep4TypeIsBlocked(ins.resultType) <> 0 Then
        errText = "MIR blocked result type reached instruction: " & ins.resultType
        Return 0
    End If
    If UXBMIRStep4TypeIsKnown(ins.resultType) = 0 Then
        errText = "MIR result type is invalid: " & ins.resultType
        Return 0
    End If
    If ins.operandCount < 0 Or ins.operandCount > 16 Then
        errText = "MIR operand count is outside supported range 0..16: " & LTrim(Str(ins.operandCount))
        Return 0
    End If
    Dim i As Integer
    For i = 0 To ins.operandCount - 1
        If UXBMIRStep4TypeIsKnown(ins.operandTypes(i)) = 0 Then
            errText = "MIR operand type is invalid at index " & LTrim(Str(i)) & ": " & ins.operandTypes(i)
            Return 0
        End If
    Next i
    Return 1
End Function

#endif
