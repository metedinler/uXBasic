#ifndef UXB_MIR_CONTEXT_FBS
#define UXB_MIR_CONTEXT_FBS

Type UXBMIRContext
    sourceName As String
    targetName As String
    errorCount As Integer
    warningCount As Integer
    nextTempId As Integer
    nextBlockId As Integer
End Type

Sub UXBMIRContextInit(ByRef ctx As UXBMIRContext, ByVal sourceText As String = "", ByVal targetText As String = "x64")
    ctx.sourceName = sourceText
    ctx.targetName = targetText
    ctx.errorCount = 0
    ctx.warningCount = 0
    ctx.nextTempId = 0
    ctx.nextBlockId = 0
End Sub

Function UXBMIRContextNextTemp(ByRef ctx As UXBMIRContext) As String
    ctx.nextTempId += 1
    Return "%t" & LTrim(Str(ctx.nextTempId))
End Function

Function UXBMIRContextNextBlock(ByRef ctx As UXBMIRContext) As Integer
    ctx.nextBlockId += 1
    Return ctx.nextBlockId
End Function

#endif
