#ifndef UXB_MIR_VALUE_FBS
#define UXB_MIR_VALUE_FBS

#include once "mir_types.fbs"

Type UXBMIRValue
    name As String
    typeName As String
    literalText As String
    intValue As LongInt
    floatValue As Double
    stringValue As String
    handleId As Integer
End Type

Function UXBMIRValueMake(ByVal nameText As String, ByVal typeText As String, ByVal literalText As String = "") As UXBMIRValue
    Dim v As UXBMIRValue
    v.name = nameText
    v.typeName = UXBMIRStep4CanonicalTypeName(typeText)
    v.literalText = literalText
    Return v
End Function

#endif
