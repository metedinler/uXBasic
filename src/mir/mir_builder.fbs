#ifndef UXB_MIR_BUILDER_FBS
#define UXB_MIR_BUILDER_FBS

#include once "mir_context.fbs"
#include once "mir_instruction.fbs"

Function UXBMIRBuilderMakeConst(ByRef ctx As UXBMIRContext, ByRef literalText As String, ByRef typeText As String) As UXBMIRInstructionRecord
    Dim tempName As String
    tempName = UXBMIRContextNextTemp(ctx)
    Return UXBMIRInstructionMake("LOAD_CONST", tempName, typeText, 1, literalText)
End Function

Function UXBMIRBuilderMakeBinary(ByRef ctx As UXBMIRContext, ByRef opcodeText As String, ByRef leftName As String, ByRef rightName As String, ByRef typeText As String) As UXBMIRInstructionRecord
    Dim tempName As String
    tempName = UXBMIRContextNextTemp(ctx)
    Return UXBMIRInstructionMake(opcodeText, tempName, typeText, 2, leftName, rightName)
End Function

#endif
