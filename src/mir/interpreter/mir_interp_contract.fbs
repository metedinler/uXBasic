#ifndef UXB_MIR_INTERP_CONTRACT_FBS
#define UXB_MIR_INTERP_CONTRACT_FBS

#include once "../../interpreter/mir/mir_interp_registry.fbs"

Function UXBMIRStep4InterpreterExpectedForOpcode(ByVal opcodeText As String) As Integer
    Dim d As String = UXBMIRInterpDecisionForOpcode(opcodeText)
    If d = MIR_EXEC_IMPLEMENTED Or d = MIR_EXEC_RUNTIME_CALL Then Return 1
    Return 0
End Function

Function UXBMIRStep5InterpreterDecisionForOpcode(ByVal opcodeText As String) As String
    Return UXBMIRInterpDecisionForOpcode(opcodeText)
End Function

Function UXBMIRStep5InterpreterHandlerForOpcode(ByVal opcodeText As String) As String
    Return UXBMIRInterpHandlerForOpcode(opcodeText)
End Function

#endif
