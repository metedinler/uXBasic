#ifndef UXB_MIR_LOWERING_DECISION_FBS
#define UXB_MIR_LOWERING_DECISION_FBS

Function UXBMIRStep4NormalizeAstKind(ByRef astKindText As String) As String
    Return UCase(Trim(astKindText))
End Function

Function UXBMIRStep4LoweringDecisionForAstNode(ByRef astKindText As String) As String
    Dim k As String
    k = UXBMIRStep4NormalizeAstKind(astKindText)
    Select Case k
    Case "ALIAS_TARGET", "BLOCK", "CASE_BLOCK", "CASE_ELSE", "CASE_IS_VALUE"
        Return "LOWER_COMPILE_TIME_ONLY"
    Case "CATCH_PART", "CLASS_ACCESS", "CLASS_BASE_REF", "CLASS_CONSTRUCTOR_DECL", "CLASS_DECORATOR_REF"
        Return "LOWER_COMPILE_TIME_ONLY"
    Case "CLASS_DESTRUCTOR_DECL", "CLASS_FIELD", "CLASS_FIELD_FLAG", "CLASS_FLAG", "CLASS_IMPLEMENTS_REF"
        Return "LOWER_COMPILE_TIME_ONLY"
    Case "CLASS_METHOD_DECL", "CLASS_METHOD_FLAG", "CLASS_MIXIN_REF", "CLASS_OPERATOR_DECL", "CLASS_PROPERTY_DECL"
        Return "LOWER_COMPILE_TIME_ONLY"
    Case "CLASS_PROPERTY_FLAG", "CONST_DECL", "DIM_BOUNDS", "EACH_BODY", "EACH_ITEMS"
        Return "LOWER_COMPILE_TIME_ONLY"
    Case "ELSEIF_PART", "ELSE_PART", "ENUM_BASE_TYPE", "ENUM_ITEM", "ENUM_STMT", "FINALLY_PART", "FRIEND_ITEM", "INTERFACE_METHOD_DECL"
        Return "LOWER_COMPILE_TIME_ONLY"
    Case "KEYWORD_REF", "MODE_REF", "PARAM_DECL", "PRINT_ITEM", "PROGRAM"
        Return "LOWER_COMPILE_TIME_ONLY"
    Case "RETURN_TYPE", "SLOT_HEADER_ARGS", "TRY_BODY", "TYPE_FIELD", "TYPE_REF"
        Return "LOWER_COMPILE_TIME_ONLY"
    Case "USING_ITEM"
        Return "LOWER_COMPILE_TIME_ONLY"
    Case "ALIAS_STMT", "ASSERT_STMT", "ASSIGN_STMT", "BINARY", "BOOLEAN"
        Return "LOWER_TO_MIR"
    Case "CALL_EXPR", "CALL_STMT", "CAST_EXPR", "CLASS_FRIEND_STMT", "CLASS_PROPERTY_GET_STMT"
        Return "LOWER_TO_MIR"
    Case "CLASS_PROPERTY_SET_STMT", "CLASS_STMT", "CLS_STMT", "COLOR_STMT", "CONST_STMT"
        Return "LOWER_TO_MIR"
    Case "DECLARE_FUNCTION_STMT", "DECLARE_SUB_STMT", "DEFTYPE_STMT", "DELETE_STMT", "DIM_DECL"
        Return "LOWER_TO_MIR"
    Case "DIM_STMT", "DO_EACH_STMT", "DO_STMT", "END_STMT", "EVENT_STMT"
        Return "LOWER_TO_MIR"
    Case "EXIT_STMT", "EXPR_STMT", "FIELD_EXPR", "FOR_EACH_STMT", "FOR_STMT"
        Return "LOWER_TO_MIR"
    Case "FUNCTION_STMT", "GOSUB_STMT", "GOTO_STMT", "IDENT", "IF_STMT"
        Return "LOWER_TO_MIR"
    Case "IMPORT_STMT", "INCDEC_EXPR", "INCDEC_STMT", "INCLUDE_STMT", "INDEX_EXPR"
        Return "LOWER_TO_MIR"
    Case "INIT_EXPR", "INPUT_STMT", "INTERFACE_STMT", "LABEL_STMT", "LOCATE_STMT"
        Return "LOWER_TO_MIR"
    Case "MAIN_STMT", "MEMBER_EXPR", "MEMCOPYB_STMT", "MEMCOPYD_STMT", "MEMCOPYW_STMT"
        Return "LOWER_TO_MIR"
    Case "MEMFILLB_STMT", "MEMFILLD_STMT", "MEMFILLW_STMT", "MODULE_STMT", "NAMESPACE_STMT"
        Return "LOWER_TO_MIR"
    Case "NEW_EXPR", "NUMBER", "PARALEL_STMT", "PIPE_STMT", "POKEB_STMT"
        Return "LOWER_TO_MIR"
    Case "POKED_STMT", "POKES_STMT", "POKEW_STMT", "PRINT_STMT", "PROMPT_EXPR"
        Return "LOWER_TO_MIR"
    Case "RANDOMIZE_STMT", "RANGE_EXPR", "REDIM_DECL", "REDIM_STMT", "RETURN_STMT"
        Return "LOWER_TO_MIR"
    Case "SELECT_STMT", "SETNEWOFFSET_STMT", "SETSTRINGSIZE_STMT", "SIZEOF_EXPR", "SLOT_CONTROL_STMT"
        Return "LOWER_TO_MIR"
    Case "SLOT_STMT", "SLOT_TABLE_STMT", "SLOT_BIND_ENTRY", "STRING", "SUB_STMT", "TERNARY_EXPR", "THREAD_STMT"
        Return "LOWER_TO_MIR"
    Case "THROW_STMT", "TRIGGER_STMT", "TRY_STMT", "TYPE_STMT", "UNARY"
        Return "LOWER_TO_MIR"
    Case "USING_STMT"
        Return "LOWER_TO_MIR"
    Case "INLINE_STMT"
        Return "LOWER_TO_MIR"
    Case "CLOSE_STMT", "GET_STMT", "INPUTF_STMT", "INPUT_FILE_STMT", "OPEN_STMT"
        Return "LOWER_TO_RUNTIME_CALL"
    Case "PUT_STMT", "SEEK_STMT"
        Return "LOWER_TO_RUNTIME_CALL"
    End Select
    Return "LOWER_BROKEN"
End Function

Function UXBMIRStep4LoweringStatusForAstNode(ByRef astKindText As String) As String
    Dim k As String
    k = UXBMIRStep4NormalizeAstKind(astKindText)
    Select Case k
    Case "ALIAS_TARGET", "BLOCK", "CASE_BLOCK", "CASE_ELSE", "CASE_IS_VALUE"
        Return "COMPILE_TIME_ONLY"
    Case "CATCH_PART", "CLASS_ACCESS", "CLASS_BASE_REF", "CLASS_CONSTRUCTOR_DECL", "CLASS_DECORATOR_REF"
        Return "COMPILE_TIME_ONLY"
    Case "CLASS_DESTRUCTOR_DECL", "CLASS_FIELD", "CLASS_FIELD_FLAG", "CLASS_FLAG", "CLASS_IMPLEMENTS_REF"
        Return "COMPILE_TIME_ONLY"
    Case "CLASS_METHOD_DECL", "CLASS_METHOD_FLAG", "CLASS_MIXIN_REF", "CLASS_OPERATOR_DECL", "CLASS_PROPERTY_DECL"
        Return "COMPILE_TIME_ONLY"
    Case "CLASS_PROPERTY_FLAG", "CONST_DECL", "DIM_BOUNDS", "EACH_BODY", "EACH_ITEMS"
        Return "COMPILE_TIME_ONLY"
    Case "ELSEIF_PART", "ELSE_PART", "ENUM_BASE_TYPE", "ENUM_ITEM", "ENUM_STMT", "FINALLY_PART", "FRIEND_ITEM", "INTERFACE_METHOD_DECL"
        Return "COMPILE_TIME_ONLY"
    Case "KEYWORD_REF", "MODE_REF", "PARAM_DECL", "PRINT_ITEM", "PROGRAM"
        Return "COMPILE_TIME_ONLY"
    Case "RETURN_TYPE", "SLOT_HEADER_ARGS", "TRY_BODY", "TYPE_FIELD", "TYPE_REF"
        Return "COMPILE_TIME_ONLY"
    Case "USING_ITEM"
        Return "COMPILE_TIME_ONLY"
    Case "ALIAS_STMT", "ASSERT_STMT", "ASSIGN_STMT", "BINARY", "BOOLEAN"
        Return "IMPLEMENTED"
    Case "CALL_EXPR", "CALL_STMT", "CAST_EXPR", "CLASS_FRIEND_STMT", "CLASS_PROPERTY_GET_STMT"
        Return "IMPLEMENTED"
    Case "CLASS_PROPERTY_SET_STMT", "CLASS_STMT", "CLS_STMT", "COLOR_STMT", "CONST_STMT"
        Return "IMPLEMENTED"
    Case "DECLARE_FUNCTION_STMT", "DECLARE_SUB_STMT", "DEFTYPE_STMT", "DELETE_STMT", "DIM_DECL"
        Return "IMPLEMENTED"
    Case "DIM_STMT", "DO_EACH_STMT", "DO_STMT", "END_STMT", "EVENT_STMT"
        Return "IMPLEMENTED"
    Case "EXIT_STMT", "EXPR_STMT", "FIELD_EXPR", "FOR_EACH_STMT", "FOR_STMT"
        Return "IMPLEMENTED"
    Case "FUNCTION_STMT", "GOSUB_STMT", "GOTO_STMT", "IDENT", "IF_STMT"
        Return "IMPLEMENTED"
    Case "IMPORT_STMT", "INCDEC_EXPR", "INCDEC_STMT", "INCLUDE_STMT", "INDEX_EXPR"
        Return "IMPLEMENTED"
    Case "INIT_EXPR", "INPUT_STMT", "INTERFACE_STMT", "LABEL_STMT", "LOCATE_STMT"
        Return "IMPLEMENTED"
    Case "MAIN_STMT", "MEMBER_EXPR", "MEMCOPYB_STMT", "MEMCOPYD_STMT", "MEMCOPYW_STMT"
        Return "IMPLEMENTED"
    Case "MEMFILLB_STMT", "MEMFILLD_STMT", "MEMFILLW_STMT", "MODULE_STMT", "NAMESPACE_STMT"
        Return "IMPLEMENTED"
    Case "NEW_EXPR", "NUMBER", "PARALEL_STMT", "PIPE_STMT", "POKEB_STMT"
        Return "IMPLEMENTED"
    Case "POKED_STMT", "POKES_STMT", "POKEW_STMT", "PRINT_STMT", "PROMPT_EXPR"
        Return "IMPLEMENTED"
    Case "RANDOMIZE_STMT", "RANGE_EXPR", "REDIM_DECL", "REDIM_STMT", "RETURN_STMT"
        Return "IMPLEMENTED"
    Case "SELECT_STMT", "SETNEWOFFSET_STMT", "SETSTRINGSIZE_STMT", "SIZEOF_EXPR", "SLOT_CONTROL_STMT"
        Return "IMPLEMENTED"
    Case "SLOT_STMT", "SLOT_TABLE_STMT", "SLOT_BIND_ENTRY", "STRING", "SUB_STMT", "TERNARY_EXPR", "THREAD_STMT"
        Return "IMPLEMENTED"
    Case "THROW_STMT", "TRIGGER_STMT", "TRY_STMT", "TYPE_STMT", "UNARY"
        Return "IMPLEMENTED"
    Case "USING_STMT"
        Return "IMPLEMENTED"
    Case "INLINE_STMT"
        Return "IMPLEMENTED"
    Case "CLOSE_STMT", "GET_STMT", "INPUTF_STMT", "INPUT_FILE_STMT", "OPEN_STMT"
        Return "RUNTIME_CALL"
    Case "PUT_STMT", "SEEK_STMT"
        Return "RUNTIME_CALL"
    End Select
    Return "BROKEN"
End Function

Function UXBMIRStep4AstNodeHasLoweringDecision(ByRef astKindText As String) As Integer
    Return IIf(UXBMIRStep4LoweringDecisionForAstNode(astKindText) <> "LOWER_BROKEN", 1, 0)
End Function

Function UXBMIRStep4AstNodeIsCompileTimeOnly(ByRef astKindText As String) As Integer
    Return IIf(UXBMIRStep4LoweringDecisionForAstNode(astKindText) = "LOWER_COMPILE_TIME_ONLY", 1, 0)
End Function

#endif
