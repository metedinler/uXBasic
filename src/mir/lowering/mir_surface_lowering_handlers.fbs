#ifndef UXB_MIR_SURFACE_LOWERING_HANDLERS_FBS
#define UXB_MIR_SURFACE_LOWERING_HANDLERS_FBS

#include once "mir_lowering_decision.fbs"
#include once "../mir_surface_registry.fbs"

Function UXBMIRStep4SurfaceLoweringStatus(ByRef surfaceText As String) As String
    If UXBMIRStep4SurfaceKnown(surfaceText) = 0 Then Return "BROKEN"
    Return "IMPLEMENTED"
End Function

#endif
