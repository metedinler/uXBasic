#ifndef UXB_MIR_INSTRUCTION_FBS
#define UXB_MIR_INSTRUCTION_FBS

#include once "mir_registry.fbs"

' Prefix marking a BYREF parameter name inside a MIR_FUNCTION_LABEL instruction's
' operand list (see semantic_to_canonical_mir_bridge.fbs and mir_interp.fbs).
' MIR_FUNCTION_LABEL operands are plain name strings with no separate flag slot,
' so this is how BYREF-ness survives the MIRFunction -> canonical-MIR bridge.
Const UXB_MIR_CANONICAL_BYREF_PARAM_PREFIX As String = "@BYREF@"

Type UXBMIRInstructionRecord
    opcode As String
    resultName As String
    resultType As String
    operands(0 To 15) As String
    operandTypes(0 To 15) As String
    operandCount As Integer
    blockId As Integer
    sourceAstKind As String
    sourceAstNode As Integer
    sourceFile As String
    sourceLine As Integer
    sourceColumn As Integer
    sourceOffset As Integer
    sourceLength As Integer
    mirInstructionId As Integer
End Type

Function UXBMIRInstructionMake(ByVal opcodeText As String, ByVal resultText As String, ByVal resultTypeText As String, ByVal countValue As Integer, ByVal op0 As String = "", ByVal op1 As String = "", ByVal op2 As String = "", ByVal op3 As String = "") As UXBMIRInstructionRecord
    Dim ins As UXBMIRInstructionRecord
    ins.opcode = UXBMIRStep4NormalizeOpcode(opcodeText)
    ins.resultName = resultText
    ins.resultType = UXBMIRStep4CanonicalTypeName(resultTypeText)
    ins.operandCount = countValue
    ins.blockId = 0
    If countValue > 0 Then ins.operands(0) = op0
    If countValue > 1 Then ins.operands(1) = op1
    If countValue > 2 Then ins.operands(2) = op2
    If countValue > 3 Then ins.operands(3) = op3
    Dim i As Integer
    For i = 0 To 15
        ins.operandTypes(i) = UXB_MIR_TYPE_INFERRED
    Next i
    ins.sourceAstNode = -1
    ins.sourceOffset = 0
    ins.sourceLength = 0
    ins.mirInstructionId = -1
    Return ins
End Function

#endif
