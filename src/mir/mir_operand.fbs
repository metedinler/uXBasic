#ifndef UXB_MIR_OPERAND_FBS
#define UXB_MIR_OPERAND_FBS

Type UXBMIROperand
    text As String
    typeName As String
    role As String
End Type

Function UXBMIROperandMake(ByVal textValue As String, ByVal typeText As String = "TYPE_INFERRED", ByVal roleText As String = "VALUE") As UXBMIROperand
    Dim o As UXBMIROperand
    o.text = textValue
    o.typeName = typeText
    o.role = roleText
    Return o
End Function

#endif
