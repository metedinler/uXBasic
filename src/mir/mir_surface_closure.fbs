#ifndef UXB_MIR_SURFACE_CLOSURE_FBS
#define UXB_MIR_SURFACE_CLOSURE_FBS

#include once "../surface/uxb_surface_layer_bridge.fbs"

Function UXBMIRSurfaceOpcode(ByRef surfaceText As String) As String
    Return UXBSurfaceMirOpcode(surfaceText)
End Function

Function UXBMIRSurfaceLoweringDecision(ByRef surfaceText As String) As String
    Dim st As String = UXBSurfaceLayerStatus(surfaceText, "MIR")
    Select Case st
    Case "IMPLEMENTED": Return "LOWER_TO_MIR"
    Case "RUNTIME_CALL": Return "LOWER_TO_RUNTIME_CALL"
    Case "COMPILE_TIME_ONLY": Return "LOWER_COMPILE_TIME_ONLY"
    Case "NATIVE_ONLY": Return "LOWER_TO_NATIVE_ONLY"
    Case "BROWSER_ONLY": Return "LOWER_TO_BROWSER_CALL"
    Case "WASM_UNSUPPORTED": Return "LOWER_TO_RUNTIME_CALL"
    End Select
    Return "LOWER_MISSING"
End Function

Function UXBMIRSurfaceVerifyRule(ByRef surfaceText As String) As String
    Dim op As String = UXBSurfaceMirOpcode(surfaceText)
    Dim g As String = UXBSurfaceGroup(surfaceText)
    If op = "" Then Return "verify_surface_missing"
    If op = "MIR_METADATA_ONLY" Then Return "verify_meta"
    If g = "OPERATOR" Or g = "BUILTIN" Then Return "verify_expr"
    If g = "CONTROL_FLOW" Then Return "verify_control"
    If g = "MEMORY" Then Return "verify_memory"
    If g = "IO" Then Return "verify_file_or_console"
    If g = "LIBRARY" Then Return "verify_host_call"
    If g = "TYPE" Or g = "COLLECTION" Or g = "PROCEDURE_OOP" Then Return "verify_object_or_decl"
    Return "verify_statement"
End Function

Function UXBMIRSurfaceStatusJson(ByRef surfaceText As String) As String
    Return "{" & _
        Chr(34) & "surface" & Chr(34) & ":" & Chr(34) & UCase(Trim(surfaceText)) & Chr(34) & "," & _
        Chr(34) & "lowering" & Chr(34) & ":" & Chr(34) & UXBMIRSurfaceLoweringDecision(surfaceText) & Chr(34) & "," & _
        Chr(34) & "mir_opcode" & Chr(34) & ":" & Chr(34) & UXBMIRSurfaceOpcode(surfaceText) & Chr(34) & "," & _
        Chr(34) & "verify_rule" & Chr(34) & ":" & Chr(34) & UXBMIRSurfaceVerifyRule(surfaceText) & Chr(34) & "}"
End Function

#endif
