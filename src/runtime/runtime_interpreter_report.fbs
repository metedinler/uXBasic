#ifndef UXB_RUNTIME_INTERPRETER_REPORT_FBS
#define UXB_RUNTIME_INTERPRETER_REPORT_FBS

#include once "runtime_context.fbs"
#include once "runtime_json_report.fbs"

Type UXBRuntimeInterpreterReport
    ok As Integer
    interpreterKind As String
    targetName As String
    instructionCount As Integer
    serviceCallCount As Integer
    errorCode As Integer
    errorText As String
    stdoutText As String
    runtimeJson As String
End Type

Sub UXBRuntimeInterpreterReportInit(ByRef r As UXBRuntimeInterpreterReport)
    r.ok = 0
    r.interpreterKind = "MIR"
    r.targetName = "NATIVE"
    r.instructionCount = 0
    r.serviceCallCount = 0
    r.errorCode = 0
    r.errorText = ""
    r.stdoutText = ""
    r.runtimeJson = "{}"
End Sub

Private Function UXBRuntimeReportJsonEscape(ByVal rawText As String) As String
    Dim outText As String = ""
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim ch As String = Mid(rawText, i, 1)
        Select Case ch
        Case Chr(34): outText &= "\" & Chr(34)
        Case "\": outText &= "\\"
        Case Chr(13): outText &= "\r"
        Case Chr(10): outText &= "\n"
        Case Chr(9): outText &= "\t"
        Case Else: outText &= ch
        End Select
    Next i
    Return outText
End Function

Function UXBRuntimeInterpreterReportFromContext( _
    ByRef rt As UXBRuntimeContext, _
    ByVal interpreterText As String, _
    ByVal instructionCountValue As Integer, _
    ByVal okValue As Integer, _
    ByVal errCodeValue As Integer, _
    ByVal errTextValue As String _
) As UXBRuntimeInterpreterReport
    Dim r As UXBRuntimeInterpreterReport
    UXBRuntimeInterpreterReportInit r
    r.ok = IIf(okValue <> 0, 1, 0)
    r.interpreterKind = UCase(Trim(interpreterText))
    r.targetName = rt.targetName
    r.instructionCount = instructionCountValue
    r.serviceCallCount = rt.serviceCallCount
    r.errorCode = errCodeValue
    r.errorText = errTextValue
    If r.errorText = "" Then r.errorText = rt.lastErrorText
    r.stdoutText = rt.stdoutText
    r.runtimeJson = UXBRuntimeContextToJson(rt)
    Return r
End Function

Function UXBRuntimeInterpreterReportToJson(ByRef r As UXBRuntimeInterpreterReport) As String
    Dim q As String = Chr(34)
    Dim j As String = "{" & Chr(10)
    j &= "  " & q & "ok" & q & ": " & IIf(r.ok <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & q & "interpreter" & q & ": " & q & UXBRuntimeReportJsonEscape(r.interpreterKind) & q & "," & Chr(10)
    j &= "  " & q & "target" & q & ": " & q & UXBRuntimeReportJsonEscape(r.targetName) & q & "," & Chr(10)
    j &= "  " & q & "instruction_count" & q & ": " & LTrim(Str(r.instructionCount)) & "," & Chr(10)
    j &= "  " & q & "service_call_count" & q & ": " & LTrim(Str(r.serviceCallCount)) & "," & Chr(10)
    j &= "  " & q & "error_code" & q & ": " & LTrim(Str(r.errorCode)) & "," & Chr(10)
    j &= "  " & q & "error_text" & q & ": " & q & UXBRuntimeReportJsonEscape(r.errorText) & q & "," & Chr(10)
    j &= "  " & q & "stdout" & q & ": " & q & UXBRuntimeReportJsonEscape(r.stdoutText) & q & "," & Chr(10)
    j &= "  " & q & "runtime" & q & ": " & r.runtimeJson & Chr(10)
    j &= "}"
    Return j
End Function

Function UXBRuntimeInterpreterReportWriteJson(ByRef r As UXBRuntimeInterpreterReport, ByVal outPath As String, ByRef errText As String) As Integer
    errText = ""
    Dim ff As Integer = FreeFile
    Open outPath For Output As #ff
    Print #ff, UXBRuntimeInterpreterReportToJson(r)
    Close #ff
    Return 1
End Function

#endif
