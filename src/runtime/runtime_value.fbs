#ifndef UXB_RUNTIME_VALUE_FBS
#define UXB_RUNTIME_VALUE_FBS

#include once "../interpreter/common/interp_value.fbs"

Type UXBRuntimeArgList
    values(Any) As UXBInterpValue
    count As Integer
End Type

Sub UXBRuntimeArgListInit(ByRef args As UXBRuntimeArgList)
    args.count = 0
    Erase args.values
End Sub

Sub UXBRuntimeArgListAdd(ByRef args As UXBRuntimeArgList, ByRef v As UXBInterpValue)
    If args.count = 0 Then
        ReDim args.values(0)
    Else
        ReDim Preserve args.values(args.count)
    End If
    args.values(args.count) = v
    args.count += 1
End Sub

Function UXBRuntimeArgText(ByRef args As UXBRuntimeArgList, ByVal indexValue As Integer) As String
    If indexValue < 0 Or indexValue >= args.count Then Return ""
    Return UXBInterpValueToString(args.values(indexValue))
End Function

Function UXBRuntimeArgInt(ByRef args As UXBRuntimeArgList, ByVal indexValue As Integer) As LongInt
    If indexValue < 0 Or indexValue >= args.count Then Return 0
    If args.values(indexValue).kind = UXB_VAL_STRING Then Return ValInt(args.values(indexValue).stringValue)
    Return args.values(indexValue).intValue
End Function

#endif
