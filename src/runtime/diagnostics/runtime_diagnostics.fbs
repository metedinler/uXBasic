#ifndef UXB_RUNTIME_DIAGNOSTICS_FBS
#define UXB_RUNTIME_DIAGNOSTICS_FBS

#include once "../runtime_context.fbs"

Function UXBRuntimeDiagnosticStatus(ByRef rt As UXBRuntimeContext) As String
    If rt.lastErrorCode <> 0 Then Return "FAIL"
    Return "PASS"
End Function

Function UXBRuntimeDiagnosticText(ByRef rt As UXBRuntimeContext) As String
    Return rt.lastErrorText
End Function

#endif
