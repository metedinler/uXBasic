#ifndef UXB_LAYER_EVENT_CONTRACT_FBS
#define UXB_LAYER_EVENT_CONTRACT_FBS

' Layer event contract for every compiler stage.
' Works with diagnostics and hook trace but does not require hook trace to be enabled.

Type UXBLayerEventState
    logPath As String
    enabled As Integer
End Type

Dim Shared gUXBLayerEventState As UXBLayerEventState

Sub UXBLayerEventInit()
    If gUXBLayerEventState.enabled <> 0 Then Exit Sub
    gUXBLayerEventState.logPath = ""
    gUXBLayerEventState.enabled = 1
End Sub

Sub UXBLayerEventSetLogPath(ByRef logPath As String)
    UXBLayerEventInit
    gUXBLayerEventState.logPath = logPath
End Sub

Private Sub UXBLayerEventWrite(ByRef lineText As String)
    UXBLayerEventInit
    If Trim(gUXBLayerEventState.logPath) = "" Then Exit Sub
    Dim As Integer f
    f = FreeFile
    On Error GoTo _le_err
    Open gUXBLayerEventState.logPath For Append As #f
    Print #f, lineText
    Close #f
    On Error GoTo 0
    Exit Sub
_le_err:
    On Error GoTo 0
End Sub

Sub UXBLayerEventBegin(ByRef layerName As String, ByRef subjectText As String)
    Dim As String lineText
    lineText = "BEGIN|" & Trim(layerName) & "|" & Trim(subjectText)
    UXBLayerEventWrite lineText
    UxbTraceBegin layerName, subjectText
End Sub

Sub UXBLayerEventEnd(ByRef layerName As String, ByRef statusText As String, ByRef detailText As String)
    Dim As String lineText
    lineText = "END|" & Trim(layerName) & "|" & Trim(statusText) & "|" & Trim(detailText)
    UXBLayerEventWrite lineText
    UxbTraceEnd layerName, statusText, detailText
End Sub

Sub UXBLayerEventDiagnostic(ByRef layerName As String, ByRef codeText As String, ByRef detailText As String)
    Dim As String lineText
    lineText = "DIAG|" & Trim(layerName) & "|" & Trim(codeText) & "|" & Trim(detailText)
    UXBLayerEventWrite lineText
End Sub

#endif
