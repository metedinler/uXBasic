#ifndef UXB_RUNTIME_DISPATCH_STRICT_FBS
#define UXB_RUNTIME_DISPATCH_STRICT_FBS

#include once "runtime_service_dispatch.fbs"
#include once "services/runtime_service_catalog.fbs"

Type UXBRuntimeStrictDispatchResult
    ok As Integer
    serviceId As String
    handlerName As String
    errorCode As Integer
    errorText As String
    value As UXBInterpValue
End Type

Sub UXBRuntimeStrictDispatchResultInit(ByRef r As UXBRuntimeStrictDispatchResult)
    r.ok = 0
    r.serviceId = ""
    r.handlerName = ""
    r.errorCode = 0
    r.errorText = ""
    r.value = UXBInterpValueVoid()
End Sub

Function UXBRuntimeDispatchStrict( _
    ByRef rt As UXBRuntimeContext, _
    ByVal serviceText As String, _
    ByRef args As UXBRuntimeArgList, _
    ByRef result As UXBRuntimeStrictDispatchResult _
) As Integer

    UXBRuntimeStrictDispatchResultInit result
    result.serviceId = UCase(Trim(serviceText))

    If result.serviceId = "" Then
        result.errorCode = UXB_RT_ERR_SERVICE_NOT_FOUND
        result.errorText = "runtime service id is empty"
        result.value = UXBRuntimeSetError(rt, result.errorCode, result.errorText)
        Return 0
    End If

    If UXBRuntimeServiceKnown(result.serviceId) = 0 Then
        result.errorCode = UXB_RT_ERR_SERVICE_NOT_FOUND
        result.errorText = "runtime service not registered: " & result.serviceId
        result.value = UXBRuntimeSetError(rt, result.errorCode, result.errorText)
        Return 0
    End If

    result.handlerName = UXBRuntimeServiceHandlerName(result.serviceId)
    If Trim(result.handlerName) = "" Then
        result.errorCode = UXB_RT_ERR_HANDLER_NOT_AVAILABLE
        result.errorText = "runtime handler not available: " & result.serviceId
        result.value = UXBRuntimeSetError(rt, result.errorCode, result.errorText)
        Return 0
    End If

    result.value = UXBRuntimeDispatch(rt, result.serviceId, args)
    If UXBInterpIsError(result.value) <> 0 Then
        result.errorCode = result.value.errorCode
        result.errorText = result.value.errorText
        result.ok = 0
        Return 0
    End If

    result.ok = 1
    Return 1
End Function

#endif
