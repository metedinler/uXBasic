#ifndef UXB_EXTFP_RUNTIME_STATUS_FBS
#define UXB_EXTFP_RUNTIME_STATUS_FBS

Type UXBExtFpRuntimeStatus
    enabled As Integer
    strictMode As Integer
    diagnosticsEnabled As Integer
    runtimeDir As String
    fp80DllPath As String
    fp128DllPath As String
    bigfpDllPath As String
    fp80DllExists As Integer
    fp128DllExists As Integer
    bigfpDllExists As Integer
    fp80Available As Integer
    fp128Available As Integer
    bigfAvailable As Integer
    bigdAvailable As Integer
    ballAvailable As Integer
    messageText As String
End Type

Sub UXBExtFpRuntimeStatusInit(ByRef s As UXBExtFpRuntimeStatus)
    s.enabled = 0
    s.strictMode = 0
    s.diagnosticsEnabled = 0
    s.runtimeDir = "uxb\\dist\\runtime_ext"
    s.fp80DllPath = ""
    s.fp128DllPath = ""
    s.bigfpDllPath = ""
    s.fp80DllExists = 0
    s.fp128DllExists = 0
    s.bigfpDllExists = 0
    s.fp80Available = 0
    s.fp128Available = 0
    s.bigfAvailable = 0
    s.bigdAvailable = 0
    s.ballAvailable = 0
    s.messageText = ""
End Sub

Sub UXBExtFpRuntimeProbe(ByRef s As UXBExtFpRuntimeStatus)
    If Trim(s.runtimeDir) = "" Then s.runtimeDir = "uxb\\dist\\runtime_ext"
    s.fp80DllPath = s.runtimeDir & "\\uxb_fp80.dll"
    s.fp128DllPath = s.runtimeDir & "\\uxb_fp128.dll"
    s.bigfpDllPath = s.runtimeDir & "\\uxb_bigfp.dll"
    s.fp80DllExists = IIf(Dir(s.fp80DllPath) <> "", 1, 0)
    s.fp128DllExists = IIf(Dir(s.fp128DllPath) <> "", 1, 0)
    s.bigfpDllExists = IIf(Dir(s.bigfpDllPath) <> "", 1, 0)
    s.fp80Available = s.fp80DllExists
    s.fp128Available = s.fp128DllExists
    s.bigfAvailable = s.bigfpDllExists
    s.bigdAvailable = s.bigfpDllExists
    s.ballAvailable = s.bigfpDllExists
    s.messageText = ""
    If s.fp80Available = 0 Then s.messageText &= "F80 runtime DLL missing: " & s.fp80DllPath & Chr(10)
    If s.fp128Available = 0 Then s.messageText &= "F128 runtime DLL missing: " & s.fp128DllPath & Chr(10)
    If s.bigfpDllExists = 0 Then s.messageText &= "BIGF/BIGD/BALL runtime DLL missing: " & s.bigfpDllPath & Chr(10)
End Sub

Private Function UXBExtFpRuntimeBaseType(ByRef typeName As String) As String
    Dim As String t
    t = UCase(Trim(typeName))
    Dim As Integer p
    p = InStr(t, "(")
    If p > 0 Then t = Left(t, p - 1)
    Return Trim(t)
End Function

Function UXBExtFpRuntimeAvailableForType(ByRef s As UXBExtFpRuntimeStatus, ByRef typeName As String) As Integer
    Dim As String t = UXBExtFpRuntimeBaseType(typeName)
    Select Case t
    Case "F80", "EXTENDED", "EXT": Return s.fp80Available
    Case "F128", "FLOAT128", "QUAD": Return s.fp128Available
    Case "BIGF", "BIGFLOAT": Return s.bigfAvailable
    Case "BIGD", "BIGDECIMAL": Return s.bigdAvailable
    Case "BALL": Return s.ballAvailable
    Case Else: Return 0
    End Select
End Function

Function UXBExtFpRuntimeStatusJsonEscape(ByRef rawText As String) As String
    Dim As String outText = ""
    Dim As Integer i
    For i = 1 To Len(rawText)
        Dim As Integer c = Asc(Mid(rawText, i, 1))
        Select Case c
        Case 34: outText &= Chr(92) & Chr(34)
        Case 92: outText &= Chr(92) & Chr(92)
        Case 13: outText &= Chr(92) & "r"
        Case 10: outText &= Chr(92) & "n"
        Case 9: outText &= Chr(92) & "t"
        Case Else
            If c < 32 Then outText &= " " Else outText &= Chr(c)
        End Select
    Next i
    Return outText
End Function

Function UXBExtFpWritePolicyJson(ByRef s As UXBExtFpRuntimeStatus, ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""
    Dim As String q = Chr(34)
    Dim As String j = ""
    j &= "{"
    j &= q & "schema_version" & q & ":" & q & "uxb-extfp-policy-json-2" & q & ","
    j &= q & "producer" & q & ":" & q & "uXBasiC" & q & ","
    j &= q & "kind" & q & ":" & q & "extfp_policy" & q & ","
    j &= q & "status" & q & ":" & q & "ok" & q & ","
    j &= q & "runtime" & q & ":{"
    j &= q & "enabled" & q & ":" & IIf(s.enabled <> 0, "true", "false") & ","
    j &= q & "strict_mode" & q & ":" & IIf(s.strictMode <> 0, "true", "false") & ","
    j &= q & "runtime_dir" & q & ":" & q & UXBExtFpRuntimeStatusJsonEscape(s.runtimeDir) & q & ","
    j &= q & "fp80_available" & q & ":" & IIf(s.fp80Available <> 0, "true", "false") & ","
    j &= q & "fp128_available" & q & ":" & IIf(s.fp128Available <> 0, "true", "false") & ","
    j &= q & "bigf_available" & q & ":" & IIf(s.bigfAvailable <> 0, "true", "false") & ","
    j &= q & "bigd_available" & q & ":" & IIf(s.bigdAvailable <> 0, "true", "false") & ","
    j &= q & "ball_available" & q & ":" & IIf(s.ballAvailable <> 0, "true", "false") & ","
    j &= q & "fp80_dll" & q & ":" & q & UXBExtFpRuntimeStatusJsonEscape(s.fp80DllPath) & q & ","
    j &= q & "fp128_dll" & q & ":" & q & UXBExtFpRuntimeStatusJsonEscape(s.fp128DllPath) & q & ","
    j &= q & "bigfp_dll" & q & ":" & q & UXBExtFpRuntimeStatusJsonEscape(s.bigfpDllPath) & q & ","
    j &= q & "message" & q & ":" & q & UXBExtFpRuntimeStatusJsonEscape(s.messageText) & q
    j &= "},"
    j &= q & "types" & q & ":{"
    j &= q & "F80" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_f80" & q & "," & q & "storage_bytes" & q & ":16," & q & "mode" & q & ":" & q & "external_dll" & q & "},"
    j &= q & "F128" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_f128" & q & "," & q & "storage_bytes" & q & ":16," & q & "mode" & q & ":" & q & "external_dll" & q & "},"
    j &= q & "BIGF" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_bigf" & q & "," & q & "storage_bytes" & q & ":8," & q & "mode" & q & ":" & q & "mpfr_handle_runtime" & q & "},"
    j &= q & "BIGD" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_bigd" & q & "," & q & "storage_bytes" & q & ":8," & q & "mode" & q & ":" & q & "decimal_precision_handle_runtime" & q & "},"
    j &= q & "BALL" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_ball" & q & "," & q & "storage_bytes" & q & ":8," & q & "mode" & q & ":" & q & "mpfr_midpoint_radius_runtime" & q & "}"
    j &= "}}"
    Dim As Integer ff = FreeFile
    If Open(outPath For Output As #ff) <> 0 Then
        errText = "cannot open extfp policy json: " & outPath
        Return 0
    End If
    Print #ff, j;
    Close #ff
    Return 1
End Function

#endif
