#ifndef UXB_RUNTIME_CONSOLE_FBS
#define UXB_RUNTIME_CONSOLE_FBS

#include once "../runtime_context.fbs"
#include once "../services/runtime_service_ids.fbs"

Function UXBRuntimeConsoleDispatch(ByRef rt As UXBRuntimeContext, ByVal serviceId As String, ByRef args As UXBRuntimeArgList) As UXBInterpValue
    Select Case UCase(Trim(serviceId))
    Case RT_PRINT
        Dim textValue As String = ""
        If args.count > 0 Then textValue = UXBInterpValueToString(args.values(0))
        UXBRuntimeWriteOutput rt, textValue, RT_PRINT
        Return UXBInterpValueVoid()
    Case RT_INPUT
        Return UXBInterpValueString("")
    Case RT_CLS
        If rt.liveEcho <> 0 Then Cls
        rt.stdoutText = ""
        rt.jsonStdoutText = ""
        rt.screenText = ""
        rt.printerText = ""
        rt.hostText = ""
        Return UXBInterpValueVoid()
    Case RT_COLOR, RT_LOCATE
        Return UXBInterpValueExternal("RUNTIME", 0, UCase(Trim(serviceId)) & ":VIRTUAL_CONSOLE")
    Case RT_GETKEY, RT_INKEY
        ' Interpreter/runtime route is real and deterministic: no host keyboard is polled here.
        ' Native/browser targets may bind this service to a host event bridge.
        Return UXBInterpValueInt(0)
    End Select
    Return UXBRuntimeSetError(rt, UXB_RT_ERR_SERVICE_NOT_FOUND, "console service not found: " & serviceId)
End Function

#endif
