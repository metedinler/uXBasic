Type ExecFnNoArgStdcallI32 As Function Stdcall () As Long
Type ExecFnArg1CdeclI32 As Function Cdecl (ByVal a0 As Long) As Long
Type ExecFnArg2CdeclI32 As Function Cdecl (ByVal a0 As Long, ByVal a1 As Long) As Long
Type ExecFnArg3CdeclI32 As Function Cdecl (ByVal a0 As Long, ByVal a1 As Long, ByVal a2 As Long) As Long
Type ExecFnArg4CdeclI32 As Function Cdecl (ByVal a0 As Long, ByVal a1 As Long, ByVal a2 As Long, ByVal a3 As Long) As Long
Type ExecFnArg1StdcallI32 As Function Stdcall (ByVal a0 As Long) As Long
Type ExecFnArg2StdcallI32 As Function Stdcall (ByVal a0 As Long, ByVal a1 As Long) As Long
Type ExecFnArg3StdcallI32 As Function Stdcall (ByVal a0 As Long, ByVal a1 As Long, ByVal a2 As Long) As Long
Type ExecFnArg4StdcallI32 As Function Stdcall (ByVal a0 As Long, ByVal a1 As Long, ByVal a2 As Long, ByVal a3 As Long) As Long
Type ExecFnNoArgCdeclU64 As Function Cdecl () As ULongInt
Type ExecFnArg1CdeclU64 As Function Cdecl (ByVal a0 As ULongInt) As ULongInt
Type ExecFnArg2CdeclU64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt) As ULongInt
Type ExecFnArg3CdeclU64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt) As ULongInt
Type ExecFnArg4CdeclU64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt, ByVal a3 As ULongInt) As ULongInt
Type ExecFnNoArgCdeclF64 As Function Cdecl () As Double
Type ExecFnArg1CdeclF64 As Function Cdecl (ByVal a0 As Double) As Double
Type ExecFnArg2CdeclF64 As Function Cdecl (ByVal a0 As Double, ByVal a1 As Double) As Double
Type ExecFnArg3CdeclF64 As Function Cdecl (ByVal a0 As Double, ByVal a1 As Double, ByVal a2 As Double) As Double
Type ExecFnArg4CdeclF64 As Function Cdecl (ByVal a0 As Double, ByVal a1 As Double, ByVal a2 As Double, ByVal a3 As Double) As Double
Type ExecFnNoArgCdeclStrPtr As Function Cdecl () As Long
Type ExecFnArg1CdeclStrPtr As Function Cdecl (ByVal a0 As ZString Ptr) As Long
Type ExecFnArg2CdeclStrPtr As Function Cdecl (ByVal a0 As ZString Ptr, ByVal a1 As ZString Ptr) As Long
Type ExecFnArg3CdeclStrPtr As Function Cdecl (ByVal a0 As ZString Ptr, ByVal a1 As ZString Ptr, ByVal a2 As ZString Ptr) As Long
Type ExecFnArg4CdeclStrPtr As Function Cdecl (ByVal a0 As ZString Ptr, ByVal a1 As ZString Ptr, ByVal a2 As ZString Ptr, ByVal a3 As ZString Ptr) As Long
