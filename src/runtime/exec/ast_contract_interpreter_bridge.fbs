#ifndef UXBASIC_AST_CONTRACT_INTERPRETER_BRIDGE_FBS
#define UXBASIC_AST_CONTRACT_INTERPRETER_BRIDGE_FBS

#include once "../../parser/ast_contract_layer_bindings.fbs"
#include once "../../interpreter/ast/ast_interp_registry.fbs"

Function AstExecStep2Status(ByVal astNodeKind As String) As String
    Dim d As String = UXBAstInterpDecisionForNode(astNodeKind)
    Select Case d
    Case AST_EXEC_IMPLEMENTED, AST_EXEC_RUNTIME_CALL
        Return "IMPLEMENTED"
    Case AST_EXEC_COMPILE_TIME_ONLY
        Return "COMPILE_TIME_ONLY"
    Case AST_EXEC_NATIVE_ONLY
        Return "NATIVE_ONLY"
    Case AST_EXEC_WASM_UNSUPPORTED
        Return "WASM_UNSUPPORTED"
    Case AST_EXEC_DIAGNOSTIC_ONLY
        Return "DIAGNOSTIC_ONLY"
    Case AST_EXEC_RESERVED
        Return "RESERVED"
    Case AST_EXEC_REMOVED
        Return "REMOVED"
    Case AST_EXEC_MISSING
        Return "MISSING"
    End Select
    Return "BROKEN"
End Function

Function AstExecStep2Handler(ByVal astNodeKind As String) As String
    Return UXBAstInterpHandlerForNode(astNodeKind)
End Function

Function AstExecStep2ExpressionDispatch(ByVal astNodeKind As String, ByRef errText As String) As Integer
    If AstExecStep2Status(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "AST expression execution blocked for " & astNodeKind
    Return 0
End Function

Function AstExecStep2ControlDispatch(ByVal astNodeKind As String, ByRef errText As String) As Integer
    If AstExecStep2Status(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "AST control execution blocked for " & astNodeKind
    Return 0
End Function

Function AstExecStep2RuntimeDispatch(ByVal astNodeKind As String, ByRef errText As String) As Integer
    If AstExecStep2Status(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "AST runtime execution blocked for " & astNodeKind
    Return 0
End Function

Function AstExecStep2ObjectDispatch(ByVal astNodeKind As String, ByRef errText As String) As Integer
    If AstExecStep2Status(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "AST object execution blocked for " & astNodeKind
    Return 0
End Function

Function AstExecStep2StatementDispatch(ByVal astNodeKind As String, ByRef errText As String) As Integer
    If AstExecStep2Status(astNodeKind) = "IMPLEMENTED" Then errText = "": Return 1
    errText = "AST statement execution blocked for " & astNodeKind
    Return 0
End Function

Function AstExecStep2NativeBlocked(ByVal astNodeKind As String, ByRef errText As String) As Integer
    errText = "native-only AST node cannot be executed by portable AST interpreter: " & astNodeKind
    Return 0
End Function

#endif
