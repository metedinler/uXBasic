Private Function ExecBuiltinGetArgNode(ByRef ps As ParseState, ByVal callNodeIdx As Integer, ByRef callName As String, ByRef argNodeIdx As Integer, ByRef errText As String) As Integer
    argNodeIdx = ExecChildAt(ps, callNodeIdx, 0)
    If argNodeIdx = -1 Then
        errText = "exec: " & callName & " arg missing"
        Return 0
    End If
    Return 1
End Function

Private Function ExecBuiltinArgAsInt(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, ByRef callName As String, ByRef valueOut As Integer, ByRef errText As String, ByVal allowString As Integer) As Integer
    Dim a0 As Integer
    If ExecBuiltinGetArgNode(ps, callNodeIdx, callName, a0, errText) = 0 Then Return 0

    Dim argNode As ASTNode
    argNode = ps.ast.nodes(a0)
    If allowString <> 0 And UCase(argNode.kind) = "STRING" Then
        valueOut = ValInt(argNode.value)
        Return 1
    End If

    valueOut = ExecEvalNode(ps, es, a0, errText)
    If errText <> "" Then Return 0
    Return 1
End Function

Private Function ExecBuiltinTextMidCall( _
    ByRef ps As ParseState, ByRef es As ExecState, ByVal callExprIdx As Integer, _
    ByRef textOut As String, ByRef errText As String _
) As Integer
    Dim midArgc As Integer
    midArgc = ExecChildCount(ps, callExprIdx)
    If midArgc < 2 Or midArgc > 3 Then
        errText = "exec: MID expects 2 or 3 arguments"
        Return 0
    End If

    Dim midSrcNode As Integer
    Dim midStartNode As Integer
    midSrcNode = ExecChildAt(ps, callExprIdx, 0)
    midStartNode = ExecChildAt(ps, callExprIdx, 1)
    If midSrcNode = -1 Or midStartNode = -1 Then
        errText = "exec: MID args missing"
        Return 0
    End If

    Dim midSrc As String
    If ExecEvalNodeAsText(ps, es, midSrcNode, midSrc, errText) = 0 Then Return 0

    Dim midStart As Integer
    midStart = ExecEvalNode(ps, es, midStartNode, errText)
    If errText <> "" Then Return 0
    If midStart < 1 Then
        errText = "exec: MID start must be >= 1"
        Return 0
    End If

    If midStart > Len(midSrc) Then
        textOut = ""
        Return 1
    End If

    If midArgc = 2 Then
        textOut = Mid(midSrc, midStart)
        Return 1
    End If

    Dim midLenNode As Integer
    midLenNode = ExecChildAt(ps, callExprIdx, 2)
    If midLenNode = -1 Then
        errText = "exec: MID length arg missing"
        Return 0
    End If

    Dim midLen As Integer
    midLen = ExecEvalNode(ps, es, midLenNode, errText)
    If errText <> "" Then Return 0
    If midLen < 0 Then
        errText = "exec: MID length must be >= 0"
        Return 0
    End If

    textOut = Mid(midSrc, midStart, midLen)
    Return 1
End Function

Private Function ExecBuiltinTextSpaceCall( _
    ByRef ps As ParseState, ByRef es As ExecState, ByVal callExprIdx As Integer, _
    ByRef callName As String, ByRef textOut As String, ByRef errText As String _
) As Integer
    Dim spaceCount As Integer
    If ExecBuiltinArgAsInt(ps, es, callExprIdx, callName, spaceCount, errText, 1) = 0 Then Return 0
    If spaceCount < 0 Then
        errText = "exec: SPACE count must be >= 0"
        Return 0
    End If
    If spaceCount > EXEC_MAX_TEXT_LEN Then
        errText = "exec: SPACE count too large"
        Return 0
    End If

    textOut = Space(spaceCount)
    Return 1
End Function

Private Function ExecBuiltinTextStringCall( _
    ByRef ps As ParseState, ByRef es As ExecState, ByVal callExprIdx As Integer, _
    ByRef textOut As String, ByRef errText As String _
) As Integer
    Dim stringArgc As Integer
    stringArgc = ExecChildCount(ps, callExprIdx)
    If stringArgc <> 2 Then
        errText = "exec: STRING expects 2 arguments"
        Return 0
    End If

    Dim stringCountNode As Integer
    Dim stringCharNode As Integer
    stringCountNode = ExecChildAt(ps, callExprIdx, 0)
    stringCharNode = ExecChildAt(ps, callExprIdx, 1)
    If stringCountNode = -1 Or stringCharNode = -1 Then
        errText = "exec: STRING args missing"
        Return 0
    End If

    Dim stringCount As Integer
    stringCount = ExecEvalNode(ps, es, stringCountNode, errText)
    If errText <> "" Then Return 0
    If stringCount < 0 Then
        errText = "exec: STRING count must be >= 0"
        Return 0
    End If
    If stringCount > EXEC_MAX_TEXT_LEN Then
        errText = "exec: STRING count too large"
        Return 0
    End If

    Dim stringCharCode As Integer
    Dim stringCharAst As ASTNode
    stringCharAst = ps.ast.nodes(stringCharNode)
    If UCase(stringCharAst.kind) = "STRING" Then
        If Len(stringCharAst.value) = 0 Then
            errText = "exec: STRING char arg empty"
            Return 0
        End If
        stringCharCode = Asc(Left(stringCharAst.value, 1))
    Else
        stringCharCode = ExecEvalNode(ps, es, stringCharNode, errText)
        If errText <> "" Then Return 0
    End If

    If stringCharCode < 0 Or stringCharCode > 255 Then
        errText = "exec: STRING char code range error"
        Return 0
    End If

    textOut = String(stringCount, stringCharCode)
    Return 1
End Function

Private Function ExecBuiltinArgAsText( _
    ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, _
    ByRef callName As String, ByRef textOut As String, ByRef errText As String _
) As Integer
    Dim a0 As Integer
    If ExecBuiltinGetArgNode(ps, callNodeIdx, callName, a0, errText) = 0 Then Return 0

    Dim argNode As ASTNode
    argNode = ps.ast.nodes(a0)

    If UCase(argNode.kind) = "STRING" Then
        textOut = argNode.value
        Return 1
    End If

    If UCase(argNode.kind) = "CALL_EXPR" Then
        Dim textCallName As String
        textCallName = UCase(Trim(argNode.value))

        Select Case textCallName
        Case "STR"
            Dim strArgNode As Integer
            strArgNode = ExecChildAt(ps, a0, 0)
            If strArgNode = -1 Then
                errText = "exec: STR arg missing"
                Return 0
            End If

            Dim magicStrText As String
            Dim magicStrRv As Integer
            magicStrRv = ExecTryEvalMagicToString(ps, es, strArgNode, magicStrText, errText)
            If magicStrRv > 0 Then
                textOut = magicStrText
                Return 1
            End If
            If magicStrRv = 0 Then Return 0

            Dim strValue As ExecValue
            If ExecEvalExpression(ps, strArgNode, es, strValue, errText) = 0 Then Return 0
            textOut = ExecValueToString(strValue)
            Return 1

        Case "UCASE"
            Dim ucSrc As String
            If ExecBuiltinArgAsText(ps, es, a0, textCallName, ucSrc, errText) = 0 Then Return 0
            textOut = UCase(ucSrc)
            Return 1

        Case "LCASE"
            Dim lcSrc As String
            If ExecBuiltinArgAsText(ps, es, a0, textCallName, lcSrc, errText) = 0 Then Return 0
            textOut = LCase(lcSrc)
            Return 1

        Case "CHR"
            Dim chrValue As Integer
            If ExecBuiltinArgAsInt(ps, es, a0, textCallName, chrValue, errText, 1) = 0 Then Return 0
            If chrValue < 0 Or chrValue > 255 Then
                errText = "exec: CHR range error"
                Return 0
            End If
            textOut = Chr(chrValue)
            Return 1

        Case "LTRIM"
            Dim ltrimSrc As String
            If ExecBuiltinArgAsText(ps, es, a0, textCallName, ltrimSrc, errText) = 0 Then Return 0
            textOut = LTrim(ltrimSrc)
            Return 1

        Case "RTRIM"
            Dim rtrimSrc As String
            If ExecBuiltinArgAsText(ps, es, a0, textCallName, rtrimSrc, errText) = 0 Then Return 0
            textOut = RTrim(rtrimSrc)
            Return 1


        Case "TRIM"
            Dim trimSrc43 As String
            If ExecBuiltinArgAsText(ps, es, a0, textCallName, trimSrc43, errText) = 0 Then Return 0
            textOut = Trim(trimSrc43)
            Return 1

        Case "LEFT"
            Dim leftArgc43 As Integer
            leftArgc43 = ExecChildCount(ps, a0)
            If leftArgc43 <> 2 Then
                errText = "exec: LEFT expects 2 arguments"
                Return 0
            End If
            Dim leftSrc43 As String
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, a0, 0), leftSrc43, errText) = 0 Then Return 0
            Dim leftLen43 As Integer
            leftLen43 = ExecEvalNode(ps, es, ExecChildAt(ps, a0, 1), errText)
            If errText <> "" Then Return 0
            If leftLen43 < 0 Then leftLen43 = 0
            textOut = Left(leftSrc43, leftLen43)
            Return 1

        Case "RIGHT"
            Dim rightArgc43 As Integer
            rightArgc43 = ExecChildCount(ps, a0)
            If rightArgc43 <> 2 Then
                errText = "exec: RIGHT expects 2 arguments"
                Return 0
            End If
            Dim rightSrc43 As String
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, a0, 0), rightSrc43, errText) = 0 Then Return 0
            Dim rightLen43 As Integer
            rightLen43 = ExecEvalNode(ps, es, ExecChildAt(ps, a0, 1), errText)
            If errText <> "" Then Return 0
            If rightLen43 < 0 Then rightLen43 = 0
            textOut = Right(rightSrc43, rightLen43)
            Return 1

        Case "INSTR"
            Dim instrArgc43 As Integer
            instrArgc43 = ExecChildCount(ps, a0)
            If instrArgc43 < 2 Or instrArgc43 > 3 Then
                errText = "exec: INSTR expects 2 or 3 arguments"
                Return 0
            End If
            Dim instrStart43 As Integer
            Dim instrHay43 As String
            Dim instrNeedle43 As String
            If instrArgc43 = 2 Then
                instrStart43 = 1
                If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, a0, 0), instrHay43, errText) = 0 Then Return 0
                If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, a0, 1), instrNeedle43, errText) = 0 Then Return 0
            Else
                instrStart43 = ExecEvalNode(ps, es, ExecChildAt(ps, a0, 0), errText)
                If errText <> "" Then Return 0
                If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, a0, 1), instrHay43, errText) = 0 Then Return 0
                If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, a0, 2), instrNeedle43, errText) = 0 Then Return 0
            End If
            textOut = LTrim(Str(InStr(instrStart43, instrHay43, instrNeedle43)))
            Return 1

        Case "MID"
            If ExecBuiltinTextMidCall(ps, es, a0, textOut, errText) = 0 Then Return 0
            Return 1

        Case "SPACE"
            If ExecBuiltinTextSpaceCall(ps, es, a0, textCallName, textOut, errText) = 0 Then Return 0
            Return 1

        Case "STRING"
            If ExecBuiltinTextStringCall(ps, es, a0, textOut, errText) = 0 Then Return 0
            Return 1
        End Select
    End If

    Dim valueOut As ExecValue
    If ExecEvalExpression(ps, a0, es, valueOut, errText) = 0 Then Return 0

    textOut = ExecValueToString(valueOut)
    Return 1
End Function

Private Function ExecTryEvalCallExprAsText(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, ByRef textOut As String, ByRef errText As String, ByRef handledOut As Integer) As Integer
    Dim callNode As ASTNode
    callNode = ps.ast.nodes(callNodeIdx)

    Dim textCallName As String
    textCallName = UCase(Trim(callNode.value))
    ' FIX8_STR_NS_INC_FIXED_20260611: normalize string builtin aliases with trailing $.
    If Right(textCallName, 1) = "$" Then textCallName = Left(textCallName, Len(textCallName) - 1)

    handledOut = 1

    Select Case textCallName
    Case "STR"
        Dim strArgNode As Integer
        strArgNode = ExecChildAt(ps, callNodeIdx, 0)
        If strArgNode = -1 Then
            errText = "exec: STR arg missing"
            Return 0
        End If

        Dim strValue As ExecValue
        If ExecEvalExpression(ps, strArgNode, es, strValue, errText) = 0 Then Return 0
        textOut = ExecValueToString(strValue)
        Return 1

    Case "UCASE"
        Dim ucText As String
        If ExecBuiltinArgAsText(ps, es, callNodeIdx, textCallName, ucText, errText) = 0 Then Return 0
        textOut = UCase(ucText)
        Return 1

    Case "LCASE"
        Dim lcText As String
        If ExecBuiltinArgAsText(ps, es, callNodeIdx, textCallName, lcText, errText) = 0 Then Return 0
        textOut = LCase(lcText)
        Return 1

    Case "CHR"
        Dim chrValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, textCallName, chrValue, errText, 1) = 0 Then Return 0
        If chrValue < 0 Or chrValue > 255 Then
            errText = "exec: CHR range error"
            Return 0
        End If
        textOut = Chr(chrValue)
        Return 1

    Case "LTRIM"
        Dim ltrimText As String
        If ExecBuiltinArgAsText(ps, es, callNodeIdx, textCallName, ltrimText, errText) = 0 Then Return 0
        textOut = LTrim(ltrimText)
        Return 1

    Case "RTRIM"
        Dim rtrimText As String
        If ExecBuiltinArgAsText(ps, es, callNodeIdx, textCallName, rtrimText, errText) = 0 Then Return 0
        textOut = RTrim(rtrimText)
        Return 1

    Case "TRIM"
        Dim trimText As String
        If ExecBuiltinArgAsText(ps, es, callNodeIdx, textCallName, trimText, errText) = 0 Then Return 0
        textOut = Trim(trimText)
        Return 1

    Case "LEFT"
        Dim leftArgc As Integer
        leftArgc = ExecChildCount(ps, callNodeIdx)
        If leftArgc <> 2 Then
            errText = "exec: LEFT expects 2 arguments"
            Return 0
        End If
        Dim leftSrc As String
        If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 0), leftSrc, errText) = 0 Then Return 0
        Dim leftLen As Integer
        leftLen = ExecEvalNode(ps, es, ExecChildAt(ps, callNodeIdx, 1), errText)
        If errText <> "" Then Return 0
        If leftLen < 0 Then leftLen = 0
        textOut = Left(leftSrc, leftLen)
        Return 1

    Case "RIGHT"
        Dim rightArgc As Integer
        rightArgc = ExecChildCount(ps, callNodeIdx)
        If rightArgc <> 2 Then
            errText = "exec: RIGHT expects 2 arguments"
            Return 0
        End If
        Dim rightSrc As String
        If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 0), rightSrc, errText) = 0 Then Return 0
        Dim rightLen As Integer
        rightLen = ExecEvalNode(ps, es, ExecChildAt(ps, callNodeIdx, 1), errText)
        If errText <> "" Then Return 0
        If rightLen < 0 Then rightLen = 0
        textOut = Right(rightSrc, rightLen)
        Return 1

    Case "INSTR"
        Dim instrArgc As Integer
        instrArgc = ExecChildCount(ps, callNodeIdx)
        If instrArgc < 2 Or instrArgc > 3 Then
            errText = "exec: INSTR expects 2 or 3 arguments"
            Return 0
        End If
        Dim instrStart As Integer
        Dim instrHay As String
        Dim instrNeedle As String
        If instrArgc = 2 Then
            instrStart = 1
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 0), instrHay, errText) = 0 Then Return 0
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 1), instrNeedle, errText) = 0 Then Return 0
        Else
            instrStart = ExecEvalNode(ps, es, ExecChildAt(ps, callNodeIdx, 0), errText)
            If errText <> "" Then Return 0
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 1), instrHay, errText) = 0 Then Return 0
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 2), instrNeedle, errText) = 0 Then Return 0
        End If
        textOut = LTrim(Str(InStr(instrStart, instrHay, instrNeedle)))
        Return 1

    Case "MID"
        Return ExecBuiltinTextMidCall(ps, es, callNodeIdx, textOut, errText)

    Case "SPACE"
        Return ExecBuiltinTextSpaceCall(ps, es, callNodeIdx, textCallName, textOut, errText)

    Case "STRING"
        Return ExecBuiltinTextStringCall(ps, es, callNodeIdx, textOut, errText)
    End Select

    handledOut = 0
    Return 1
End Function

Private Function ExecEvalNodeAsText(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef textOut As String, ByRef errText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then
        errText = "exec: invalid text node"
        Return 0
    End If

    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)

    If UCase(n.kind) = "STRING" Then
        textOut = n.value
        Return 1
    End If

    If UCase(n.kind) = "CALL_EXPR" Then
        Dim handledCallExpr As Integer
        If ExecTryEvalCallExprAsText(ps, es, nodeIdx, textOut, errText, handledCallExpr) = 0 Then Return 0
        If handledCallExpr <> 0 Then
            Return 1
        End If
    End If

    Dim magicText As String
    Dim magicRv As Integer
    magicRv = ExecTryEvalMagicToString(ps, es, nodeIdx, magicText, errText)
    If magicRv > 0 Then
        textOut = magicText
        Return 1
    End If
    If magicRv = 0 Then Return 0

    Dim valueOut As ExecValue
    If ExecEvalExpression(ps, nodeIdx, es, valueOut, errText) = 0 Then Return 0

    textOut = ExecValueToString(valueOut)
    Return 1
End Function
