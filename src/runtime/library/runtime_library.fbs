#ifndef UXB_RUNTIME_LIBRARY_FBS
#define UXB_RUNTIME_LIBRARY_FBS

#include once "../runtime_context.fbs"
#include once "../services/runtime_service_ids.fbs"

Private Function UXBRuntimeLibraryPayload(ByVal serviceId As String, ByRef args As UXBRuntimeArgList) As String
    Dim s As String = UCase(Trim(serviceId)) & ":RUNTIME_CALL"
    Dim i As Integer
    For i = 0 To args.count - 1
        s &= ":" & UXBInterpValueToString(args.values(i))
    Next i
    Return s
End Function

Function UXBRuntimeLibraryDispatch(ByRef rt As UXBRuntimeContext, ByVal serviceId As String, ByRef args As UXBRuntimeArgList) As UXBInterpValue
    Select Case UCase(Trim(serviceId))
    Case RT_JSON_CALL, RT_REGEX_CALL, RT_HTTP_CALL, RT_OS_CALL, RT_LLAMA_CALL, RT_LUA_CALL, RT_PROLOG_CALL, RT_SQLITE_CALL, RT_ARCHIVE_CALL, RT_AUDIO_CALL, RT_CRYPTO_CALL, RT_CURL_CALL, RT_GRAPHICS_CALL, RT_IMAGE_CALL, RT_ONNX_CALL, RT_SERVER_CALL, RT_STRINGX_CALL, RT_LIBRARY_CALL
        Return UXBRuntimeSetError(rt, UXB_RT_ERR_SERVICE_NOT_FOUND, "runtime library service has no bound implementation: " & serviceId)
    Case RT_EXTFP_CALL
        Return UXBRuntimeSetError(rt, UXB_RT_ERR_SERVICE_NOT_FOUND, "external-number calls must use the real BIGINIT/FP runtime bridge")
    End Select
    Return UXBRuntimeSetError(rt, UXB_RT_ERR_SERVICE_NOT_FOUND, "library service not found: " & serviceId)
End Function

#endif
