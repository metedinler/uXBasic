Function UXBRuntimeCatalogFind(ByRef cat As UXBRuntimeServiceCatalog, ByVal serviceText As String) As Integer
    Dim key As String = UCase(Trim(serviceText))
    Dim i As Integer
    For i = 0 To cat.count - 1
        If cat.records(i).serviceId = key Then Return i
    Next i
    Return -1
End Function

