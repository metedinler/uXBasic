#ifndef UXB_RUNTIME_SERVICE_CATALOG_FBS
#define UXB_RUNTIME_SERVICE_CATALOG_FBS

#include once "runtime_service_ids.fbs"
#include once "../runtime_service_registry.fbs"
#include once "runtime_service_signature.fbs"

' Dairesel include yollarinda FreeBASIC bazen fonksiyon govdesini gormeden
' katalog satirina ulasiyor. Bu acik Declare, tek gecisli derlemeyi sabitler.
Declare Function UXBRuntimeServiceHandlerName(ByVal serviceId As String) As String

Type UXBRuntimeServiceContract
    serviceId As String
    familyName As String
    handlerName As String
    signatureText As String
    supportedTargets As String
    positiveTest As String
    negativeTest As String
    failClosedCode As String
End Type

Type UXBRuntimeServiceCatalog
    records(Any) As UXBRuntimeServiceContract
    count As Integer
End Type

Sub UXBRuntimeServiceCatalogInit(ByRef cat As UXBRuntimeServiceCatalog)
    cat.count = 0
    Erase cat.records
End Sub

Private Sub UXBRuntimeServiceCatalogEnsure(ByRef cat As UXBRuntimeServiceCatalog, ByVal needCount As Integer)
    If cat.count = 0 Then
        ReDim cat.records(15)
    End If
    If UBound(cat.records) + 1 >= needCount Then Exit Sub
    Dim cap As Integer = UBound(cat.records) + 1
    If cap < 16 Then cap = 16
    Do While cap < needCount
        cap *= 2
    Loop
    ReDim Preserve cat.records(cap - 1)
End Sub

Sub UXBRuntimeServiceCatalogAdd( _
    ByRef cat As UXBRuntimeServiceCatalog, _
    ByVal serviceText As String, _
    ByVal signatureText As String, _
    ByVal targetsText As String, _
    ByVal positiveText As String, _
    ByVal negativeText As String, _
    ByVal failCodeText As String = "RUNTIME_SERVICE_FAIL_CLOSED" _
)
    Dim sid As String = UCase(Trim(serviceText))
    If sid = "" Then Exit Sub
    UXBRuntimeServiceCatalogEnsure cat, cat.count + 1
    cat.records(cat.count).serviceId = sid
    cat.records(cat.count).familyName = UXBRuntimeServiceFamily(sid)
    cat.records(cat.count).handlerName = UXBRuntimeServiceHandlerName(sid)
    cat.records(cat.count).signatureText = signatureText
    cat.records(cat.count).supportedTargets = UCase(Trim(targetsText))
    cat.records(cat.count).positiveTest = positiveText
    cat.records(cat.count).negativeTest = negativeText
    cat.records(cat.count).failClosedCode = failCodeText
    cat.count += 1
End Sub

