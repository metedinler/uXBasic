    UXBRuntimeServiceCatalogAdd cat, RT_PRINT, "VOID(ANY)", "X64,JS,WASM,BROWSER", "tests/adim12/positive/adim12_print.bas", "tests/adim12/negative/adim12_missing_service.bas"
