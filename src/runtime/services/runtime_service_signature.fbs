#ifndef UXB_RUNTIME_SERVICE_SIGNATURE_FBS
#define UXB_RUNTIME_SERVICE_SIGNATURE_FBS

Type UXBRuntimeServiceSignature
    returnType As String
    argTypes(0 To 15) As String
    argCount As Integer
    variadic As Integer
End Type

Sub UXBRuntimeServiceSignatureClear(ByRef sig As UXBRuntimeServiceSignature)
    Dim i As Integer
    sig.returnType = "VOID"
    sig.argCount = 0
    sig.variadic = 0
    For i = 0 To 15
        sig.argTypes(i) = ""
    Next i
End Sub

Private Function UXBRuntimeSignatureCanonicalType(ByVal t As String) As String
    Dim u As String = UCase(Trim(t))
    Select Case u
    Case "", "VOID": Return "VOID"
    Case "INT", "INTEGER", "I32": Return "I32"
    Case "LONG", "LONGINT", "I64": Return "I64"
    Case "DOUBLE", "F64", "FLOAT": Return "F64"
    Case "SINGLE", "F32": Return "F32"
    Case "STR", "STRING": Return "STRING"
    Case "PTR", "HANDLE", "FILE", "OBJECT": Return u
    Case "ANY", "VARIANT": Return "ANY"
    End Select
    Return u
End Function

Function UXBRuntimeSignatureMake(ByVal returnTypeText As String, ByVal argsText As String, ByVal variadicValue As Integer = 0) As UXBRuntimeServiceSignature
    Dim sig As UXBRuntimeServiceSignature
    UXBRuntimeServiceSignatureClear sig
    sig.returnType = UXBRuntimeSignatureCanonicalType(returnTypeText)
    sig.variadic = IIf(variadicValue <> 0, 1, 0)

    Dim raw As String = Trim(argsText)
    If raw = "" Or UCase(raw) = "VOID" Then Return sig

    Dim i As Integer
    Dim startPos As Integer = 1
    For i = 1 To Len(raw) + 1
        If i > Len(raw) Or Mid(raw, i, 1) = "," Then
            Dim part As String = Trim(Mid(raw, startPos, i - startPos))
            If part <> "" Then
                If sig.argCount <= 15 Then
                    sig.argTypes(sig.argCount) = UXBRuntimeSignatureCanonicalType(part)
                    sig.argCount += 1
                End If
            End If
            startPos = i + 1
        End If
    Next i

    Return sig
End Function

Function UXBRuntimeSignatureToText(ByRef sig As UXBRuntimeServiceSignature) As String
    Dim outText As String = sig.returnType & "("
    Dim i As Integer
    For i = 0 To sig.argCount - 1
        If i > 0 Then outText &= ","
        outText &= sig.argTypes(i)
    Next i
    If sig.variadic <> 0 Then
        If sig.argCount > 0 Then outText &= ","
        outText &= "..."
    End If
    outText &= ")"
    Return outText
End Function

#endif
