#ifndef UXB_RUNTIME_LIBRARY_REGISTRY_ADIM15_FBS
#define UXB_RUNTIME_LIBRARY_REGISTRY_ADIM15_FBS

Type UXBLibrarySurfaceRoute
    libraryName As String
    surfaceName As String
    routeKind As String      ' RUNTIME_SERVICE, BACKEND_NATIVE, BACKEND_WEB, DIAGNOSTIC
    nativeOnly As Integer
    evidenceFunction As String
End Type

Const UXB_LIB_ROUTE_MAX As Integer = 512
Dim Shared gUXBLibraryRoutes(0 To UXB_LIB_ROUTE_MAX - 1) As UXBLibrarySurfaceRoute
Dim Shared gUXBLibraryRouteCount As Integer

Sub UXBLibraryRegistryResetAdim15()
    gUXBLibraryRouteCount = 0
End Sub

Function UXBLibraryRegistryAddAdim15(ByRef libName As String, ByRef surfaceName As String, ByRef routeKind As String, ByVal nativeOnly As Integer, ByRef evidenceFunction As String) As Integer
    If gUXBLibraryRouteCount >= UXB_LIB_ROUTE_MAX Then Return 0
    gUXBLibraryRoutes(gUXBLibraryRouteCount).libraryName = UCase(Trim(libName))
    gUXBLibraryRoutes(gUXBLibraryRouteCount).surfaceName = UCase(Trim(surfaceName))
    gUXBLibraryRoutes(gUXBLibraryRouteCount).routeKind = UCase(Trim(routeKind))
    gUXBLibraryRoutes(gUXBLibraryRouteCount).nativeOnly = nativeOnly
    gUXBLibraryRoutes(gUXBLibraryRouteCount).evidenceFunction = evidenceFunction
    gUXBLibraryRouteCount += 1
    Return 1
End Function

Sub UXBLibraryRegistryInitDefaultsAdim15()
    If gUXBLibraryRouteCount > 0 Then Exit Sub
    UXBLibraryRegistryAddAdim15 "MATH", "SIN", "RUNTIME_SERVICE", 0, "UXBRuntimeMathDispatch"
    UXBLibraryRegistryAddAdim15 "MATH", "COS", "RUNTIME_SERVICE", 0, "UXBRuntimeMathDispatch"
    UXBLibraryRegistryAddAdim15 "STRINGX", "REGEX", "BACKEND_NATIVE", 1, "UXBBackendNativeOnlyDiagnosticAdim15"
    UXBLibraryRegistryAddAdim15 "OS", "PROCESS", "BACKEND_NATIVE", 1, "UXBBackendNativeOnlyDiagnosticAdim15"
    UXBLibraryRegistryAddAdim15 "CURL", "HTTP", "BACKEND_NATIVE", 1, "UXBBackendNativeOnlyDiagnosticAdim15"
    UXBLibraryRegistryAddAdim15 "BROWSER", "CANVAS", "BACKEND_WEB", 0, "UXBJsBackendEmitModule"
    UXBLibraryRegistryAddAdim15 "WEBGPU", "GPU", "BACKEND_WEB", 0, "UXBJsBackendEmitModule"
    UXBLibraryRegistryAddAdim15 "LLAMA", "INFER", "BACKEND_NATIVE", 1, "UXBFFIRegistryResolveCall"
    UXBLibraryRegistryAddAdim15 "LUA", "CALL", "BACKEND_NATIVE", 1, "UXBFFIRegistryResolveCall"
    UXBLibraryRegistryAddAdim15 "PROLOG", "QUERY", "RUNTIME_SERVICE", 0, "UXBRuntimeServiceDispatch"
End Sub

Function UXBLibraryRegistryFindAdim15(ByRef libName As String, ByRef surfaceName As String) As Integer
    UXBLibraryRegistryInitDefaultsAdim15
    Dim i As Integer
    Dim l As String
    Dim s As String
    l = UCase(Trim(libName))
    s = UCase(Trim(surfaceName))
    For i = 0 To gUXBLibraryRouteCount - 1
        If gUXBLibraryRoutes(i).libraryName = l And gUXBLibraryRoutes(i).surfaceName = s Then Return i
    Next i
    Return -1
End Function

Function UXBLibraryRegistryWriteCsvAdim15(ByRef outPath As String, ByRef errText As String) As Integer
    UXBLibraryRegistryInitDefaultsAdim15
    errText = ""
    Dim f As Integer
    f = FreeFile
    Open outPath For Output As #f
    If Err <> 0 Then errText = "library registry csv open failed: " & outPath: Return 0
    Print #f, "library_name,surface_name,route_kind,native_only,evidence_function"
    Dim i As Integer
    For i = 0 To gUXBLibraryRouteCount - 1
        Print #f, gUXBLibraryRoutes(i).libraryName & "," & gUXBLibraryRoutes(i).surfaceName & "," & gUXBLibraryRoutes(i).routeKind & "," & LTrim(Str(gUXBLibraryRoutes(i).nativeOnly)) & "," & gUXBLibraryRoutes(i).evidenceFunction
    Next i
    Close #f
    Return 1
End Function

#endif
