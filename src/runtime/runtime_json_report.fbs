#ifndef UXB_RUNTIME_JSON_REPORT_FBS
#define UXB_RUNTIME_JSON_REPORT_FBS

#include once "runtime_context.fbs"

Private Function UXBRuntimeReportJsonEscape2(ByVal rawText As String) As String
    Dim outText As String = ""
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim ch As String = Mid(rawText, i, 1)
        Select Case ch
        Case Chr(34): outText &= "\" & Chr(34)
        Case "\": outText &= "\\"
        Case Chr(13): outText &= "\r"
        Case Chr(10): outText &= "\n"
        Case Chr(9): outText &= "\t"
        Case Else: outText &= ch
        End Select
    Next i
    Return outText
End Function

Function UXBRuntimeContextToJson(ByRef rt As UXBRuntimeContext) As String
    Dim q As String = Chr(34)
    Dim j As String = "{" & Chr(10)
    j &= "  " & q & "target" & q & ":" & q & UXBRuntimeReportJsonEscape2(rt.targetName) & q & "," & Chr(10)
    j &= "  " & q & "service_call_count" & q & ":" & LTrim(Str(rt.serviceCallCount)) & "," & Chr(10)
    j &= "  " & q & "last_error_code" & q & ":" & LTrim(Str(rt.lastErrorCode)) & "," & Chr(10)
    j &= "  " & q & "last_error_text" & q & ":" & q & UXBRuntimeReportJsonEscape2(rt.lastErrorText) & q & "," & Chr(10)
    j &= "  " & q & "stdout" & q & ":" & q & UXBRuntimeReportJsonEscape2(rt.stdoutText) & q & "," & Chr(10)
    j &= "  " & q & "stderr" & q & ":" & q & UXBRuntimeReportJsonEscape2(rt.stderrText) & q & "," & Chr(10)
    j &= "  " & q & "screen" & q & ":{" & _
        q & "text" & q & ":" & q & UXBRuntimeReportJsonEscape2(rt.screenText) & q & "," & _
        q & "row" & q & ":0," & _
        q & "col" & q & ":0," & _
        q & "fg" & q & ":0," & _
        q & "bg" & q & ":0," & _
        q & "cls_count" & q & ":0}" & Chr(10)
    j &= "}"
    Return j
End Function

#endif
