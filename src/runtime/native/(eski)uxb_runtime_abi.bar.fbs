 ' uxb_runtime_abi.fbs
 ' C ABI specification for native/uxb_runtime.dll
 '
 ' Rules:
 ' - extern "C" exports
 ' - __declspec(dllexport) on Windows
 ' - All functions return int: 1 = success, 0 = error
 ' - Error text retrieved via `uxb_last_error()` (const char* / string)
 ' - String inputs: `const char *`
 ' - Buffer outputs: `char * out, int out_len`
 '
 ' Mandatory exports (canonical signatures)
 '
 ' int uxb_rt_init();
 ' int uxb_rt_shutdown();
 '
 ' int uxb_task_register(const char* task_name, const char* body_json, int flags);
 ' int uxb_slot_bind(const char* slot_name, const char* handler);
 '
 ' int uxb_task_on(const char* task_name);
 ' int uxb_task_off(const char* task_name);
 ' int uxb_slot_on(const char* slot_name);
 ' int uxb_slot_off(const char* slot_name);
 '
 ' int uxb_task_trigger(const char* task_name, const char* payload_json);
 '
 ' SHELL: capture stdout/stderr into provided buffers and put exit code into `exit_code`
 ' int uxb_shell_run(const char* command, int timeout_ms, char* out, int out_len, char* err, int err_len, int* exit_code);
 '
 ' int uxb_thread_start(const char* thread_label, int flags);
 '
 ' PIPE: input JSON -> output buffer
 ' int uxb_pipe_run(const char* pipe_name, const char* input_json, char* out, int out_len);
 '
 ' PARALEL: group descriptor (JSON)
 ' int uxb_parallel_run(const char* group_name, const char* json_tasklist);
 '
 ' Last error accessor
 ' const char* uxb_last_error();
#ifndef UXB_RUNTIME_NATIVE_ABI_FBS
#define UXB_RUNTIME_NATIVE_ABI_FBS

' Aşama 6: uxb_runtime.dll sabit C ABI sözleşmesi.
' Bu dosya derleyiciye DLL zorunluluğu getirmez; yalnız sabit adları ve durum kodlarını tanımlar.
' Gerçek yükleme/çözümleme uxb_runtime_loader.fbs içindedir.

Const UXB_RT_OK As Integer = 0
Const UXB_RT_ERR_GENERIC As Integer = -1
Const UXB_RT_ERR_TIMEOUT As Integer = -2
Const UXB_RT_ERR_NOT_FOUND As Integer = -3
Const UXB_RT_ERR_INVALID_ARG As Integer = -4
Const UXB_RT_ERR_NOT_LOADED As Integer = -5

Const UXB_RT_TASK_EVENT As Integer = 1
Const UXB_RT_TASK_PIPE As Integer = 2
Const UXB_RT_TASK_THREAD As Integer = 3
Const UXB_RT_TASK_PARALEL As Integer = 4

Const UXB_RT_SLOT_OFF As Integer = 0
Const UXB_RT_SLOT_ON As Integer = 1

Const UXB_RT_SYMBOL_INIT As String = "uxb_rt_init"
Const UXB_RT_SYMBOL_TASK_REGISTER As String = "uxb_task_register"
Const UXB_RT_SYMBOL_SLOT_BIND As String = "uxb_slot_bind"
Const UXB_RT_SYMBOL_TASK_ON As String = "uxb_task_on"
Const UXB_RT_SYMBOL_TASK_OFF As String = "uxb_task_off"
Const UXB_RT_SYMBOL_SLOT_ON As String = "uxb_slot_on"
Const UXB_RT_SYMBOL_SLOT_OFF As String = "uxb_slot_off"
Const UXB_RT_SYMBOL_TASK_TRIGGER As String = "uxb_task_trigger"
Const UXB_RT_SYMBOL_SHELL_RUN As String = "uxb_shell_run"
Const UXB_RT_SYMBOL_THREAD_START As String = "uxb_thread_start"
Const UXB_RT_SYMBOL_PIPE_RUN As String = "uxb_pipe_run"
Const UXB_RT_SYMBOL_PARALLEL_RUN As String = "uxb_parallel_run"
Const UXB_RT_SYMBOL_LAST_ERROR As String = "uxb_last_error"

Type UXBNativeRuntimeSymbols
    rtInit As Any Ptr
    taskRegister As Any Ptr
    slotBind As Any Ptr
    taskOn As Any Ptr
    taskOff As Any Ptr
    slotOn As Any Ptr
    slotOff As Any Ptr
    taskTrigger As Any Ptr
    shellRun As Any Ptr
    threadStart As Any Ptr
    pipeRun As Any Ptr
    parallelRun As Any Ptr
    lastError As Any Ptr
End Type

Type UXBNativeRuntime
    dllPath As String
    hModule As Any Ptr
    loaded As Integer
    symbols As UXBNativeRuntimeSymbols
    lastError As String
End Type

#endif
