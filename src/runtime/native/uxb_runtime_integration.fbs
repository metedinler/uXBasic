#ifndef UXB_RUNTIME_INTEGRATION_FBS
#define UXB_RUNTIME_INTEGRATION_FBS
#include once "uxb_runtime_loader.fbs"
#include once "uxb_runtime_bridge.fbs"
Function uxb_runtime_try_init() As Integer
    If uxb_runtime_is_loaded()=0 Then If uxb_runtime_load()=0 Then Return 0
    Return uxb_rt_init()
End Function
Function uxb_runtime_native_callbacks_enabled() As Integer
    Dim v As String=UCase(Trim(Environ("UXB_NATIVE_INTERP_CALLBACKS")))
    If v="0" Or v="OFF" Or v="FALSE" Or v="NO" Then Return 0
    Return 1
End Function
#endif
