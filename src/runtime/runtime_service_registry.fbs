#ifndef UXB_RUNTIME_SERVICE_REGISTRY_FBS
#define UXB_RUNTIME_SERVICE_REGISTRY_FBS

#include once "services/runtime_service_matrix.fbs"

Function UXBRuntimeServiceHandlerName(ByVal serviceId As String) As String
    Select Case UXBRuntimeServiceFamily(serviceId)
    Case "CONSOLE": Return "UXBRuntimeConsoleDispatch"
    Case "STRING": Return "UXBRuntimeStringDispatch"
    Case "MATH": Return "UXBRuntimeMathDispatch"
    Case "MEMORY": Return "UXBRuntimeMemoryDispatch"
    Case "FILE": Return "UXBRuntimeFileDispatch"
    Case "FFI": Return "UXBRuntimeFfiDispatch"
    Case "LIBRARY", "EXTFP": Return "UXBRuntimeLibraryDispatch"
    Case "BROWSER", "WASM_BRIDGE", "HOST": Return "UXBRuntimeBrowserDispatch"
    End Select
    Return ""
End Function

Function UXBRuntimeServiceDecision(ByVal serviceId As String, ByVal targetName As String) As String
    If UXBRuntimeServiceKnown(serviceId) = 0 Then Return "MISSING"
    Return UXBRuntimeServiceTargetStatus(serviceId, targetName)
End Function

#endif
