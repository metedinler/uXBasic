#ifndef UXB_RUNTIME_STRING_FBS
#define UXB_RUNTIME_STRING_FBS

#include once "../runtime_context.fbs"
#include once "../services/runtime_service_ids.fbs"

Private Function UXBRuntimeStringCompare(ByRef a As String, ByRef b As String) As Integer
    Dim al As String
    Dim bl As String
    al = a
    bl = b
    If al = bl Then Return 0
    If al < bl Then Return -1
    Return 1
End Function

Function UXBRuntimeStringDispatch(ByRef rt As UXBRuntimeContext, ByVal serviceId As String, ByRef args As UXBRuntimeArgList) As UXBInterpValue
    Dim a As String = ""
    Dim b As String = ""
    If args.count > 0 Then a = UXBInterpValueToString(args.values(0))
    If args.count > 1 Then b = UXBInterpValueToString(args.values(1))
    Select Case UCase(Trim(serviceId))
    Case RT_STR_LEN
        Return UXBInterpValueInt(Len(a))
    Case RT_STR_CONCAT
        Return UXBInterpValueString(a & b)
    Case RT_STR_LEFT
        Return UXBInterpValueString(Left(a, CInt(UXBRuntimeArgInt(args, 1))))
    Case RT_STR_RIGHT
        Return UXBInterpValueString(Right(a, CInt(UXBRuntimeArgInt(args, 1))))
    Case RT_STR_MID
        Dim startPos As Integer = CInt(UXBRuntimeArgInt(args, 1))
        Dim sizeValue As Integer = CInt(UXBRuntimeArgInt(args, 2))
        If sizeValue <= 0 Then Return UXBInterpValueString(Mid(a, startPos))
        Return UXBInterpValueString(Mid(a, startPos, sizeValue))
    Case RT_STR_COMPARE
        Return UXBInterpValueInt(UXBRuntimeStringCompare(a, b))
    Case RT_STR_TO_UPPER
        Return UXBInterpValueString(UCase(a))
    Case RT_STR_TO_LOWER
        Return UXBInterpValueString(LCase(a))
    Case RT_STR_TRIM
        Return UXBInterpValueString(Trim(a))
    Case RT_STR_LTRIM
        Return UXBInterpValueString(LTrim(a))
    Case RT_STR_RTRIM
        Return UXBInterpValueString(RTrim(a))
    Case RT_STR_SPACE
        Return UXBInterpValueString(Space(CInt(UXBRuntimeArgInt(args, 0))))
    Case RT_STR_ASC
        If Len(a) = 0 Then Return UXBRuntimeSetError(rt, UXB_RT_ERR_BAD_ARGUMENT, "ASC requires non-empty string")
        Return UXBInterpValueInt(Asc(Left(a, 1)))
    Case RT_STR_CHR
        Return UXBInterpValueString(Chr(CInt(UXBRuntimeArgInt(args, 0))))
    Case RT_STR_VAL
        Return UXBInterpValueFloat(Val(a))
    Case RT_STR_STR
        Return UXBInterpValueString(Str(UXBRuntimeArgInt(args, 0)))
    End Select
    Return UXBRuntimeSetError(rt, UXB_RT_ERR_SERVICE_NOT_FOUND, "string service not found: " & serviceId)
End Function

#endif
