#ifndef UXB_PROJECT_OUTPUT_POLICY_FBS
#define UXB_PROJECT_OUTPUT_POLICY_FBS

' Central project output policy for UXBc.
' Keeps generated outputs away from uxb/src.
' YAMA 1.1: compiler binary bin/ altinda kalir; compilerin urettigi tum json/log/report/asm/exe
' ciktilari build/<run_id>/ altinda toplanir. --out-root bu kokun adini degistirir.

Type UXBProjectOutputPolicy
    rootDir As String
    projectName As String
    runId As String
    baseOutDir As String
    sourceDir As String
    astInterpreterDir As String
    mirInterpreterDir As String
    x64AstAsmDir As String
    mirX64AsmDir As String
    jsonDir As String
    logDir As String
    diagnosticsDir As String
    reportDir As String
    artifactDir As String
End Type

Sub UXBProjectOutputPolicyInit(ByRef p As UXBProjectOutputPolicy)
    p.rootDir = "build"
    p.projectName = "default"
    p.runId = ""
    p.baseOutDir = ""
    p.sourceDir = ""
    p.astInterpreterDir = ""
    p.mirInterpreterDir = ""
    p.x64AstAsmDir = ""
    p.mirX64AsmDir = ""
    p.jsonDir = ""
    p.logDir = ""
    p.diagnosticsDir = ""
    p.reportDir = ""
    p.artifactDir = ""
End Sub

Function UXBPathJoin2(ByRef a As String, ByRef b As String) As String
    If Len(Trim(a)) = 0 Then Return b
    If Right(a, 1) = "/" Or Right(a, 1) = "\" Then Return a & b
    Return a & "/" & b
End Function

Sub UXBProjectOutputPolicyFinalize(ByRef p As UXBProjectOutputPolicy)
    If Trim(p.rootDir) = "" Then p.rootDir = "build"
    If Trim(p.projectName) = "" Then p.projectName = "default"
    If Trim(p.runId) = "" Then p.runId = "manual"

    p.baseOutDir = UXBPathJoin2(p.rootDir, p.runId)

    p.sourceDir = UXBPathJoin2(p.baseOutDir, "source")
    p.astInterpreterDir = UXBPathJoin2(p.baseOutDir, "ast_interpreter")
    p.mirInterpreterDir = UXBPathJoin2(p.baseOutDir, "mir_interpreter")
    p.x64AstAsmDir = UXBPathJoin2(UXBPathJoin2(p.baseOutDir, "asm"), "x64_ast")
    p.mirX64AsmDir = UXBPathJoin2(UXBPathJoin2(p.baseOutDir, "asm"), "x64_mir")
    p.jsonDir = UXBPathJoin2(p.baseOutDir, "json")
    p.logDir = UXBPathJoin2(p.baseOutDir, "logs")
    p.diagnosticsDir = UXBPathJoin2(p.baseOutDir, "diagnostics")
    p.reportDir = UXBPathJoin2(p.baseOutDir, "reports")
    p.artifactDir = UXBPathJoin2(p.baseOutDir, "exe")
End Sub

Function UXBProjectOutputIsSourcePollution(ByRef pathText As String) As Integer
    Dim As String p
    p = LCase(Trim(pathText))

    If InStr(p, "uxb/src/") > 0 Or InStr(p, "uxb\src\") > 0 Then
        If Right(p, 4) = ".exe" Then Return 1
        If Right(p, 4) = ".obj" Then Return 1
        If Right(p, 2) = ".o" Then Return 1
        If Right(p, 4) = ".asm" Then Return 1
        If Right(p, 5) = ".nasm" Then Return 1
        If Right(p, 4) = ".log" Then Return 1
        If InStr(p, "/dist/") > 0 Or InStr(p, "\dist\") > 0 Then Return 1
        If InStr(p, "/build/") > 0 Or InStr(p, "\build\") > 0 Then Return 1
        If InStr(p, "/tmp/") > 0 Or InStr(p, "\tmp\") > 0 Then Return 1
    End If

    Return 0
End Function

#endif
