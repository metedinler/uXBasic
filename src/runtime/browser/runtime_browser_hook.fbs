#ifndef UXB_RUNTIME_BROWSER_HOOK_FBS
#define UXB_RUNTIME_BROWSER_HOOK_FBS

' Handles the BROWSER / WASM_BRIDGE / HOST runtime service family for the shared
' ("generic") runtime dispatcher used by the AST interpreter (src/runtime/exec) and
' any other non-codegen execution path that goes through UXBRuntimeDispatch.
'
' These services (RT_BROWSER_CANVAS/AUDIO/INPUT/FILE/FETCH, RT_HOST_CALL,
' RT_WEBGPU_CALL, RT_WASM_IMPORT_CALL, RT_WASM_EXPORT_CALL -- see
' src/runtime/services/runtime_service_ids.fbs and runtime_service_matrix.fbs, which
' classifies this whole family as "BROWSER_ONLY"/"RUNTIME_CALL" for the JS/WASM/
' BROWSER targets specifically) only have a real implementation where an actual
' browser or WASM host is present: the JS backend emits real DOM Canvas/Audio/Input/
' Fetch calls (see src/codegen/js/js_stmt_emit.fbs), and the WASM target's host calls
' go through the wasmtime bridge (runtime/browser/ux_wasm_bridge.js +
' runtime_ext/uxwasmrt) when a program built for --target wasm actually runs.
'
' A program executed by the native AST interpreter (`uxb run` / `uxb int`) is not
' hosted in a browser and has no DOM/host bridge available, so there is no real
' native fallback to provide here -- the correct, designed behavior is the same
' honest "wrong target" diagnostic UXBRuntimeDispatch already gives for a genuinely
' unregistered service, not a silent no-op or a fake value.
Private Function UXBRuntimeBrowserDispatch(ByRef rt As UXBRuntimeContext, ByVal serviceId As String, ByRef args As UXBRuntimeArgList) As UXBInterpValue
    Return UXBRuntimeSetError(rt, UXB_RT_ERR_HANDLER_NOT_AVAILABLE, serviceId & " is a browser/WASM-only runtime service; it has no native/AST-interpreter implementation. Build with --target js or --target wasm to use it.")
End Function

#endif
