#ifndef UXB_CLI_ROUTE_MATRIX_FBS
#define UXB_CLI_ROUTE_MATRIX_FBS

#include once "cli_args.fbs"
#include once "cli_help.fbs"

Function UXBCliRouteMatrixCsv() As String
    Dim s As String
    s = "verb,target,legacy_flags,json_field,description" & Chr(10)
    s &= "lex,,--debug-token-dump,--token-json-out,lexer token dump" & Chr(10)
    s &= "par,,--parse-only,--parser-json-out,parser route" & Chr(10)
    s &= "ast,,--ast-contract-check,--ast-json-out,AST contract/json" & Chr(10)
    s &= "sem,,--semantic,--semantic-json-out,semantic pass" & Chr(10)
    s &= "hir,,--semantic,--hir-json-out,HIR inventory" & Chr(10)
    s &= "mir,,--mir-verify,--mir-full-json-out,MIR build/verify" & Chr(10)
    s &= "int,,--execmem --interpreter-backend AST,--run-report-json-out,AST-compatible interpreter; MIR is explicit via mir or --interpreter-backend MIR" & Chr(10)
    s &= "x64,x64,--emit-x64-nasm,--x64-codegen-policy-json-out,x64 NASM backend" & Chr(10)
    s &= "x86,x86_retired,--emit-x86,--backend-report-json-out,x86 backend (EMEKLI - CLI_TARGET_RETIRED doner, x64 kullanin)" & Chr(10)
    s &= "jsw,js,--emit-js,--backend-report-json-out,JS backend" & Chr(10)
    s &= "wat,wat,--emit-wat,--backend-report-json-out,WAT backend" & Chr(10)
    s &= "bld,x64,--build-x64,,x64 build" & Chr(10)
    s &= "run,,--execmem,,run program" & Chr(10)
    s &= "chk,,--validate-all,--validate-all-report-json-out,all validation gates" & Chr(10)
    s &= "fmt,,--format-check,,format check" & Chr(10)
    s &= "map,,--source-map,--source-map-json-out,source map" & Chr(10)
    s &= "doc,,--doc,--doc-json-out,docs" & Chr(10)
    s &= "rel,,--release-gate,--release-json-out,release gate" & Chr(10)
    s &= "mtx,,--emit-surface-matrices,,export all surface backend matrices" & Chr(10)
    s &= "hlp,,--help,,help" & Chr(10)
    s &= "ver,,--version,,version" & Chr(10)
    Return s
End Function

Function UXBCliWriteRouteMatrix(ByRef outPath As String, ByRef errText As String) As Integer
    Return UXBCliWriteTextFile(outPath, UXBCliRouteMatrixCsv(), errText)
End Function

#endif
