#ifndef UXB_CLI_JSON_REPORT_FBS
#define UXB_CLI_JSON_REPORT_FBS

#include once "cli_args.fbs"
#include once "cli_help.fbs"

Private Function UXBCliJsonEscape(ByRef textIn As String) As String
    Dim outText As String = ""
    Dim i As Integer
    For i = 1 To Len(textIn)
        Dim ch As String = Mid(textIn, i, 1)
        If ch = Chr(34) Then
            outText &= "'"
        ElseIf ch = "\" Then
            outText &= "/"
        ElseIf Asc(ch) < 32 Then
            outText &= " "
        Else
            outText &= ch
        End If
    Next i
    Return outText
End Function

Function UXBCliStateToJson(ByRef s As UXBCliState) As String
    Dim q As String = Chr(34)
    Dim j As String = "{" & Chr(10)
    j &= "  " & q & "schema" & q & ": " & q & "uxb-cli-adim12" & q & "," & Chr(10)
    j &= "  " & q & "initialized" & q & ": " & IIf(s.initialized <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & q & "verb" & q & ": " & q & UXBCliJsonEscape(s.route.verb) & q & "," & Chr(10)
    j &= "  " & q & "source" & q & ": " & q & UXBCliJsonEscape(s.route.sourcePath) & q & "," & Chr(10)
    j &= "  " & q & "target" & q & ": " & q & UXBCliJsonEscape(s.route.target) & q & "," & Chr(10)
    j &= "  " & q & "stop_after" & q & ": " & q & UXBCliJsonEscape(s.route.stopAfter) & q & "," & Chr(10)
    j &= "  " & q & "json_out" & q & ": " & q & UXBCliJsonEscape(s.route.jsonOut) & q & "," & Chr(10)
    j &= "  " & q & "alias_flag_count" & q & ": " & LTrim(Str(s.aliasFlagCount)) & "," & Chr(10)
    j &= "  " & q & "alias_value_count" & q & ": " & LTrim(Str(s.aliasValueCount)) & "," & Chr(10)
    j &= "  " & q & "error_code" & q & ": " & q & UXBCliJsonEscape(s.errorCode) & q & "," & Chr(10)
    j &= "  " & q & "error_text" & q & ": " & q & UXBCliJsonEscape(s.errorText) & q & Chr(10)
    j &= "}" & Chr(10)
    Return j
End Function

Function UXBCliWriteJsonReport(ByRef s As UXBCliState, ByRef outPath As String, ByRef errText As String) As Integer
    If Trim(outPath) = "" Then Return 1
    Return UXBCliWriteTextFile(outPath, UXBCliStateToJson(s), errText)
End Function

#endif
