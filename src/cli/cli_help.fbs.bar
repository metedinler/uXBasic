#ifndef UXB_CLI_HELP_FBS
#define UXB_CLI_HELP_FBS

#include once "cli_args.fbs"

Function UXBCliEnsureParentDir(ByRef outPath As String) As Integer
    Dim p As String = Trim(outPath)
    If p = "" Then Return 1
    Dim cut As Integer = InStrRev(p, "\")
    Dim cut2 As Integer = InStrRev(p, "/")
    If cut2 > cut Then cut = cut2
    If cut <= 0 Then Return 1
    Dim parentDir As String = Left(p, cut - 1)
    If parentDir = "" Then Return 1

    Dim norm As String = ""
    Dim j As Integer
    For j = 1 To Len(parentDir)
        Dim cj As String = Mid(parentDir, j, 1)
        If cj = "/" Then
            norm &= "\"
        Else
            norm &= cj
        End If
    Next j
    Dim acc As String = ""
    Dim i As Integer
    Dim ch As String
    For i = 1 To Len(norm)
        ch = Mid(norm, i, 1)
        acc &= ch
        If ch = "\" Then
            If Len(acc) > 3 Then
                Dim partial As String = Left(acc, Len(acc) - 1)
                If partial <> "" And Dir(partial) = "" Then MkDir partial
            End If
        End If
    Next i
    If Dir(norm) = "" Then MkDir norm
    Return 1
End Function

Function UXBCliHelpText() As String
    Dim header As String
    Dim verbs As String
    Dim ommon As String
    Dim native As String
    Dim web As String
    Dim reports As String
    Dim s As String
    Dim ss As String
    Dim examples As String
    Dim footer As String
    ShowUXBCliHelp
    header = "=== uXBasic CLI (12.06_1) ===" & Chr(10) & Chr(10)
    header &= "Kullanım: uxb <verb> [kaynak.uxb] [seçenekler...]" & Chr(10)
    header &= "          uxb @komutlar.uxcli" & Chr(10) & Chr(10)
    header &= "              <komutlar>.uxcli bir komut calistirma dosyasidir." & Chr(10) 
    header &= "====================================================================================" & Chr(10) & Chr(10)
    header &= "uXBasic komut satırı yalnız çalıştırmak için değildir; öğrenmek için de kullanılır."  & Chr(10)
    header &= "Bir genç programcı `--tokens-json-out`, `--ast-json-out`, `--mir-full-json-out`"  & Chr(10)
    header &= "gibi seçeneklerle kendi yazdığı programın iç organlarını görebilir. " & Chr(10)
    header &= "Bu, derleyici yazmayı öğrenmenin kısa yoludur. " & Chr(10)
    
    verbs &= "VERBLER (3 harfli komutlar):" & Chr(10)
    verbs &= "  lex   : Lexer / token üretimi" & Chr(10)
    verbs &= "  par   : Parser-only (sadece syntax kontrol)" & Chr(10)
    verbs &= "  ast   : AST üretimi + sözleşme kontrolü" & Chr(10)
    verbs &= "  sem   : Semantic analiz + type binding" & Chr(10)
    verbs &= "  hir   : HIR üretimi" & Chr(10)
    verbs &= "  mir   : MIR üretimi ve doğrulama" & Chr(10)
    verbs &= "  int   : MIR Interpreter ile çalıştırma (run ile aynı)" & Chr(10)
    verbs &= "  x64   : x64 NASM üretimi + build" & Chr(10)
    verbs &= "  jsw   : JavaScript / Web backend" & Chr(10)
    verbs &= "  wat   : WAT üretimi" & Chr(10)
    verbs &= "  bld   : Tam x64 build pipeline" & Chr(10)
    verbs &= "  run   : Programı çalıştır (interpreter)" & Chr(10)
    verbs &= "  chk   : Toplu doğrulama (validate-all)" & Chr(10)
    verbs &= "  fmt   : Format kontrolü" & Chr(10)
    verbs &= "  map   : Source map üretimi" & Chr(10)
    verbs &= "  doc   : Dokümantasyon üretimi" & Chr(10)
    verbs &= "  rel   : Release gate (production kontrolü)" & Chr(10)
    verbs &= "  hlp   : Bu yardım mesajı" & Chr(10)
    verbs &= "  ver   : Versiyon bilgisi" & Chr(10) & Chr(10)

    ommon = "ORTAK ÖNEMLİ SEÇENEKLER:" & Chr(10)
    ommon &= "  --target <x64|js|wat|wasm|browser>     Hedef platform" & Chr(10)
    ommon &= "  --stop-after <lex|par|ast|sem|mir>     Belirli aşamada dur" & Chr(10)
    ommon &= "  --out-root <klasör>                    Çıktı kökü (varsayılan: build/)" & Chr(10)
    ommon &= "  --artifact-root <klasör>               Artifact kökü" & Chr(10)
    ommon &= "  --run-id <id>                          Çalışma kimliği" & Chr(10)
    ommon &= "  --json-out <dosya>                     Genel JSON raporu" & Chr(10)
    ommon &= "  --strict                               Katı mod" & Chr(10)
    ommon &= "  --debug                                Debug çıktısı" & Chr(10)
    ommon &= "  --quiet / --sessiz                     Sessiz mod" & Chr(10) & Chr(10)
   
    ommon &= "GENEL / KONTROL" & Chr(10)
    ommon &= "  --format-check           fmt    Format kontrolü" & Chr(10)
    ommon &= "  --help                   hfg    Bu yardım" & Chr(10)
    ommon &= "  --version                vfg    Versiyon bilgisi" & Chr(10)
    ommon &= "  --target                 tgt    x64|js|wat|wasm|browser" & Chr(10)
    ommon &= "  --stop-after             stp    lex|par|ast|sem|mir" & Chr(10)
    ommon &= "  --strict                 str    Katı mod" & Chr(10)
    ommon &= "  --debug                  dbg    Debug modu" & Chr(10)
    ommon &= "  --quiet                  qui    Sessiz mod" & Chr(10)
    ommon &= "  --trace                  trc    Trace modu" & Chr(10) & Chr(10)


    native = "NATIVE BACKEND (x64):" & Chr(10)
    native &= "  --emit-x64-nasm-out <dosya.asm>        NASM çıktısı" & Chr(10)
    native &= "  --build-x64-out <dosya.exe>            EXE üret" & Chr(10)
    native &= "  --x64-mode <MIR|AST|BOTH>              Kod üretme modu" & Chr(10) & Chr(10)
    
    web = "WEB BACKEND:" & Chr(10)
    web &= "  --emit-js --js-out <dosya.js>" & Chr(10)
    web &= "  --emit-wat --wat-out <dosya.wat>" & Chr(10)
    web &= "  --emit-wasm --wasm-out <dosya.wasm>" & Chr(10)
    web &= "  --emit-browser --html-out <dosya.html>" & Chr(10) & Chr(10)

    reports = "ÇIKTI RAPORLARI:" & Chr(10)
    reports &= "  --tokens-json-out          Lexer tokenleri" & Chr(10)
    reports &= "  --ast-json-out             AST" & Chr(10)
    reports &= "  --semantic-json-out        Semantic analiz" & Chr(10)
    reports &= "  --mir-full-json-out        Tam MIR" & Chr(10)
    reports &= "  --backend-report-json-out  Backend raporu" & Chr(10)
    reports &= "  --all-diagnostics-json-out Tüm hatalar ve uyarılar raporu" & Chr(10)
    reports &= "  --type-infer-report-csv-out Type infer raporu" & Chr(10) & Chr(10)
    
    s &= "JSON RAPORLARI" & Chr(10)
    s &= "  --json-out                      jsn    Genel JSON" & Chr(10)
    s &= "  --tokens-json-out               tjs    Lexer tokenleri" & Chr(10)
    s &= "  --ast-json-out                  ajo    AST" & Chr(10)
    s &= "  --parser-json-out               pjo    Parser" & Chr(10)
    s &= "  --semantic-json-out             sjo    Semantic" & Chr(10)
    s &= "  --hir-json-out                  hjo    HIR" & Chr(10)
    s &= "  --mir-full-json-out             mfj    Tam MIR" & Chr(10)
    s &= "  --mir-json-out                  mij    MIR" & Chr(10)
    s &= "  --backend-report-json-out       brj     Backend raporu" & Chr(10)
    s &= "  --all-diagnostics-json-out      b02     Tum tanilar" & Chr(10)
    s &= "  --type-infer-report-csv-out     tir     Type infer CSV" & Chr(10) & Chr(10)
    
    s &= "NATIVE BACKEND (x64)" & Chr(10)
    s &= "  --emit-x64-nasm          x6e    NASM emit" & Chr(10)
    s &= "  --emit-x64-nasm-out      x6o    NASM cikti dosyası" & Chr(10)
    s &= "  --build-x64              bx6    Tam build" & Chr(10)
    s &= "  --build-x64-out          bxo    EXE cikti" & Chr(10)
    s &= "  --x64-mode               x6m    MIR|AST" & Chr(10) & Chr(10)
    
    s &= "WEB BACKEND" & Chr(10)
    s &= "  --emit-js                ejs    JavaScript emit" & Chr(10)
    s &= "  --js-out                 jso    JS cikti" & Chr(10)
    s &= "  --emit-wat               ewt    WAT emit" & Chr(10)
    s &= "  --wat-out                wat    WAT cikti" & Chr(10)
    s &= "  --emit-wasm              ewm    WASM emit" & Chr(10)
    s &= "  --wasm-out               wsm    WASM cikti" & Chr(10)
    s &= "  --html-out               htm    HTML cikti" & Chr(10)
    s &= "  --manifest-out           man    Manifest JSON" & Chr(10) & Chr(10)

    s &= "DIGER ONEMLI SECENEKLER" & Chr(10)
    s &= "  --preprocessed-out       pre    On islenmis kaynak" & Chr(10)
    s &= "  --source-map-json-out    smj    Source map" & Chr(10)
    s &= "  --doc-json-out           djo    Dokumantasyon" & Chr(10)
    s &= "  --run-report-json-out    rrj    Çalistirma raporu" & Chr(10)
    s &= "  --error-limit            erl    Maksimum hata sayisi" & Chr(10)
    s &= "  --out-root               ort    Cikti kok dizini" & Chr(10)
    s &= "  --artifact-root          art    Artifact kok dizini" & Chr(10) & Chr(10)

    ss = "uXBasiC CLI - 3 harfli komut zinciri" & Chr(10)
    ss &= "Kullanim: uxb <verb> [source.bas] [options]" & Chr(10)
    ss &= "Verbler: lex par ast sem hir mir int x64 x86 jsw wat bld run chk fmt map doc rel hlp ver" & Chr(10)
    ss &= "Ortak: --json-out --out-root <build-koku> --artifact-root <build-koku> --run-id --stop-after --target --diag-format --error-limit --strict --time-passes @file.uxcli" & Chr(10)
    ss &= "Preprocessor: --pp=A|B --preprocessor=A|B" & Chr(10)
    ss &= "Interpreter: --interpreter-backend=AST|MIR|BOTH" & Chr(10)
    ss &= "Native x64: --x64-mode=AST|MIR|BOTH --emit-x64-nasm --emit-x64-nasm-out <file> --build-x64 --build-x64-out <dir>" & Chr(10)
    ss &= "Web: --emit-js --emit-wat --emit-wasm --emit-browser --js-out <file> --js-runtime-out <file> --wat-out <file> --wasm-out <file> --html-out <file>" & Chr(10)
    ss &= "Artifact: varsayilan build/<run_id>/; --out-root verilirse <kok>/<run_id>/; JSON <kok>/<run_id>/json/ altina yazilir" & Chr(10) & _
         "          --run-manifest-json-out --all-diagnostics-json-out --error-summary-json-out --backend-matrix-json-out" & Chr(10)
    ss &= "Type binding: --type-infer-report-csv-out <file.csv>" & Chr(10)
    ss &= "Deprecated alias: --enable-mir-x64 kullanilabilir ama tercih edilen --x64-mode=MIR" & Chr(10)

    examples = "ÖRNEKLER:" & Chr(10)
    examples &= "  uxb lex program.uxb --tokens-json-out tokens.json" & Chr(10)
    examples &= "  uxb x64 program.uxb --emit-x64-nasm-out out.asm --build-x64-out program.exe" & Chr(10)
    examples &= "  uxb run program.uxb" & Chr(10)
    examples &= "  uxb jsw program.uxb --js-out app.js" & Chr(10) & Chr(10)
    
    footer = "Detaylı yardım için: uxb hlp --verbose" & Chr(10)
    footer &= "Bir genç programcı bu seçeneklerle derleyicinin içini görebilir." & Chr(10)
    Print header
    print verbs
    print ommon
    print native
    print Web
    print reports
    print s
    print ss
    print examples    

    ' Birleştir
    Return footer
End Function


' Return string sınırını aşmak için tek büyük string yerine doğrudan Print kullanıyoruz.
Sub ShowUXBCliHelp()
    Dim verbs As String
    Dim ommon As String
    Dim native As String
    Dim web As String
    Dim reports As String
    Dim s As String
    Dim ss As String
    Dim examples As String
    Dim footer As String
    
    ' === 1. BÖLÜM: BAŞLIK VE ÖĞRENME FELSEFESİ ===
    Print "=== uXBasic CLI Compiler Infrastructure ==="
    Print "Kullanim: uxb <verb> [kaynak.uxb] [seçenekler...]"
    Print "          uxb @komutlar.uxcli (Toplu komut dosyasi)"
    Print "================================================================================"
    Print "uXBasic komut satiri yalniz calistirmak icin degildir; ogrenmek icin de kullanilir."
    Print "Bir genc programci seceneklerle kendi yazdigi programin ic organlarini gorebilir."
    Print "Bu, derleyici yazmayi ogrenmenin kisa yoludur."
    Print "================================================================================"
    Print ""

    ' === 2. BÖLÜM: VERBLER (3 HARFLİ ANA KOMUTLAR) ===
    Print "VERBLER (Aşama Seçiciler):"
    Print "  lex   : Lexer / token üretimi            | par   : Sadece syntax kontrol"
    Print "  ast   : AST üretimi & contract check     | sem   : Semantic analiz & type binding"
    Print "  hir   : HIR üretimi                      | mir   : MIR üretimi ve doğrulama"
    Print "  int   : MIR Interpreter ile çalıştırma   | x64   : x64 NASM üretimi + build"
    Print "  jsw   : JavaScript / Web backend         | wat   : WAT üretimi"
    Print "  bld   : Tam x64 build pipeline           | run   : Programı çalıştır (interpreter)"
    Print "  chk   : Toplu doğrulama (validate-all)   | fmt   : Format kontrolü"
    Print "  map   : Source map üretimi               | doc   : Dokümantasyon üretimi"
    Print "  rel   : Release gate kontrolü            | hlp   : Detaylı yardım"
    Print "  ver   : Versiyon bilgisi"
    Print ""

    ' === 3. BÖLÜM: GENEL VE KONTROL SEÇENEKLERİ ===
    Print "GENEL VE KONTROL SEÇENEKLERİ (Tetikleyiciler ve Bayraklar):"
    Print "  --format-check          : Biçimlendirme kontrolünü aktif eder."
    Print "  --help                  : Genel yardım menüsünü gösterir."
    Print "  --version               : Derleyici sürüm bilgisini basar."
    Print "  --target <hedef>        : Hedef platform seçer (x64, js, wat, wasm, browser, x86)."
    Print "  --stop-after <aşama>    : Belirtilen derleme aşamasında (lex, par, ast, sem, mir) durur."
    Print "  --diag-format           : Tanı/Hata mesajlarının çıktı formatını ayarlar."
    Print "  --strict                : Katı mod kurallarını devreye alır."
    Print "  --time-passes           : Derleyici aşamalarının çalışma sürelerini raporlar."
    Print "  --parse-only            : Sadece parser katmanını çalıştırır."
    Print "  --semantic              : Semantik analizi zorunlu kılar (Alternatifi: --semantik)."
    Print "  --mir-verify            : MIR katmanı doğrulamayı tetikler."
    Print "  --execmem               : Kod üretimi için dinamik bellek yürütmesini açar."
    Print "  --interpreter-backend   : Yorumlayıcı motorunun arkasındaki katmanı seçer."
    Print "  --validate-all          : Tüm doğrulama adımlarını çalıştırır."
    Print "  --validate-all-fail-fast: İlk hatada doğrulamayı keser."
    Print "  --source-map            : Kaynak haritası (source-map) üretimini tetikler."
    Print "  --doc                   : Otomatik dökümantasyon motorunu çalıştırır."
    Print "  --release-gate          : Canlıya alım (production) kapısı kontrollerini yürütür."
    Print "  --extract-src           : Gömülü kaynak kodları ayrıştırır."
    Print "  --console-mode          : Konsol çıktı modunu yapılandırır."
    Print "  --interop               : Harici dil bağlama (interoperability) modunu açar."
    Print "  --codegen / --x64gen    : Native kod üreticilerini tetikler."
    Print "  --debug /               : Derleyici içi hata ayıklama (debug) çıktısını açar."
    Print "  --quiet /               : Log çıktılarını kapatır, sadece hataları basar."
    Print "  --trace / --hook-trace  : Derleyici adımlarını ve hook'ları izler."
    Print "  --extfp-strict          : Genişletilmiş sabit nokta (ExtFP) katı modunu açar."
    Print "  --enable-extfp-runtime  : ExtFP çalışma zamanı desteğini aktif eder."
    Print "  --adim25-27-close-gate  : Adım 25-27 arası optimizasyon kapısını kapatır. Denemeyin!"
    Print "  --adim25-26-27-close-gate: Adım 25-27 tam optimizasyon kapısını kapatır. Denemeyin!"
    Print ""

    ' === 4. BÖLÜM: EMIT VE OUT AYRIMI (KULLANICININ KARIŞTIRDIĞI YER) ===
    Print "HEEDEF EMIT TETİKLEYİCİLERİ (Tek Başına Yazılır):"
    Print "  --emit-js               : JavaScript kod üretimi modunu açar."
    Print "  --emit-wat              : WebAssembly Text (WAT) üretim modunu açar."
    Print "  --emit-wasm             : WebAssembly ikili (WASM) üretim modunu açar."
    Print "  --emit-browser          : Tarayıcı uyumlu HTML/JS üretim modunu açar."
    Print "  --emit-nasm             : x64 NASM Assembly üretimini tetikler."
    Print "  --emit-x64-nasm         : x64 NASM Assembly üretimini tetikler."
    Print "  --emit-x86              : x86 Assembly üretim modunu tetikler."
    Print "  --build-x64             : Üretilen x64 kodunu doğrudan EXE'ye derler."
    Print "  --wat2wasm              : Dahili WAT -> WASM dönüştürücüsünü tetikler."
    Print ""
    Print "ÇIKTI DOSYA HEDEFLERİ (Arkasına Mutlaka Dosya/Klasör Yolu İster!):"
    Print "  --js-out <dosya.js>     : Üretilen JavaScript kodunun yazılacağı dosya."
    Print "  --wat-out <dosya.wat>   : Üretilen WebAssembly Text kodunun yazılacağı dosya."
    Print "  --wasm-out <dosya.wasm> : Üretilen binary WASM kodunun yazılacağı dosya."
    Print "  --html-out <dosya.html> : Üretilen tarayıcı arayüzünün yazılacağı dosya."
    Print "  --emit-x64-nasm-out <f> : NASM assembly çıktısının kaydedileceği dosya."
    Print "  --x64gen-out <klasör>   : Üretilen yerel x64 binary dosyalarının klasörü."
    Print "  --build-x64-out <exe>   : Derlenecek nihai Windows EXE dosyasının adı/yolu."
    Print "  --out-root <klasör>     : Tüm çıktıların yazılacağı kök dizin (Örn: build/)."
    Print "  --artifact-root <klas>  : Ara derleme dosyalarının (artifact) kök dizini."
    Print "  --extfp-runtime-dir <d> : ExtFP runtime kütüphanelerinin aranacağı dizin."
    Print ""

    ' === 5. BÖLÜM: BİR GENÇ PROGRAMCI İÇİN ANALİZ VE JSON RAPORLARI ===
    Print "İÇ ORGAN ANALİZİ VE JSON/CSV ÇIKTILARI (Dosya Yolu İster):"
    Print "  --json-out <dosya>      : Genel derleme raporunu JSON formatında yazar."
    Print "  --error-limit <sayı>    : Maksimum hata limiti ve hata raporlama dosyası."
    Print "  --token-json-out <f>    : Standart token akışını JSON olarak kaydeder."
    Print "  --tokens-json-out <f>   : Gelişmiş lexer token listesini JSON olarak kaydeder."
    Print "  --parser-json-out <f>   : Parser (Sözdizimi) ağaç analiz raporunu yazar."
    Print "  --ast-json-out <dosya>  : Soyut Sözdizimi Ağacını (AST) JSON olarak dışa aktarır."
    Print "  --ir-json-out <dosya>   : Ara Seviye Temsili (IR) verilerini yazar."
    Print "  --hir-json-out <dosya>  : High-Level IR (HIR) analiz çıktısını yazar."
    Print "  --mir-json-out <dosya>  : Medium-Level IR (MIR) temel analiz çıktısını yazar."
    Print "  --mir-full-json-out <f> : Tüm MIR kontrol akış grafiğini (CFG) JSON yazar."
    Print "  --semantic-json-out <f> : Semantik analiz ve tip bağlama raporunu yazar."
    Print "  --backend-report-json-out : Arka yüz (backend) kod üretim matris raporunu yazar."
    Print "  --source-map-json-out <f> : Kaynak kod-hedef kod eşleşme haritasını JSON yazar."
    Print "  --doc-json-out <dosya>  : Üretilen API ve dil dökümantasyonunu JSON yazar."
    Print "  --release-json-out <f>  : Release kapısı test sonuç raporunu JSON yazar."
    Print "  --run-report-json-out <f>: Interpreter çalıştırma metriklerini raporlar."
    Print "  --log-out / --debug-log-out <f> : Derleyici iç loglarını dosyaya kaydeder."
    Print "  --stdout-out / --stderr-out <f> : Standart çıktıları dosyaya yönlendirir."
    Print ""
    Print "GELİŞMİŞ KATMAN VE MATRİS RAPORLARI:"
    Print "  --lexer-diagnostics-json-out <f>    | --parser-diagnostics-json-out <f>"
    Print "  --semantic-diagnostics-json-out <f>  | --mir-opt-report-json-out <f>"
    Print "  --symbol-table-json-out <f>         | --type-table-json-out <f>"
    Print "  --layout-report-json-out <f>        | --hir-inventory-json-out <f>"
    Print "  --inventory-json-out <f>            | --pipeline-json-out <f>"
    Print "  --mir-pipeline-json-out <f>         | --mir-opcodes-json-out <f>"
    Print "  --mir-surface-json-out <f>          | --mir-module-json-out <f>"
    Print "  --mir-verify-json-out <f>           | --artifact-report-json-out <f>"
    Print "  --ast-contract-json-out <f>         | --ast-contract-report-json-out <f>"
    Print "  --ast-contract-matrix-out <f>       | --session-live-json-out <f>"
    Print "  --layer-timing-json-out <f>         | --trace-json <f>"
    Print "  --runtime-trace-json-out <f>        | --x64-codegen-policy-json-out <f>"
    Print "  --extfp-policy-json-out <f>         | --program-output-json-out <f>"
    Print "  --program-output-out <f>            | --final-screen-json-out <f>"
    Print "  --ast-contract-check                | --debug-token-dump"
    Print "  --dump-ast                          | --dump-mir"
    Print "  --language / --message-lang <tr|en> : Derleyici mesaj dilini seçer."
    Print "  --run-id <kimlik>                   : Çalışma oturumuna özel ID atar."
    Print "  --enable-mir-x64-experimental       : Deneysel MIR-x64 pipeline'ı açar. Kaldirildi!"
    Print ""

    ' === 6. BÖLÜM: DOĞRU KULLANIM ÖRNEKLERİ ===
    Print "AYRI İŞLEV KULLANIM ÖRNEKLERİ (Doğru ve Yanlış Kombinasyonlar):"
    Print "  DOĞRU (Adım adım ve parametreli):"
    Print "    uxb jsw main.uxb --emit-js --js-out build/app.js"
    Print "    uxb x64 main.uxb --emit-x64-nasm --emit-x64-nasm-out build/out.asm"
    Print "    uxb bld main.uxb --build-x64 --build-x64-out bin/oyun.exe"
    Print "    uxb ast main.uxb --ast-json-out build/ast_yapisi.json"
    Print ""
    Print "  YANLIŞ (Parametresiz arka arkaya yazım - HATA VERİR):"
    Print "    uxb jsw main.uxb --emit-js --js-out  <-- Hatalı! Çıktı dosyası belirtilmedi."
    Print "================================================================================"
    Print "Detayli yardim icin: uxb hlp --verbose"
    print""
    Print "uXBasic Compiler v1.06 (12.06.2026) - Zuhtu Mete DINLER - Developer"
    Print "uXBasic Compiler Copyright @ MIT 2026"
End Sub

Sub UXBCliPrintHelp()
    Print UXBCliHelpText()
End Sub

Sub UXBCliPrintVersion()
    Print UXB_CLI_VERSION_TEXT
End Sub

Function UXBCliWriteTextFile(ByRef outPath As String, ByRef textValue As String, ByRef errText As String) As Integer
    If Trim(outPath) = "" Then Return 1
    UXBCliEnsureParentDir outPath
    Dim f As Integer = FreeFile
    Open outPath For Output As #f
    If Err <> 0 Then errText = "CLI_OUTPUT_WRITE_FAIL: " & outPath: Return 0
    Print #f, textValue;
    Close #f
    Return 1
End Function

