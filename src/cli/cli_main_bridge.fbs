#ifndef UXB_CLI_MAIN_BRIDGE_FBS
#define UXB_CLI_MAIN_BRIDGE_FBS

' NON-ENTRY FILE
' Bu dosya sistemsel main girisi degildir; CLI bridge yardimci katmanidir.

#include once "cli_args.fbs"
#include once "cli_response_file.fbs"
#include once "cli_verb_dispatch.fbs"
#include once "cli_help.fbs"
#include once "cli_json_report.fbs"
#include once "cli_route_matrix.fbs"
#include once "cli_registry_adim41.fbs"
#include once "cli_output_contract_adim41.fbs"
Declare Function UXBNormalizeCliArgAdim41(ByRef argText As String, ByRef normalizedOut As String, ByRef errText As String) As Integer

Private Function UXBCliNormalizeExpandedArgsAdim41(ByRef s As UXBCliState, ByRef errText As String) As Integer
    Dim normalized As UXBCliArgList
    UXBCliArgListInit normalized
    errText = ""

    Dim i As Integer
    For i = 0 To s.expandedArgs.count - 1
        Dim rawArg As String
        rawArg = s.expandedArgs.items(i)
        If Left(Trim(rawArg), 1) = "-" Then
            Dim norm As String
            Dim nerr As String
            If UXBNormalizeCliArgAdim41(rawArg, norm, nerr) = 0 Then
                errText = nerr
                Return 0
            End If
            If UXBCliArgListAdd(normalized, norm) = 0 Then
                errText = "CLI_ARG_LIMIT: normalized arg list too long"
                Return 0
            End If
        Else
            If UXBCliArgListAdd(normalized, rawArg) = 0 Then
                errText = "CLI_ARG_LIMIT: normalized arg list too long"
                Return 0
            End If
        End If
    Next i

    s.expandedArgs = normalized
    Return 1
End Function

Function UXBCliBridgeReady() As Integer
    Return gUXBCli.initialized
End Function

Function UXBCliCompatHasArg(ByRef keyText As String) As Integer
    If gUXBCli.initialized = 0 Then Return 0
    If UXBCliHasAliasFlag(gUXBCli, keyText) <> 0 Then Return 1
    Dim tmpValue As String
    If UXBCliGetAliasValue(gUXBCli, keyText, tmpValue) <> 0 Then Return 1
    If UXBCliArgListHasKey(gUXBCli.expandedArgs, keyText) <> 0 Then Return 1
    Return 0
End Function

Function UXBCliCompatGetArgValue(ByRef keyText As String, ByRef valueOut As String) As Integer
    If gUXBCli.initialized = 0 Then valueOut = "": Return 0
    If UXBCliGetAliasValue(gUXBCli, keyText, valueOut) <> 0 Then Return 1
    Return UXBCliArgListGetValue(gUXBCli.expandedArgs, keyText, valueOut)
End Function

Function UXBCliInitFromCommandLine(ByRef errText As String) As Integer
    UXBCliStateInit gUXBCli
    errText = ""
    If UXBCliReadCommandLineRaw(gUXBCli.rawArgs) = 0 Then errText = "CLI_ARG_LIMIT: raw command line too long": Return 0
    If UXBCliExpandResponseFiles(gUXBCli.rawArgs, gUXBCli.expandedArgs, errText) = 0 Then UXBCliSetError gUXBCli, "CLI_RESPONSE_FILE_ERROR", errText: Return 0
    If UXBCliNormalizeExpandedArgsAdim41(gUXBCli, errText) = 0 Then UXBCliSetError gUXBCli, "CLI_OPTION_ERROR", errText: Return 0
    If UXBCliParseExpandedArgs(gUXBCli) = 0 Then errText = gUXBCli.errorText: Return 0
    gUXBCli.initialized = 1
    Return 1
End Function

Function UXBCliIsHelpRequested() As Integer
    Return gUXBCli.route.helpMode
End Function

Function UXBCliIsVersionRequested() As Integer
    Return gUXBCli.route.versionMode
End Function

Function UXBCliWriteStartupReports(ByRef errText As String) As Integer
    errText = ""
    If UXBCliWriteRouteMatrix(gUXBCli.route.routeMatrixOut, errText) = 0 Then Return 0
    If UXBCliWriteTextFile(gUXBCli.route.helpOut, UXBCliHelpText(), errText) = 0 Then Return 0
    If gUXBCli.route.jsonOut <> "" Then If UXBCliWriteJsonReport(gUXBCli, gUXBCli.route.jsonOut, errText) = 0 Then Return 0
    If UXBCliWriteJsonReport(gUXBCli, gUXBCli.route.reportOut, errText) = 0 Then Return 0
    Return 1
End Function

#endif
