#ifndef UXB_COMMON_SOURCE_LOCATION_ADIM16_EXT_FBS
#define UXB_COMMON_SOURCE_LOCATION_ADIM16_EXT_FBS

#include once "source_location.fbs"
#include once "json_builder.fbs"

Function UXBSourceLocationIsKnown(ByRef srcLoc As SourceLocation) As Integer
    If Trim(srcLoc.filePath) <> "" Then Return 1
    If srcLoc.lineNo > 0 Then Return 1
    If srcLoc.colNo > 0 Then Return 1
    If Trim(srcLoc.lexemeSnippet) <> "" Then Return 1
    Return 0
End Function

Function UXBSourceLocationToCompact(ByRef srcLoc As SourceLocation) As String
    Dim s As String
    s = ""
    If Trim(srcLoc.filePath) <> "" Then s &= srcLoc.filePath
    If srcLoc.lineNo > 0 Then
        If s <> "" Then s &= ":"
        s &= LTrim(Str(srcLoc.lineNo))
        If srcLoc.colNo > 0 Then s &= ":" & LTrim(Str(srcLoc.colNo))
    End If
    If s = "" And Trim(srcLoc.lexemeSnippet) <> "" Then
        s = "<snippet:" & srcLoc.lexemeSnippet & ">"
    End If
    Return s
End Function

Sub UXBSourceLocationJsonFields(ByRef b As UXBJsonBuilder, ByRef srcLoc As SourceLocation)
    UXBJsonFieldString b, "file", srcLoc.filePath
    UXBJsonFieldInt b, "line", srcLoc.lineNo
    UXBJsonFieldInt b, "col", srcLoc.colNo
    UXBJsonFieldInt b, "length", srcLoc.length
    UXBJsonFieldString b, "lexeme", srcLoc.lexemeSnippet
End Sub

Function UXBSourceLocationMerge(ByRef primaryLoc As SourceLocation, ByRef fallbackLoc As SourceLocation) As SourceLocation
    Dim outLoc As SourceLocation
    outLoc = primaryLoc
    If Trim(outLoc.filePath) = "" Then outLoc.filePath = fallbackLoc.filePath
    If outLoc.lineNo <= 0 Then outLoc.lineNo = fallbackLoc.lineNo
    If outLoc.colNo <= 0 Then outLoc.colNo = fallbackLoc.colNo
    If outLoc.length <= 0 Then outLoc.length = fallbackLoc.length
    If Trim(outLoc.lexemeSnippet) = "" Then outLoc.lexemeSnippet = fallbackLoc.lexemeSnippet
    Return outLoc
End Function

#endif
