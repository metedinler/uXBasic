#ifndef UXB_ITERATOR_CONTRACT_FBS
#define UXB_ITERATOR_CONTRACT_FBS

' PATCH5 canonical iterator contract.
' Array iteration is a value-semantic iterator: the handle is an index cursor.
' Generic object iterators use the same MIR contract but are only legal when a
' concrete backend/library supplies the ITER_CREATE/NEXT/CLOSE implementation.

Const UXB_ITER_KIND_ARRAY As String = "ARRAY"
Const UXB_ITER_KIND_STRING As String = "STRING"
Const UXB_ITER_KIND_OBJECT As String = "OBJECT"
Const UXB_ITER_METHOD_CREATE As String = "ITER_CREATE"
Const UXB_ITER_METHOD_NEXT As String = "ITER_NEXT"
Const UXB_ITER_METHOD_CLOSE As String = "ITER_CLOSE"

Function UXBIteratorKindKnown(ByRef kindText As String) As Integer
    Select Case UCase(Trim(kindText))
    Case UXB_ITER_KIND_ARRAY, UXB_ITER_KIND_STRING, UXB_ITER_KIND_OBJECT
        Return 1
    End Select
    Return 0
End Function

#endif
