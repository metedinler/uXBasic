#ifndef UXB_COMMON_SOURCE_MAPPING_FBS
#define UXB_COMMON_SOURCE_MAPPING_FBS

#include once "source_location.fbs"
#include once "source_location_adim16_ext.fbs"
#include once "json_builder.fbs"
#include once "report_writer.fbs"

Type UXBSourceMapEntry
    surface As String
    sourceStage As String
    targetStage As String
    entityKind As String
    entityName As String
    sourceFile As String
    sourceLine As Integer
    sourceCol As Integer
    sourceLength As Integer
    targetId As String
    status As String
End Type

Type UXBSourceMapList
    items(Any) As UXBSourceMapEntry
    count As Integer
    capacity As Integer
End Type

Sub UXBSourceMapInit(ByRef m As UXBSourceMapList)
    m.capacity = 64
    ReDim m.items(m.capacity - 1)
    m.count = 0
End Sub

Private Sub UXBSourceMapEnsure(ByRef m As UXBSourceMapList, ByVal minSize As Integer)
    If m.capacity >= minSize Then Exit Sub
    Dim nc As Integer
    nc = m.capacity
    If nc < 1 Then nc = 64
    Do While nc < minSize
        nc *= 2
    Loop
    ReDim Preserve m.items(nc - 1)
    m.capacity = nc
End Sub

Function UXBSourceMapAdd(ByRef m As UXBSourceMapList, ByRef surfaceText As String, ByRef sourceStageText As String, ByRef targetStageText As String, ByRef entityKindText As String, ByRef entityNameText As String, ByRef srcLoc As SourceLocation, ByRef targetIdText As String, ByRef statusText As String = "OK") As Integer
    UXBSourceMapEnsure m, m.count + 1
    Dim idx As Integer
    idx = m.count
    m.count += 1
    With m.items(idx)
        .surface = surfaceText
        .sourceStage = sourceStageText
        .targetStage = targetStageText
        .entityKind = entityKindText
        .entityName = entityNameText
        .sourceFile = srcLoc.filePath
        .sourceLine = srcLoc.lineNo
        .sourceCol = srcLoc.colNo
        .sourceLength = srcLoc.length
        .targetId = targetIdText
        .status = statusText
    End With
    Return idx
End Function

Function UXBSourceMapMissingLocationCount(ByRef m As UXBSourceMapList) As Integer
    Dim n As Integer
    n = 0
    Dim i As Integer
    For i = 0 To m.count - 1
        If m.items(i).sourceLine <= 0 And Trim(m.items(i).sourceFile) = "" Then n += 1
    Next i
    Return n
End Function

Function UXBSourceMapToCsv(ByRef m As UXBSourceMapList, ByRef csvOut As String) As Integer
    csvOut = "surface,source_stage,target_stage,entity_kind,entity_name,source_file,line,col,length,target_id,status" & Chr(10)
    Dim i As Integer
    For i = 0 To m.count - 1
        With m.items(i)
            csvOut &= UXBReportCsvEscape(.surface) & "," & UXBReportCsvEscape(.sourceStage) & "," & UXBReportCsvEscape(.targetStage) & "," & UXBReportCsvEscape(.entityKind) & "," & UXBReportCsvEscape(.entityName) & "," & UXBReportCsvEscape(.sourceFile) & "," & LTrim(Str(.sourceLine)) & "," & LTrim(Str(.sourceCol)) & "," & LTrim(Str(.sourceLength)) & "," & UXBReportCsvEscape(.targetId) & "," & UXBReportCsvEscape(.status) & Chr(10)
        End With
    Next i
    Return 1
End Function

Function UXBSourceMapWriteCsv(ByRef m As UXBSourceMapList, ByRef outPath As String, ByRef errText As String) As Integer
    Dim csvText As String
    UXBSourceMapToCsv m, csvText
    Return UXBReportWriteText(outPath, csvText, errText)
End Function

Function UXBSourceMapToJson(ByRef m As UXBSourceMapList, ByRef jsonOut As String) As Integer
    Dim b As UXBJsonBuilder
    UXBJsonInit b
    UXBJsonBeginObject b
    UXBJsonFieldString b, "schema", "uxb.source_map.v1"
    UXBJsonFieldInt b, "count", m.count
    UXBJsonFieldInt b, "missing_location_count", UXBSourceMapMissingLocationCount(m)
    UXBJsonBeginArrayField b, "entries"
    Dim i As Integer
    For i = 0 To m.count - 1
        UXBJsonBeginObject b
        With m.items(i)
            UXBJsonFieldString b, "surface", .surface
            UXBJsonFieldString b, "source_stage", .sourceStage
            UXBJsonFieldString b, "target_stage", .targetStage
            UXBJsonFieldString b, "entity_kind", .entityKind
            UXBJsonFieldString b, "entity_name", .entityName
            UXBJsonFieldString b, "source_file", .sourceFile
            UXBJsonFieldInt b, "line", .sourceLine
            UXBJsonFieldInt b, "col", .sourceCol
            UXBJsonFieldInt b, "length", .sourceLength
            UXBJsonFieldString b, "target_id", .targetId
            UXBJsonFieldString b, "status", .status
        End With
        UXBJsonEndObject b
    Next i
    UXBJsonEndArray b
    UXBJsonEndObject b
    jsonOut = UXBJsonText(b)
    Return 1
End Function

Function UXBSourceMapWriteJson(ByRef m As UXBSourceMapList, ByRef outPath As String, ByRef errText As String) As Integer
    Dim jsonText As String
    UXBSourceMapToJson m, jsonText
    Return UXBReportWriteText(outPath, jsonText, errText)
End Function

#endif
