#ifndef UXB_STRING_BUILDER_FBS
#define UXB_STRING_BUILDER_FBS

' Linear-time string accumulation.
'
' `s &= piece` in FreeBASIC reallocates the destination to EXACTLY the new length
' every time, so building a large text piece by piece (JSON artifacts of tokens,
' AST, MIR ...) copies the whole text on every append: O(n^2). Measured: the token
' JSON of a 600-statement program (3600 tokens, ~1 MB) took 1.4 s and a
' 1500-statement one took ~20 s -- most of what `uxb sem` spent.
'
' This builder keeps a buffer with spare capacity that doubles when full, and
' writes each piece in place with the MID assignment statement.

Type UXBStrBuf
    buf As String
    used As Integer
End Type

Sub UXBStrBufInit(ByRef b As UXBStrBuf, ByVal initialCapacity As Integer = 4096)
    If initialCapacity < 64 Then initialCapacity = 64
    b.buf = Space(initialCapacity)
    b.used = 0
End Sub

Sub UXBStrBufAdd(ByRef b As UXBStrBuf, ByRef piece As String)
    Dim n As Integer = Len(piece)
    If n = 0 Then Exit Sub
    Dim need As Integer = b.used + n
    If need > Len(b.buf) Then
        Dim newCap As Integer = Len(b.buf) * 2
        If newCap < need Then newCap = need + 4096
        b.buf &= Space(newCap - Len(b.buf))
    End If
    Mid(b.buf, b.used + 1, n) = piece
    b.used = need
End Sub

Function UXBStrBufText(ByRef b As UXBStrBuf) As String
    Return Left(b.buf, b.used)
End Function

#endif
