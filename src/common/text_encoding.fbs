#ifndef UXB_TEXT_ENCODING_FBS
#define UXB_TEXT_ENCODING_FBS

' A UTF-8 byte-order mark (EF BB BF) at the start of a file is a marker, not text. Windows
' editors (Notepad, PowerShell's Out-File/Set-Content -Encoding utf8) put one in front of
' UTF-8 files, and the lexer used to report it as three "unknown character" errors, so a
' perfectly good program written in such an editor failed with
' "Lexer diagnostic bridge hata buldu: 3". Every source loader strips it.
Function UXBStripUtf8Bom(ByRef textIn As String) As String
    If Len(textIn) >= 3 Then
        If textIn[0] = 239 And textIn[1] = 187 And textIn[2] = 191 Then Return Mid(textIn, 4)
    End If
    Return textIn
End Function

#endif