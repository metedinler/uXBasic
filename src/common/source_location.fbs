#ifndef UXB_COMMON_SOURCE_LOCATION_FBS
#define UXB_COMMON_SOURCE_LOCATION_FBS

Type SourceLocation
    filePath As String
    lineNo As Integer
    colNo As Integer
    length As Integer
    offset As Integer
    lexemeSnippet As String
End Type

Function UXBSourceSnippet(ByVal textValue As String, ByVal maxLen As Integer = 48) As String
    Dim t As String
    t = Trim(textValue)
    If maxLen < 4 Then maxLen = 4
    If Len(t) > maxLen Then Return Left(t, maxLen) & "..."
    Return t
End Function

Function UXBSourceLocationMake(ByVal filePathText As String = "", ByVal lineValue As Integer = 0, ByVal colValue As Integer = 0, ByVal lengthValue As Integer = 0, ByVal lexemeText As String = "", ByVal offsetValue As Integer = 0) As SourceLocation
    Dim srcLoc As SourceLocation
    srcLoc.filePath = filePathText
    srcLoc.lineNo = lineValue
    srcLoc.colNo = colValue
    srcLoc.length = lengthValue
    srcLoc.offset = offsetValue
    srcLoc.lexemeSnippet = UXBSourceSnippet(lexemeText)
    Return srcLoc
End Function

Function UXBSourceLocationHasData(ByRef srcLoc As SourceLocation) As Integer
    If srcLoc.lineNo > 0 Then Return 1
    If srcLoc.offset > 0 Then Return 1
    If Trim(srcLoc.filePath) <> "" Then Return 1
    If Trim(srcLoc.lexemeSnippet) <> "" Then Return 1
    Return 0
End Function

Function UXBSourceLocationLine(ByRef srcLoc As SourceLocation) As String
    If srcLoc.lineNo <= 0 Then Return ""
    Dim s As String
    If Trim(srcLoc.filePath) <> "" Then s = srcLoc.filePath & ":" Else s = ""
    s &= LTrim(Str(srcLoc.lineNo)) & ":" & LTrim(Str(srcLoc.colNo))
    Return s
End Function

#endif
