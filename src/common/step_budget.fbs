#ifndef UXB_STEP_BUDGET_FBS
#define UXB_STEP_BUDGET_FBS

' S-110 (Mete's decision, 2026-09-20): a normal run has NO step limit. A program's
' meaning is what a native build would do, and a native `DO : LOOP` never stops; an
' interpreter that cuts a valid long-running program off after N steps changes the
' language, not just the engine (the canonical-MIR interpreter used to stop every
' program after 250,000 steps, the AST engine after 1,000,000 iterations of any one
' loop -- valid programs failed on one engine and ran on the others).
'
' The budget is an OPTIONAL execution guard for tests and untrusted programs:
'     uxb run prog.uxb --max-steps 100000
' 0 (the default) means unlimited. It applies to the two interpreters (AST `run` and
' canonical-MIR `run --interpreter-backend MIR`); native builds have no such budget.
' It is a run budget, not language semantics.

Dim Shared gUxbMaxSteps As LongInt     ' 0 = unlimited
Dim Shared gUxbExecSteps As LongInt    ' statements/iterations counted by the AST engine

' Counts one unit of AST-engine work. Returns 1 to continue, 0 when the budget is
' exhausted (errText filled). Free when no budget is set.
Function UXBStepBudgetTick(ByRef errText As String) As Integer
    If gUxbMaxSteps <= 0 Then Return 1
    gUxbExecSteps += 1
    If gUxbExecSteps > gUxbMaxSteps Then
        errText = "exec: step limit exceeded (--max-steps " & LTrim(Str(gUxbMaxSteps)) & ")"
        Return 0
    End If
    Return 1
End Function

#endif
