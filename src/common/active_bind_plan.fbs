#ifndef UXB_COMMON_ACTIVE_BIND_PLAN_FBS
#define UXB_COMMON_ACTIVE_BIND_PLAN_FBS

#include once "report_writer.fbs"

Type UXBActiveBindEntry
    layerName As String
    gateName As String
    functionName As String
    statusText As String
    noteText As String
End Type

Type UXBActiveBindPlan
    entries(Any) As UXBActiveBindEntry
    count As Integer
    capacity As Integer
End Type

Sub UXBActiveBindPlanInit(ByRef p As UXBActiveBindPlan)
    p.capacity = 32
    ReDim p.entries(p.capacity - 1)
    p.count = 0
End Sub

Private Sub UXBActiveBindPlanEnsure(ByRef p As UXBActiveBindPlan, ByVal minSize As Integer)
    If p.capacity >= minSize Then Exit Sub
    Dim nc As Integer
    nc = p.capacity
    If nc < 1 Then nc = 32
    Do While nc < minSize
        nc *= 2
    Loop
    ReDim Preserve p.entries(nc - 1)
    p.capacity = nc
End Sub

Sub UXBActiveBindPlanAdd(ByRef p As UXBActiveBindPlan, ByRef layerText As String, ByRef gateText As String, ByRef fnText As String, ByRef statusText As String, ByRef noteText As String)
    UXBActiveBindPlanEnsure p, p.count + 1
    With p.entries(p.count)
        .layerName = layerText
        .gateName = gateText
        .functionName = fnText
        .statusText = statusText
        .noteText = noteText
    End With
    p.count += 1
End Sub

Private Function UXBActiveBindJsonEscape(ByRef rawText As String) As String
    Dim s As String
    s = ""
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim ch As String
        ch = Mid(rawText, i, 1)
        Select Case ch
        Case Chr(34)
            s &= "\" & Chr(34)
        Case "\"
            s &= "\\"
        Case Chr(10)
            s &= "\n"
        Case Chr(13)
            s &= "\r"
        Case Else
            s &= ch
        End Select
    Next i
    Return s
End Function

Function UXBActiveBindPlanToJson(ByRef p As UXBActiveBindPlan) As String
    Dim q As String
    q = Chr(34)
    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & q & "schema" & q & ": " & q & "uxb.active_bind_plan.v1" & q & "," & Chr(10)
    j &= "  " & q & "count" & q & ": " & LTrim(Str(p.count)) & "," & Chr(10)
    j &= "  " & q & "entries" & q & ": [" & Chr(10)
    Dim i As Integer
    For i = 0 To p.count - 1
        With p.entries(i)
            j &= "    {"
            j &= q & "layer" & q & ":" & q & UXBActiveBindJsonEscape(.layerName) & q & ","
            j &= q & "gate" & q & ":" & q & UXBActiveBindJsonEscape(.gateName) & q & ","
            j &= q & "function" & q & ":" & q & UXBActiveBindJsonEscape(.functionName) & q & ","
            j &= q & "status" & q & ":" & q & UXBActiveBindJsonEscape(.statusText) & q & ","
            j &= q & "note" & q & ":" & q & UXBActiveBindJsonEscape(.noteText) & q
            j &= "}"
            If i < p.count - 1 Then j &= ","
            j &= Chr(10)
        End With
    Next i
    j &= "  ]" & Chr(10)
    j &= "}" & Chr(10)
    Return j
End Function

Function UXBActiveBindPlanWriteJson(ByRef p As UXBActiveBindPlan, ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then Return 1
    Dim j As String
    j = UXBActiveBindPlanToJson(p)
    Return UXBReportWriteText(outPath, j, errText)
End Function

#endif
