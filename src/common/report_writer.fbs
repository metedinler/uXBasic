#ifndef UXB_COMMON_REPORT_WRITER_FBS
#define UXB_COMMON_REPORT_WRITER_FBS

Private Function UXBReportDirName(ByVal p As String) As String
    Dim i As Integer
    For i = Len(p) To 1 Step -1
        Dim ch As String
        ch = Mid(p, i, 1)
        If ch = "\" Or ch = "/" Then Return Left(p, i - 1)
    Next i
    Return ""
End Function

Private Sub UXBReportEnsureDir(ByVal dirText As String)
    Dim d As String
    d = Trim(dirText)
    If d = "" Or d = "." Then Exit Sub
    Dim norm As String
    norm = ""
    Dim i As Integer
    For i = 1 To Len(d)
        Dim ch As String
        ch = Mid(d, i, 1)
        If ch = "/" Then norm &= "\" Else norm &= ch
    Next i
    If Dir(norm) <> "" Then Exit Sub

    Dim cur As String
    cur = ""
    For i = 1 To Len(norm)
        Dim ch2 As String
        ch2 = Mid(norm, i, 1)
        cur &= ch2
        If ch2 = "\" Then
            Dim partial As String
            partial = Left(cur, Len(cur) - 1)
            If Len(partial) > 0 And Len(partial) <> 2 Then
                If Dir(partial) = "" Then MkDir partial
            End If
        End If
    Next i
    If Dir(norm) = "" Then MkDir norm
End Sub

Private Sub UXBReportEnsureParentDir(ByVal outPath As String)
    Dim d As String
    d = UXBReportDirName(outPath)
    If Trim(d) <> "" Then UXBReportEnsureDir d
End Sub

' FreeBASIC'te "On Error Resume Next" yoktur. Hata sirasinda dosya kapatmak
' gerekirse bu yardimci Sub, hatayi kendi icinde yutar ve ana hata akisini bozmaz.
Private Sub UXBReportSafeClose(ByVal fileNo As Integer)
    On Error GoTo _uxb_report_safe_close_error
    Close #fileNo
    On Error GoTo 0
    Exit Sub

_uxb_report_safe_close_error:
    On Error GoTo 0
End Sub

Function UXBReportCsvEscape(ByRef rawText As String) As String
    Dim t As String
    t = rawText
    Dim needsQuote As Integer
    needsQuote = 0
    If InStr(t, ",") > 0 Then needsQuote = 1
    If InStr(t, Chr(34)) > 0 Then needsQuote = 1
    If InStr(t, Chr(10)) > 0 Then needsQuote = 1
    If InStr(t, Chr(13)) > 0 Then needsQuote = 1

    Dim outText As String
    outText = ""
    Dim i As Integer
    For i = 1 To Len(t)
        Dim c As String
        c = Mid(t, i, 1)
        If c = Chr(34) Then outText &= Chr(34) & Chr(34) Else outText &= c
    Next i

    If needsQuote <> 0 Then Return Chr(34) & outText & Chr(34)
    Return outText
End Function

Function UXBReportWriteText(ByRef outPath As String, ByRef contentText As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then
        errText = "report write path is empty"
        Return 0
    End If

    Dim f As Integer
    Dim opened As Integer
    f = FreeFile
    opened = 0

    On Error GoTo _uxb_report_write_dir_err
    UXBReportEnsureParentDir outPath

    On Error GoTo _uxb_report_write_open_err
    Open outPath For Output As #f
    opened = 1

    On Error GoTo _uxb_report_write_print_err
    Print #f, contentText;

    On Error GoTo _uxb_report_write_close_err
    Close #f
    opened = 0
    On Error GoTo 0
    Return 1

_uxb_report_write_dir_err:
    errText = "report write parent dir failed: " & outPath & " err=" & LTrim(Str(Err))
    On Error GoTo 0
    Return 0

_uxb_report_write_open_err:
    errText = "report write open failed: " & outPath & " err=" & LTrim(Str(Err))
    On Error GoTo 0
    Return 0

_uxb_report_write_print_err:
    errText = "report write print failed: " & outPath & " err=" & LTrim(Str(Err))
    On Error GoTo 0
    If opened <> 0 Then UXBReportSafeClose f
    Return 0

_uxb_report_write_close_err:
    errText = "report write close failed: " & outPath & " err=" & LTrim(Str(Err))
    On Error GoTo 0
    Return 0
End Function

Function UXBReportAppendText(ByRef outPath As String, ByRef contentText As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then
        errText = "report append path is empty"
        Return 0
    End If

    Dim f As Integer
    Dim opened As Integer
    f = FreeFile
    opened = 0

    On Error GoTo _uxb_report_append_dir_err
    UXBReportEnsureParentDir outPath

    On Error GoTo _uxb_report_append_open_err
    Open outPath For Append As #f
    opened = 1

    On Error GoTo _uxb_report_append_print_err
    Print #f, contentText;

    On Error GoTo _uxb_report_append_close_err
    Close #f
    opened = 0
    On Error GoTo 0
    Return 1

_uxb_report_append_dir_err:
    errText = "report append parent dir failed: " & outPath & " err=" & LTrim(Str(Err))
    On Error GoTo 0
    Return 0

_uxb_report_append_open_err:
    errText = "report append open failed: " & outPath & " err=" & LTrim(Str(Err))
    On Error GoTo 0
    Return 0

_uxb_report_append_print_err:
    errText = "report append print failed: " & outPath & " err=" & LTrim(Str(Err))
    On Error GoTo 0
    If opened <> 0 Then UXBReportSafeClose f
    Return 0

_uxb_report_append_close_err:
    errText = "report append close failed: " & outPath & " err=" & LTrim(Str(Err))
    On Error GoTo 0
    Return 0
End Function

#endif
