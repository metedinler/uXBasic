#ifndef UXB_COMMON_JSON_BUILDER_FBS
#define UXB_COMMON_JSON_BUILDER_FBS

Type UXBJsonBuilder
    text As String
    indentLevel As Integer
    needComma(0 To 63) As Integer
End Type

Sub UXBJsonInit(ByRef b As UXBJsonBuilder)
    b.text = ""
    b.indentLevel = 0
    Dim i As Integer
    For i = 0 To 63
        b.needComma(i) = 0
    Next i
End Sub

Function UXBJsonEscape(ByRef rawText As String) As String
    Dim outText As String
    outText = ""
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim c As String
        c = Mid(rawText, i, 1)
        Select Case Asc(c)
        Case 8
            outText &= "\b"
        Case 9
            outText &= "\t"
        Case 10
            outText &= "\n"
        Case 12
            outText &= "\f"
        Case 13
            outText &= "\r"
        Case 34
            outText &= Chr(92) & Chr(34)
        Case 92
            outText &= "\\"
        Case Else
            If Asc(c) < 32 Then
                outText &= "?"
            Else
                outText &= c
            End If
        End Select
    Next i
    Return outText
End Function

Private Sub UXBJsonIndent(ByRef b As UXBJsonBuilder)
    Dim i As Integer
    For i = 1 To b.indentLevel
        b.text &= "  "
    Next i
End Sub

Private Sub UXBJsonBeforeValue(ByRef b As UXBJsonBuilder)
    If b.indentLevel < 0 Then b.indentLevel = 0
    If b.indentLevel > 63 Then b.indentLevel = 63
    If b.needComma(b.indentLevel) <> 0 Then b.text &= "," & Chr(10)
    UXBJsonIndent b
    b.needComma(b.indentLevel) = 1
End Sub

Private Sub UXBJsonBeforeField(ByRef b As UXBJsonBuilder, ByRef fieldName As String)
    UXBJsonBeforeValue b
    b.text &= Chr(34) & UXBJsonEscape(fieldName) & Chr(34) & ": "
End Sub
Function UXBJsonCanPush(ByRef b As UXBJsonBuilder, ByRef errText As String) As Integer
    errText = ""
    If b.indentLevel < 0 Then
        errText = "JSON_BUILDER_DEPTH_UNDERFLOW"
        Return 0
    End If
    If b.indentLevel >= 63 Then
        errText = "JSON_BUILDER_DEPTH_OVERFLOW"
        Return 0
    End If
    Return 1
End Function

Function UXBJsonPushLevel(ByRef b As UXBJsonBuilder, ByRef errText As String) As Integer
    If UXBJsonCanPush(b, errText) = 0 Then Return 0
    b.indentLevel += 1
    b.needComma(b.indentLevel) = 0
    Return 1
End Function

Function UXBJsonPopLevel(ByRef b As UXBJsonBuilder, ByRef errText As String) As Integer
    errText = ""
    If b.indentLevel <= 0 Then
        errText = "JSON_BUILDER_DEPTH_UNDERFLOW"
        Return 0
    End If
    b.indentLevel -= 1
    b.needComma(b.indentLevel) = 1
    Return 1
End Function

Function UXBJsonBeginObjectSafe(ByRef b As UXBJsonBuilder, ByRef errText As String) As Integer
    UXBJsonBeforeValue b
    b.text &= "{" & Chr(10)
    If UXBJsonPushLevel(b, errText) = 0 Then Return 0
    Return 1
End Function

Function UXBJsonBeginArraySafe(ByRef b As UXBJsonBuilder, ByRef errText As String) As Integer
    UXBJsonBeforeValue b
    b.text &= "[" & Chr(10)
    If UXBJsonPushLevel(b, errText) = 0 Then Return 0
    Return 1
End Function

Function UXBJsonEndObjectSafe(ByRef b As UXBJsonBuilder, ByRef errText As String) As Integer
    b.text &= Chr(10)
    If UXBJsonPopLevel(b, errText) = 0 Then Return 0
    UXBJsonIndent b
    b.text &= "}"
    Return 1
End Function

Function UXBJsonEndArraySafe(ByRef b As UXBJsonBuilder, ByRef errText As String) As Integer
    b.text &= Chr(10)
    If UXBJsonPopLevel(b, errText) = 0 Then Return 0
    UXBJsonIndent b
    b.text &= "]"
    Return 1
End Function


Sub UXBJsonBeginObject(ByRef b As UXBJsonBuilder)
    UXBJsonBeforeValue b
    b.text &= "{" & Chr(10)
    b.indentLevel += 1
    b.needComma(b.indentLevel) = 0
End Sub

Sub UXBJsonBeginObjectField(ByRef b As UXBJsonBuilder, ByRef fieldName As String)
    UXBJsonBeforeField b, fieldName
    b.text &= "{" & Chr(10)
    b.indentLevel += 1
    b.needComma(b.indentLevel) = 0
End Sub

Sub UXBJsonEndObject(ByRef b As UXBJsonBuilder)
    b.text &= Chr(10)
    b.indentLevel -= 1
    If b.indentLevel < 0 Then b.indentLevel = 0
    UXBJsonIndent b
    b.text &= "}"
    b.needComma(b.indentLevel) = 1
End Sub

Sub UXBJsonBeginArrayField(ByRef b As UXBJsonBuilder, ByRef fieldName As String)
    UXBJsonBeforeField b, fieldName
    b.text &= "[" & Chr(10)
    b.indentLevel += 1
    b.needComma(b.indentLevel) = 0
End Sub

Sub UXBJsonBeginArray(ByRef b As UXBJsonBuilder)
    UXBJsonBeforeValue b
    b.text &= "[" & Chr(10)
    b.indentLevel += 1
    b.needComma(b.indentLevel) = 0
End Sub

Sub UXBJsonEndArray(ByRef b As UXBJsonBuilder)
    b.text &= Chr(10)
    b.indentLevel -= 1
    If b.indentLevel < 0 Then b.indentLevel = 0
    UXBJsonIndent b
    b.text &= "]"
    b.needComma(b.indentLevel) = 1
End Sub

Sub UXBJsonFieldString(ByRef b As UXBJsonBuilder, ByRef fieldName As String, ByRef fieldValue As String)
    UXBJsonBeforeField b, fieldName
    b.text &= Chr(34) & UXBJsonEscape(fieldValue) & Chr(34)
End Sub

Sub UXBJsonFieldInt(ByRef b As UXBJsonBuilder, ByRef fieldName As String, ByVal fieldValue As Integer)
    UXBJsonBeforeField b, fieldName
    b.text &= LTrim(Str(fieldValue))
End Sub

Sub UXBJsonFieldBool(ByRef b As UXBJsonBuilder, ByRef fieldName As String, ByVal fieldValue As Integer)
    UXBJsonBeforeField b, fieldName
    If fieldValue <> 0 Then b.text &= "true" Else b.text &= "false"
End Sub

Sub UXBJsonFieldRaw(ByRef b As UXBJsonBuilder, ByRef fieldName As String, ByRef rawValue As String)
    UXBJsonBeforeField b, fieldName
    b.text &= rawValue
End Sub

Sub UXBJsonArrayString(ByRef b As UXBJsonBuilder, ByRef valueText As String)
    UXBJsonBeforeValue b
    b.text &= Chr(34) & UXBJsonEscape(valueText) & Chr(34)
End Sub

Function UXBJsonText(ByRef b As UXBJsonBuilder) As String
    Return b.text
End Function

#endif
