#ifndef UXB_TASK_CONTEXT_NAMES_FBS
#define UXB_TASK_CONTEXT_NAMES_FBS

' Task context variable names, shared by every layer that produces or consumes
' them: MIR lowering, the AST interpreter's slot runtime, the canonical-MIR
' bridge, and both x64 emitters.
'
' These carry the value a TRIGGER passes into a task, and the value a PIPE
' hands back.  They used to be spelled INPUT and OUTPUT, which collided with
' the INPUT console statement: the same word read the keyboard at statement
' position and the task payload inside an expression.  Mete's decision
' (2026-09-11) renamed them, with no compatibility alias for the old spelling
' -- an old "PRINT INPUT" must fail loudly rather than silently read a value
' that no longer lands there.
'
' They are deliberately NOT lexer keywords.  Like the former OUTPUT, they
' resolve as ordinary identifiers, so no keyword-table or KEYWORD_REF path
' needs to know about them; only the "known symbol" exemption lists do.
Const UXB_TASK_INPUT_NAME As String = "TASKIN"
Const UXB_TASK_RESULT_NAME As String = "TASKOUT"

#endif
