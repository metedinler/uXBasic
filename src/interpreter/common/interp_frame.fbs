#ifndef UXB_INTERP_FRAME_FBS
#define UXB_INTERP_FRAME_FBS

#include once "interp_value.fbs"

Type UXBInterpLocal
    nameText As String
    value As UXBInterpValue
    declaredType As String
End Type

Type UXBInterpFrame
    frameName As String
    routineKind As String
    returnTarget As Integer
    nodeIndex As Integer
    locals(Any) As UXBInterpLocal
    localCount As Integer
    returnValue As UXBInterpValue
    hasReturnValue As Integer
End Type

Sub UXBInterpFrameInit(ByRef f As UXBInterpFrame, ByVal nameText As String, ByVal kindText As String, ByVal nodeIndex As Integer)
    f.frameName = nameText
    f.routineKind = kindText
    f.returnTarget = -1
    f.nodeIndex = nodeIndex
    f.localCount = 0
    f.hasReturnValue = 0
    f.returnValue = UXBInterpValueVoid()
    Erase f.locals
End Sub

Private Function UXBInterpFrameFindLocal(ByRef f As UXBInterpFrame, ByVal nameText As String) As Integer
    Dim key As String = UCase(Trim(nameText))
    Dim i As Integer
    For i = 0 To f.localCount - 1
        If UCase(f.locals(i).nameText) = key Then Return i
    Next i
    Return -1
End Function

Function UXBInterpFrameHasLocal(ByRef f As UXBInterpFrame, ByVal nameText As String) As Integer
    Return IIf(UXBInterpFrameFindLocal(f, nameText) >= 0, 1, 0)
End Function

Sub UXBInterpFrameSetLocal(ByRef f As UXBInterpFrame, ByVal nameText As String, ByRef v As UXBInterpValue, ByVal declaredType As String = "")
    Dim idx As Integer = UXBInterpFrameFindLocal(f, nameText)
    If idx < 0 Then
        If f.localCount = 0 Then
            ReDim f.locals(0)
        Else
            ReDim Preserve f.locals(f.localCount)
        End If
        idx = f.localCount
        f.localCount += 1
        f.locals(idx).nameText = Trim(nameText)
    End If
    If Trim(declaredType) <> "" Then f.locals(idx).declaredType = UCase(Trim(declaredType))
    f.locals(idx).value = UXBInterpApplyDeclaredType(v, f.locals(idx).declaredType)
End Sub

Function UXBInterpFrameGetLocal(ByRef f As UXBInterpFrame, ByVal nameText As String, ByRef outValue As UXBInterpValue) As Integer
    Dim idx As Integer = UXBInterpFrameFindLocal(f, nameText)
    If idx < 0 Then Return 0
    outValue = f.locals(idx).value
    Return 1
End Function

#endif
