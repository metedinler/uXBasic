#ifndef UXB_INTERP_STACK_FBS
#define UXB_INTERP_STACK_FBS

#include once "interp_frame.fbs"

Type UXBInterpStack
    frames(Any) As UXBInterpFrame
    frameCount As Integer
    maxDepth As Integer
End Type

Sub UXBInterpStackInit(ByRef st As UXBInterpStack)
    st.frameCount = 0
    st.maxDepth = 1024
    Erase st.frames
End Sub

Function UXBInterpStackPush(ByRef st As UXBInterpStack, ByRef frameValue As UXBInterpFrame, ByRef errText As String) As Integer
    If st.frameCount >= st.maxDepth Then
        errText = "interpreter call stack limit exceeded"
        Return 0
    End If
    If st.frameCount = 0 Then
        ReDim st.frames(0)
    Else
        ReDim Preserve st.frames(st.frameCount)
    End If
    st.frames(st.frameCount) = frameValue
    st.frameCount += 1
    Return 1
End Function

Function UXBInterpStackPop(ByRef st As UXBInterpStack, ByRef outFrame As UXBInterpFrame, ByRef errText As String) As Integer
    If st.frameCount <= 0 Then
        errText = "interpreter call stack is empty"
        Return 0
    End If
    outFrame = st.frames(st.frameCount - 1)
    st.frameCount -= 1
    If st.frameCount <= 0 Then
        Erase st.frames
    Else
        ReDim Preserve st.frames(st.frameCount - 1)
    End If
    Return 1
End Function

Function UXBInterpStackTop(ByRef st As UXBInterpStack) As UXBInterpFrame Ptr
    If st.frameCount <= 0 Then Return 0
    Return @st.frames(st.frameCount - 1)
End Function

#endif
