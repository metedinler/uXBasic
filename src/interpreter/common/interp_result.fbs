#ifndef UXB_INTERP_RESULT_FBS
#define UXB_INTERP_RESULT_FBS

#include once "interp_value.fbs"

Type UXBInterpDiagnostic
    code As Integer
    severity As String
    messageText As String
End Type

Type UXBInterpResult
    statusText As String
    exitCode As Integer
    stdoutText As String
    stderrText As String
    returnValue As UXBInterpValue
    errorCode As Integer
    errorText As String
    diagnostics(Any) As UXBInterpDiagnostic
    diagnosticCount As Integer
    runtimeServiceCalls As Integer
    executedSteps As LongInt
    outputMode As String
    outputEventsJson As String
End Type

Sub UXBInterpResultInit(ByRef r As UXBInterpResult)
    r.statusText = "PASS"
    r.exitCode = 0
    r.stdoutText = ""
    r.stderrText = ""
    r.returnValue = UXBInterpValueVoid()
    r.errorCode = 0
    r.errorText = ""
    r.diagnosticCount = 0
    r.runtimeServiceCalls = 0
    r.executedSteps = 0
    r.outputMode = "JSON"
    r.outputEventsJson = "[]"
    Erase r.diagnostics
End Sub

Sub UXBInterpResultFail(ByRef r As UXBInterpResult, ByVal codeValue As Integer, ByVal textValue As String)
    r.statusText = "FAIL"
    r.exitCode = IIf(codeValue <> 0, codeValue, 1)
    r.errorCode = codeValue
    r.errorText = textValue
    r.stderrText &= textValue & Chr(10)
End Sub

Sub UXBInterpResultAddDiagnostic(ByRef r As UXBInterpResult, ByVal codeValue As Integer, ByVal severityText As String, ByVal messageText As String)
    If r.diagnosticCount = 0 Then
        ReDim r.diagnostics(0)
    Else
        ReDim Preserve r.diagnostics(r.diagnosticCount)
    End If
    r.diagnostics(r.diagnosticCount).code = codeValue
    r.diagnostics(r.diagnosticCount).severity = severityText
    r.diagnostics(r.diagnosticCount).messageText = messageText
    r.diagnosticCount += 1
End Sub

Private Function UXBInterpJsonEscape(ByVal rawText As String) As String
    Dim outText As String = ""
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim ch As String = Mid(rawText, i, 1)
        Select Case ch
        Case Chr(34): outText &= "\" & Chr(34)
        Case "\": outText &= "\\"
        Case Chr(13): outText &= "\r"
        Case Chr(10): outText &= "\n"
        Case Chr(9): outText &= "\t"
        Case Else: outText &= ch
        End Select
    Next i
    Return outText
End Function

Function UXBInterpResultToJson(ByRef r As UXBInterpResult, ByVal layerText As String) As String
    Dim q As String = Chr(34)
    Dim j As String = "{" & Chr(10)
    j &= "  " & q & "layer" & q & ":" & q & UXBInterpJsonEscape(layerText) & q & "," & Chr(10)
    j &= "  " & q & "status" & q & ":" & q & UXBInterpJsonEscape(r.statusText) & q & "," & Chr(10)
    j &= "  " & q & "exit_code" & q & ":" & LTrim(Str(r.exitCode)) & "," & Chr(10)
    j &= "  " & q & "error_code" & q & ":" & LTrim(Str(r.errorCode)) & "," & Chr(10)
    j &= "  " & q & "error_text" & q & ":" & q & UXBInterpJsonEscape(r.errorText) & q & "," & Chr(10)
    j &= "  " & q & "stdout" & q & ":" & q & UXBInterpJsonEscape(r.stdoutText) & q & "," & Chr(10)
    j &= "  " & q & "stderr" & q & ":" & q & UXBInterpJsonEscape(r.stderrText) & q & "," & Chr(10)
    j &= "  " & q & "output_mode" & q & ":" & q & UXBInterpJsonEscape(r.outputMode) & q & "," & Chr(10)
    j &= "  " & q & "output_events" & q & ":" & r.outputEventsJson & "," & Chr(10)
    j &= "  " & q & "runtime_service_calls" & q & ":" & LTrim(Str(r.runtimeServiceCalls)) & "," & Chr(10)
    j &= "  " & q & "executed_steps" & q & ":" & LTrim(Str(r.executedSteps)) & "," & Chr(10)
    j &= "  " & q & "return_value" & q & ":" & q & UXBInterpJsonEscape(UXBInterpValueToString(r.returnValue)) & q & Chr(10)
    j &= "}"
    Return j
End Function

Function UXBInterpResultWriteJson(ByRef r As UXBInterpResult, ByVal filePath As String, ByVal layerText As String, ByRef errText As String) As Integer
    If Trim(filePath) = "" Then Return 1
    Dim f As Integer = FreeFile
    Open filePath For Output As #f
    If Err <> 0 Then
        errText = "interpreter json cannot be written: " & filePath
        Return 0
    End If
    Print #f, UXBInterpResultToJson(r, layerText);
    Close #f
    Return 1
End Function

#endif
