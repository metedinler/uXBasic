#ifndef UXB_INTERP_COMPARE_FBS
#define UXB_INTERP_COMPARE_FBS

#include once "interp_result.fbs"

Type UXBInterpCompareResult
    statusText As String
    stdoutMatch As Integer
    stderrMatch As Integer
    exitMatch As Integer
    returnMatch As Integer
    runtimeCallMatch As Integer
    messageText As String
End Type

Function UXBInterpCompare(ByRef leftResult As UXBInterpResult, ByRef rightResult As UXBInterpResult) As UXBInterpCompareResult
    Dim c As UXBInterpCompareResult
    c.stdoutMatch = IIf(leftResult.stdoutText = rightResult.stdoutText, 1, 0)
    c.stderrMatch = IIf(leftResult.stderrText = rightResult.stderrText, 1, 0)
    c.exitMatch = IIf(leftResult.exitCode = rightResult.exitCode, 1, 0)
    c.returnMatch = IIf(UXBInterpValueToString(leftResult.returnValue) = UXBInterpValueToString(rightResult.returnValue), 1, 0)
    c.runtimeCallMatch = IIf(leftResult.runtimeServiceCalls = rightResult.runtimeServiceCalls, 1, 0)
    If c.stdoutMatch <> 0 And c.stderrMatch <> 0 And c.exitMatch <> 0 And c.returnMatch <> 0 And c.runtimeCallMatch <> 0 Then
        c.statusText = "PASS"
        c.messageText = "AST and MIR interpreter results match"
    Else
        c.statusText = "FAIL"
        c.messageText = "AST and MIR interpreter results differ"
    End If
    Return c
End Function

#endif
