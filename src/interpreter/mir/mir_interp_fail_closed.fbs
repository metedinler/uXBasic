#ifndef UXB_MIR_INTERP_FAIL_CLOSED_FBS
#define UXB_MIR_INTERP_FAIL_CLOSED_FBS

#include once "../common/interp_context.fbs"
#include once "mir_interp_registry.fbs"

Function UXBMIRInterpFailClosed(ByRef ctx As UXBInterpContext, ByVal opcodeText As String, ByVal decisionText As String) As UXBInterpValue
    Select Case UCase(Trim(decisionText))
    Case MIR_EXEC_NATIVE_ONLY
        Return UXBInterpValueError(UXB_INTERP_ERR_NATIVE_ONLY, "MIR opcode requires native backend: " & opcodeText)
    Case MIR_EXEC_WASM_UNSUPPORTED
        Return UXBInterpValueError(UXB_INTERP_ERR_WASM_UNSUPPORTED, "MIR opcode is not supported by WASM interpreter: " & opcodeText)
    Case MIR_EXEC_DIAGNOSTIC_ONLY
        Return UXBInterpValueError(UXB_INTERP_ERR_DIAGNOSTIC_ONLY, "MIR opcode is diagnostic-only: " & opcodeText)
    Case MIR_EXEC_RESERVED
        Return UXBInterpValueError(UXB_INTERP_ERR_RESERVED_NODE, "MIR opcode is reserved: " & opcodeText)
    End Select
    Return UXBInterpValueError(UXB_INTERP_ERR_MIR_OPCODE, "MIR opcode has no interpreter path: " & opcodeText)
End Function

#endif
