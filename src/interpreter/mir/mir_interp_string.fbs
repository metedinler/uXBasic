#ifndef UXB_MIR_INTERP_STRING_FBS
#define UXB_MIR_INTERP_STRING_FBS

#include once "../../mir/mir_instruction.fbs"
#include once "../common/interp_context.fbs"

Function UXBMIRInterpExecString(ByRef ins As UXBMIRInstructionRecord, ByRef ctx As UXBInterpContext, ByRef sourceValue As UXBInterpValue, ByRef secondValue As UXBInterpValue) As UXBInterpValue
    Dim s As String = UXBInterpValueToString(sourceValue)
    Dim b As String = UXBInterpValueToString(secondValue)
    Select Case UXBMIRStep4CanonicalOpcode(ins.opcode)
    Case "MIR_STR_NEW", "MIR_STR_ASSIGN"
        Return UXBInterpValueString(s)
    Case "MIR_STR_CONCAT"
        Return UXBInterpValueString(s & b)
    Case "MIR_STR_LEN"
        Return UXBInterpValueInt(Len(s))
    Case "MIR_STR_LEFT"
        Return UXBInterpValueString(Left(s, secondValue.intValue))
    Case "MIR_STR_RIGHT"
        Return UXBInterpValueString(Right(s, secondValue.intValue))
    Case "MIR_STR_MID"
        Dim startAt As Integer = 1
        If ins.operandCount > 1 Then startAt = secondValue.intValue
        Return UXBInterpValueString(Mid(s, startAt))
    Case "MIR_STR_COMPARE"
        If s < b Then Return UXBInterpValueInt(-1)
        If s > b Then Return UXBInterpValueInt(1)
        Return UXBInterpValueInt(0)
    End Select
    Return UXBInterpValueError(UXB_INTERP_ERR_MIR_OPCODE, "MIR string opcode not executable: " & ins.opcode)
End Function

#endif
