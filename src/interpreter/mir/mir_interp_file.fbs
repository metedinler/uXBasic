#ifndef UXB_MIR_INTERP_FILE_FBS
#define UXB_MIR_INTERP_FILE_FBS

#include once "../../mir/mir_instruction.fbs"
#include once "../common/interp_context.fbs"
#include once "../../runtime/runtime_service_dispatch.fbs"

Function UXBMIRInterpExecFile(ByRef ins As UXBMIRInstructionRecord, ByRef ctx As UXBInterpContext) As UXBInterpValue
    Dim args As UXBRuntimeArgList
    UXBRuntimeArgListInit args
    Dim i As Integer
    For i = 0 To ins.operandCount - 1
        UXBRuntimeArgListAdd args, UXBInterpValueString(ins.operands(i))
    Next i
    Select Case UXBMIRStep4NormalizeOpcode(ins.opcode)
    Case "OPEN", "MIR_FILE_OPEN": Return UXBRuntimeDispatch(ctx.runtime, RT_FILE_OPEN, args)
    Case "CLOSE": Return UXBRuntimeDispatch(ctx.runtime, RT_FILE_CLOSE, args)
    Case "GET": Return UXBRuntimeDispatch(ctx.runtime, RT_FILE_READ, args)
    Case "PUT": Return UXBRuntimeDispatch(ctx.runtime, RT_FILE_WRITE, args)
    Case "SEEK": Return UXBRuntimeDispatch(ctx.runtime, RT_FILE_SEEK, args)
    End Select
    Return UXBInterpValueError(UXB_INTERP_ERR_MIR_OPCODE, "MIR file opcode not executable: " & ins.opcode)
End Function

#endif
