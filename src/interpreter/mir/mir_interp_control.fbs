#ifndef UXB_MIR_INTERP_CONTROL_FBS
#define UXB_MIR_INTERP_CONTROL_FBS

#include once "../../mir/mir_instruction.fbs"
#include once "../common/interp_context.fbs"

Type UXBMIRInterpControlSignal
    nextIndex As Integer
    returnNow As Integer
    returnValue As UXBInterpValue
    failed As Integer
    errorValue As UXBInterpValue
End Type

Function UXBMIRInterpControlDefault(ByVal currentIndex As Integer) As UXBMIRInterpControlSignal
    Dim s As UXBMIRInterpControlSignal
    s.nextIndex = currentIndex + 1
    s.returnNow = 0
    s.failed = 0
    s.returnValue = UXBInterpValueVoid()
    s.errorValue = UXBInterpValueVoid()
    Return s
End Function

Function UXBMIRInterpControlFail(ByVal currentIndex As Integer, ByVal codeValue As Integer, ByVal messageText As String) As UXBMIRInterpControlSignal
    Dim s As UXBMIRInterpControlSignal = UXBMIRInterpControlDefault(currentIndex)
    s.failed = 1
    s.errorValue = UXBInterpValueError(codeValue, messageText)
    Return s
End Function

#endif
