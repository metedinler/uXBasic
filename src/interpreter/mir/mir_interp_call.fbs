#ifndef UXB_MIR_INTERP_CALL_FBS
#define UXB_MIR_INTERP_CALL_FBS

#include once "../../mir/mir_instruction.fbs"
#include once "../common/interp_context.fbs"
#include once "mir_interp_runtime_call.fbs"

Function UXBMIRInterpExecCall(ByRef ins As UXBMIRInstructionRecord, ByRef ctx As UXBInterpContext) As UXBInterpValue
    Select Case UXBMIRStep4CanonicalOpcode(ins.opcode)
    Case "MIR_CALL", "MIR_CALL_BUILTIN", "MIR_CALL_RUNTIME", "MIR_CALL_EXTERNAL", "MIR_HOST_CALL", "MIR_JS_CALL", "MIR_BROWSER_CALL", "MIR_WASM_IMPORT", "MIR_WASM_EXPORT"
        Return UXBMIRInterpExecRuntimeCall(ins, ctx)
    Case "MIR_CALL_DLL", "MIR_CALL_API", "MIR_NATIVE_ONLY"
        Return UXBInterpValueError(UXB_INTERP_ERR_NATIVE_ONLY, "MIR call requires native backend: " & ins.opcode)
    End Select
    Return UXBInterpValueError(UXB_INTERP_ERR_MIR_OPCODE, "MIR call opcode not executable: " & ins.opcode)
End Function

#endif
