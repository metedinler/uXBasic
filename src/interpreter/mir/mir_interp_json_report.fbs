#ifndef UXB_MIR_INTERP_JSON_REPORT_FBS
#define UXB_MIR_INTERP_JSON_REPORT_FBS

#include once "../common/interp_result.fbs"
#include once "../trace/interp_trace_json.fbs"

Function UXBMIRInterpResultToJson(ByRef resultValue As UXBInterpResult) As String
    Return UXBInterpResultToJson(resultValue, "mir_interpreter")
End Function

Function UXBMIRInterpFullReportToJson(ByRef resultValue As UXBInterpResult, ByRef traceValue As UXBInterpTraceBuffer) As String
    Dim q As String = Chr(34)
    Dim j As String = "{" & Chr(10)
    j &= "  " & q & "result" & q & ":" & UXBInterpResultToJson(resultValue, "mir_interpreter") & "," & Chr(10)
    j &= "  " & q & "trace" & q & ":" & UXBInterpTraceToJson(traceValue) & Chr(10)
    j &= "}"
    Return j
End Function

Function UXBMIRInterpWriteFullReportJson(ByRef resultValue As UXBInterpResult, ByRef traceValue As UXBInterpTraceBuffer, ByVal filePath As String, ByRef errText As String) As Integer
    If Trim(filePath) = "" Then Return 1
    Dim f As Integer = FreeFile
    Open filePath For Output As #f
    If Err <> 0 Then
        errText = "mir interpreter report cannot be written: " & filePath
        Return 0
    End If
    Print #f, UXBMIRInterpFullReportToJson(resultValue, traceValue);
    Close #f
    Return 1
End Function

#endif
