#ifndef UXB_MIR_INTERP_REGISTRY_FBS
#define UXB_MIR_INTERP_REGISTRY_FBS

#include once "../../mir/mir_registry.fbs"

Const MIR_EXEC_IMPLEMENTED As String = "MIR_EXEC_IMPLEMENTED"
Const MIR_EXEC_RUNTIME_CALL As String = "MIR_EXEC_RUNTIME_CALL"
Const MIR_EXEC_NATIVE_ONLY As String = "MIR_EXEC_NATIVE_ONLY"
Const MIR_EXEC_JS_ONLY As String = "MIR_EXEC_JS_ONLY"
Const MIR_EXEC_BROWSER_ONLY As String = "MIR_EXEC_BROWSER_ONLY"
Const MIR_EXEC_WASM_UNSUPPORTED As String = "MIR_EXEC_WASM_UNSUPPORTED"
Const MIR_EXEC_DIAGNOSTIC_ONLY As String = "MIR_EXEC_DIAGNOSTIC_ONLY"
Const MIR_EXEC_RESERVED As String = "MIR_EXEC_RESERVED"
Const MIR_EXEC_REMOVED As String = "MIR_EXEC_REMOVED"
Const MIR_EXEC_MISSING As String = "MIR_EXEC_MISSING"
Const MIR_EXEC_BROKEN As String = "MIR_EXEC_BROKEN"

Function UXBMIRInterpDecisionForOpcode(ByVal opcodeText As String) As String
    Dim op As String = UXBMIRStep4NormalizeOpcode(opcodeText)
    If UXBMIRStep4OpcodeKnown(op) = 0 Then Return MIR_EXEC_MISSING
    If op = "MIR_NATIVE_ONLY" Or op = "INLINE" Then Return MIR_EXEC_NATIVE_ONLY
    If op = "MIR_WASM_UNSUPPORTED" Then Return MIR_EXEC_WASM_UNSUPPORTED
    Select Case UXBMIRStep4OpcodeGroup(op)
    Case "MIR_RUNTIME", "MIR_FILE", "MIR_MEMORY", "MIR_CALL", "MIR_TARGET"
        Return MIR_EXEC_RUNTIME_CALL
    Case "MIR_INVALID"
        Return MIR_EXEC_BROKEN
    End Select
    Return MIR_EXEC_IMPLEMENTED
End Function

Function UXBMIRInterpHandlerForOpcode(ByVal opcodeText As String) As String
    Select Case UXBMIRStep4OpcodeGroup(opcodeText)
    Case "MIR_ARITH", "MIR_EXPR": Return "UXBMIRInterpExecArith"
    Case "MIR_CONTROL": Return "UXBMIRInterpExecControl"
    Case "MIR_CALL": Return "UXBMIRInterpExecCall"
    Case "MIR_STRING": Return "UXBMIRInterpExecString"
    Case "MIR_STORAGE": Return "UXBMIRInterpExecStorage"
    Case "MIR_MEMORY": Return "UXBMIRInterpExecMemory"
    Case "MIR_FILE": Return "UXBMIRInterpExecFile"
    Case "MIR_RUNTIME", "MIR_TARGET": Return "UXBMIRInterpExecRuntimeCall"
    Case "MIR_OBJECT": Return "UXBMIRInterpExecArrayObject"
    Case "MIR_FAIL_CLOSED": Return "UXBMIRInterpFailClosed"
    End Select
    Return "UXBMIRInterpFailClosed"
End Function

#endif
