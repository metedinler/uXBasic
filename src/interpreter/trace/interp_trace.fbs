#ifndef UXB_INTERP_TRACE_FBS
#define UXB_INTERP_TRACE_FBS

#include once "interp_trace_event.fbs"

Type UXBInterpTraceBuffer
    enabled As Integer
    events(Any) As UXBInterpTraceEvent
    eventCount As Integer
End Type

Sub UXBInterpTraceInit(ByRef tr As UXBInterpTraceBuffer, ByVal enabledValue As Integer)
    tr.enabled = IIf(enabledValue <> 0, 1, 0)
    tr.eventCount = 0
    Erase tr.events
End Sub

Sub UXBInterpTraceAdd(ByRef tr As UXBInterpTraceBuffer, ByVal kindText As String, ByVal layerText As String, ByVal nodeKind As String, ByVal opcodeText As String, ByVal messageText As String, ByVal valueText As String, ByVal lineNo As Integer = 0, ByVal colNo As Integer = 0)
    If tr.enabled = 0 Then Exit Sub
    If tr.eventCount = 0 Then
        ReDim tr.events(0)
    Else
        ReDim Preserve tr.events(tr.eventCount)
    End If
    Dim idx As Integer = tr.eventCount
    tr.eventCount += 1
    tr.events(idx).sequenceNo = idx + 1
    tr.events(idx).eventKind = kindText
    tr.events(idx).layerName = layerText
    tr.events(idx).nodeKind = nodeKind
    tr.events(idx).opcode = opcodeText
    tr.events(idx).messageText = messageText
    tr.events(idx).valueText = valueText
    tr.events(idx).lineNo = lineNo
    tr.events(idx).colNo = colNo
End Sub

#endif
