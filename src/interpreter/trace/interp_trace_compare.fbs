#ifndef UXB_INTERP_TRACE_COMPARE_FBS
#define UXB_INTERP_TRACE_COMPARE_FBS

#include once "interp_trace.fbs"

Function UXBInterpTraceShapeMatches(ByRef a As UXBInterpTraceBuffer, ByRef b As UXBInterpTraceBuffer, ByRef errText As String) As Integer
    If a.eventCount <> b.eventCount Then
        errText = "trace event count mismatch"
        Return 0
    End If
    Dim i As Integer
    For i = 0 To a.eventCount - 1
        If a.events(i).eventKind <> b.events(i).eventKind Then
            errText = "trace kind mismatch at event " & LTrim(Str(i + 1))
            Return 0
        End If
    Next i
    errText = ""
    Return 1
End Function

#endif
