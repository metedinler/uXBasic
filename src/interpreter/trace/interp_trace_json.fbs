#ifndef UXB_INTERP_TRACE_JSON_FBS
#define UXB_INTERP_TRACE_JSON_FBS

#include once "interp_trace.fbs"

Private Function UXBInterpTraceJsonEscape2(ByVal rawText As String) As String
    Dim outText As String = ""
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim ch As String = Mid(rawText, i, 1)
        Select Case ch
        Case Chr(34): outText &= "\" & Chr(34)
        Case "\": outText &= "\\"
        Case Chr(13): outText &= "\r"
        Case Chr(10): outText &= "\n"
        Case Chr(9): outText &= "\t"
        Case Else: outText &= ch
        End Select
    Next i
    Return outText
End Function

Function UXBInterpTraceToJson(ByRef tr As UXBInterpTraceBuffer) As String
    Dim q As String = Chr(34)
    Dim j As String = "{" & Chr(10)
    j &= "  " & q & "enabled" & q & ":" & IIf(tr.enabled <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & q & "event_count" & q & ":" & LTrim(Str(tr.eventCount)) & "," & Chr(10)
    j &= "  " & q & "events" & q & ":[" & Chr(10)
    Dim i As Integer
    For i = 0 To tr.eventCount - 1
        If i > 0 Then j &= "," & Chr(10)
        j &= "    {"
        j &= q & "seq" & q & ":" & LTrim(Str(tr.events(i).sequenceNo)) & ","
        j &= q & "kind" & q & ":" & q & UXBInterpTraceJsonEscape2(tr.events(i).eventKind) & q & ","
        j &= q & "layer" & q & ":" & q & UXBInterpTraceJsonEscape2(tr.events(i).layerName) & q & ","
        j &= q & "node" & q & ":" & q & UXBInterpTraceJsonEscape2(tr.events(i).nodeKind) & q & ","
        j &= q & "opcode" & q & ":" & q & UXBInterpTraceJsonEscape2(tr.events(i).opcode) & q & ","
        j &= q & "message" & q & ":" & q & UXBInterpTraceJsonEscape2(tr.events(i).messageText) & q & ","
        j &= q & "value" & q & ":" & q & UXBInterpTraceJsonEscape2(tr.events(i).valueText) & q
        j &= "}"
    Next i
    j &= Chr(10) & "  ]" & Chr(10) & "}"
    Return j
End Function

Function UXBInterpTraceWriteJson(ByRef tr As UXBInterpTraceBuffer, ByVal filePath As String, ByRef errText As String) As Integer
    If Trim(filePath) = "" Then Return 1
    Dim f As Integer = FreeFile
    Open filePath For Output As #f
    If Err <> 0 Then
        errText = "trace json cannot be written: " & filePath
        Return 0
    End If
    Print #f, UXBInterpTraceToJson(tr);
    Close #f
    Return 1
End Function

#endif
