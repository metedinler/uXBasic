#ifndef UXB_AST_INTERP_HELPERS_FBS
#define UXB_AST_INTERP_HELPERS_FBS

#include once "../../parser/ast.fbs"
#include once "../common/interp_context.fbs"
#include once "../../runtime/runtime_service_dispatch.fbs"

Function UXBAstInterpChild(ByRef ast As ASTPool, ByVal nodeIdx As Integer, ByVal childNo As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ast.count Then Return AST_NULL
    Dim idx As Integer = ast.nodes(nodeIdx).firstChild
    Dim i As Integer = 0
    Do While idx <> AST_NULL
        If i = childNo Then Return idx
        i += 1
        idx = ast.nodes(idx).nextSibling
    Loop
    Return AST_NULL
End Function

Function UXBAstInterpChildByRole(ByRef ast As ASTPool, ByVal nodeIdx As Integer, ByVal roleName As String) As Integer
    Return ASTFirstChildByRole(ast, nodeIdx, roleName)
End Function

Function UXBAstInterpChildByKind(ByRef ast As ASTPool, ByVal nodeIdx As Integer, ByVal kindName As String) As Integer
    Return ASTFirstChildByKind(ast, nodeIdx, kindName)
End Function

Function UXBAstInterpNodeName(ByRef ast As ASTPool, ByVal nodeIdx As Integer) As String
    If nodeIdx < 0 Or nodeIdx >= ast.count Then Return ""
    If Trim(ast.nodes(nodeIdx).symbolName) <> "" Then Return ast.nodes(nodeIdx).symbolName
    Return ast.nodes(nodeIdx).value
End Function

Function UXBAstInterpFirstExprChild(ByRef ast As ASTPool, ByVal nodeIdx As Integer) As Integer
    Dim c As Integer
    c = UXBAstInterpChildByRole(ast, nodeIdx, "VALUE")
    If c <> AST_NULL Then Return c
    c = UXBAstInterpChildByRole(ast, nodeIdx, "EXPR")
    If c <> AST_NULL Then Return c
    c = UXBAstInterpChildByRole(ast, nodeIdx, "CONDITION")
    If c <> AST_NULL Then Return c
    If nodeIdx >= 0 And nodeIdx < ast.count Then
        If ast.nodes(nodeIdx).left <> AST_NULL Then Return ast.nodes(nodeIdx).left
        Return ast.nodes(nodeIdx).firstChild
    End If
    Return AST_NULL
End Function

Function UXBAstInterpServiceForCallName(ByVal callName As String) As String
    Dim n As String = UCase(Trim(callName))
    If InStr(n, ".") > 0 Then
        Dim p As Integer = InStr(n, ".")
        n = Left(n, p - 1)
    End If
    Select Case n
    Case "ABS": Return RT_MATH_ABS
    Case "SQR", "SQRT": Return RT_MATH_SQRT
    Case "SIN": Return RT_MATH_SIN
    Case "COS": Return RT_MATH_COS
    Case "LOG": Return RT_MATH_LOG
    Case "EXP": Return RT_MATH_EXP
    Case "RND": Return RT_RND
    Case "TIMER": Return RT_TIMER
    Case "LEN": Return RT_STR_LEN
    Case "LEFT", "LEFT$": Return RT_STR_LEFT
    Case "RIGHT", "RIGHT$": Return RT_STR_RIGHT
    Case "MID", "MID$": Return RT_STR_MID
    Case "UCASE", "UCASE$": Return RT_STR_TO_UPPER
    Case "LCASE", "LCASE$": Return RT_STR_TO_LOWER
    Case "TRIM", "TRIM$": Return RT_STR_TRIM
    Case "JSON": Return RT_JSON_CALL
    Case "REGEX": Return RT_REGEX_CALL
    Case "HTTP", "CURL", "FETCH": Return RT_HTTP_CALL
    Case "OS", "SHELL": Return RT_OS_CALL
    Case "LLAMA": Return RT_LLAMA_CALL
    Case "LUA": Return RT_LUA_CALL
    Case "PROLOG": Return RT_PROLOG_CALL
    Case "SQLITE": Return RT_SQLITE_CALL
    Case "CANVAS": Return RT_BROWSER_CANVAS
    Case "AUDIO": Return RT_BROWSER_AUDIO
    Case "WEBGPU": Return RT_WEBGPU_CALL
    Case "WASM_IMPORT": Return RT_WASM_IMPORT_CALL
    Case "WASM_EXPORT": Return RT_WASM_EXPORT_CALL
    Case "BIGF", "BIGD", "BALL", "BIGINIT", "FP80", "FP128", "EXTFP": Return RT_EXTFP_CALL
    End Select
    Return ""
End Function

Function UXBAstInterpServiceForStmtKind(ByVal kindText As String) As String
    Dim k As String = UCase(Trim(kindText))
    Select Case k
    Case ASTK_PRINT_STMT, ASTK_PRINT_ITEM: Return RT_PRINT
    Case ASTK_INPUT_STMT: Return RT_INPUT
    Case ASTK_CLS_STMT: Return RT_CLS
    Case ASTK_COLOR_STMT: Return RT_COLOR
    Case ASTK_LOCATE_STMT: Return RT_LOCATE
    Case ASTK_RANDOMIZE_STMT: Return RT_RANDOMIZE
    Case ASTK_OPEN_STMT: Return RT_FILE_OPEN
    Case ASTK_CLOSE_STMT: Return RT_FILE_CLOSE
    Case ASTK_GET_STMT, ASTK_INPUT_FILE_STMT, ASTK_INPUTF_STMT: Return RT_FILE_READ
    Case ASTK_PUT_STMT: Return RT_FILE_WRITE
    Case ASTK_SEEK_STMT: Return RT_FILE_SEEK
    Case ASTK_DELETE_STMT: Return RT_FILE_DELETE
    Case ASTK_POKEB_STMT, ASTK_POKEW_STMT, ASTK_POKED_STMT, ASTK_POKES_STMT: Return RT_POKE
    Case ASTK_MEMCOPYB_STMT, ASTK_MEMCOPYW_STMT, ASTK_MEMCOPYD_STMT: Return RT_MEM_COPY
    Case ASTK_MEMFILLB_STMT, ASTK_MEMFILLW_STMT, ASTK_MEMFILLD_STMT: Return RT_MEM_FILL
    Case ASTK_SETNEWOFFSET_STMT: Return RT_MEM_STORE
    Case ASTK_INLINE_STMT: Return RT_INLINE_NATIVE
    End Select
    Return ""
End Function

Function UXBAstInterpJsonEscape(ByVal rawText As String) As String
    Dim outText As String = ""
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim ch As String = Mid(rawText, i, 1)
        Select Case ch
        Case Chr(34): outText &= "\" & Chr(34)
        Case "\": outText &= "\\"
        Case Chr(13): outText &= "\r"
        Case Chr(10): outText &= "\n"
        Case Chr(9): outText &= "\t"
        Case Else: outText &= ch
        End Select
    Next i
    Return outText
End Function

#endif
