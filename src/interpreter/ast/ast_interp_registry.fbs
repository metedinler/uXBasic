#ifndef UXB_AST_INTERP_REGISTRY_FBS
#define UXB_AST_INTERP_REGISTRY_FBS

#include once "../../parser/ast_node_kinds.fbs"
#include once "../../parser/ast_contract_layer_bindings.fbs"

Const AST_EXEC_IMPLEMENTED As String = "AST_EXEC_IMPLEMENTED"
Const AST_EXEC_RUNTIME_CALL As String = "AST_EXEC_RUNTIME_CALL"
Const AST_EXEC_NATIVE_ONLY As String = "AST_EXEC_NATIVE_ONLY"
Const AST_EXEC_JS_ONLY As String = "AST_EXEC_JS_ONLY"
Const AST_EXEC_BROWSER_ONLY As String = "AST_EXEC_BROWSER_ONLY"
Const AST_EXEC_WASM_UNSUPPORTED As String = "AST_EXEC_WASM_UNSUPPORTED"
Const AST_EXEC_COMPILE_TIME_ONLY As String = "AST_EXEC_COMPILE_TIME_ONLY"
Const AST_EXEC_DIAGNOSTIC_ONLY As String = "AST_EXEC_DIAGNOSTIC_ONLY"
Const AST_EXEC_RESERVED As String = "AST_EXEC_RESERVED"
Const AST_EXEC_REMOVED As String = "AST_EXEC_REMOVED"
Const AST_EXEC_MISSING As String = "AST_EXEC_MISSING"
Const AST_EXEC_BROKEN As String = "AST_EXEC_BROKEN"

Function UXBAstInterpDecisionForNode(ByVal nodeKind As String) As String
    Dim n As String = UCase(Trim(nodeKind))
    If UXBAstContractIsNativeOnlyNode(n) <> 0 Then Return AST_EXEC_NATIVE_ONLY
    If UXBAstContractIsCompileTimeNode(n) <> 0 Then Return AST_EXEC_COMPILE_TIME_ONLY
    If UXBAstContractIsRuntimeServiceNode(n) <> 0 Then Return AST_EXEC_RUNTIME_CALL
    If UXBAstContractIsExpressionNode(n) <> 0 Then Return AST_EXEC_IMPLEMENTED
    If UXBAstContractIsControlNode(n) <> 0 Then Return AST_EXEC_IMPLEMENTED
    If UXBAstContractIsErrorNode(n) <> 0 Then Return AST_EXEC_IMPLEMENTED
    If UXBAstContractIsTypeOrObjectNode(n) <> 0 Then Return AST_EXEC_IMPLEMENTED
    Select Case n
    Case ASTK_PROGRAM, ASTK_BLOCK, ASTK_DIM_STMT, ASTK_DIM_DECL, ASTK_REDIM_STMT, ASTK_REDIM_DECL, ASTK_ASSIGN_STMT, ASTK_EXPR_STMT, ASTK_CALL_STMT, ASTK_RETURN_STMT, ASTK_END_STMT
        Return AST_EXEC_IMPLEMENTED
    End Select
    Return AST_EXEC_MISSING
End Function

Function UXBAstInterpHandlerForNode(ByVal nodeKind As String) As String
    Dim n As String = UCase(Trim(nodeKind))
    If UXBAstContractIsExpressionNode(n) <> 0 Then Return "UXBAstInterpEvalExpr"
    If UXBAstContractIsControlNode(n) <> 0 Then Return "UXBAstInterpExecControl"
    If UXBAstContractIsFileNode(n) <> 0 Then Return "UXBAstInterpExecFile"
    If UXBAstContractIsMemoryNode(n) <> 0 Then Return "UXBAstInterpExecMemory"
    If UXBAstContractIsTypeOrObjectNode(n) <> 0 Then Return "UXBAstInterpExecTypeClass"
    If UXBAstContractIsRuntimeServiceNode(n) <> 0 Then Return "UXBAstInterpExecRuntimeStmt"
    Select Case n
    Case ASTK_PROGRAM, ASTK_BLOCK, ASTK_DIM_STMT, ASTK_DIM_DECL, ASTK_REDIM_STMT, ASTK_REDIM_DECL, ASTK_ASSIGN_STMT, ASTK_EXPR_STMT, ASTK_CALL_STMT, ASTK_RETURN_STMT, ASTK_END_STMT
        Return "UXBAstInterpExecStmt"
    End Select
    Return "UXBAstInterpFailClosed"
End Function

#endif
