#ifndef UXB_AST_INTERP_TYPE_CLASS_FBS
#define UXB_AST_INTERP_TYPE_CLASS_FBS

#include once "../../parser/ast.fbs"
#include once "../common/interp_context.fbs"
#include once "ast_interp_expr.fbs"

Function UXBAstInterpExecTypeClass(ByRef ast As ASTPool, ByVal nodeIdx As Integer, ByRef ctx As UXBInterpContext) As UXBInterpValue
    If nodeIdx < 0 Or nodeIdx >= ast.count Then Return UXBInterpValueVoid()
    Dim n As ASTNode = ast.nodes(nodeIdx)
    Select Case UCase(Trim(n.kind))
    Case ASTK_CLASS_STMT, ASTK_TYPE_STMT, ASTK_INTERFACE_STMT, ASTK_CLASS_FIELD, ASTK_TYPE_FIELD, ASTK_CLASS_METHOD_DECL, ASTK_INTERFACE_METHOD_DECL, ASTK_CLASS_PROPERTY_DECL, ASTK_CLASS_OPERATOR_DECL, ASTK_CLASS_CONSTRUCTOR_DECL, ASTK_CLASS_DESTRUCTOR_DECL
        If Trim(n.value) <> "" And (UCase(Trim(n.kind)) = ASTK_CLASS_METHOD_DECL Or UCase(Trim(n.kind)) = ASTK_INTERFACE_METHOD_DECL) Then UXBInterpContextRegisterRoutine ctx, n.value, n.kind, nodeIdx
        Return UXBInterpValueVoid()
    Case ASTK_NEW_EXPR
        Dim typeName As String = n.typeName
        If typeName = "" Then typeName = n.value
        Dim id As Integer = UXBInterpHeapAlloc(ctx.heap, "OBJECT", typeName)
        Return UXBInterpValueHandle("OBJECT", id)
    Case ASTK_FIELD_EXPR, ASTK_MEMBER_EXPR
        Return UXBAstInterpEvalExpr(ast, nodeIdx, ctx)
    Case ASTK_INDEX_EXPR
        Return UXBAstInterpEvalExpr(ast, nodeIdx, ctx)
    End Select
    Return UXBInterpValueVoid()
End Function

#endif
