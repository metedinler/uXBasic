#ifndef UXB_AST_INTERP_FILE_FBS
#define UXB_AST_INTERP_FILE_FBS

#include once "../../parser/ast.fbs"
#include once "../common/interp_context.fbs"
#include once "../../runtime/runtime_service_dispatch.fbs"
#include once "ast_interp_helpers.fbs"
#include once "ast_interp_expr.fbs"

Function UXBAstInterpExecFile(ByRef ast As ASTPool, ByVal nodeIdx As Integer, ByRef ctx As UXBInterpContext) As UXBInterpValue
    Dim n As ASTNode = ast.nodes(nodeIdx)
    Dim sid As String = UXBAstInterpServiceForStmtKind(n.kind)
    If sid = "" Then Return UXBInterpValueError(UXB_INTERP_ERR_NODE_NOT_EXECUTABLE, "file AST node not executable: " & n.kind)
    Dim args As UXBRuntimeArgList
    UXBRuntimeArgListInit args
    If n.value <> "" And n.firstChild = AST_NULL Then UXBRuntimeArgListAdd args, UXBInterpValueString(n.value)
    Dim ch As Integer = n.firstChild
    Do While ch <> AST_NULL
        Dim av As UXBInterpValue = UXBAstInterpEvalExpr(ast, ch, ctx)
        If UXBInterpIsError(av) <> 0 Then Return av
        UXBRuntimeArgListAdd args, av
        ch = ast.nodes(ch).nextSibling
    Loop
    Dim res As UXBInterpValue = UXBRuntimeDispatch(ctx.runtime, sid, args)
    UXBInterpContextSyncRuntime ctx
    Return res
End Function

#endif
