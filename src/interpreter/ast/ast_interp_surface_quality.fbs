#ifndef UXB_AST_INTERP_SURFACE_QUALITY_FBS
#define UXB_AST_INTERP_SURFACE_QUALITY_FBS

#include once "../../parser/ast.fbs"
#include once "../../parser/ast_contract_layer_bindings.fbs"
#include once "ast_interp_registry.fbs"
#include once "ast_interp_helpers.fbs"
#include once "../../runtime/runtime_service_registry.fbs"

Function UXBAstInterpValidateNodeSurface(ByRef ast As ASTPool, ByVal nodeIdx As Integer, ByRef errText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ast.count Then errText = "ast interpreter: node index out of range": Return 0
    Dim k As String = UCase(Trim(ast.nodes(nodeIdx).kind))
    If k = "" Then errText = "ast interpreter: empty node kind": Return 0
    Dim decision As String = UXBAstInterpDecisionForNode(k)
    Select Case decision
    Case AST_EXEC_MISSING, AST_EXEC_BROKEN
        errText = "ast interpreter: node has no execution decision: " & k
        Return 0
    Case AST_EXEC_NATIVE_ONLY
        errText = "ast interpreter: native-only node cannot run in AST interpreter: " & k
        Return 0
    Case AST_EXEC_DIAGNOSTIC_ONLY, AST_EXEC_RESERVED, AST_EXEC_REMOVED
        errText = "ast interpreter: non-executable node reached runtime: " & k
        Return 0
    End Select
    If UXBAstContractIsRuntimeServiceNode(k) <> 0 Then
        Dim sid As String = UXBAstInterpServiceForStmtKind(k)
        If sid <> "" Then
            If UXBRuntimeServiceKnown(sid) = 0 Then errText = "ast interpreter: runtime service not registered for " & k & ": " & sid: Return 0
        End If
    End If
    errText = ""
    Return 1
End Function

Function UXBAstInterpValidateTreeSurface(ByRef ast As ASTPool, ByVal rootIdx As Integer, ByRef errText As String) As Integer
    If rootIdx < 0 Or rootIdx >= ast.count Then errText = "ast interpreter: root out of range": Return 0
    Dim i As Integer
    For i = 0 To ast.count - 1
        If UXBAstInterpValidateNodeSurface(ast, i, errText) = 0 Then Return 0
    Next i
    errText = ""
    Return 1
End Function

#endif
