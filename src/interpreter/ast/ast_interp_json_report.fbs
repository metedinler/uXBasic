#ifndef UXB_AST_INTERP_JSON_REPORT_FBS
#define UXB_AST_INTERP_JSON_REPORT_FBS

#include once "../common/interp_result.fbs"
#include once "../trace/interp_trace_json.fbs"
#include once "ast_interp_helpers.fbs"

Function UXBAstInterpResultToJson(ByRef resultValue As UXBInterpResult) As String
    Return UXBInterpResultToJson(resultValue, "AST_INTERPRETER")
End Function

Function UXBAstInterpFullJson(ByRef resultValue As UXBInterpResult, ByRef traceValue As UXBInterpTraceBuffer) As String
    Dim q As String = Chr(34)
    Dim j As String = "{" & Chr(10)
    j &= "  " & q & "layer" & q & ":" & q & "AST_INTERPRETER" & q & "," & Chr(10)
    j &= "  " & q & "result" & q & ":" & UXBInterpResultToJson(resultValue, "AST_INTERPRETER") & "," & Chr(10)
    j &= "  " & q & "trace" & q & ":" & UXBInterpTraceToJson(traceValue) & Chr(10)
    j &= "}"
    Return j
End Function

#endif
