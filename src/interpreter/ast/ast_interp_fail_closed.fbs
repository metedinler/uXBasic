#ifndef UXB_AST_INTERP_FAIL_CLOSED_FBS
#define UXB_AST_INTERP_FAIL_CLOSED_FBS

#include once "../common/interp_context.fbs"
#include once "ast_interp_registry.fbs"

Function UXBAstInterpFailClosed(ByRef ctx As UXBInterpContext, ByVal nodeKind As String, ByVal decisionText As String) As UXBInterpValue
    Select Case UCase(Trim(decisionText))
    Case AST_EXEC_NATIVE_ONLY
        Return UXBInterpValueError(UXB_INTERP_ERR_NATIVE_ONLY, "AST node requires native backend: " & nodeKind)
    Case AST_EXEC_WASM_UNSUPPORTED
        Return UXBInterpValueError(UXB_INTERP_ERR_WASM_UNSUPPORTED, "AST node is not supported in WASM interpreter: " & nodeKind)
    Case AST_EXEC_DIAGNOSTIC_ONLY
        Return UXBInterpValueError(UXB_INTERP_ERR_DIAGNOSTIC_ONLY, "AST node is diagnostic-only: " & nodeKind)
    Case AST_EXEC_RESERVED
        Return UXBInterpValueError(UXB_INTERP_ERR_RESERVED_NODE, "AST node is reserved: " & nodeKind)
    End Select
    Return UXBInterpValueError(UXB_INTERP_ERR_NODE_NOT_EXECUTABLE, "AST node has no interpreter path: " & nodeKind)
End Function

#endif
