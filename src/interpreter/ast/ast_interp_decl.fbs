#ifndef UXB_AST_INTERP_DECL_FBS
#define UXB_AST_INTERP_DECL_FBS

#include once "../../parser/ast.fbs"
#include once "../common/interp_context.fbs"
#include once "ast_interp_expr.fbs"

Function UXBAstInterpExecDecl(ByRef ast As ASTPool, ByVal nodeIdx As Integer, ByRef ctx As UXBInterpContext) As UXBInterpValue
    If nodeIdx < 0 Or nodeIdx >= ast.count Then Return UXBInterpValueVoid()
    Dim n As ASTNode = ast.nodes(nodeIdx)
    Select Case UCase(Trim(n.kind))
    Case ASTK_SUB_STMT, ASTK_FUNCTION_STMT, ASTK_EVENT_STMT, ASTK_PIPE_STMT, ASTK_THREAD_STMT, ASTK_PARALEL_STMT, ASTK_CLASS_METHOD_DECL, ASTK_INTERFACE_METHOD_DECL, ASTK_DECLARE_SUB_STMT, ASTK_DECLARE_FUNCTION_STMT
        If Trim(n.value) <> "" Then UXBInterpContextRegisterRoutine ctx, n.value, n.kind, nodeIdx
        Return UXBInterpValueVoid()
    Case ASTK_DIM_DECL, ASTK_CONST_DECL, ASTK_PARAM_DECL, ASTK_REDIM_DECL
        Dim initValue As UXBInterpValue = UXBInterpValueDefaultForType(n.typeName)
        Dim initIdx As Integer = n.firstChild
        If initIdx <> AST_NULL Then initValue = UXBAstInterpEvalExpr(ast, initIdx, ctx)
        If UXBInterpIsError(initValue) <> 0 Then Return initValue
        If UCase(Trim(n.kind)) = ASTK_CONST_DECL Then
            UXBInterpContextSetGlobal ctx, n.value, initValue, n.typeName, 1
        Else
            UXBInterpContextSetSymbol ctx, n.value, initValue, n.typeName
        End If
        If ctx.lastErrorCode <> 0 Then Return UXBInterpValueError(ctx.lastErrorCode, ctx.lastError)
        Return UXBInterpValueVoid()
    Case ASTK_DIM_STMT, ASTK_CONST_STMT, ASTK_REDIM_STMT
        Dim ch As Integer = n.firstChild
        Do While ch <> AST_NULL
            Dim vr As UXBInterpValue = UXBAstInterpExecDecl(ast, ch, ctx)
            If UXBInterpIsError(vr) <> 0 Then Return vr
            ch = ast.nodes(ch).nextSibling
        Loop
        Return UXBInterpValueVoid()
    End Select
    Return UXBInterpValueVoid()
End Function

#endif
