#ifndef UXB_ARTIFACTS_EXE_ARTIFACT_MANIFEST_FBS
#define UXB_ARTIFACTS_EXE_ARTIFACT_MANIFEST_FBS

#include once "../common/artifact_standard.fbs"

Type UXBExeArtifactManifest
    sourceFile As String
    asmPath As String
    objPath As String
    exePath As String
    nasmCommand As String
    freebasicCommand As String
    linkScriptPath As String
    linkRspPath As String
    buildProgramScriptPath As String
    buildAllScriptPath As String
    target As String
    backendRoute As String
    status As String
    diagnostics As String
End Type

Sub UXBExeArtifactManifestInit(ByRef m As UXBExeArtifactManifest)
    m.sourceFile = ""
    m.asmPath = ""
    m.objPath = ""
    m.exePath = ""
    m.nasmCommand = ""
    m.freebasicCommand = ""
    m.linkScriptPath = ""
    m.linkRspPath = ""
    m.buildProgramScriptPath = ""
    m.buildAllScriptPath = ""
    m.target = ""
    m.backendRoute = ""
    m.status = ""
    m.diagnostics = ""
End Sub

Private Function UXBExeArtifactManifestPayload(ByRef m As UXBExeArtifactManifest) As String
    Dim q As String
    q = Chr(34)
    Dim p As String
    p = ""
    p &= q & "source_file" & q & ":" & q & UXBJsonEscape(m.sourceFile) & q & ","
    p &= q & "asmPath" & q & ":" & q & UXBJsonEscape(m.asmPath) & q & ","
    p &= q & "asm_path" & q & ":" & q & UXBJsonEscape(m.asmPath) & q & ","
    p &= q & "objPath" & q & ":" & q & UXBJsonEscape(m.objPath) & q & ","
    p &= q & "object_path" & q & ":" & q & UXBJsonEscape(m.objPath) & q & ","
    p &= q & "exePath" & q & ":" & q & UXBJsonEscape(m.exePath) & q & ","
    p &= q & "exe_path" & q & ":" & q & UXBJsonEscape(m.exePath) & q & ","
    p &= q & "nasmCommand" & q & ":" & q & UXBJsonEscape(m.nasmCommand) & q & ","
    p &= q & "nasm_command" & q & ":" & q & UXBJsonEscape(m.nasmCommand) & q & ","
    p &= q & "freebasicCommand" & q & ":" & q & UXBJsonEscape(m.freebasicCommand) & q & ","
    p &= q & "freebasic_command" & q & ":" & q & UXBJsonEscape(m.freebasicCommand) & q & ","
    p &= q & "linkScriptPath" & q & ":" & q & UXBJsonEscape(m.linkScriptPath) & q & ","
    p &= q & "link_program_bat" & q & ":" & q & UXBJsonEscape(m.linkScriptPath) & q & ","
    p &= q & "linkRspPath" & q & ":" & q & UXBJsonEscape(m.linkRspPath) & q & ","
    p &= q & "link_rsp" & q & ":" & q & UXBJsonEscape(m.linkRspPath) & q & ","
    p &= q & "build_program_bat" & q & ":" & q & UXBJsonEscape(m.buildProgramScriptPath) & q & ","
    p &= q & "build_all_bat" & q & ":" & q & UXBJsonEscape(m.buildAllScriptPath) & q & ","
    p &= q & "target" & q & ":" & q & UXBJsonEscape(m.target) & q & ","
    p &= q & "backendRoute" & q & ":" & q & UXBJsonEscape(m.backendRoute) & q & ","
    p &= q & "backend_route" & q & ":" & q & UXBJsonEscape(m.backendRoute) & q & ","
    p &= q & "status" & q & ":" & q & UXBJsonEscape(m.status) & q & ","
    p &= q & "diagnostics" & q & ":" & q & UXBJsonEscape(m.diagnostics) & q
    Return p
End Function

Function UXBWriteExeArtifactManifest(ByRef outPath As String, ByRef runId As String, ByRef sourceText As String, ByRef m As UXBExeArtifactManifest, ByRef errText As String) As Integer
    Dim payload As String
    payload = UXBExeArtifactManifestPayload(m)
    Return UXBArtifactWriteStandardJson(outPath, runId, sourceText, "EXE_ARTIFACT_MANIFEST", m.status, 0, payload, errText)
End Function

#endif
