#ifndef UXB_MAIN_BACKEND_CLOSE_GATE_ADIM27_FBS
#define UXB_MAIN_BACKEND_CLOSE_GATE_ADIM27_FBS

#include once "semantic/ast_mir_coverage_gate_adim25.fbs"
#include once "backend/backend_web_coverage_gate_adim26.fbs"
#include once "cli/cli_backend_route_close_adim27.fbs"

' Bu bağlayıcı main_program_entry.fbs içinden çağrılmak için tasarlanmıştır.
' Üç hedefi tek noktadan doğrular ama işleri tek modüle yığmaz:
'   ADIM25: AST -> MIR coverage
'   ADIM26: MIR -> JS/WAT/WASM/BROWSER opcode coverage
'   ADIM27: CLI 3 harfli route kapanışı

Type UXBMainCloseGateResultAdim27
    ok As Integer
    astMirOk As Integer
    webOk As Integer
    cliOk As Integer
    errorsText As String
End Type

Sub UXBMainCloseGateResultInitAdim27(ByRef r As UXBMainCloseGateResultAdim27)
    r.ok = 1
    r.astMirOk = 1
    r.webOk = 1
    r.cliOk = 1
    r.errorsText = ""
End Sub

Private Sub UXBMainCloseGateAppendErrorAdim27(ByRef r As UXBMainCloseGateResultAdim27, ByRef msgText As String)
    If Trim(msgText) = "" Then Exit Sub
    If Trim(r.errorsText) <> "" Then r.errorsText &= Chr(10)
    r.errorsText &= msgText
    r.ok = 0
End Sub

Function UXBMainRunAstMirWebCliCloseGatesAdim27( _
    ByRef ps As ParseState, _
    ByRef m As MIRModule, _
    ByVal mirReady As Integer, _
    ByRef webTargetText As String, _
    ByVal webRequested As Integer, _
    ByRef resultValue As UXBMainCloseGateResultAdim27, _
    ByRef reportRootText As String = "" _
) As Integer
    Dim errText As String
    Dim okValue As Integer

    UXBMainCloseGateResultInitAdim27 resultValue

    Dim reportRoot As String
    reportRoot = Trim(reportRootText)
    If reportRoot = "" Then reportRoot = "reports\control\current"

    okValue = UXBAstMirCoverageGateAdim25(ps.ast, ps.rootNode, m, mirReady, _
        reportRoot & "/adim25_ast_mir_coverage.csv", _
        reportRoot & "/adim25_ast_mir_coverage.json", errText)
    If okValue = 0 Then
        resultValue.astMirOk = 0
        UXBMainCloseGateAppendErrorAdim27 resultValue, errText
    End If

    If webRequested <> 0 Then
        okValue = UXBBackendWebCoverageGateAdim26(m, webTargetText, _
            reportRoot & "/adim26_" & UXBBackendNormalizeTarget(webTargetText) & "_opcode_coverage.csv", errText)
        If okValue = 0 Then
            resultValue.webOk = 0
            UXBMainCloseGateAppendErrorAdim27 resultValue, errText
        End If
    End If

    okValue = UXBAdim27CliRouteCloseGate(gUXBCli, reportRoot & "/adim27_cli_route_close.csv", errText)
    If okValue = 0 Then
        resultValue.cliOk = 0
        UXBMainCloseGateAppendErrorAdim27 resultValue, errText
    End If

    Return resultValue.ok
End Function

#endif
