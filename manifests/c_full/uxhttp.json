{
  "name": "uxhttp",
  "namespace": "curl",
  "package": "mingw-w64-ucrt-x86_64-curl-winssl",
  "pkg_config": "libcurl",
  "headers": [
    "curl/curl.h"
  ],
  "function_patterns": [
    "^curl_"
  ],
  "constant_patterns": [
    "^CURL",
    "^LIBCURL_"
  ],
  "dll_globs": [
    "libcurl-*.dll",
    "libcurl.dll"
  ],
  "exclude_function_patterns": [],
  "engine": "libcurl",
  "license": "curl/MIT",
  "homepage": "https://curl.se/libcurl/"
}
