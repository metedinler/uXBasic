{
  "name": "uxregex",
  "namespace": "pcre2",
  "package": "mingw-w64-ucrt-x86_64-pcre2",
  "pkg_config": "libpcre2-8",
  "headers": [
    "pcre2.h"
  ],
  "defines": [
    "PCRE2_CODE_UNIT_WIDTH=8"
  ],
  "function_patterns": [
    "^pcre2_"
  ],
  "constant_patterns": [
    "^PCRE2_"
  ],
  "dll_globs": [
    "libpcre2-8-*.dll",
    "libpcre2-8.dll"
  ],
  "exclude_function_patterns": [
    "_16$",
    "_32$"
  ],
  "engine": "PCRE2",
  "license": "BSD-3-Clause",
  "homepage": "https://www.pcre.org/"
}
