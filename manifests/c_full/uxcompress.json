{
  "name": "uxcompress",
  "namespace": "zstd",
  "package": "mingw-w64-ucrt-x86_64-zstd",
  "pkg_config": "libzstd",
  "headers": [
    "zstd.h",
    "zdict.h",
    "zstd_errors.h"
  ],
  "function_patterns": [
    "^ZSTD_",
    "^ZDICT_"
  ],
  "constant_patterns": [
    "^ZSTD_",
    "^ZDICT_"
  ],
  "dll_globs": [
    "libzstd.dll",
    "libzstd-*.dll"
  ],
  "exclude_function_patterns": [],
  "experimental_defines": [
    "ZSTD_STATIC_LINKING_ONLY"
  ],
  "engine": "Zstandard",
  "license": "BSD-3-Clause OR GPL-2.0-or-later",
  "homepage": "https://facebook.github.io/zstd/"
}
