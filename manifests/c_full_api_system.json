{
  "schema": "uxb.c.full_api.system.v1",
  "profile": "stable",
  "security": {
    "provider": "MSYS2 UCRT64 official repositories",
    "allow_random_dll_downloads": false,
    "verify_with": [
      "pacman -Qkk",
      "PE32+ x64 audit",
      "SHA256 runtime manifest"
    ]
  },
  "tool_packages": [
    "mingw-w64-ucrt-x86_64-gcc",
    "mingw-w64-ucrt-x86_64-clang",
    "mingw-w64-ucrt-x86_64-libffi",
    "mingw-w64-ucrt-x86_64-pkgconf"
  ],
  "libraries": [
    {
      "name": "uxsqlite",
      "namespace": "sqlite3",
      "package": "mingw-w64-ucrt-x86_64-sqlite3",
      "pkg_config": "sqlite3",
      "headers": [
        "sqlite3.h"
      ],
      "function_patterns": [
        "^sqlite3_"
      ],
      "constant_patterns": [
        "^SQLITE_"
      ],
      "dll_globs": [
        "libsqlite3-*.dll",
        "sqlite3.dll"
      ],
      "exclude_function_patterns": [],
      "engine": "SQLite",
      "license": "Public-Domain",
      "homepage": "https://sqlite.org/"
    },
    {
      "name": "uxhttp",
      "namespace": "curl",
      "package": "mingw-w64-ucrt-x86_64-curl-winssl",
      "pkg_config": "libcurl",
      "headers": [
        "curl/curl.h"
      ],
      "function_patterns": [
        "^curl_"
      ],
      "constant_patterns": [
        "^CURL",
        "^LIBCURL_"
      ],
      "dll_globs": [
        "libcurl-*.dll",
        "libcurl.dll"
      ],
      "exclude_function_patterns": [],
      "engine": "libcurl",
      "license": "curl/MIT",
      "homepage": "https://curl.se/libcurl/"
    },
    {
      "name": "uxjson",
      "namespace": "jsonc",
      "package": "mingw-w64-ucrt-x86_64-json-c",
      "pkg_config": "json-c",
      "headers": [
        "json-c/json.h"
      ],
      "function_patterns": [
        "^json_"
      ],
      "constant_patterns": [
        "^JSON_"
      ],
      "dll_globs": [
        "libjson-c-*.dll",
        "libjson-c.dll"
      ],
      "exclude_function_patterns": [],
      "engine": "json-c",
      "license": "MIT",
      "homepage": "https://github.com/json-c/json-c"
    },
    {
      "name": "uxregex",
      "namespace": "pcre2",
      "package": "mingw-w64-ucrt-x86_64-pcre2",
      "pkg_config": "libpcre2-8",
      "headers": [
        "pcre2.h"
      ],
      "defines": [
        "PCRE2_CODE_UNIT_WIDTH=8"
      ],
      "function_patterns": [
        "^pcre2_"
      ],
      "constant_patterns": [
        "^PCRE2_"
      ],
      "dll_globs": [
        "libpcre2-8-*.dll",
        "libpcre2-8.dll"
      ],
      "exclude_function_patterns": [
        "_16$",
        "_32$"
      ],
      "engine": "PCRE2",
      "license": "BSD-3-Clause",
      "homepage": "https://www.pcre.org/"
    },
    {
      "name": "uxcompress",
      "namespace": "zstd",
      "package": "mingw-w64-ucrt-x86_64-zstd",
      "pkg_config": "libzstd",
      "headers": [
        "zstd.h",
        "zdict.h",
        "zstd_errors.h"
      ],
      "function_patterns": [
        "^ZSTD_",
        "^ZDICT_"
      ],
      "constant_patterns": [
        "^ZSTD_",
        "^ZDICT_"
      ],
      "dll_globs": [
        "libzstd.dll",
        "libzstd-*.dll"
      ],
      "exclude_function_patterns": [],
      "experimental_defines": [
        "ZSTD_STATIC_LINKING_ONLY"
      ],
      "engine": "Zstandard",
      "license": "BSD-3-Clause OR GPL-2.0-or-later",
      "homepage": "https://facebook.github.io/zstd/"
    },
    {
      "name": "uxarchive",
      "namespace": "archive",
      "package": "mingw-w64-ucrt-x86_64-libarchive",
      "pkg_config": "libarchive",
      "headers": [
        "archive.h",
        "archive_entry.h"
      ],
      "function_patterns": [
        "^archive_"
      ],
      "constant_patterns": [
        "^ARCHIVE_"
      ],
      "dll_globs": [
        "libarchive-*.dll",
        "libarchive.dll"
      ],
      "exclude_function_patterns": [],
      "engine": "libarchive",
      "license": "BSD-2-Clause",
      "homepage": "https://www.libarchive.org/"
    },
    {
      "name": "uxcrypto",
      "namespace": "sodium",
      "package": "mingw-w64-ucrt-x86_64-libsodium",
      "pkg_config": "libsodium",
      "headers": [
        "sodium.h"
      ],
      "function_patterns": [
        "^sodium_",
        "^crypto_",
        "^randombytes_"
      ],
      "constant_patterns": [
        "^sodium_",
        "^crypto_",
        "^randombytes_"
      ],
      "dll_globs": [
        "libsodium-*.dll",
        "libsodium.dll"
      ],
      "exclude_function_patterns": [],
      "engine": "libsodium",
      "license": "ISC",
      "homepage": "https://libsodium.org/"
    }
  ]
}
