# Keyword alias overlay in built-in ALIAS command syntax
# canonical form recommendation: ALIAS <alias> AS <canonical>

ALIAS PARALLEL AS PARALEL
ALIAS SIHIRLIMETHOD AS SIHIRLIMETOT
ALIAS THREAT AS THREAD
ALIAS EGER AS IF
ALIAS DEGILSE AS ELSE
ALIAS YOKSA AS ELSE
ALIAS SON AS END
ALIAS YAZDIR AS PRINT
ALIAS DONGU AS LOOP
ALIAS KADAR AS UNTIL
ALIAS FONKSIYON AS FUNCTION
ALIAS ALTYORDAM AS SUB
ALIAS GIRIS AS INPUT
ALIAS CIKIS AS EXIT
