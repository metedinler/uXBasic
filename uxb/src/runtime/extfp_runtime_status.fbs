#ifndef UXB_EXTFP_RUNTIME_STATUS_FBS
#define UXB_EXTFP_RUNTIME_STATUS_FBS

Type UXBExtFpRuntimeStatus
    enabled As Integer
    strictMode As Integer
    diagnosticsEnabled As Integer

    runtimeDir As String

    fp80DllPath As String
    fp128DllPath As String

    fp80DllExists As Integer
    fp128DllExists As Integer

    fp80Available As Integer
    fp128Available As Integer

    messageText As String
End Type

Sub UXBExtFpRuntimeStatusInit(ByRef s As UXBExtFpRuntimeStatus)
    s.enabled = 0
    s.strictMode = 0
    s.diagnosticsEnabled = 0

    s.runtimeDir = "uxb\\dist\\runtime_ext"

    s.fp80DllPath = ""
    s.fp128DllPath = ""

    s.fp80DllExists = 0
    s.fp128DllExists = 0

    s.fp80Available = 0
    s.fp128Available = 0

    s.messageText = ""
End Sub

Sub UXBExtFpRuntimeProbe(ByRef s As UXBExtFpRuntimeStatus)
    If Trim(s.runtimeDir) = "" Then
        s.runtimeDir = "uxb\\dist\\runtime_ext"
    End If

    s.fp80DllPath = s.runtimeDir & "\\uxb_fp80.dll"
    s.fp128DllPath = s.runtimeDir & "\\uxb_fp128.dll"

    s.fp80DllExists = 0
    s.fp128DllExists = 0

    If Dir(s.fp80DllPath) <> "" Then s.fp80DllExists = 1
    If Dir(s.fp128DllPath) <> "" Then s.fp128DllExists = 1

    s.fp80Available = s.fp80DllExists
    s.fp128Available = s.fp128DllExists

    s.messageText = ""
    If s.fp80Available = 0 Then
        s.messageText &= "F80 runtime DLL missing: " & s.fp80DllPath & Chr(10)
    End If

    If s.fp128Available = 0 Then
        s.messageText &= "F128 runtime DLL missing: " & s.fp128DllPath & Chr(10)
    End If
End Sub

Function UXBExtFpRuntimeAvailableForType(ByRef s As UXBExtFpRuntimeStatus, ByRef typeName As String) As Integer
    Dim As String t
    t = UXBExtFpBaseType(typeName)

    Select Case t
    Case "F80", "EXTENDED", "EXT"
        Return s.fp80Available
    Case "F128", "FLOAT128", "QUAD"
        Return s.fp128Available
    Case Else
        Return 0
    End Select
End Function

Function UXBExtFpRuntimeStatusJsonEscape(ByRef rawText As String) As String
    Dim As String outText
    outText = ""

    Dim As Integer i
    For i = 1 To Len(rawText)
        Dim As Integer c
        c = Asc(Mid(rawText, i, 1))

        Select Case c
        Case 34
            outText &= Chr(92) & Chr(34)
        Case 92
            outText &= Chr(92) & Chr(92)
        Case 13
            outText &= Chr(92) & "r"
        Case 10
            outText &= Chr(92) & "n"
        Case 9
            outText &= Chr(92) & "t"
        Case Else
            If c < 32 Then
                outText &= " "
            Else
                outText &= Chr(c)
            End If
        End Select
    Next i

    Return outText
End Function

Function UXBExtFpWritePolicyJson(ByRef s As UXBExtFpRuntimeStatus, ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""

    Dim As String j
    Dim As String q
    j = ""
    q = Chr(34)

    j &= "{"
    j &= q & "schema_version" & q & ":" & q & "uxb-extfp-policy-json-1" & q & ","
    j &= q & "producer" & q & ":" & q & "uXBasiC" & q & ","
    j &= q & "kind" & q & ":" & q & "extfp_policy" & q & ","
    j &= q & "status" & q & ":" & q & "ok" & q & ","
    j &= q & "runtime" & q & ":{"
    j &= q & "enabled" & q & ":" & IIf(s.enabled <> 0, "true", "false") & ","
    j &= q & "strict_mode" & q & ":" & IIf(s.strictMode <> 0, "true", "false") & ","
    j &= q & "runtime_dir" & q & ":" & q & UXBExtFpRuntimeStatusJsonEscape(s.runtimeDir) & q & ","
    j &= q & "fp80_dll" & q & ":" & q & UXBExtFpRuntimeStatusJsonEscape(s.fp80DllPath) & q & ","
    j &= q & "fp80_available" & q & ":" & IIf(s.fp80Available <> 0, "true", "false") & ","
    j &= q & "fp128_dll" & q & ":" & q & UXBExtFpRuntimeStatusJsonEscape(s.fp128DllPath) & q & ","
    j &= q & "fp128_available" & q & ":" & IIf(s.fp128Available <> 0, "true", "false") & ","
    j &= q & "message" & q & ":" & q & UXBExtFpRuntimeStatusJsonEscape(s.messageText) & q
    j &= "},"
    j &= q & "types" & q & ":{"
    j &= q & "F80" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_f80" & q & "," & q & "storage_bytes" & q & ":16," & q & "mode" & q & ":" & q & "external_dll" & q & "},"
    j &= q & "F128" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_f128" & q & "," & q & "storage_bytes" & q & ":16," & q & "mode" & q & ":" & q & "external_dll" & q & "},"
    j &= q & "BIGF" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_bigf" & q & "," & q & "storage_bytes" & q & ":8," & q & "mode" & q & ":" & q & "handle_policy_only" & q & "},"
    j &= q & "BIGD" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_bigd" & q & "," & q & "storage_bytes" & q & ":8," & q & "mode" & q & ":" & q & "handle_policy_only" & q & "},"
    j &= q & "BALL" & q & ":{" & q & "runtime_family" & q & ":" & q & "uxb_ball" & q & "," & q & "storage_bytes" & q & ":8," & q & "mode" & q & ":" & q & "handle_policy_only" & q & "}"
    j &= "}"
    j &= "}"

    Dim As Integer ff
    ff = FreeFile

    If Open(outPath For Output As #ff) <> 0 Then
        errText = "cannot open extfp policy json: " & outPath
        Return 0
    End If

    Print #ff, j;
    Close #ff

    Return 1
End Function

#endif
