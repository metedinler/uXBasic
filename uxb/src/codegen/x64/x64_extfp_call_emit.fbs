#ifndef UXB_X64_EXTFP_CALL_EMIT_FBS
#define UXB_X64_EXTFP_CALL_EMIT_FBS
Function UXBX64ExtFpRuntimeBinaryName(ByRef typeName As String, ByRef opName As String) As String
    Dim As String fam = UXBExternalFloatRuntimeFamily(typeName)
    Dim As String op = UCase(Trim(opName))
    If fam = "" Then Return ""
    Select Case op
    Case "ADD", "+": Return fam & "_add"
    Case "SUB", "-": Return fam & "_sub"
    Case "MUL", "*": Return fam & "_mul"
    Case "DIV", "/": Return fam & "_div"
    Case Else: Return ""
    End Select
End Function
Sub UXBX64EmitLeaArg(ByRef asmText As String, ByRef regName As String, ByRef addressExpr As String)
    asmText &= "    lea " & regName & ", " & addressExpr & Chr(10)
End Sub
Function UXBX64EmitExtFpBinaryCall(ByRef asmText As String, ByRef typeName As String, ByRef opName As String, ByRef leftAddress As String, ByRef rightAddress As String, ByRef outAddress As String, ByRef errText As String) As Integer
    errText = ""
    Dim As String fnName = UXBX64ExtFpRuntimeBinaryName(typeName, opName)
    If fnName = "" Then
        errText = "external FP runtime binary op not supported: type=" & typeName & " op=" & opName
        Return 0
    End If
    UXBX64EmitLeaArg asmText, "rcx", leftAddress
    UXBX64EmitLeaArg asmText, "rdx", rightAddress
    UXBX64EmitLeaArg asmText, "r8", outAddress
    asmText &= "    sub rsp, 32" & Chr(10)
    asmText &= "    call " & fnName & Chr(10)
    asmText &= "    add rsp, 32" & Chr(10)
    Return 1
End Function
#endif
