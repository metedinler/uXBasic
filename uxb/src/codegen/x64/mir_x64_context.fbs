#ifndef UXB_MIR_X64_CONTEXT_FBS
#define UXB_MIR_X64_CONTEXT_FBS

Type MIRX64LocalSlot
    nameText As String
    offset As Integer
    sizeBytes As Integer
    typeName As String
End Type

Type MIRX64StringLiteral
    rawText As String
    labelText As String
End Type

Type MIRX64Context
    asmText As String
    dataText As String
    externText As String
    errorText As String
    warningText As String

    labelCounter As Integer
    localCount As Integer
    locals(Any) As MIRX64LocalSlot
    stackBytes As Integer

    stringCount As Integer
    stringLiterals(Any) As MIRX64StringLiteral

    supportedInstructionCount As Integer
    unsupportedInstructionCount As Integer
End Type

Sub MIRX64Init(ByRef cg As MIRX64Context)
    cg.asmText = ""
    cg.dataText = ""
    cg.externText = ""
    cg.errorText = ""
    cg.warningText = ""
    cg.labelCounter = 0
    cg.localCount = 0
    ReDim cg.locals(0)
    cg.stackBytes = 0
    cg.stringCount = 0
    ReDim cg.stringLiterals(0)
    cg.supportedInstructionCount = 0
    cg.unsupportedInstructionCount = 0
End Sub

Sub MIRX64Emit(ByRef cg As MIRX64Context, ByRef lineText As String)
    cg.asmText &= lineText & Chr(10)
End Sub

Sub MIRX64EmitData(ByRef cg As MIRX64Context, ByRef lineText As String)
    cg.dataText &= lineText & Chr(10)
End Sub

Sub MIRX64EmitExtern(ByRef cg As MIRX64Context, ByRef lineText As String)
    cg.externText &= lineText & Chr(10)
End Sub

Sub MIRX64AddError(ByRef cg As MIRX64Context, ByRef msg As String)
    If Len(cg.errorText) > 0 Then cg.errorText &= Chr(10)
    cg.errorText &= msg
End Sub

Sub MIRX64AddWarning(ByRef cg As MIRX64Context, ByRef msg As String)
    If Len(cg.warningText) > 0 Then cg.warningText &= Chr(10)
    cg.warningText &= msg
End Sub

Function MIRX64Align16(ByVal n As Integer) As Integer
    If n Mod 16 = 0 Then Return n
    Return n + (16 - (n Mod 16))
End Function

Function MIRX64ToStr(ByVal n As Integer) As String
    Return LTrim(Str(n))
End Function

Function MIRX64NextLabel(ByRef cg As MIRX64Context, ByRef stem As String) As String
    cg.labelCounter += 1
    Return ".Lmir_" & stem & "_" & MIRX64ToStr(cg.labelCounter)
End Function

#endif
