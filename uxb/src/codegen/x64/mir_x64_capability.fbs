#ifndef UXB_MIR_X64_CAPABILITY_FBS
#define UXB_MIR_X64_CAPABILITY_FBS

Function MIRX64EmitterAvailable() As Integer
    Return 1
End Function

Function MIRX64OpcodeSupported(ByRef opcodeText As String) As Integer
    Dim op As String
    op = UCase(Trim(opcodeText))

    Select Case op
    Case "LOAD_CONST", "LOAD_VAR", "STORE_VAR"
        Return 1
    Case "ADD", "SUB", "MUL", "DIV", "MOD", "NEG"
        Return 1
    Case "EQ", "NE", "LT", "LE", "GT", "GE"
        Return 1
    Case "LABEL", "JMP", "JZ", "JNZ"
        Return 1
    Case "CALL", "RET"
        Return 1
    Case Else
        Return 0
    End Select
End Function

Function MIRX64CallTargetSupported(ByRef targetText As String) As Integer
    Dim t As String
    t = UCase(Trim(targetText))

    Select Case t
    Case "PRINT", "PRINTLN", "CONSOLE_PRINT", "CONSOLE_PRINTLN"
        Return 1
    Case "PRINT_SEP_COMMA", "PRINT_SEP_SPACE"
        Return 1
    Case Else
        Return 0
    End Select
End Function

#endif
