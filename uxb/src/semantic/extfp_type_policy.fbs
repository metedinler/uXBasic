#ifndef UXB_EXTFP_TYPE_POLICY_FBS
#define UXB_EXTFP_TYPE_POLICY_FBS
Const UXB_EXTFP_NONE = 0
Const UXB_EXTFP_F80 = 80
Const UXB_EXTFP_F128 = 128
Const UXB_EXTFP_BIGF = 1001
Const UXB_EXTFP_BIGD = 1002
Const UXB_EXTFP_BALL = 1003
Function UXBExtFpTrimType(ByRef typeName As String) As String
    Return UCase(Trim(typeName))
End Function
Function UXBExtFpBaseType(ByRef typeName As String) As String
    Dim As String t = UXBExtFpTrimType(typeName)
    Dim As Integer p = InStr(t, "(")
    If p > 0 Then t = Left(t, p - 1)
    Return Trim(t)
End Function
Function UXBExtFpPrecisionArg(ByRef typeName As String) As Integer
    Dim As String t = UXBExtFpTrimType(typeName)
    Dim As Integer p1 = InStr(t, "(")
    Dim As Integer p2 = InStr(t, ")")
    If p1 <= 0 Or p2 <= p1 Then Return 0
    Return ValInt(Mid(t, p1 + 1, p2 - p1 - 1))
End Function
Function UXBExternalFloatKind(ByRef typeName As String) As Integer
    Dim As String b = UXBExtFpBaseType(typeName)
    Select Case b
    Case "F80", "EXTENDED", "EXT": Return UXB_EXTFP_F80
    Case "F128", "FLOAT128", "QUAD": Return UXB_EXTFP_F128
    Case "BIGF", "BIGFLOAT": Return UXB_EXTFP_BIGF
    Case "BIGD", "BIGDECIMAL": Return UXB_EXTFP_BIGD
    Case "BALL": Return UXB_EXTFP_BALL
    Case Else: Return UXB_EXTFP_NONE
    End Select
End Function
Function UXBIsExternalFloatType(ByRef typeName As String) As Integer
    If UXBExternalFloatKind(typeName) <> UXB_EXTFP_NONE Then Return 1
    Return 0
End Function
Function UXBIsHighPrecisionFloatType(ByRef typeName As String) As Integer
    Select Case UXBExternalFloatKind(typeName)
    Case UXB_EXTFP_F80, UXB_EXTFP_F128, UXB_EXTFP_BIGF, UXB_EXTFP_BIGD, UXB_EXTFP_BALL: Return 1
    Case Else: Return 0
    End Select
End Function
Function UXBExternalFloatStorageBytes(ByRef typeName As String) As Integer
    Select Case UXBExternalFloatKind(typeName)
    Case UXB_EXTFP_F80: Return 16
    Case UXB_EXTFP_F128: Return 16
    Case UXB_EXTFP_BIGF, UXB_EXTFP_BIGD, UXB_EXTFP_BALL: Return 8
    Case Else: Return 0
    End Select
End Function
Function UXBExternalFloatRuntimeFamily(ByRef typeName As String) As String
    Select Case UXBExternalFloatKind(typeName)
    Case UXB_EXTFP_F80: Return "uxb_f80"
    Case UXB_EXTFP_F128: Return "uxb_f128"
    Case UXB_EXTFP_BIGF: Return "uxb_bigf"
    Case UXB_EXTFP_BIGD: Return "uxb_bigd"
    Case UXB_EXTFP_BALL: Return "uxb_ball"
    Case Else: Return ""
    End Select
End Function
Function UXBExternalFloatPrecisionBits(ByRef typeName As String) As Integer
    Dim As Integer k = UXBExternalFloatKind(typeName)
    Dim As Integer p = UXBExtFpPrecisionArg(typeName)
    Select Case k
    Case UXB_EXTFP_F80: Return 80
    Case UXB_EXTFP_F128: Return 128
    Case UXB_EXTFP_BIGF: If p > 0 Then Return p Else Return 256
    Case UXB_EXTFP_BIGD: If p > 0 Then Return p Else Return 80
    Case UXB_EXTFP_BALL: If p > 0 Then Return p Else Return 256
    Case Else: Return 0
    End Select
End Function
Function UXBIsIntegerTypeName(ByRef typeName As String) As Integer
    Dim As String t = UXBExtFpBaseType(typeName)
    Select Case t
    Case "I8","U8","I16","U16","I32","U32","I64","U64","INTEGER","LONG","ULONG","BYTE","UBYTE","SHORT","USHORT": Return 1
    Case Else: Return 0
    End Select
End Function
Function UXBNumericPromotionRank(ByRef typeName As String) As Integer
    Select Case UXBExtFpBaseType(typeName)
    Case "BALL": Return 900
    Case "BIGD", "BIGDECIMAL": Return 800
    Case "BIGF", "BIGFLOAT": Return 700
    Case "F128", "FLOAT128", "QUAD": Return 600
    Case "F80", "EXTENDED", "EXT": Return 500
    Case "F64", "DOUBLE": Return 400
    Case "F32", "SINGLE": Return 300
    Case "I64", "U64", "LONG", "ULONG": Return 200
    Case "I32", "U32", "INTEGER": Return 100
    Case Else: Return 0
    End Select
End Function
Function UXBNumericPromotionResult(ByRef leftType As String, ByRef rightType As String, ByRef errText As String) As String
    errText = ""
    Dim As String l = UXBExtFpBaseType(leftType)
    Dim As String r = UXBExtFpBaseType(rightType)
    If l = "" Then Return rightType
    If r = "" Then Return leftType
    If l = r Then Return leftType
    If l = "BIGD" Or l = "BIGDECIMAL" Or r = "BIGD" Or r = "BIGDECIMAL" Then
        If UXBIsIntegerTypeName(leftType) <> 0 Then Return rightType
        If UXBIsIntegerTypeName(rightType) <> 0 Then Return leftType
        errText = "BIGD cannot be mixed with binary floating point without explicit cast."
        Return ""
    End If
    If l = "BALL" Or r = "BALL" Then
        If l = "BALL" Then Return leftType Else Return rightType
    End If
    If l = "BIGF" Or l = "BIGFLOAT" Or r = "BIGF" Or r = "BIGFLOAT" Then
        If l = "BIGF" Or l = "BIGFLOAT" Then Return leftType Else Return rightType
    End If
    If UXBNumericPromotionRank(leftType) >= UXBNumericPromotionRank(rightType) Then Return leftType
    Return rightType
End Function
#endif
