#ifndef UXB_COMPILER_MESSAGE_BUS_FBS
#define UXB_COMPILER_MESSAGE_BUS_FBS

' Central compiler message/i18n contract.
' Default language: Turkish.
' Secondary language: English.
' This layer complements diagnostics.fbs and error_localization.fbs.

Type UXBCompilerMessageState
    language As String
    messageLogPath As String
    initialized As Integer
End Type

Dim Shared gUXBMessageState As UXBCompilerMessageState

Sub UXBMessageBusInit()
    If gUXBMessageState.initialized <> 0 Then Exit Sub
    gUXBMessageState.language = "tr"
    gUXBMessageState.messageLogPath = ""
    gUXBMessageState.initialized = 1
End Sub

Function UXBNormalizeMessageLanguage(ByRef langText As String) As String
    Dim As String l
    l = LCase(Trim(langText))
    Select Case l
    Case "tr", "turkish", "turkce", "türkçe"
        Return "tr"
    Case "en", "english", "ingilizce"
        Return "en"
    Case Else
        Return "tr"
    End Select
End Function

Function UXBMessageLanguageSupported(ByRef langText As String) As Integer
    Dim As String l
    l = LCase(Trim(langText))
    Select Case l
    Case "tr", "turkish", "turkce", "türkçe", "en", "english", "ingilizce"
        Return 1
    Case Else
        Return 0
    End Select
End Function

Sub UXBMessageBusSetLanguage(ByRef langText As String)
    UXBMessageBusInit
    gUXBMessageState.language = UXBNormalizeMessageLanguage(langText)
End Sub

Function UXBMessageBusLanguage() As String
    UXBMessageBusInit
    Return gUXBMessageState.language
End Function

Sub UXBMessageBusSetLogPath(ByRef logPath As String)
    UXBMessageBusInit
    gUXBMessageState.messageLogPath = logPath
End Sub

Private Sub UXBMessageBusAppend(ByRef lineText As String)
    UXBMessageBusInit
    If Trim(gUXBMessageState.messageLogPath) = "" Then Exit Sub
    Dim As Integer f
    f = FreeFile
    On Error GoTo _mb_err
    Open gUXBMessageState.messageLogPath For Append As #f
    Print #f, lineText
    Close #f
    On Error GoTo 0
    Exit Sub
_mb_err:
    On Error GoTo 0
End Sub

Function UXBMessageText(ByRef msgKey As String, ByRef fallbackTr As String, ByRef fallbackEn As String) As String
    UXBMessageBusInit
    If gUXBMessageState.language = "en" Then
        If Trim(fallbackEn) <> "" Then Return fallbackEn
    End If
    Return fallbackTr
End Function

Sub UXBMessageEmit(ByRef layerName As String, ByRef severity As String, ByRef msgKey As String, ByRef fallbackTr As String, ByRef fallbackEn As String)
    Dim As String msg
    msg = UXBMessageText(msgKey, fallbackTr, fallbackEn)

    Dim As String lineText
    lineText = "[" & UCase(Trim(severity)) & "]" & "[" & Trim(layerName) & "] " & msgKey & ": " & msg

    Select Case UCase(Trim(severity))
    Case "ERROR"
        UxbError lineText
    Case "WARN", "WARNING"
        UxbWarn lineText
    Case Else
        UxbInfo lineText
    End Select

    UXBMessageBusAppend lineText
End Sub

#endif
