#ifndef UXB_STEP4_MIR_OPCODE_FBS
#define UXB_STEP4_MIR_OPCODE_FBS

' Step4 canonical MIR opcode registry.
' Existing legacy opcode names are kept accepted to avoid breaking old lowering.

Function UXBMIRStep4NormalizeOpcode(ByRef opcodeText As String) As String
    Return UCase(Trim(opcodeText))
End Function

Function UXBMIRStep4OpcodeGroup(ByRef opcodeText As String) As String
    Dim op As String
    op = UXBMIRStep4NormalizeOpcode(opcodeText)

    Select Case op
    Case "MIR_NOP", "MIR_MODULE_BEGIN", "MIR_MODULE_END", "MIR_NAMESPACE_BEGIN", "MIR_NAMESPACE_END", "MIR_IMPORT", "MIR_INCLUDE", "MIR_ALIAS", "MIR_USING"
        Return "MIR_META"
    Case "MIR_CONST", "MIR_LOAD_CONST", "LOAD_CONST"
        Return "MIR_CONST"
    Case "MIR_LOCAL_DECL", "MIR_PARAM_DECL", "MIR_GLOBAL_DECL", "MIR_LOAD", "MIR_STORE", "MIR_LOAD_LOCAL", "MIR_STORE_LOCAL", "MIR_LOAD_GLOBAL", "MIR_STORE_GLOBAL", "LOAD_VAR", "STORE_VAR"
        Return "MIR_LOCAL"
    Case "MIR_ADD", "MIR_SUB", "MIR_MUL", "MIR_DIV", "MIR_IDIV", "MIR_MOD", "MIR_NEG", "MIR_INC", "MIR_DEC", "ADD", "SUB", "MUL", "DIV", "MOD", "NEG"
        Return "MIR_ARITH"
    Case "MIR_FADD", "MIR_FSUB", "MIR_FMUL", "MIR_FDIV", "MIR_FNEG", "MIR_FCMP", "FADD", "FSUB", "FMUL", "FDIV", "FNEG"
        Return "MIR_ARITH"
    Case "MIR_EQ", "MIR_NE", "MIR_LT", "MIR_LE", "MIR_GT", "MIR_GE", "EQ", "NE", "LT", "LE", "GT", "GE"
        Return "MIR_COMPARE"
    Case "MIR_AND", "MIR_OR", "MIR_XOR", "MIR_NOT", "AND", "OR", "XOR", "NOT", "SHL", "SHR", "ROL", "ROR"
        Return "MIR_LOGIC"
    Case "MIR_CAST", "MIR_COERCE", "MIR_TYPEOF", "MIR_SIZEOF", "MIR_OFFSETOF", "DEF_TYPE"
        Return "MIR_CAST"
    Case "MIR_LABEL", "MIR_JMP", "MIR_JMP_IF_TRUE", "MIR_JMP_IF_FALSE", "MIR_SELECT_BEGIN", "MIR_CASE", "MIR_CASE_ELSE", "MIR_SELECT_END", "MIR_LOOP_BEGIN", "MIR_LOOP_END", "MIR_BREAK", "MIR_CONTINUE", "MIR_RETURN", "JMP", "JZ", "JNZ", "RET", "LABEL"
        Return "MIR_CONTROL"
    Case "MIR_FUNCTION_BEGIN", "MIR_FUNCTION_END", "MIR_SUB_BEGIN", "MIR_SUB_END", "MIR_CALL", "MIR_CALL_BUILTIN", "MIR_CALL_RUNTIME", "MIR_CALL_EXTERNAL", "MIR_CALL_DLL", "MIR_CALL_API", "CALL"
        Return "MIR_CALL"
    Case "MIR_STR_NEW", "MIR_STR_ASSIGN", "MIR_STR_CONCAT", "MIR_STR_LEN", "MIR_STR_MID", "MIR_STR_LEFT", "MIR_STR_RIGHT", "MIR_STR_COMPARE", "SETSTRINGSIZE"
        Return "MIR_STRING"
    Case "MIR_ARRAY_NEW", "MIR_ARRAY_LOAD", "MIR_ARRAY_STORE", "LOAD_INDEXED", "STORE_INDEXED", "DIM", "REDIM"
        Return "MIR_ARRAY"
    Case "MIR_OBJECT_NEW", "MIR_FIELD_LOAD", "MIR_FIELD_STORE", "MIR_TYPE_DECL", "MIR_CLASS_DECL", "MIR_METHOD_DECL", "MIR_INTERFACE_DECL", "NEW"
        Return "MIR_OBJECT"
    Case "MIR_MEM_LOAD", "MIR_MEM_STORE", "MIR_MEM_COPY", "MIR_MEM_FILL", "MIR_PEEK", "MIR_POKE"
        Return "MIR_MEMORY"
    Case "MIR_FILE_OPEN", "MIR_FILE_CLOSE", "MIR_FILE_READ", "MIR_FILE_WRITE", "MIR_FILE_SEEK", "MIR_FILE_DELETE"
        Return "MIR_FILE"
    Case "MIR_PRINT", "MIR_INPUT", "MIR_CLS", "MIR_COLOR", "MIR_LOCATE", "MIR_RANDOMIZE", "MIR_TIMER", "MIR_RUNTIME_CALL", "CONST"
        Return "MIR_RUNTIME"
    Case "MIR_TRY_BEGIN", "MIR_CATCH_BEGIN", "MIR_FINALLY_BEGIN", "MIR_TRY_END", "MIR_THROW", "MIR_ASSERT"
        Return "MIR_RUNTIME"
    Case "MIR_JS_CALL", "MIR_BROWSER_CALL"
        Return "MIR_BROWSER"
    Case "MIR_WASM_IMPORT", "MIR_WASM_EXPORT"
        Return "MIR_WASM"
    Case "MIR_NATIVE_ONLY", "MIR_WASM_UNSUPPORTED", "MIR_DIAGNOSTIC_ONLY", "MIR_RESERVED_NODE", "MIR_BROKEN_NODE"
        Return "MIR_DIAGNOSTIC"
    End Select

    Return ""
End Function

Function UXBMIRStep4OpcodeRegistered(ByRef opcodeText As String) As Integer
    Return IIf(UXBMIRStep4OpcodeGroup(opcodeText) <> "", 1, 0)
End Function

#endif
