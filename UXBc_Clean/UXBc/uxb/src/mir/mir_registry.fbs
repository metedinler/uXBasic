#ifndef UXB_STEP4_MIR_REGISTRY_FBS
#define UXB_STEP4_MIR_REGISTRY_FBS

Function UXBMIRStep4VerifyRuleForOpcode(ByRef opcodeText As String) As String
    Dim op As String
    op = UXBMIRStep4NormalizeOpcode(opcodeText)

    Select Case op
    Case "MIR_NOP", "MIR_MODULE_BEGIN", "MIR_MODULE_END", "MIR_NAMESPACE_BEGIN", "MIR_NAMESPACE_END", "MIR_IMPORT", "MIR_INCLUDE", "MIR_ALIAS", "MIR_USING"
        Return "verify_meta"
    Case "MIR_CONST", "MIR_GLOBAL_DECL", "MIR_LOCAL_DECL", "MIR_PARAM_DECL", "MIR_LOAD", "MIR_STORE", "MIR_LOAD_GLOBAL", "MIR_STORE_GLOBAL", "MIR_LOAD_LOCAL", "MIR_STORE_LOCAL", "MIR_LOAD_CONST"
        Return "verify_storage"
    Case "MIR_ADD", "MIR_SUB", "MIR_MUL", "MIR_DIV", "MIR_IDIV", "MIR_MOD", "MIR_NEG", "MIR_INC", "MIR_DEC", "MIR_FADD", "MIR_FSUB", "MIR_FMUL", "MIR_FDIV", "MIR_FNEG", "MIR_FCMP"
        Return "verify_arith"
    Case "MIR_EQ", "MIR_NE", "MIR_LT", "MIR_LE", "MIR_GT", "MIR_GE", "MIR_AND", "MIR_OR", "MIR_XOR", "MIR_NOT", "MIR_CAST", "MIR_COERCE", "MIR_TYPEOF", "MIR_SIZEOF", "MIR_OFFSETOF"
        Return "verify_expr"
    Case "MIR_LABEL", "MIR_JMP", "MIR_JMP_IF_TRUE", "MIR_JMP_IF_FALSE", "MIR_SELECT_BEGIN", "MIR_CASE", "MIR_CASE_ELSE", "MIR_SELECT_END", "MIR_LOOP_BEGIN", "MIR_LOOP_END", "MIR_BREAK", "MIR_CONTINUE"
        Return "verify_control"
    Case "MIR_FUNCTION_BEGIN", "MIR_FUNCTION_END", "MIR_SUB_BEGIN", "MIR_SUB_END", "MIR_CALL", "MIR_CALL_BUILTIN", "MIR_CALL_RUNTIME", "MIR_CALL_EXTERNAL", "MIR_CALL_DLL", "MIR_CALL_API", "MIR_RETURN"
        Return "verify_call"
    Case "MIR_STR_NEW", "MIR_STR_ASSIGN", "MIR_STR_CONCAT", "MIR_STR_LEN", "MIR_STR_MID", "MIR_STR_LEFT", "MIR_STR_RIGHT", "MIR_STR_COMPARE"
        Return "verify_string"
    Case "MIR_ARRAY_NEW", "MIR_ARRAY_LOAD", "MIR_ARRAY_STORE", "MIR_OBJECT_NEW", "MIR_FIELD_LOAD", "MIR_FIELD_STORE", "MIR_TYPE_DECL", "MIR_CLASS_DECL", "MIR_METHOD_DECL", "MIR_INTERFACE_DECL"
        Return "verify_object"
    Case "MIR_MEM_LOAD", "MIR_MEM_STORE", "MIR_MEM_COPY", "MIR_MEM_FILL", "MIR_PEEK", "MIR_POKE"
        Return "verify_memory"
    Case "MIR_FILE_OPEN", "MIR_FILE_CLOSE", "MIR_FILE_READ", "MIR_FILE_WRITE", "MIR_FILE_SEEK", "MIR_FILE_DELETE"
        Return "verify_file"
    Case "MIR_PRINT", "MIR_INPUT", "MIR_CLS", "MIR_COLOR", "MIR_LOCATE", "MIR_RANDOMIZE", "MIR_TIMER", "MIR_RUNTIME_CALL"
        Return "verify_runtime"
    Case "MIR_TRY_BEGIN", "MIR_CATCH_BEGIN", "MIR_FINALLY_BEGIN", "MIR_TRY_END", "MIR_THROW", "MIR_ASSERT"
        Return "verify_exception"
    Case "MIR_JS_CALL", "MIR_BROWSER_CALL", "MIR_WASM_IMPORT", "MIR_WASM_EXPORT", "MIR_HOST_CALL"
        Return "verify_target"
    Case "MIR_NATIVE_ONLY", "MIR_WASM_UNSUPPORTED", "MIR_DIAGNOSTIC_ONLY", "MIR_RESERVED_NODE", "MIR_BROKEN_NODE"
        Return "verify_diagnostic"

    ' Backward compatible legacy opcodes still accepted by the current pipeline.
    Case "LOAD_CONST", "LOAD_VAR", "STORE_VAR", "LOAD_INDEXED", "STORE_INDEXED", "ADD", "SUB", "MUL", "DIV", "MOD", "NEG", "FADD", "FSUB", "FMUL", "FDIV", "FNEG", "EQ", "NE", "LT", "LE", "GT", "GE", "AND", "OR", "XOR", "NOT", "SHL", "SHR", "ROL", "ROR", "CALL", "RET", "JMP", "JZ", "JNZ", "LABEL", "NEW", "DIM", "REDIM", "CONST", "DEF_TYPE", "SETSTRINGSIZE"
        Return "verify_legacy_compat"
    End Select

    Return ""
End Function

Function UXBMIRStep4HasVerifyRule(ByRef opcodeText As String) As Integer
    Return IIf(UXBMIRStep4VerifyRuleForOpcode(opcodeText) <> "", 1, 0)
End Function

#endif
