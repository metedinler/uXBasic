#ifndef UXB_STEP4_MIR_REGISTRY_FBS
#define UXB_STEP4_MIR_REGISTRY_FBS

Function UXBMIRStep4VerifyRuleForOpcode(ByRef opcodeText As String) As String
    Dim op As String
    op = UXBMIRStep4NormalizeOpcode(opcodeText)

    Select Case op
    ' --- Step4: Eksik verify_rule'lar eklendi ---
    Case "ADD", "MIR_ADD", "FADD", "MIR_FADD", "SUB", "MIR_SUB", "MUL", "MIR_MUL", "DIV", "MIR_DIV", "IDIV", "MIR_IDIV", "MOD", "MIR_MOD", "NEG", "MIR_NEG", "INC", "MIR_INC", "DEC", "MIR_DEC", "FSUB", "MIR_FSUB", "FMUL", "MIR_FMUL", "FDIV", "MIR_FDIV", "FNEG", "MIR_FNEG", "FCMP", "MIR_FCMP"
        Return "verify_arith"
    Case "AND", "MIR_AND", "OR", "MIR_OR", "XOR", "MIR_XOR", "NOT", "MIR_NOT"
        Return "verify_expr"
    Case "EQ", "MIR_EQ", "NE", "MIR_NE", "LT", "MIR_LT", "LE", "MIR_LE", "GT", "MIR_GT", "GE", "MIR_GE"
        Return "verify_expr"
    Case "CALL", "MIR_CALL", "MIR_JS_CALL", "MIR_CALL_BUILTIN", "MIR_CALL_RUNTIME", "MIR_CALL_EXTERNAL", "MIR_CALL_DLL", "MIR_CALL_API"
        Return "verify_call"
    Case "CONST", "MIR_CONST", "DEF_TYPE", "MIR_GLOBAL_DECL", "MIR_LOCAL_DECL", "MIR_PARAM_DECL", "MIR_LOAD", "MIR_STORE", "MIR_LOAD_GLOBAL", "MIR_STORE_GLOBAL", "MIR_LOAD_LOCAL", "MIR_STORE_LOCAL", "MIR_LOAD_CONST"
        Return "verify_storage"
    Case "LABEL", "MIR_LABEL", "JMP", "MIR_JMP", "JZ", "JNZ", "MIR_JMP_IF_TRUE", "MIR_JMP_IF_FALSE"
        Return "verify_control"
    Case "NEW", "MIR_OBJECT_NEW", "MIR_ARRAY_NEW", "MIR_STR_NEW"
        Return "verify_object"
    Case "PRINT", "MIR_PRINT"
        Return "verify_runtime"
    Case "FILE_OPEN", "MIR_FILE_OPEN"
        Return "verify_file"
    Case "WASM_IMPORT", "MIR_WASM_IMPORT"
        Return "verify_target"
    Case "NOP", "MIR_NOP"
        Return "verify_meta"
    Case "SETSTRINGSIZE"
        Return "verify_string"
    Case "ROL", "ROR", "SHL", "SHR"
        Return "verify_arith"
    Case "DIM", "REDIM"
        Return "verify_storage"
    ' --- Legacy ve diger opcode'lar ---
    Case "LOAD_CONST", "LOAD_VAR", "STORE_VAR", "LOAD_INDEXED", "STORE_INDEXED", "RET"
        Return "verify_legacy_compat"
    End Select

    Return ""
End Function

Function UXBMIRStep4HasVerifyRule(ByRef opcodeText As String) As Integer
    Return IIf(UXBMIRStep4VerifyRuleForOpcode(opcodeText) <> "", 1, 0)
End Function

#endif
