#ifndef UXB_STEP4_MIR_TYPES_FBS
#define UXB_STEP4_MIR_TYPES_FBS

Const UXB_MIR_TYPE_UNKNOWN As String = "TYPE_UNKNOWN"
Const UXB_MIR_TYPE_ERROR As String = "TYPE_ERROR"
Const UXB_MIR_LAYOUT_MISSING As String = "LAYOUT_MISSING"

Function UXBMIRStep4TokenIsBlocked(ByRef tokenText As String) As Integer
    Dim t As String
    t = UCase(Trim(tokenText))
    If t = "" Then Return 0

    If InStr(t, UXB_MIR_TYPE_UNKNOWN) > 0 Then Return 1
    If InStr(t, UXB_MIR_TYPE_ERROR) > 0 Then Return 1
    If InStr(t, UXB_MIR_LAYOUT_MISSING) > 0 Then Return 1

    Return 0
End Function

Function UXBMIRStep4TypeNameIsKnown(ByRef typeText As String) As Integer
    Dim t As String
    t = UCase(Trim(typeText))
    If t = "" Then Return 0

    Select Case t
    Case "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "F80", "F128", "BOOLEAN", "STRING", "PTR", "TYPE", "CLASS", "INTERFACE", "LIST", "DICT", "SET", "ARRAY", "OBJECT"
        Return 1
    End Select

    Return IIf(UXBMIRStep4TokenIsBlocked(t) = 0, 1, 0)
End Function

#endif
