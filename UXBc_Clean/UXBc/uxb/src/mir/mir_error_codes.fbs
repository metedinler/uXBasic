#ifndef UXB_STEP4_MIR_ERROR_CODES_FBS
#define UXB_STEP4_MIR_ERROR_CODES_FBS

Const UXB_MIR_E_OK = 0
Const UXB_MIR_E_OPCODE_UNKNOWN = 4001
Const UXB_MIR_E_VERIFY_RULE_MISSING = 4002
Const UXB_MIR_E_BAD_OPERAND_COUNT = 4003
Const UXB_MIR_E_BAD_BRANCH_TARGET = 4004
Const UXB_MIR_E_FORBIDDEN_TYPE_LEAK = 4005
Const UXB_MIR_E_CALL_SIGNATURE = 4006
Const UXB_MIR_E_MEMORY_WIDTH = 4007
Const UXB_MIR_E_BLOCK_TERMINATOR = 4008

Function UXBMIRStep4ErrorName(ByVal code As Integer) As String
    Select Case code
    Case UXB_MIR_E_OK
        Return "UXB_MIR_E_OK"
    Case UXB_MIR_E_OPCODE_UNKNOWN
        Return "UXB_MIR_E_OPCODE_UNKNOWN"
    Case UXB_MIR_E_VERIFY_RULE_MISSING
        Return "UXB_MIR_E_VERIFY_RULE_MISSING"
    Case UXB_MIR_E_BAD_OPERAND_COUNT
        Return "UXB_MIR_E_BAD_OPERAND_COUNT"
    Case UXB_MIR_E_BAD_BRANCH_TARGET
        Return "UXB_MIR_E_BAD_BRANCH_TARGET"
    Case UXB_MIR_E_FORBIDDEN_TYPE_LEAK
        Return "UXB_MIR_E_FORBIDDEN_TYPE_LEAK"
    Case UXB_MIR_E_CALL_SIGNATURE
        Return "UXB_MIR_E_CALL_SIGNATURE"
    Case UXB_MIR_E_MEMORY_WIDTH
        Return "UXB_MIR_E_MEMORY_WIDTH"
    Case UXB_MIR_E_BLOCK_TERMINATOR
        Return "UXB_MIR_E_BLOCK_TERMINATOR"
    Case Else
        Return "UXB_MIR_E_UNKNOWN"
    End Select
End Function

#endif
