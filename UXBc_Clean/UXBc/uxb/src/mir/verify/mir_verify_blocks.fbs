#ifndef UXB_STEP4_MIR_VERIFY_BLOCKS_FBS
#define UXB_STEP4_MIR_VERIFY_BLOCKS_FBS

Private Function UXBMIRStep4IsTerminalOpcode(ByRef opRaw As String) As Integer
    Dim op As String
    op = UXBMIRStep4NormalizeOpcode(opRaw)

    If op = "MIR_JMP" Or op = "MIR_JMP_IF_TRUE" Or op = "MIR_JMP_IF_FALSE" Or op = "MIR_RETURN" Then Return 1
    If op = "JMP" Or op = "JZ" Or op = "JNZ" Or op = "RET" Then Return 1

    Return 0
End Function

Function UXBMIRStep4VerifyBlocks(ByRef m As MIRModule, ByRef errText As String) As Integer
    errText = ""

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        If m.functions(fi).blockCount <= 0 Then
            errText = "step4 verify blocks: function has no block index=" & LTrim(Str(fi))
            Return 0
        End If

        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim blk As MIRBasicBlock Ptr
            blk = @m.functions(fi).blocks(bi)

            If blk->instructionCount <= 0 Then
                errText = "step4 verify blocks: empty basic block id=" & LTrim(Str(blk->id))
                Return 0
            End If

            Dim lastOp As String
            lastOp = blk->instructions(blk->instructionCount - 1).opcode
            If UXBMIRStep4IsTerminalOpcode(lastOp) = 0 And bi = m.functions(fi).blockCount - 1 Then
                errText = "step4 verify blocks: final block must end with terminal opcode"
                Return 0
            End If
        Next bi
    Next fi

    Return 1
End Function

#endif
