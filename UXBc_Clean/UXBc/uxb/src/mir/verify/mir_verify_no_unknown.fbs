#ifndef UXB_STEP4_MIR_VERIFY_NO_UNKNOWN_FBS
#define UXB_STEP4_MIR_VERIFY_NO_UNKNOWN_FBS

Private Function UXBMIRStep4HasForbiddenToken(ByRef tokenText As String) As Integer
    Dim t As String
    t = UCase(Trim(tokenText))

    If t = "" Then Return 0
    If InStr(t, "TYPE_UNKNOWN") > 0 Then Return 1
    If InStr(t, "TYPE_ERROR") > 0 Then Return 1
    If InStr(t, "LAYOUT_MISSING") > 0 Then Return 1

    Return 0
End Function

Sub UXBMIRStep4VerifyNoUnknown(ByRef m As MIRModule, ByRef r As UXBMIRVerifyResult)
    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim inst As MIRIRInstruction Ptr
                inst = @m.functions(fi).blocks(bi).instructions(ii)

                If UXBMIRStep4HasForbiddenToken(inst->opcode) <> 0 Then
                    UXBMIRVerifyAddError r, "MIR forbidden token in opcode: " & inst->opcode
                End If

                If UXBMIRStep4HasForbiddenToken(inst->result) <> 0 Then
                    UXBMIRVerifyAddError r, "MIR forbidden token in result: " & inst->result
                End If

                Dim oi As Integer
                For oi = 0 To inst->operandCount - 1
                    If UXBMIRStep4HasForbiddenToken(inst->operands(oi)) <> 0 Then
                        UXBMIRVerifyAddError r, "MIR forbidden token in operand: " & inst->operands(oi)
                    End If
                Next oi
            Next ii
        Next bi
    Next fi
End Sub

#endif
