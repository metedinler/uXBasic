#ifndef UXB_STEP4_MIR_VERIFY_TARGET_SUPPORT_FBS
#define UXB_STEP4_MIR_VERIFY_TARGET_SUPPORT_FBS

Function UXBMIRStep4VerifyTargetSupport(ByRef m As MIRModule, ByRef errText As String) As Integer
    errText = ""

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim inst As MIRIRInstruction Ptr
                inst = @m.functions(fi).blocks(bi).instructions(ii)

                Dim op As String
                op = UXBMIRStep4NormalizeOpcode(inst->opcode)

                If op = "MIR_RESERVED_NODE" Or op = "MIR_BROKEN_NODE" Then
                    errText = "step4 verify target: reserved/broken opcode cannot be emitted"
                    Return 0
                End If
            Next ii
        Next bi
    Next fi

    Return 1
End Function

#endif
