#ifndef UXB_STEP4_MIR_VERIFY_MEMORY_FBS
#define UXB_STEP4_MIR_VERIFY_MEMORY_FBS

Function UXBMIRStep4VerifyMemory(ByRef m As MIRModule, ByRef errText As String) As Integer
    errText = ""

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim inst As MIRIRInstruction Ptr
                inst = @m.functions(fi).blocks(bi).instructions(ii)

                Dim op As String
                op = UXBMIRStep4NormalizeOpcode(inst->opcode)

                If op = "MIR_MEM_COPY" Or op = "MIR_MEM_FILL" Then
                    If inst->operandCount < 2 Then
                        errText = "step4 verify memory: MEM_COPY/MEM_FILL need at least addr+size"
                        Return 0
                    End If
                ElseIf op = "MIR_MEM_LOAD" Or op = "MIR_MEM_STORE" Or op = "MIR_PEEK" Or op = "MIR_POKE" Then
                    If inst->operandCount < 1 Then
                        errText = "step4 verify memory: memory opcode needs address operand"
                        Return 0
                    End If
                End If
            Next ii
        Next bi
    Next fi

    Return 1
End Function

#endif
