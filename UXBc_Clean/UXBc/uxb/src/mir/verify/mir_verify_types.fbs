#ifndef UXB_STEP4_MIR_VERIFY_TYPES_FBS
#define UXB_STEP4_MIR_VERIFY_TYPES_FBS

Function UXBMIRStep4VerifyTypes(ByRef m As MIRModule, ByRef errText As String) As Integer
    errText = ""

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim inst As MIRIRInstruction Ptr
                inst = @m.functions(fi).blocks(bi).instructions(ii)

                If UXBMIRStep4TokenIsBlocked(inst->result) <> 0 Then
                    errText = "step4 verify types: forbidden result token " & inst->result
                    Return 0
                End If

                Dim oi As Integer
                For oi = 0 To inst->operandCount - 1
                    If UXBMIRStep4TokenIsBlocked(inst->operands(oi)) <> 0 Then
                        errText = "step4 verify types: forbidden operand token " & inst->operands(oi)
                        Return 0
                    End If
                Next oi
            Next ii
        Next bi
    Next fi

    Return 1
End Function

#endif
