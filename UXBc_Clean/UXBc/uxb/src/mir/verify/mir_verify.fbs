#ifndef UXB_STEP4_MIR_VERIFY_FBS
#define UXB_STEP4_MIR_VERIFY_FBS

Function UXBMIRStep4VerifyAll(ByRef m As MIRModule, ByRef errText As String) As Integer
    errText = ""

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim inst As MIRIRInstruction Ptr
                inst = @m.functions(fi).blocks(bi).instructions(ii)

                If UXBMIRStep4OpcodeRegistered(inst->opcode) = 0 Then
                    errText = "step4 verify: opcode registry miss " & inst->opcode
                    Return 0
                End If

                If UXBMIRStep4HasVerifyRule(inst->opcode) = 0 Then
                    errText = "step4 verify: verify rule missing " & inst->opcode
                    Return 0
                End If
            Next ii
        Next bi
    Next fi

    If UXBMIRStep4VerifyTypes(m, errText) = 0 Then Return 0
    If UXBMIRStep4VerifyOperands(m, errText) = 0 Then Return 0
    If UXBMIRStep4VerifyBlocks(m, errText) = 0 Then Return 0
    If UXBMIRStep4VerifyControlFlow(m, errText) = 0 Then Return 0
    If UXBMIRStep4VerifyCalls(m, errText) = 0 Then Return 0
    If UXBMIRStep4VerifyMemory(m, errText) = 0 Then Return 0
    If UXBMIRStep4VerifyTargetSupport(m, errText) = 0 Then Return 0

    Return 1
End Function

#endif
