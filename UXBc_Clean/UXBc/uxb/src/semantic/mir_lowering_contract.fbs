#ifndef UXB_MIR_LOWERING_CONTRACT_FBS
#define UXB_MIR_LOWERING_CONTRACT_FBS

' MIR lowering contract layer.
' This file is intentionally small and safe:
' - does not change existing lowering by itself,
' - provides standard diagnostics for missing lowering,
' - gives Copilot exact function names to call when completing lowering.

Type UXBMIRLoweringDecision
    surfaceName As String
    surfaceKind As String
    targetOpcode As String
    loweringStatus As String
    requiresRuntime As Integer
    requiresAddress As Integer
    diagnosticText As String
End Type

Sub UXBMIRLoweringDecisionInit(ByRef d As UXBMIRLoweringDecision)
    d.surfaceName = ""
    d.surfaceKind = ""
    d.targetOpcode = ""
    d.loweringStatus = "unknown"
    d.requiresRuntime = 0
    d.requiresAddress = 0
    d.diagnosticText = ""
End Sub

Function UXBMIRDefaultOpcodeForSurface(ByRef surfaceKind As String, ByRef surfaceName As String) As String
    Dim As String k
    Dim As String n
    k = UCase(Trim(surfaceKind))
    n = UCase(Trim(surfaceName))

    If k = "OPERATOR" Then
        Select Case n
        Case "+"
            Return "ADD"
        Case "-"
            Return "SUB"
        Case "*"
            Return "MUL"
        Case "/"
            Return "DIV"
        Case "MOD"
            Return "MOD"
        Case "="
            Return "EQ"
        Case "<>"
            Return "NE"
        Case "<"
            Return "LT"
        Case "<="
            Return "LE"
        Case ">"
            Return "GT"
        Case ">="
            Return "GE"
        Case "AND"
            Return "AND"
        Case "OR"
            Return "OR"
        Case "XOR"
            Return "XOR"
        Case "NOT"
            Return "NOT"
        End Select
    End If

    If k = "KEYWORD" Then
        Select Case n
        Case "DIM"
            Return "DIM"
        Case "REDIM"
            Return "REDIM"
        Case "PRINT"
            Return "PRINT"
        Case "INPUT"
            Return "INPUT"
        Case "IF"
            Return "JZ"
        Case "ELSE", "ELSEIF"
            Return "JMP"
        Case "FOR", "WHILE", "DO"
            Return "LABEL"
        Case "GOTO"
            Return "JMP"
        Case "GOSUB"
            Return "CALL"
        Case "RETURN"
            Return "RET"
        Case "CALL"
            Return "CALL"
        Case "OPEN", "CLOSE", "GET", "PUT", "SEEK"
            Return n
        Case "TYPE"
            Return "DEF_TYPE"
        Case "NEW"
            Return "NEW"
        Case "DELETE"
            Return "DELETE"
        End Select
    End If

    If k = "BUILTIN" Or k = "BUILTIN_FUNCTION" Then
        Return "CALL"
    End If

    If k = "TYPE" Then
        Select Case n
        Case "F80"
            Return "F80_CALL"
        Case "F128"
            Return "F128_CALL"
        Case "BIGF"
            Return "BIGF_CALL"
        Case "BIGD"
            Return "BIGD_CALL"
        Case "BALL"
            Return "BALL_CALL"
        Case Else
            Return "DIM"
        End Select
    End If

    Return ""
End Function

Function UXBMIRDecideLowering(ByRef surfaceKind As String, ByRef surfaceName As String, ByRef d As UXBMIRLoweringDecision) As Integer
    UXBMIRLoweringDecisionInit(d)

    d.surfaceKind = surfaceKind
    d.surfaceName = surfaceName
    d.targetOpcode = UXBMIRDefaultOpcodeForSurface(surfaceKind, surfaceName)

    If Trim(d.targetOpcode) = "" Then
        d.loweringStatus = "missing"
        d.diagnosticText = "MIR lowering missing for " & surfaceKind & ":" & surfaceName
        Return 0
    End If

    d.requiresRuntime = UXBMIRRequiresRuntimeCall(d.targetOpcode)
    d.requiresAddress = UXBMIRRequiresAddressableStorage(d.targetOpcode)

    If UXBMIRKnownOpcode(d.targetOpcode) = 0 Then
        d.loweringStatus = "diagnostic_only"
        d.diagnosticText = "MIR opcode contract does not know opcode: " & d.targetOpcode
        Return 0
    End If

    d.loweringStatus = "planned"
    d.diagnosticText = ""
    Return 1
End Function

Function UXBMIRLoweringDiagnostic(ByRef surfaceKind As String, ByRef surfaceName As String) As String
    Dim As UXBMIRLoweringDecision d
    If UXBMIRDecideLowering(surfaceKind, surfaceName, d) = 0 Then
        Return d.diagnosticText
    End If
    Return ""
End Function

#endif
