#ifndef UXB_MIR_OPCODE_CONTRACT_FBS
#define UXB_MIR_OPCODE_CONTRACT_FBS

' Central MIR opcode contract.
' Purpose:
' - one place to classify opcodes,
' - one place to decide whether an opcode is value/memory/flow/call/fp/runtime,
' - one place for MIR lowering and MIR x64 backend to agree.

Const UXB_MIR_OP_UNKNOWN = 0
Const UXB_MIR_OP_VALUE = 1
Const UXB_MIR_OP_MEMORY = 2
Const UXB_MIR_OP_FLOW = 3
Const UXB_MIR_OP_CALL = 4
Const UXB_MIR_OP_TYPE = 5
Const UXB_MIR_OP_FP = 6
Const UXB_MIR_OP_EXTFP = 7
Const UXB_MIR_OP_RUNTIME = 8
Const UXB_MIR_OP_DIAGNOSTIC = 9

Function UXBMIRNormalizeOpcode(ByRef opcodeText As String) As String
    Return UCase(Trim(opcodeText))
End Function

Function UXBMIROpCategory(ByRef opcodeText As String) As Integer
    Dim As String op
    op = UXBMIRNormalizeOpcode(opcodeText)

    Select Case op
    Case "LOAD_CONST", "LOAD_VAR", "STORE_VAR", "ADD", "SUB", "MUL", "DIV", "MOD", "NEG", _
         "EQ", "NE", "LT", "LE", "GT", "GE", "AND", "OR", "XOR", "NOT", "SHL", "SHR", "ROL", "ROR", _
         "CAST", "CONV", "CONVERT"
        Return UXB_MIR_OP_VALUE

    Case "DIM", "REDIM", "LOAD_INDEXED", "STORE_INDEXED", "LOAD_FIELD", "STORE_FIELD", "LOAD_ADDR", _
         "MEMCOPY", "MEMFILL", "POKE", "PEEK"
        Return UXB_MIR_OP_MEMORY

    Case "LABEL", "JMP", "JZ", "JNZ", "RET", "RETURN"
        Return UXB_MIR_OP_FLOW

    Case "CALL", "CALL_USER", "CALL_DLL", "CALL_API", "IMPORT", "INLINE"
        Return UXB_MIR_OP_CALL

    Case "DEF_TYPE", "NEW", "DELETE", "CTOR", "DTOR", "METHOD_CALL", "THIS"
        Return UXB_MIR_OP_TYPE

    Case "FADD", "FSUB", "FMUL", "FDIV", "FNEG"
        Return UXB_MIR_OP_FP

    Case "EXTFP_CALL", "F80_CALL", "F128_CALL", "BIGF_CALL", "BIGD_CALL", "BALL_CALL"
        Return UXB_MIR_OP_EXTFP

    Case "PRINT", "PRINTLN", "INPUT", "CLS", "LOCATE", "COLOR", "OPEN", "CLOSE", "GET", "PUT", "SEEK"
        Return UXB_MIR_OP_RUNTIME

    Case Else
        Return UXB_MIR_OP_UNKNOWN
    End Select
End Function

Function UXBMIROpCategoryName(ByVal categoryId As Integer) As String
    Select Case categoryId
    Case UXB_MIR_OP_VALUE
        Return "value"
    Case UXB_MIR_OP_MEMORY
        Return "memory"
    Case UXB_MIR_OP_FLOW
        Return "flow"
    Case UXB_MIR_OP_CALL
        Return "call"
    Case UXB_MIR_OP_TYPE
        Return "type_object"
    Case UXB_MIR_OP_FP
        Return "native_fp"
    Case UXB_MIR_OP_EXTFP
        Return "external_fp"
    Case UXB_MIR_OP_RUNTIME
        Return "runtime"
    Case UXB_MIR_OP_DIAGNOSTIC
        Return "diagnostic"
    Case Else
        Return "unknown"
    End Select
End Function

Function UXBMIRKnownOpcode(ByRef opcodeText As String) As Integer
    If UXBMIROpCategory(opcodeText) <> UXB_MIR_OP_UNKNOWN Then Return 1
    Return 0
End Function

Function UXBMIRRequiresRuntimeCall(ByRef opcodeText As String) As Integer
    Select Case UXBMIROpCategory(opcodeText)
    Case UXB_MIR_OP_CALL, UXB_MIR_OP_EXTFP, UXB_MIR_OP_RUNTIME
        Return 1
    Case Else
        Return 0
    End Select
End Function

Function UXBMIRRequiresAddressableStorage(ByRef opcodeText As String) As Integer
    Select Case UXBMIROpCategory(opcodeText)
    Case UXB_MIR_OP_MEMORY, UXB_MIR_OP_EXTFP
        Return 1
    Case Else
        Return 0
    End Select
End Function

Function UXBMIRCanBePureScalar(ByRef opcodeText As String) As Integer
    Select Case UXBMIROpCategory(opcodeText)
    Case UXB_MIR_OP_VALUE, UXB_MIR_OP_FLOW
        Return 1
    Case Else
        Return 0
    End Select
End Function

#endif
