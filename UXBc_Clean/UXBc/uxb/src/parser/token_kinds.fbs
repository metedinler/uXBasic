Enum TokKind
    TOK_UNKNOWN = 0
    TOK_EOF
    TOK_EOL
    TOK_IDENT
    TOK_KEYWORD
    TOK_NUMBER
    TOK_STRING
    TOK_OP
End Enum

Type Token
    kind As String
    kindCode As TokKind
    lexeme As String
    rawLexeme As String
    canonicalLexeme As String
    lineNo As Integer
    colNo As Integer
    sourceFile As String
    offset As Integer
    length As Integer
    lexemeLength As Integer
End Type

Type LexerDiagnostic
    code As String
    message As String
    sourceFile As String
    lineNo As Integer
    colNo As Integer
End Type

Type LexerDiagnosticList
    items(Any) As LexerDiagnostic
    count As Integer
    capacity As Integer
End Type

Type TokenList
    items(Any) As Token
    count As Integer
    capacity As Integer
End Type

Sub TokenListInit(ByRef t As TokenList)
    t.capacity = 8
    ReDim t.items(t.capacity - 1)
    t.count = 0
End Sub

Private Sub TokenListEnsureCapacity(ByRef t As TokenList, ByVal minSize As Integer)
    If t.capacity >= minSize Then Exit Sub

    Dim newCapacity As Integer
    newCapacity = t.capacity
    If newCapacity < 1 Then newCapacity = 1

    Do While newCapacity < minSize
        newCapacity *= 2
    Loop

    ReDim Preserve t.items(newCapacity - 1)
    t.capacity = newCapacity
End Sub

Private Function TokKindFromName(ByRef k As String) As TokKind
    Select Case UCase(Trim(k))
    Case "EOF": Return TOK_EOF
    Case "EOL": Return TOK_EOL
    Case "IDENT": Return TOK_IDENT
    Case "KEYWORD": Return TOK_KEYWORD
    Case "NUMBER": Return TOK_NUMBER
    Case "STRING": Return TOK_STRING
    Case "OP": Return TOK_OP
    Case Else: Return TOK_UNKNOWN
    End Select
End Function

Sub TokenListPush(ByRef t As TokenList, ByVal k As String, ByVal lx As String, ByVal ln As Integer, ByVal cn As Integer, ByVal sourceFileText As String = "", ByVal rawLexemeText As String = "", ByVal canonicalLexemeText As String = "", ByVal sourceOffset As Integer = 0, ByVal tokenLength As Integer = -1)
    TokenListEnsureCapacity t, t.count + 1

    Dim resolvedRaw As String
    resolvedRaw = rawLexemeText
    If resolvedRaw = "" Then resolvedRaw = lx

    Dim resolvedCanonical As String
    resolvedCanonical = canonicalLexemeText
    If resolvedCanonical = "" Then resolvedCanonical = lx

    Dim resolvedLength As Integer
    resolvedLength = tokenLength
    If resolvedLength < 0 Then resolvedLength = Len(resolvedRaw)

    t.items(t.count).kind = k
    t.items(t.count).kindCode = TokKindFromName(k)
    t.items(t.count).lexeme = lx
    t.items(t.count).rawLexeme = resolvedRaw
    t.items(t.count).canonicalLexeme = resolvedCanonical
    t.items(t.count).lineNo = ln
    t.items(t.count).colNo = cn
    t.items(t.count).sourceFile = sourceFileText
    t.items(t.count).offset = sourceOffset
    t.items(t.count).length = resolvedLength
    t.items(t.count).lexemeLength = resolvedLength
    t.count += 1
End Sub

Sub TokenListClear(ByRef t As TokenList)
    t.count = 0
End Sub

Function TokenListAt(ByRef t As TokenList, ByVal idx As Integer) As Token
    Dim z As Token

    If idx < 0 Or idx >= t.count Then
        z.kind = "EOF"
        z.kindCode = TOK_EOF
        z.lexeme = ""
        z.rawLexeme = ""
        z.canonicalLexeme = ""
        z.lineNo = 0
        z.colNo = 0
        z.sourceFile = ""
        z.offset = 0
        z.length = 0
        z.lexemeLength = 0
        Return z
    End If

    Return t.items(idx)
End Function

Sub LexerDiagnosticListInit(ByRef d As LexerDiagnosticList)
    d.capacity = 8
    ReDim d.items(d.capacity - 1)
    d.count = 0
End Sub

Private Sub LexerDiagnosticListEnsureCapacity(ByRef d As LexerDiagnosticList, ByVal minSize As Integer)
    If d.capacity >= minSize Then Exit Sub

    Dim newCapacity As Integer
    newCapacity = d.capacity
    If newCapacity < 1 Then newCapacity = 1

    Do While newCapacity < minSize
        newCapacity *= 2
    Loop

    ReDim Preserve d.items(newCapacity - 1)
    d.capacity = newCapacity
End Sub

Sub LexerDiagnosticListPush(ByRef d As LexerDiagnosticList, ByRef codeText As String, ByRef messageText As String, ByVal ln As Integer, ByVal cn As Integer, ByRef sourceFileText As String)
    LexerDiagnosticListEnsureCapacity d, d.count + 1
    d.items(d.count).code = codeText
    d.items(d.count).message = messageText
    d.items(d.count).lineNo = ln
    d.items(d.count).colNo = cn
    d.items(d.count).sourceFile = sourceFileText
    d.count += 1
End Sub
