#ifndef UXB_WASM_INSTR_EMIT_FBS
#define UXB_WASM_INSTR_EMIT_FBS

Private Function UXBWasmIsIntLiteral(ByRef s As String) As Integer
    Dim t As String
    Dim i As Integer
    Dim c As String

    t = Trim(s)
    If t = "" Then Return 0
    If Left(t, 1) = "-" Or Left(t, 1) = "+" Then t = Mid(t, 2)
    If t = "" Then Return 0
    For i = 1 To Len(t)
        c = Mid(t, i, 1)
        If c < "0" Or c > "9" Then Return 0
    Next i
    Return 1
End Function

Public Function UXBWasmBinaryInstr(ByRef opcode As String) As String
    Select Case UCase(Trim(opcode))
    Case "ADD"
        Return "i32.add"
    Case "SUB"
        Return "i32.sub"
    Case "MUL"
        Return "i32.mul"
    Case "DIV"
        Return "i32.div_s"
    Case "MOD"
        Return "i32.rem_s"
    Case "EQ"
        Return "i32.eq"
    Case "NE"
        Return "i32.ne"
    Case "LT"
        Return "i32.lt_s"
    Case "LE"
        Return "i32.le_s"
    Case "GT"
        Return "i32.gt_s"
    Case "GE"
        Return "i32.ge_s"
    Case "FADD"
        Return "f64.add"
    Case "FSUB"
        Return "f64.sub"
    Case "FMUL"
        Return "f64.mul"
    Case "FDIV"
        Return "f64.div"
    End Select
    Return ""
End Function

Public Function UXBWasmEmitValue(ByRef valueText As String) As String
    Dim t As String
    t = Trim(valueText)
    If UXBWasmIsIntLiteral(t) <> 0 Then
        Return "    i32.const " & t & Chr(10)
    End If
    Return "    local.get $" & UXBWasmSafeName(t) & Chr(10)
End Function

#endif
