#ifndef UXB_WASM_TYPE_EMIT_FBS
#define UXB_WASM_TYPE_EMIT_FBS

Public Function UXBWasmSafeName(ByRef rawName As String) As String
    Dim outText As String
    Dim i As Integer
    Dim c As String

    outText = ""
    For i = 1 To Len(rawName)
        c = Mid(rawName, i, 1)
        If (c >= "A" And c <= "Z") Or (c >= "a" And c <= "z") Or (c >= "0" And c <= "9") Or c = "_" Then
            outText &= c
        Else
            outText &= "_"
        End If
    Next i

    If outText = "" Then outText = "uxb_fn"
    Return outText
End Function

Public Function UXBWasmType(ByRef uxbType As String) As String
    Select Case UCase(Trim(uxbType))
    Case "I64", "U64"
        Return "i64"
    Case "F32"
        Return "f32"
    Case "F64"
        Return "f64"
    Case Else
        Return "i32"
    End Select
End Function

#endif
