#ifndef UXB_WASM_MANIFEST_EMIT_FBS
#define UXB_WASM_MANIFEST_EMIT_FBS

Private Function UXBWasmJsonEscape(ByRef rawText As String) As String
    Dim outText As String
    Dim i As Integer
    Dim c As String

    outText = ""
    For i = 1 To Len(rawText)
        c = Mid(rawText, i, 1)
        Select Case c
        Case Chr(34)
            outText &= "\" & Chr(34)
        Case "\"
            outText &= "\\"
        Case Chr(10)
            outText &= "\n"
        Case Chr(13)
            outText &= "\r"
        Case Else
            outText &= c
        End Select
    Next i
    Return outText
End Function


Private Function UXBWasmBaseName(ByRef filePath As String) As String
    Dim i As Integer
    Dim s As String
    s = Trim(filePath)
    For i = Len(s) To 1 Step -1
        If Mid(s, i, 1) = "\" Or Mid(s, i, 1) = "/" Then
            s = Mid(s, i + 1)
            Exit For
        End If
    Next i
    Return s
End Function

Private Function UXBWasmDefaultModuleName(ByRef watPath As String) As String
    Dim b As String
    b = UXBWasmBaseName(watPath)
    If LCase(Right(b, 4)) = ".wat" Then b = Left(b, Len(b) - 4) & ".wasm"
    If Trim(b) = "" Then b = "program.wasm"
    Return b
End Function

Public Function UXBWasmWriteManifest(ByRef module As MIRModule, ByRef watPath As String, ByRef manifestPath As String, ByRef errText As String) As Integer
    Dim textValue As String
    Dim i As Integer
    Dim ff As Integer

    If Trim(manifestPath) = "" Then Return 1

    textValue = "{" & Chr(10)
    textValue &= "  " & Chr(34) & "format" & Chr(34) & ": " & Chr(34) & "uxb-wasm-manifest-v1" & Chr(34) & "," & Chr(10)
    textValue &= "  " & Chr(34) & "wat" & Chr(34) & ": " & Chr(34) & UXBWasmJsonEscape(watPath) & Chr(34) & "," & Chr(10)
    textValue &= "  " & Chr(34) & "module" & Chr(34) & ": " & Chr(34) & UXBWasmDefaultModuleName(watPath) & Chr(34) & "," & Chr(10)
    textValue &= "  " & Chr(34) & "exports" & Chr(34) & ": [" & Chr(10)

    For i = 0 To module.functionCount - 1
        If i > 0 Then textValue &= "," & Chr(10)
        textValue &= "    {" & Chr(34) & "name" & Chr(34) & ": " & Chr(34) & UXBWasmSafeName(module.functions(i).name) & Chr(34) & ", " & _
            Chr(34) & "kind" & Chr(34) & ": " & Chr(34) & "function" & Chr(34) & "}"
    Next i

    textValue &= Chr(10) & "  ]," & Chr(10)
    textValue &= "  " & Chr(34) & "imports" & Chr(34) & ": [" & Chr(10)
    textValue &= "    {" & Chr(34) & "module" & Chr(34) & ": " & Chr(34) & "ux" & Chr(34) & ", " & Chr(34) & "name" & Chr(34) & ": " & Chr(34) & "print_i32" & Chr(34) & "}" & Chr(10)
    textValue &= "  ]" & Chr(10)
    textValue &= "}" & Chr(10)

    ff = FreeFile
    Open manifestPath For Output As #ff
    Print #ff, textValue;
    Close #ff
    Return 1
End Function

#endif
