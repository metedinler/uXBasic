#ifndef UXB_JS_WASM_BRIDGE_EMIT_FBS
#define UXB_JS_WASM_BRIDGE_EMIT_FBS

Public Function UXBJsEmitWasmLoadSnippet(ByRef wasmPath As String) As String
    Dim p As String
    p = Trim(wasmPath)
    If p = "" Then Return ""
    Return "  const wasm = await loadUxWasm(" & UXBJsQuote(p) & ");" & Chr(10) & _
           "  ux.wasm = wasm;" & Chr(10)
End Function

#endif
