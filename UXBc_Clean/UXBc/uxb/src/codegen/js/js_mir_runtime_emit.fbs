#ifndef UXB_JS_MIR_RUNTIME_EMIT_FBS
#define UXB_JS_MIR_RUNTIME_EMIT_FBS

Public Function UXBJsEmitPreamble(ByRef wasmPath As String) As String
    Dim outText As String
    outText = ""
    outText &= "import { ux } from " & Chr(34) & "./ux_runtime.js" & Chr(34) & ";" & Chr(10)
    outText &= "import " & Chr(34) & "./ux_canvas2d.js" & Chr(34) & ";" & Chr(10)
    outText &= "import " & Chr(34) & "./ux_input.js" & Chr(34) & ";" & Chr(10)
    outText &= "import " & Chr(34) & "./ux_audio.js" & Chr(34) & ";" & Chr(10)
    outText &= "import " & Chr(34) & "./ux_ai_bridge.js" & Chr(34) & ";" & Chr(10)
    If Trim(wasmPath) <> "" Then
        outText &= "import { loadUxWasm } from " & Chr(34) & "./ux_wasm_bridge.js" & Chr(34) & ";" & Chr(10)
    End If
    outText &= Chr(10)
    Return outText
End Function

Public Function UXBJsEmitMainFooter() As String
    Return "main().catch(err => { console.error(err); ux.print('uXBasic runtime error: ' + err.message); });" & Chr(10)
End Function

#endif
