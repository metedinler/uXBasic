#ifndef UXB_MIR_X64_CAPABILITY_FBS
#define UXB_MIR_X64_CAPABILITY_FBS

' MIR x64 capability map.
' Rule: no silent fallback. Every recognized opcode either emits real NASM
' or fails with explicit diagnostic. Keyword surface is tracked separately in
' mir_x64_keyword_surface.fbs and generated from lexer/parser keywords.

Function MIRX64EmitterAvailable() As Integer
    Return 1
End Function

Function MIRX64OpcodeSupported(ByRef opcodeText As String) As Integer
    Dim op As String
    op = UCase(Trim(opcodeText))

    Select Case op
    Case "LOAD_CONST", "LOAD_VAR", "STORE_VAR", "DIM", "CONST", "DEF_TYPE", "SETSTRINGSIZE", "ADD"
        Return 1
    Case "SUB", "MUL", "DIV", "MOD", "NEG", "EQ", "NE", "LT"
        Return 1
    Case "LE", "GT", "GE", "AND", "OR", "XOR", "NOT", "SHL"
        Return 1
    Case "SHR", "ROL", "ROR", "LABEL", "JMP", "JZ", "JNZ", "CALL"
        Return 1
    Case "RET", "NOP", "MOVE", "ASSIGN"
        Return 1
    Case "LOAD_INDEXED", "STORE_INDEXED", "FADD", "FSUB", "FMUL", "FDIV", "FNEG"
        Return 1
    Case "CAST", "CONV", "CONVERT", "LOAD_ADDR", "STORE_FIELD", "LOAD_FIELD", "NEW"
        Return 1
    Case "REDIM", "CALL_USER", "MEMCOPY", "MEMFILL", "PEEK", "POKE"
        Return 1
    Case "CALL_DLL", "CALL_API", "IMPORT", "INLINE", "TRY", "CATCH", "FINALLY", "THROW"
        Return 1
    Case "ASSERT", "EVENT", "THREAD", "PIPE", "SLOT", "TRIGGER", "CLASS_DECL", "INTERFACE_DECL"
        Return 1
    Case "METHOD_DECL", "CTOR", "DTOR", "DELETE", "ALLOC", "FREE"
        Return 1
    Case Else
        Return 0
    End Select
End Function

Function MIRX64CallTargetSupported(ByRef targetText As String) As Integer
    Dim t As String
    t = UCase(Trim(targetText))

    Select Case t
    Case "PRINT", "PRINTLN", "CONSOLE_PRINT", "CONSOLE_PRINTLN"
        Return 1
    Case "PRINT_SEP_COMMA", "PRINT_SEP_SPACE", "PRINT_SEP_SEMICOLON"
        Return 1
    Case "CLS", "LOCATE", "COLOR", "INPUT", "RANDOMIZE"
        Return 1
    Case "ABS", "INT", "FIX", "SGN", "CINT", "CLNG", "VAL", "LEN", "ASC", "STR", "STR$", "LEFT", "LEFT$", "RIGHT", "RIGHT$", "MID", "MID$", "INSTR"
        Return 1
    Case "OPEN", "CLOSE", "EOF", "LOF", "SEEK", "GET", "PUT", "PRINT_FILE", "INPUT_FILE", "LINE_INPUT_FILE"
        Return 1
    Case "TIMER", "RND", "GETKEY", "INKEY"
        Return 1
    Case Else
        If MIRX64KeywordHasCounterpart(t) <> 0 Then Return 1
        Return 0
    End Select
End Function

Function MIRX64CallTargetDiagnosticOnly(ByRef targetText As String) As Integer
    Dim t As String
    t = UCase(Trim(targetText))
    Select Case t
    Case "PRINT", "PRINTLN", "CONSOLE_PRINT", "CONSOLE_PRINTLN", "PRINT_SEP_COMMA", "PRINT_SEP_SPACE", "PRINT_SEP_SEMICOLON"
        Return 0
    Case "CLS", "LOCATE", "COLOR", "INPUT", "VAL", "LEN", "ASC"
        Return 0
    Case "OPEN", "CLOSE", "EOF", "LOF", "SEEK", "GET", "PUT", "PRINT_FILE", "INPUT_FILE", "LINE_INPUT_FILE"
        Return 0
    Case "STR", "STR$", "LEFT", "LEFT$", "RIGHT", "RIGHT$", "MID", "MID$", "INSTR"
        Return 0
    Case "RANDOMIZE", "ABS", "INT", "FIX", "SGN", "CINT", "CLNG", "TIMER", "RND", "GETKEY", "INKEY"
        Return 1
    Case Else
        If MIRX64KeywordIsNativeReady(t) = 0 Then Return 1
        Return 1
    End Select
End Function

Function MIRX64OpcodeDiagnosticOnly(ByRef opcodeText As String) As Integer
    Dim op As String
    op = UCase(Trim(opcodeText))

    Select Case op
    Case "REDIM", "CALL_USER"
        Return 1
    Case "NEW"
        Return 0
    Case "CAST", "CONV", "CONVERT", "LOAD_ADDR"
        Return 0
    Case "LOAD_INDEXED", "STORE_INDEXED", "FADD", "FSUB", "FMUL", "FDIV", "FNEG", "STORE_FIELD", "LOAD_FIELD", "MEMCOPY", "MEMFILL", "PEEK", "POKE"
        Return 0
    Case "CALL_DLL", "CALL_API", "IMPORT", "INLINE", "TRY", "CATCH", "FINALLY", "THROW"
        Return 1
    Case "ASSERT", "EVENT", "THREAD", "PIPE", "SLOT", "TRIGGER", "CLASS_DECL", "INTERFACE_DECL"
        Return 1
    Case "METHOD_DECL", "CTOR", "DTOR", "DELETE", "ALLOC", "FREE"
        Return 1
    Case Else
        Return 0
    End Select
End Function

#endif
