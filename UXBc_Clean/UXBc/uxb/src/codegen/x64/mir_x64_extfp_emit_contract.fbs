#ifndef UXB_MIR_X64_EXTFP_EMIT_CONTRACT_FBS
#define UXB_MIR_X64_EXTFP_EMIT_CONTRACT_FBS

' MIR x64 EXTFP emit contract.
' All external FP arithmetic is lowered to runtime calls.

Const UXB_MIRX64_EXTFP_ROUTE_UNKNOWN = 0
Const UXB_MIRX64_EXTFP_ROUTE_FROM_STR = 1
Const UXB_MIRX64_EXTFP_ROUTE_TO_STR = 2
Const UXB_MIRX64_EXTFP_ROUTE_COPY = 3
Const UXB_MIRX64_EXTFP_ROUTE_BINARY = 4
Const UXB_MIRX64_EXTFP_ROUTE_CMP = 5
Const UXB_MIRX64_EXTFP_ROUTE_PRINT = 6
Const UXB_MIRX64_EXTFP_ROUTE_DIAGNOSTIC = 7

Function MIRX64ExtFpRouteForOp(ByRef opName As String) As Integer
    Select Case UCase(Trim(opName))
    Case "FROM_STR", "FROM_STRING"
        Return UXB_MIRX64_EXTFP_ROUTE_FROM_STR
    Case "TO_STR", "TO_STRING"
        Return UXB_MIRX64_EXTFP_ROUTE_TO_STR
    Case "COPY"
        Return UXB_MIRX64_EXTFP_ROUTE_COPY
    Case "ADD", "SUB", "MUL", "DIV", "+", "-", "*", "/"
        Return UXB_MIRX64_EXTFP_ROUTE_BINARY
    Case "CMP", "COMPARE"
        Return UXB_MIRX64_EXTFP_ROUTE_CMP
    Case "PRINT"
        Return UXB_MIRX64_EXTFP_ROUTE_PRINT
    Case Else
        Return UXB_MIRX64_EXTFP_ROUTE_DIAGNOSTIC
    End Select
End Function

Function MIRX64ExtFpNativeInstructionForbidden(ByRef asmLine As String) As Integer
    Dim As String s
    s = LCase(Trim(asmLine))
    If Left(s, 3) = "fld" Then Return 1
    If Left(s, 4) = "fstp" Then Return 1
    If Left(s, 4) = "fadd" Then Return 1
    If Left(s, 4) = "fsub" Then Return 1
    If Left(s, 4) = "fmul" Then Return 1
    If Left(s, 4) = "fdiv" Then Return 1
    If InStr(s, "addsd") > 0 Then Return 1
    If InStr(s, "subsd") > 0 Then Return 1
    If InStr(s, "mulsd") > 0 Then Return 1
    If InStr(s, "divsd") > 0 Then Return 1
    If InStr(s, "addss") > 0 Then Return 1
    If InStr(s, "subss") > 0 Then Return 1
    If InStr(s, "mulss") > 0 Then Return 1
    If InStr(s, "divss") > 0 Then Return 1
    Return 0
End Function

#endif
