#ifndef UXB_MIR_X64_RUNTIME_EMIT_HELPERS_FBS
#define UXB_MIR_X64_RUNTIME_EMIT_HELPERS_FBS

' Helper routines to emit Win64 runtime calls from MIR x64 backend.
' These helpers assume Microsoft x64 ABI:
' RCX, RDX, R8, R9 integer/pointer args + 32-byte shadow space.

Sub MIRX64EmitRuntimeExtern(ByRef cg As MIRX64Context, ByRef symbolName As String)
    If Trim(symbolName) = "" Then Exit Sub
    ' Avoid duplicates by simple text check.
    If InStr(cg.externText, "extern " & symbolName) = 0 Then
        MIRX64EmitExtern cg, "extern " & symbolName
    End If
End Sub

Sub MIRX64EmitRuntimeCall0(ByRef cg As MIRX64Context, ByRef symbolName As String)
    MIRX64EmitRuntimeExtern cg, symbolName
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & symbolName
    MIRX64Emit cg, "    add rsp, 32"
End Sub

Sub MIRX64EmitRuntimeCall1Reg(ByRef cg As MIRX64Context, ByRef symbolName As String, ByRef rcxReg As String)
    MIRX64EmitRuntimeExtern cg, symbolName
    MIRX64Emit cg, "    mov rcx, " & rcxReg
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & symbolName
    MIRX64Emit cg, "    add rsp, 32"
End Sub

Sub MIRX64EmitRuntimeCall2Reg(ByRef cg As MIRX64Context, ByRef symbolName As String, ByRef rcxReg As String, ByRef rdxReg As String)
    MIRX64EmitRuntimeExtern cg, symbolName
    MIRX64Emit cg, "    mov rcx, " & rcxReg
    MIRX64Emit cg, "    mov rdx, " & rdxReg
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & symbolName
    MIRX64Emit cg, "    add rsp, 32"
End Sub

Sub MIRX64EmitRuntimeCall3Reg(ByRef cg As MIRX64Context, ByRef symbolName As String, ByRef rcxReg As String, ByRef rdxReg As String, ByRef r8Reg As String)
    MIRX64EmitRuntimeExtern cg, symbolName
    MIRX64Emit cg, "    mov rcx, " & rcxReg
    MIRX64Emit cg, "    mov rdx, " & rdxReg
    MIRX64Emit cg, "    mov r8, " & r8Reg
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & symbolName
    MIRX64Emit cg, "    add rsp, 32"
End Sub

Sub MIRX64EmitRuntimeCall4Reg(ByRef cg As MIRX64Context, ByRef symbolName As String, ByRef rcxReg As String, ByRef rdxReg As String, ByRef r8Reg As String, ByRef r9Reg As String)
    MIRX64EmitRuntimeExtern cg, symbolName
    MIRX64Emit cg, "    mov rcx, " & rcxReg
    MIRX64Emit cg, "    mov rdx, " & rdxReg
    MIRX64Emit cg, "    mov r8, " & r8Reg
    MIRX64Emit cg, "    mov r9, " & r9Reg
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & symbolName
    MIRX64Emit cg, "    add rsp, 32"
End Sub

Function MIRX64EmitRuntimePrintI64(ByRef cg As MIRX64Context, ByRef valueReg As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_print_i64", valueReg
    Return 1
End Function

Function MIRX64EmitRuntimePrintCStr(ByRef cg As MIRX64Context, ByRef valueReg As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_print_cstr", valueReg
    Return 1
End Function

Function MIRX64EmitRuntimePrintNewline(ByRef cg As MIRX64Context) As Integer
    MIRX64EmitRuntimeCall0 cg, "__uxb_rt_print_newline"
    Return 1
End Function

Function MIRX64EmitRuntimeCls(ByRef cg As MIRX64Context) As Integer
    MIRX64EmitRuntimeCall0 cg, "__uxb_rt_cls"
    Return 1
End Function

Function MIRX64EmitRuntimeInputI64(ByRef cg As MIRX64Context, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall0 cg, "__uxb_rt_input_i64"
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeLocate(ByRef cg As MIRX64Context, ByRef rowReg As String, ByRef colReg As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_locate", rowReg, colReg
    Return 1
End Function

Function MIRX64EmitRuntimeColor(ByRef cg As MIRX64Context, ByRef fgReg As String, ByRef bgReg As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_color", fgReg, bgReg
    Return 1
End Function

Function MIRX64EmitRuntimeMemoryCopy(ByRef cg As MIRX64Context, ByRef dstReg As String, ByRef srcReg As String, ByRef bytesReg As String) As Integer
    MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_memcopy", dstReg, srcReg, bytesReg
    Return 1
End Function

Function MIRX64EmitRuntimeMemoryFill(ByRef cg As MIRX64Context, ByRef dstReg As String, ByRef valueReg As String, ByRef bytesReg As String) As Integer
    MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_memfill", dstReg, valueReg, bytesReg
    Return 1
End Function

Function MIRX64EmitRuntimeStringLen(ByRef cg As MIRX64Context, ByRef valueReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_strlen", valueReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeValueI64(ByRef cg As MIRX64Context, ByRef valueReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_val_i64", valueReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimePeekI64(ByRef cg As MIRX64Context, ByRef addrReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_peek_i64", addrReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimePokeI64(ByRef cg As MIRX64Context, ByRef addrReg As String, ByRef valueReg As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_poke_i64", addrReg, valueReg
    Return 1
End Function

Function MIRX64EmitRuntimeStringRight(ByRef cg As MIRX64Context, ByRef textReg As String, ByRef countReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_right", textReg, countReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringLeft(ByRef cg As MIRX64Context, ByRef textReg As String, ByRef countReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_left", textReg, countReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringMid(ByRef cg As MIRX64Context, ByRef textReg As String, ByRef startReg As String, ByRef lenReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_mid", textReg, startReg, lenReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringInstr(ByRef cg As MIRX64Context, ByRef textReg As String, ByRef needleReg As String, ByRef startReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_instr", textReg, needleReg, startReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringFromI64(ByRef cg As MIRX64Context, ByRef valueReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_str_i64", valueReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFileOpen(ByRef cg As MIRX64Context, ByRef fileReg As String, ByRef modeReg As String, ByRef handleReg As String, ByRef lenReg As String) As Integer
    If Trim(lenReg) = "" Then
        MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_file_open", fileReg, modeReg, handleReg
    Else
        MIRX64EmitRuntimeCall4Reg cg, "__uxb_rt_file_open", fileReg, modeReg, handleReg, lenReg
    End If
    Return 1
End Function

Function MIRX64EmitRuntimeFileClose(ByRef cg As MIRX64Context, ByRef handleReg As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_file_close", handleReg
    Return 1
End Function

Function MIRX64EmitRuntimeFileSeek(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef posReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    If Trim(posReg) = "" Then
        MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_file_seek", handleReg
    Else
        MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_file_seek", handleReg, posReg
    End If
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFileEof(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_file_eof", handleReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFileLof(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_file_lof", handleReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFileGet(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef posReg As String, ByRef bytesReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    If Trim(posReg) = "" Then
        MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_file_get", handleReg
    ElseIf Trim(bytesReg) = "" Then
        MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_file_get", handleReg, posReg
    Else
        MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_file_get", handleReg, posReg, bytesReg
    End If
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFilePut(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef posReg As String, ByRef bytesReg As String, ByRef valueReg As String) As Integer
    If Trim(posReg) = "" Then
        MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_file_put", handleReg, valueReg
    ElseIf Trim(bytesReg) = "" Then
        MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_file_put", handleReg, posReg, valueReg
    Else
        MIRX64EmitRuntimeCall4Reg cg, "__uxb_rt_file_put", handleReg, posReg, bytesReg, valueReg
    End If
    Return 1
End Function

Function MIRX64EmitRuntimeUnsupportedDiagnostic(ByRef cg As MIRX64Context, ByRef opcodeText As String, ByRef reasonText As String) As Integer
    MIRX64AddError cg, "TR: MIR_X64_RUNTIME_BACKED_BEKLEMEDE: " & opcodeText & " - " & reasonText & " | EN: MIR_X64_RUNTIME_BACKED_PENDING: " & opcodeText & " - " & reasonText
    Return 0
End Function

#endif
