#ifndef UXB_MIR_X64_RUNTIME_CALL_CONTRACT_FBS
#define UXB_MIR_X64_RUNTIME_CALL_CONTRACT_FBS

' Runtime-backed MIR x64 call contract.
' x64 MIR backend should emit calls to these symbols instead of fake native implementations.

Const UXB_RT_FAMILY_CONSOLE = 1
Const UXB_RT_FAMILY_STRING = 2
Const UXB_RT_FAMILY_FILE = 3
Const UXB_RT_FAMILY_MEMORY = 4
Const UXB_RT_FAMILY_EXTFP = 5
Const UXB_RT_FAMILY_UNKNOWN = 0

Function MIRX64RuntimeFamilyName(ByVal fam As Integer) As String
    Select Case fam
    Case UXB_RT_FAMILY_CONSOLE
        Return "console"
    Case UXB_RT_FAMILY_STRING
        Return "string"
    Case UXB_RT_FAMILY_FILE
        Return "file"
    Case UXB_RT_FAMILY_MEMORY
        Return "memory"
    Case UXB_RT_FAMILY_EXTFP
        Return "extfp"
    Case Else
        Return "unknown"
    End Select
End Function

Function MIRX64RuntimeSymbolForOpcode(ByRef opcodeText As String, ByRef callTarget As String) As String
    Dim As String op
    Dim As String target
    op = UCase(Trim(opcodeText))
    target = UCase(Trim(callTarget))

    Select Case op
    Case "PRINT"
        Return "__uxb_rt_print_i64"
    Case "PRINTLN"
        Return "__uxb_rt_print_newline"
    Case "INPUT"
        Return "__uxb_rt_input_i64"
    Case "CLS"
        Return "__uxb_rt_cls"
    Case "LOCATE"
        Return "__uxb_rt_locate"
    Case "COLOR"
        Return "__uxb_rt_color"
    Case "OPEN"
        Return "__uxb_rt_file_open"
    Case "CLOSE"
        Return "__uxb_rt_file_close"
    Case "EOF"
        Return "__uxb_rt_file_eof"
    Case "LOF"
        Return "__uxb_rt_file_lof"
    Case "SEEK"
        Return "__uxb_rt_file_seek"
    Case "GET"
        Return "__uxb_rt_file_get"
    Case "PUT"
        Return "__uxb_rt_file_put"
    Case "MEMCOPY"
        Return "__uxb_rt_memcopy"
    Case "MEMFILL"
        Return "__uxb_rt_memfill"
    Case "PEEK"
        Return "__uxb_rt_peek_i64"
    Case "POKE"
        Return "__uxb_rt_poke_i64"
    Case "CALL"
        Select Case target
        Case "LEN"
            Return "__uxb_rt_strlen"
        Case "ASC"
            Return "__uxb_rt_asc"
        Case "CHR", "CHR$"
            Return "__uxb_rt_chr"
        Case "VAL"
            Return "__uxb_rt_val_i64"
        Case "STR", "STR$"
            Return "__uxb_rt_str_i64"
        Case "LEFT", "LEFT$"
            Return "__uxb_rt_left"
        Case "RIGHT", "RIGHT$"
            Return "__uxb_rt_right"
        Case "MID", "MID$"
            Return "__uxb_rt_mid"
        Case "INSTR"
            Return "__uxb_rt_instr"
        Case Else
            Return ""
        End Select
    Case Else
        Return ""
    End Select
End Function

Function MIRX64RuntimeFamilyForSymbol(ByRef symbolName As String) As Integer
    Dim As String s
    s = LCase(Trim(symbolName))
    If Left(s, 15) = "__uxb_rt_print" Or Left(s, 14) = "__uxb_rt_input" Or s = "__uxb_rt_cls" Or s = "__uxb_rt_locate" Or s = "__uxb_rt_color" Then
        Return UXB_RT_FAMILY_CONSOLE
    End If
    If Left(s, 12) = "__uxb_rt_str" Or InStr(s, "strlen") > 0 Or InStr(s, "_left") > 0 Or InStr(s, "_right") > 0 Or InStr(s, "_mid") > 0 Or InStr(s, "_instr") > 0 Then
        Return UXB_RT_FAMILY_STRING
    End If
    If Left(s, 13) = "__uxb_rt_file" Then
        Return UXB_RT_FAMILY_FILE
    End If
    If InStr(s, "mem") > 0 Or InStr(s, "peek") > 0 Or InStr(s, "poke") > 0 Then
        Return UXB_RT_FAMILY_MEMORY
    End If
    If InStr(s, "f80") > 0 Or InStr(s, "f128") > 0 Or InStr(s, "big") > 0 Or InStr(s, "ball") > 0 Then
        Return UXB_RT_FAMILY_EXTFP
    End If
    Return UXB_RT_FAMILY_UNKNOWN
End Function

#endif
