#ifndef UXB_MIR_X64_TYPE_CLASS_FFI_EMIT_HELPERS_FBS
#define UXB_MIR_X64_TYPE_CLASS_FFI_EMIT_HELPERS_FBS

' Emit helpers for TYPE / CLASS / FFI in MIR x64 backend.
' These helpers are deliberately strict: no fake offsets, no fake ABI.

Function MIRX64EmitTypeFieldLoadByOffset( _
    ByRef cg As MIRX64Context, _
    ByRef baseReg As String, _
    ByVal fieldOffset As Integer, _
    ByRef outReg As String, _
    ByRef errText As String _
) As Integer
    errText = ""

    If fieldOffset < 0 Then
        errText = "UXB_TYPE_FIELD_OFFSET_MISSING"
        MIRX64AddError cg, errText
        Return 0
    End If

    MIRX64Emit cg, "    mov " & outReg & ", [" & baseReg & " + " & Str(fieldOffset) & "]"
    Return 1
End Function

Function MIRX64EmitTypeFieldStoreByOffset( _
    ByRef cg As MIRX64Context, _
    ByRef baseReg As String, _
    ByVal fieldOffset As Integer, _
    ByRef valueReg As String, _
    ByRef errText As String _
) As Integer
    errText = ""

    If fieldOffset < 0 Then
        errText = "UXB_TYPE_FIELD_OFFSET_MISSING"
        MIRX64AddError cg, errText
        Return 0
    End If

    MIRX64Emit cg, "    mov [" & baseReg & " + " & Str(fieldOffset) & "], " & valueReg
    Return 1
End Function

Function MIRX64EmitDirectMethodCall( _
    ByRef cg As MIRX64Context, _
    ByRef methodSymbol As String, _
    ByRef thisReg As String, _
    ByRef errText As String _
) As Integer
    errText = ""

    If Trim(methodSymbol) = "" Then
        errText = "UXB_CLASS_METHOD_SYMBOL_MISSING"
        MIRX64AddError cg, errText
        Return 0
    End If

    ' Win64 ABI: this pointer in RCX for direct method call.
    MIRX64Emit cg, "    mov rcx, " & thisReg
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & methodSymbol
    MIRX64Emit cg, "    add rsp, 32"
    Return 1
End Function

Function MIRX64EmitObjectRuntimeCall( _
    ByRef cg As MIRX64Context, _
    ByRef runtimeSymbol As String, _
    ByRef argReg As String, _
    ByRef errText As String _
) As Integer
    errText = ""

    If Trim(runtimeSymbol) = "" Then
        errText = "UXB_OBJECT_RUNTIME_SYMBOL_MISSING"
        MIRX64AddError cg, errText
        Return 0
    End If

    MIRX64Emit cg, "extern " & runtimeSymbol
    If Trim(argReg) <> "" Then
        MIRX64Emit cg, "    mov rcx, " & argReg
    End If
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & runtimeSymbol
    MIRX64Emit cg, "    add rsp, 32"
    Return 1
End Function

Function MIRX64EmitWin64Call0(ByRef cg As MIRX64Context, ByRef targetSymbol As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(targetSymbol) = "" Then
        errText = "UXB_FFI_TARGET_SYMBOL_MISSING"
        MIRX64AddError cg, errText
        Return 0
    End If
    MIRX64Emit cg, "extern " & targetSymbol
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & targetSymbol
    MIRX64Emit cg, "    add rsp, 32"
    Return 1
End Function

Function MIRX64EmitWin64Call1( _
    ByRef cg As MIRX64Context, _
    ByRef targetSymbol As String, _
    ByRef rcxReg As String, _
    ByRef errText As String _
) As Integer
    errText = ""
    If Trim(targetSymbol) = "" Then
        errText = "UXB_FFI_TARGET_SYMBOL_MISSING"
        MIRX64AddError cg, errText
        Return 0
    End If
    MIRX64Emit cg, "extern " & targetSymbol
    MIRX64Emit cg, "    mov rcx, " & rcxReg
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & targetSymbol
    MIRX64Emit cg, "    add rsp, 32"
    Return 1
End Function

Function MIRX64EmitWin64Call2( _
    ByRef cg As MIRX64Context, _
    ByRef targetSymbol As String, _
    ByRef rcxReg As String, _
    ByRef rdxReg As String, _
    ByRef errText As String _
) As Integer
    errText = ""
    If Trim(targetSymbol) = "" Then
        errText = "UXB_FFI_TARGET_SYMBOL_MISSING"
        MIRX64AddError cg, errText
        Return 0
    End If
    MIRX64Emit cg, "extern " & targetSymbol
    MIRX64Emit cg, "    mov rcx, " & rcxReg
    MIRX64Emit cg, "    mov rdx, " & rdxReg
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call " & targetSymbol
    MIRX64Emit cg, "    add rsp, 32"
    Return 1
End Function

Function MIRX64EmitInlineGuardDiagnostic(ByRef cg As MIRX64Context, ByRef reasonText As String) As Integer
    MIRX64AddError cg, "UXB_INLINE_GUARD_REQUIRED: " & reasonText
    Return 0
End Function

#endif
