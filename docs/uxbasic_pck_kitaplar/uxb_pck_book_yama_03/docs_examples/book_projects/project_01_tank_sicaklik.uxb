' Project 01: Tank sicaklik izleyici
DIM sicaklik(3) AS I32
sicaklik(1) = 18
sicaklik(2) = 24
sicaklik(3) = 21

DIM i AS I32
DIM toplam AS I32 = 0

FOR i = 1 TO 3
    toplam = toplam + sicaklik(i)
    IF sicaklik(i) < 19 THEN
        PRINT "TANK_DUSUK"
    ELSEIF sicaklik(i) > 23 THEN
        PRINT "TANK_YUKSEK"
    ELSE
        PRINT "TANK_NORMAL"
    END IF
NEXT i

PRINT toplam / 3
