{
  "module": "uxnn",
  "external_dependencies": [
    {
      "name": "MSYS2 UCRT64 GCC",
      "package": "mingw-w64-ucrt-x86_64-gcc",
      "required": true
    },
    {
      "name": "OpenBLAS",
      "package": "mingw-w64-ucrt-x86_64-openblas",
      "required": false,
      "fallback": "pure C loops"
    },
    {
      "name": "pkgconf",
      "package": "pkgconf",
      "required": false
    }
  ],
  "runtime_dlls": [
    "uxnn.dll",
    "libopenblas.dll",
    "libgfortran-5.dll",
    "libquadmath-0.dll",
    "libgcc_s_seh-1.dll",
    "libwinpthread-1.dll",
    "libstdc++-6.dll"
  ]
}