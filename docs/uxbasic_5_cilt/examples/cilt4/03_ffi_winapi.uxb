MAIN
    DIM ilk AS U32
    DIM ikinci AS U32

    ilk = U32(CALL(API, "kernel32", "GetTickCount", U32, STDCALL))
    CALL(DLL, "kernel32.dll", "Sleep", VOID, STDCALL, 5)
    ikinci = U32(CALL(DLL, "kernel32.dll", "GetTickCount", U32, STDCALL))

    ASSERT ikinci >= ilk
    PRINT "WINAPI_TICK_OK"
    PRINT "CILT4_FFI_PASS"
END MAIN
