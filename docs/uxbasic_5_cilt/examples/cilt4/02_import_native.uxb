DECLARE FUNCTION agirlik_katsayisi LIB "uxb_book_native.dll" ALIAS "agirlik_katsayisi" (BYVAL agirlik AS F64, BYVAL katsayi AS F64) AS F64
DECLARE FUNCTION koli_topla LIB "uxb_book_native.dll" ALIAS "koli_topla" (BYVAL a AS I32, BYVAL b AS I32) AS I32

PRINT "CILT4_IMPORT_SURFACE_PASS"
