FUNCTION KargoUcreti(BYVAL agirlik AS I32, BYVAL uzaklik AS I32) AS I32
    DIM taban AS I32
    DIM agirlikPayi AS I32
    DIM uzaklikPayi AS I32

    taban = 35
    agirlikPayi = agirlik * 8
    uzaklikPayi = uzaklik \ 10
    RETURN taban + agirlikPayi + uzaklikPayi
END FUNCTION

MAIN
    DIM ucret AS I32
    ucret = KargoUcreti(4, 120)
    ASSERT ucret = 79
    PRINT "KARGO_UCRETI="; ucret
    PRINT "CILT1_KARGO_PASS"
END MAIN
