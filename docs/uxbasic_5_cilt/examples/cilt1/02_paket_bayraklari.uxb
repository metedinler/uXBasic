MAIN
    DIM kirilabilir AS U8
    DIM sogukZincir AS U8
    DIM ekspres AS U8
    DIM bayraklar AS U8
    DIM sogukMu AS BOOLEAN

    kirilabilir = U8(1)
    sogukZincir = U8(2)
    ekspres = U8(4)
    bayraklar = U8(kirilabilir OR sogukZincir)
    sogukMu = (bayraklar AND sogukZincir) <> 0

    ASSERT bayraklar = 3
    ASSERT sogukMu
    ASSERT (bayraklar AND ekspres) = 0
    PRINT "PAKET_BAYRAKLARI="; bayraklar
    PRINT "CILT1_BIT_PASS"
END MAIN
