MAIN
    DIM kuyruk AS LIST
    DIM bolgeler AS SET
    DIM adet AS I32

    CALL LISTADD(kuyruk, 8101)
    CALL LISTADD(kuyruk, 8102)
    CALL SETADD(bolgeler, "A")
    CALL SETADD(bolgeler, "A")
    CALL SETADD(bolgeler, "B")
    adet = LISTLEN(kuyruk)

    ASSERT adet = 2
    ASSERT SETLEN(bolgeler) = 2
    PRINT "COLLECTION_LEN_I32="; adet
    PRINT "BOOK_REG_COLLECTION_PASS"
END MAIN
