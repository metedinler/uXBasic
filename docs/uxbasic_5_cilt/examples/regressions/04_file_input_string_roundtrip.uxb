MAIN
    DIM metin AS STRING
    DIM sayi AS I32

    OPEN "docs/uxbasic_5_cilt/reports/book_file_string.txt" FOR OUTPUT AS #41
    PRINT #41, "DOSYA"
    PRINT #41, "902"
    CLOSE #41

    OPEN "docs/uxbasic_5_cilt/reports/book_file_string.txt" FOR INPUT AS #42
    INPUT #42, metin
    INPUT #42, sayi
    CLOSE #42

    ASSERT metin = "DOSYA"
    ASSERT sayi = 902
    PRINT "FILE_STRING="; metin; ":"; sayi
    PRINT "BOOK_REG_FILE_STRING_PASS"
END MAIN
