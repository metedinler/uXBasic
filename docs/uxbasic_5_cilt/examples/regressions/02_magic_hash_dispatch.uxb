CLASS Anahtar
PUBLIC
    MAGIC HASH() AS I32
        RETURN 701
    END MAGIC
END CLASS

MAIN
    DIM anahtar AS Anahtar
    DIM hashDegeri AS I32

    anahtar = NEW Anahtar()
    hashDegeri = anahtar.HASH()

    ASSERT hashDegeri = 701
    PRINT "MAGIC_HASH="; hashDegeri
    PRINT "BOOK_REG_MAGIC_HASH_PASS"
END MAIN
