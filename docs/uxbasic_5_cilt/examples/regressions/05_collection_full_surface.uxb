MAIN
    DIM sayilar AS LIST
    DIM puanlar AS DICT
    DIM etiketler AS SET

    CALL LISTADD(sayilar, 10)
    CALL LISTADD(sayilar, 20)
    ASSERT LISTLEN(sayilar) = 2
    ASSERT LISTGET(sayilar, 1) = 20
    CALL LISTSET(sayilar, 1, 25)
    ASSERT LISTGET(sayilar, 1) = 25
    CALL LISTREMOVE(sayilar, 0)
    ASSERT LISTLEN(sayilar) = 1
    ASSERT LISTGET(sayilar, 0) = 25

    CALL DICTSET(puanlar, "ali", 70)
    CALL DICTSET(puanlar, "ayse", 80)
    CALL DICTSET(puanlar, "ali", 75)
    ASSERT DICTLEN(puanlar) = 2
    ASSERT DICTHAS(puanlar, "ali")
    ASSERT NOT DICTHAS(puanlar, "mete")
    ASSERT DICTGET(puanlar, "ali") = 75

    CALL SETADD(etiketler, "x64")
    CALL SETADD(etiketler, "x64")
    CALL SETADD(etiketler, "wasm")
    ASSERT SETLEN(etiketler) = 2
    ASSERT SETHAS(etiketler, "x64")
    CALL SETREMOVE(etiketler, "x64")
    ASSERT NOT SETHAS(etiketler, "x64")
    ASSERT SETLEN(etiketler) = 1

    CALL LISTCLEAR(sayilar)
    CALL DICTCLEAR(puanlar)
    CALL SETCLEAR(etiketler)
    ASSERT LISTLEN(sayilar) = 0
    ASSERT DICTLEN(puanlar) = 0
    ASSERT SETLEN(etiketler) = 0

    PRINT "BOOK_REG_COLLECTION_FULL_PASS"
END MAIN
