FUNCTION TESLIMSKOR(BYVAL teslim AS I32, BYVAL gecikme AS I32, BYVAL hasar AS I32) AS I32
    RETURN teslim * 10 - gecikme * 3 - hasar * 7
END FUNCTION

DIM skor AS I32
skor = TESLIMSKOR(18, 4, 2)
ASSERT skor = 154

CALL SCREEN(960, 540)
CLS
CALL FILLRECT(24, 24, 912, 72)
CALL FILLRECT(24, 120, 280, 160)
CALL FILLRECT(340, 120, 280, 160)
CALL FILLRECT(656, 120, 280, 160)
CALL TEXT(48, 68, "uXBasic Kargo Operasyon Panosu")
CALL TEXT(48, 168, "Teslim: 18")
CALL TEXT(364, 168, "Gecikme: 4")
CALL TEXT(680, 168, "Hasar: 2")
PRINT skor
PRINT "HIBRIT_PANO_PASS"
