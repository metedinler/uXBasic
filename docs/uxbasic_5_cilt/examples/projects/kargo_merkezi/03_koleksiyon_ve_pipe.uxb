PIPE RiskSinirla puan AS I32
    IF puan > 100 THEN
        OUTPUT = 100
    ELSE
        OUTPUT = puan
    END IF
END PIPE

SLOT
    RiskSlot 12 ON PIPE RiskSinirla
END SLOT

MAIN
    DIM bekleyen AS LIST
    DIM durum AS DICT
    DIM bolge AS SET
    DIM adet AS I32
    DIM risk AS I32

    CALL LISTADD(bekleyen, 7308)
    CALL LISTADD(bekleyen, 7310)
    CALL DICTSET(durum, "7308", 1)
    CALL DICTSET(durum, "7310", 2)
    CALL SETADD(bolge, "IC_ANADOLU")
    CALL SETADD(bolge, "EGE")

    adet = LISTLEN(bekleyen)
    risk = 137 |> RiskSinirla

    ASSERT adet = 2
    ASSERT risk = 100
    ASSERT SETLEN(bolge) = 2
    TRIGGER RiskSinirla, 64
    ASSERT OUTPUT = 64
    PRINT "KUYRUK="; adet
    PRINT "SINIRLI_RISK="; risk
    PRINT "KARGO_ASAMA3_PASS"
END MAIN
