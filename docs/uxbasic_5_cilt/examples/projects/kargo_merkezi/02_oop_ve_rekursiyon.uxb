CLASS GonderiKurali
PUBLIC
    METHOD Hesapla(BYVAL agirlik AS I32) AS I32
        RETURN 40 + agirlik * 5
    END METHOD
END CLASS

MAIN
    DIM kural AS GonderiKurali
    DIM risk AS I32

    kural = NEW GonderiKurali()
    risk = kural.Hesapla(9)

    ASSERT risk = 85
    PRINT "RISK="; risk
    PRINT "KARGO_ASAMA2_OOP_PASS"
END MAIN
