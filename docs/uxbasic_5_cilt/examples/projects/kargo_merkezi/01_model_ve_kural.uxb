TYPE Gonderi
    kod AS I32
    agirlik AS I32
    uzaklik AS I32
    oncelik AS U8
END TYPE

FUNCTION UcretHesapla(BYVAL agirlik AS I32, BYVAL uzaklik AS I32, BYVAL oncelik AS U8) AS I32
    DIM sonuc AS I32
    sonuc = 30 + agirlik * 8 + uzaklik \ 20
    IF oncelik = U8(1) THEN
        sonuc = sonuc + 25
    END IF
    RETURN sonuc
END FUNCTION

MAIN
    DIM g AS Gonderi
    DIM ucret AS I32

    g.kod = 7001
    g.agirlik = 6
    g.uzaklik = 180
    g.oncelik = U8(1)
    ucret = UcretHesapla(g.agirlik, g.uzaklik, g.oncelik)

    ASSERT ucret = 112
    PRINT "MODEL_KOD="; g.kod
    PRINT "MODEL_UCRET="; ucret
    PRINT "KARGO_ASAMA1_PASS"
END MAIN
