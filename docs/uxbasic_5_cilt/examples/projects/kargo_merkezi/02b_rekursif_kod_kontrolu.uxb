FUNCTION BasamakToplami(BYVAL deger AS I32) AS I32
    IF deger < 10 THEN
        RETURN deger
    END IF
    RETURN (deger MOD 10) + BasamakToplami(deger \ 10)
END FUNCTION

MAIN
    DIM kodKontrol AS I32
    kodKontrol = BasamakToplami(7308)
    ASSERT kodKontrol = 18
    PRINT "KOD_KONTROL="; kodKontrol
    PRINT "KARGO_ASAMA2_RECURSION_PASS"
END MAIN
