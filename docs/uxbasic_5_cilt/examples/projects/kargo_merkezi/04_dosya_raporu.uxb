MAIN
    DIM kod AS I32
    DIM durum AS I32

    OPEN "docs/uxbasic_5_cilt/examples/projects/kargo_merkezi/operasyon_raporu.txt" FOR OUTPUT AS #17
    PRINT #17, "7401"
    PRINT #17, "2"
    CLOSE #17

    OPEN "docs/uxbasic_5_cilt/examples/projects/kargo_merkezi/operasyon_raporu.txt" FOR INPUT AS #18
    INPUT #18, kod
    INPUT #18, durum
    CLOSE #18

    ASSERT kod = 7401
    ASSERT durum = 2
    PRINT "RAPOR_KOD="; kod
    PRINT "RAPOR_DURUM="; durum
    PRINT "KARGO_ASAMA4_PASS"
END MAIN
