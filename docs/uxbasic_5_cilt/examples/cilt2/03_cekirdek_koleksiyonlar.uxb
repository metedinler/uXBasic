MAIN
    DIM kuyruk AS LIST
    DIM durumlar AS DICT
    DIM bolgeler AS SET
    DIM adet AS I32
    DIM ilk AS OBJECT
    DIM durum AS OBJECT

    CALL LISTADD(kuyruk, 4101)
    CALL LISTADD(kuyruk, 4102)
    adet = LISTLEN(kuyruk)
    ilk = LISTGET(kuyruk, 0)

    CALL DICTSET(durumlar, "4101", 1)
    CALL DICTSET(durumlar, "4102", 2)
    durum = DICTGET(durumlar, "4102")

    CALL SETADD(bolgeler, "ANKARA")
    CALL SETADD(bolgeler, "ANKARA")
    CALL SETADD(bolgeler, "IZMIR")

    ASSERT adet = 2
    ASSERT ilk = 4101
    ASSERT durum = 2
    ASSERT SETLEN(bolgeler) = 2
    PRINT "KOLEKSIYON_ADET="; adet
    PRINT "CILT2_COLLECTION_PASS"
END MAIN
