CLASS GonderiKurali
PUBLIC
    METHOD Hesapla(BYVAL agirlik AS I32) AS I32
        RETURN 40 + agirlik * 5
    END METHOD
END CLASS

MAIN
    DIM kural AS GonderiKurali
    DIM tutar AS I32
    kural = NEW GonderiKurali()
    tutar = kural.Hesapla(6)
    ASSERT tutar = 70
    PRINT "OOP_TUTAR="; tutar
    PRINT "CILT2_OOP_PASS"
END MAIN
