FUNCTION RiskPuani(BYVAL gecikme AS I32, BYVAL hasar AS I32) AS I32
    DIM puan AS I32
    puan = gecikme * 3 + hasar * 7
    IF puan > 100 THEN
        RETURN 100
    END IF
    RETURN puan
END FUNCTION

MAIN
    DIM risk AS I32
    risk = RiskPuani(8, 5)
    ASSERT risk = 59
    PRINT "PIPELINE_RISK="; risk
    PRINT "CILT3_PIPELINE_PASS"
END MAIN
