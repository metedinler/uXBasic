{
  "schema_version": "uxb-external-dependencies-1",
  "module": "uxtensor",
  "primary_backend": "OpenBLAS/CBLAS via MSYS2 UCRT64",
  "fallback_backend": "plain C loops",
  "install_script": "uxb/runtime_ext/uxtensor/fetch_uxtensor_deps_msys2.bat",
  "copy_script": "uxb/runtime_ext/uxtensor/copy_uxtensor_runtime_deps.bat",
  "local_dependency_cache": "uxb/dist/runtime_ext/deps/uxtensor",
  "dependencies": [
    {"name": "MSYS2 UCRT64 GCC", "package": "mingw-w64-ucrt-x86_64-gcc", "manager": "pacman", "required": true},
    {"name": "OpenBLAS", "package": "mingw-w64-ucrt-x86_64-openblas", "manager": "pacman", "required": false, "preferred": true},
    {"name": "pkgconf", "package": "pkgconf", "manager": "pacman", "required": false, "preferred": true}
  ],
  "runtime_dlls_copied_when_present": [
    "libopenblas.dll",
    "libgfortran-5.dll",
    "libquadmath-0.dll",
    "libgcc_s_seh-1.dll",
    "libwinpthread-1.dll",
    "libstdc++-6.dll",
    "uxtensor.dll"
  ]
}
