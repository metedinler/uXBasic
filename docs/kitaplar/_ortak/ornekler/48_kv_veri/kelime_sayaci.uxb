' KONU: Orta düzey: DICT ile kelime sayma
' KOMUTLAR: DICT DICTSET DICTGET DICTHAS FOR EACH
' ACIKLAMA: Metni boşluklardan keserek kelimeleri sayar. DICTGET sonucu OBJECT olduğundan toplamadan önce CINT ile sayıya çevrilir.
'= elma=3
'= armut=2
'= kiraz=1
DIM metin AS STRING = "elma armut elma kiraz armut elma "
DIM sayac AS DICT
DIM kelime AS STRING = ""
DIM c AS STRING
DIM i AS I32
FOR i = 1 TO LEN(metin)
    c = MID(metin, i, 1)
    IF c = " " THEN
        IF DICTHAS(sayac, kelime) THEN
            DICTSET(sayac, kelime, CINT(DICTGET(sayac, kelime)) + 1)
        ELSE
            DICTSET(sayac, kelime, 1)
        END IF
        kelime = ""
    ELSE
        kelime = kelime + c
    END IF
NEXT
DIM anahtar AS STRING
FOR EACH anahtar IN sayac
    PRINT anahtar; "="; DICTGET(sayac, anahtar)
NEXT
