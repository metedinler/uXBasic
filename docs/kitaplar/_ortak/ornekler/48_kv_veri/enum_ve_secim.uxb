' KONU: ENUM ile adlandırılmış sabitler ve SELECT CASE
' KOMUTLAR: ENUM SELECT CASE
' ACIKLAMA: ENUM üyeleri 0'dan (ya da verilen değerden) başlayıp birer birer artar; tip olarak kullanılabilir.
'= sali
'= 3
ENUM Gun
    PZT = 1
    SAL
    CAR
END ENUM

DIM g AS Gun = Gun.SAL
SELECT CASE g
    CASE Gun.PZT
        PRINT "pazartesi"
    CASE Gun.SAL
        PRINT "sali"
END SELECT
PRINT Gun.CAR
