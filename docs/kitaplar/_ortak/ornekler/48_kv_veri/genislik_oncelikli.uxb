' KONU: Üst düzey: LIST ile kuyruk ve genişlik öncelikli gezinti (BFS)
' KOMUTLAR: LIST LISTADD LISTREMOVE LISTLEN dizi
' ACIKLAMA: Beş düğümlü bir grafı komşuluk matrisiyle tutar; LIST'i kuyruk gibi kullanıp düğümleri ziyaret sırasıyla yazar.
'= 0 1 2 3 4
DIM bagli(4, 4) AS I32
bagli(0, 1) = 1: bagli(1, 0) = 1
bagli(0, 2) = 1: bagli(2, 0) = 1
bagli(1, 3) = 1: bagli(3, 1) = 1
bagli(2, 3) = 1: bagli(3, 2) = 1
bagli(3, 4) = 1: bagli(4, 3) = 1

DIM gorulen(4) AS I32
DIM kuyruk AS LIST
DIM dugum AS I32
DIM k AS I32
LISTADD(kuyruk, 0)
gorulen(0) = 1
DO WHILE LISTLEN(kuyruk) > 0
    dugum = CINT(LISTGET(kuyruk, 0))
    LISTREMOVE(kuyruk, 0)
    PRINT dugum; " ";
    FOR k = 0 TO 4
        IF bagli(dugum, k) = 1 AND gorulen(k) = 0 THEN
            gorulen(k) = 1
            LISTADD(kuyruk, k)
        END IF
    NEXT
LOOP
PRINT
