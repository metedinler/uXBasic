' KONU: Orta düzey: TYPE dizisi ve kabarcık sıralaması
' KOMUTLAR: TYPE dizi FOR IF
' ACIKLAMA: Kayıtların yaşa göre sıralanması: alanlar tek tek takas edilir.
'= 2 20
'= 3 25
'= 1 30
TYPE Kisi
    no AS I32
    yas AS I32
END TYPE

DIM k(2) AS Kisi
k(0).no = 1: k(0).yas = 30
k(1).no = 2: k(1).yas = 20
k(2).no = 3: k(2).yas = 25
DIM i AS I32
DIM j AS I32
DIM gecici AS I32
FOR i = 0 TO 1
    FOR j = 0 TO 1 - i
        IF k(j).yas > k(j + 1).yas THEN
            gecici = k(j).yas
            k(j).yas = k(j + 1).yas
            k(j + 1).yas = gecici
            gecici = k(j).no
            k(j).no = k(j + 1).no
            k(j + 1).no = gecici
        END IF
    NEXT
NEXT
FOR i = 0 TO 2
    PRINT k(i).no; " "; k(i).yas
NEXT
