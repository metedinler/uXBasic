' KONU: Üst düzey: uxdataframe (DuckDB) ile satış tablosu: SQL ile gruplama ve sıralama
' KOMUTLAR: INCLUDE uxdataframe.OpenMemory uxdataframe.Exec uxdataframe.Query uxdataframe.GetText
' ACIKLAMA: Bellek içi DuckDB veritabanında satış tablosu kurulur; bölge bazında ciro (adet x fiyat) toplanıp büyükten küçüğe sıralanır, sonuç tablosunun satır ve sütunları gezilir. Sorgu sonucu bir tutamaçtır; işiniz bitince Free ile bırakılır. DuckDB kütüphanesi ayrı bir yerel DLL olduğundan bu örnek yalnız yerel motorlarda çalışır.
'= bolge sayisi: 3
'= Kuzey: ciro 73, kalem 2
'= Dogu: ciro 72, kalem 1
'= Guney: ciro 58, kalem 2
'= toplam ciro: 203
INCLUDE "include/modules/uxdataframe.uxmh"

MAIN
    DIM df AS U64
    DIM sonuc AS U64
    DIM toplamSonuc AS U64
    DIM rc AS I32
    DIM n AS I64
    DIM i AS I64
    DIM bolge AS STRING
    DIM ciro AS F64
    DIM kalem AS F64
    DIM toplam AS F64

    df = uxdataframe.OpenMemory()
    ASSERT df <> 0, "DuckDB acilamadi"
    rc = uxdataframe.Exec(df, "CREATE TABLE satis(bolge VARCHAR, urun VARCHAR, adet INTEGER, fiyat DOUBLE)")
    rc = uxdataframe.Exec(df, "INSERT INTO satis VALUES ('Kuzey','kalem',10,2.5),('Kuzey','defter',4,12.0),('Guney','kalem',20,2.5),('Guney','silgi',8,1.0),('Dogu','defter',6,12.0)")

    sonuc = uxdataframe.Query(df, "SELECT bolge, SUM(adet * fiyat) AS ciro, COUNT(*) AS kalem FROM satis GROUP BY bolge ORDER BY ciro DESC")
    n = uxdataframe.RowCount(sonuc)
    PRINT "bolge sayisi: "; n
    FOR i = 0 TO n - 1
        bolge = uxdataframe.GetText(sonuc, i, 0)
        ciro = uxdataframe.GetF64(sonuc, i, 1)
        kalem = uxdataframe.GetF64(sonuc, i, 2)
        PRINT bolge; ": ciro "; ciro; ", kalem "; kalem
    NEXT
    uxdataframe.Free(sonuc)

    toplamSonuc = uxdataframe.Query(df, "SELECT SUM(adet * fiyat) FROM satis")
    toplam = uxdataframe.GetF64(toplamSonuc, 0, 0)
    PRINT "toplam ciro: "; toplam
    uxdataframe.Free(toplamSonuc)
    uxdataframe.Free(df)
END MAIN
