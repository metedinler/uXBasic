' KONU: Orta düzey: onluktan ikiliğe çevirme ve BIN/HEX ile karşılaştırma
' KOMUTLAR: FUNCTION DO WHILE MOD CHR BIN HEX
' ACIKLAMA: İkiye bölme ve kalan alma yöntemiyle ikilik gösterim üretir; yerleşik BIN ve HEX ile aynı sonucu verdiğini doğrular.
'= 1010 1010 11111111 FF
FUNCTION Ikilik(n AS I32) AS STRING
    DIM r AS STRING = ""
    IF n = 0 THEN RETURN "0"
    DO WHILE n > 0
        r = CHR(48 + n MOD 2) + r
        n = n \ 2
    LOOP
    RETURN r
END FUNCTION

PRINT Ikilik(10); " "; BIN(10); " "; Ikilik(255); " "; HEX(255)
