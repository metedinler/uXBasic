' KONU: Orta düzey: çok boyutlu dizi ve REDIM PRESERVE
' KOMUTLAR: DIM REDIM PRESERVE LBOUND UBOUND FOR
' ACIKLAMA: Çarpım tablosunu 2 boyutlu dizide tutar, satır toplamlarını yazar; sonra tek boyutlu diziyi verisini koruyarak büyütür.
'= satir 1 toplam 6
'= satir 2 toplam 12
'= satir 3 toplam 18
'= 7 0 9 3
DIM tablo(1 TO 3, 1 TO 3) AS I32
DIM i AS I32
DIM j AS I32
DIM satir_toplami AS I32
FOR i = 1 TO 3
    satir_toplami = 0
    FOR j = 1 TO 3
        tablo(i, j) = i * j
        satir_toplami += tablo(i, j)
    NEXT
    PRINT "satir "; i; " toplam "; satir_toplami
NEXT
DIM v(0 TO 1) AS I32
v(0) = 7
REDIM PRESERVE v(0 TO 3) AS I32
v(3) = 9
PRINT v(0); " "; v(1); " "; v(3); " "; UBOUND(v)
