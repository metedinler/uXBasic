' KONU: Kapsam ve gölgeleme
' KOMUTLAR: DIM SUB
' ACIKLAMA: Yordam içinde aynı adlı yerel değişken ya da parametre, genel değişkeni gölgeler; genel değişken değişmez.
'= yerel x=99
'= parametre x=6
'= genel x=10
DIM x AS I32 = 10

SUB Yerel()
    DIM x AS I32 = 99
    PRINT "yerel x="; x
END SUB

SUB Parametre(x AS I32)
    x = x + 1
    PRINT "parametre x="; x
END SUB

Yerel()
Parametre(5)
PRINT "genel x="; x
