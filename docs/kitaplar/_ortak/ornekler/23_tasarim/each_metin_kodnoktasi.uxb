' KONU: FOR EACH metin üzerinde: kod noktası ve 0 tabanlı sıra
' KOMUTLAR: FOR EACH STRING
' ACIKLAMA: FOR EACH c, i IN s metni Unicode kod noktası kod noktası gezer; i 0 tabanlı karakter sırasıdır.
'= 0:a
'= 1:b
'= 2:c
DIM s AS STRING = "abc"
DIM c AS STRING
DIM i AS I32
FOR EACH c, i IN s
    PRINT i; ":"; c
NEXT
