' KONU: LOCK ... END LOCK birden çok deyimi bölünmez yapar
' KOMUTLAR: LOCK END LOCK
' ACIKLAMA: LOCK yalnız birden çok deyimin birlikte bölünmez olması içindir; transaction değildir (hata olursa yapılan yazmalar geri alınmaz).
'= 3 7
DIM a AS I64 = 1
DIM b AS I64 = 2

THREAD Degistir(x AS I32)
    LOCK a, b
        a = a + 2
        b = b + 5
    END LOCK
END THREAD

DIM t AS TASK = SPAWN Degistir(0)
t.JOIN()
PRINT a; " "; b
