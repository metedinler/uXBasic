' KONU: %%IFN, %%IFC, %%ELIF ile sayısal ve metinsel koşullar
' KOMUTLAR: %%DEFINE %%IFN %%IFC %%ELIF %%ELSE %%ENDIF
' ACIKLAMA: Sayı karşılaştırması için %%IFN, iki metnin eşitliği için %%IFC, zincir için %%ELIF kullanılır.
'= genislik: orta
'= platform: web
%%DEFINE GENISLIK 700
%%DEFINE HEDEF web

%%IFN GENISLIK >= 1000
PRINT "genislik: buyuk"
%%ELIF GENISLIK >= 640
PRINT "genislik: orta"
%%ELSE
PRINT "genislik: kucuk"
%%ENDIF

%%IFC HEDEF, WEB
PRINT "platform: web"
%%ELSE
PRINT "platform: baska"
%%ENDIF
