' KONU: Makro parantezi: yanlış ve doğru yazım
' KOMUTLAR: %%MACRO %%DEFINE
' ACIKLAMA: Makro, ifadeyi metin olarak yerine koyar; işlem önceliği korunmaz. Parametreyi ve gövdeyi parantez içine almak sonucu değiştirir.
'= kotu: 9
'= iyi: 16
'= sabit kotu: 8
'= sabit iyi: 10
%%MACRO IKI_KOTU(X) X + X
%%MACRO IKI_IYI(X) ((X) + (X))
%%DEFINE TOPLAM_KOTU 2 + 3
%%DEFINE TOPLAM_IYI (2 + 3)

PRINT "kotu: "; IKI_KOTU(3 + 1) * 2
PRINT "iyi: "; IKI_IYI(3 + 1) * 2
PRINT "sabit kotu: "; TOPLAM_KOTU * 2
PRINT "sabit iyi: "; TOPLAM_IYI * 2
