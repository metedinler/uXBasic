' KONU: %%DEFINE, %%MACRO ve %%IF ile derleme anında seçim
' KOMUTLAR: %%DEFINE %%MACRO %%IF %%ELSE %%ENDIF
' ACIKLAMA: Önişlemci kaynağı derlemeden önce değiştirir: makro metni yerine koyar, %%IF seçilmeyen kolu tamamen siler.
'= kare=49
'= alan=24
'= mod=hizli
%%DEFINE HIZLI 1
%%MACRO KARE(X) ((X) * (X))
%%DEFINE EN 6
%%DEFINE BOY 4

PRINT "kare="; KARE(3 + 4)
PRINT "alan="; EN * BOY

%%IF HIZLI
PRINT "mod=hizli"
%%ELSE
PRINT "mod=yavas"
%%ENDIF
