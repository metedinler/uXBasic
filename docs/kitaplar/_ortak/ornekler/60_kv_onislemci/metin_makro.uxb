' KONU: Metin değerli makro: tırnak tuzağı
' KOMUTLAR: %%DEFINE %%SET
' ACIKLAMA: %%DEFINE ve %%SET, değerin başındaki ve sonundaki çift tırnağı atar. Metin sabiti olarak kalması için değeri parantez içine alın.
'= Merhaba Ece
'= 2 + 3 = 5
%%DEFINE ADI Ece
%%DEFINE SELAM ("Merhaba ")
%%SET BASLIK = ("2 + 3 = ")

PRINT SELAM + "Ece"
PRINT BASLIK; 2 + 3
