' KONU: TYPE içinde TYPE ve alan erişimi
' KOMUTLAR: TYPE DIM
' ACIKLAMA: Kayıt tipleri iç içe kullanılır; alanlara nokta ile erişilir.
'= 3 4
'= 7
TYPE Nokta
    x AS I32
    y AS I32
END TYPE

TYPE Cizgi
    a AS Nokta
    b AS Nokta
END TYPE

DIM c AS Cizgi
c.a.x = 3
c.a.y = 4
PRINT c.a.x; " "; c.a.y
PRINT c.a.x + c.a.y
