' KONU: SELECT CASE IS karşılaştırma
' KOMUTLAR: SELECT CASE IS
' ACIKLAMA: CASE IS ile karşılaştırma operatörü kullanılır: CASE IS > 5.
'= buyuk
'= kucuk
DIM i AS I32
FOR i = 9 TO 1 STEP -8
    SELECT CASE i
        CASE IS > 5
            PRINT "buyuk"
        CASE ELSE
            PRINT "kucuk"
    END SELECT
NEXT i
