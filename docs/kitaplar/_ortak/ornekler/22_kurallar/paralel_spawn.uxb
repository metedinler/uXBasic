' KONU: PARALEL + SPAWN + JOIN
' KOMUTLAR: PARALEL SPAWN TASK JOIN
' ACIKLAMA: PARALEL gövdesi görev olarak SPAWN ile başlatılır; sonuçlar JOIN ile başlatma sırasına göre okunur.
'= 9
'= 16
'= 25
PARALEL Kare(x AS I32)
    RETURN x * x
END PARALEL

DIM a AS TASK = SPAWN Kare(3)
DIM b AS TASK = SPAWN Kare(4)
DIM c AS TASK = SPAWN Kare(5)
PRINT a.JOIN()
PRINT b.JOIN()
PRINT c.JOIN()
