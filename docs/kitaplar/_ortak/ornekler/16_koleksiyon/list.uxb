' KONU: LIST
' KOMUTLAR: LIST LISTADD LISTGET LISTLEN FOR EACH
' ACIKLAMA: Büyüyebilen sıralı liste.
'= 3
'= 20
'= 0:10
'= 1:20
'= 2:30
DIM l AS LIST
LISTADD(l, 10)
LISTADD(l, 20)
LISTADD(l, 30)
PRINT LISTLEN(l)
PRINT LISTGET(l, 1)
DIM v AS I32
DIM i AS I32
FOR EACH v, i IN l
    PRINT i; ":"; v
NEXT
