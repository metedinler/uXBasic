' KONU: Üst düzey: sınıf, özyineleme, PIPE, EVENT, THREAD, PARALEL ve ATOMIC tek programda
' KOMUTLAR: CLASS METHOD PIPE EVENT TRIGGER THREAD PARALEL SPAWN TASK OF JOIN ATOMIC TASKOUT CDBL
' ACIKLAMA: Tasarım kılavuzundaki bütünleşik örneğin bugün AST, MIR ve x64'te çalışan hâli. EVENT bir ham değeri PIPE ile normalleştirir ve sonucu TASKOUT'tan alır. THREAD her çağrıda bir Analiz nesnesi üretir, nesnenin özyinelemeli metodu değeri düzeltir, ortak sayaç ATOMIC.ADD ile artar, nesne DELETE ile yok edilir. PARALEL dört THREAD başlatıp sonuçlarını topar. MAIN olayı tetikler, PARALEL'i başlatıp JOIN eder, sayacı okur. Görev yapıları JS'te çalışmaz (G-GOREV-6); örnek AST, MIR ve x64 içindir. Tasarımdaki DIM SHARED, LOCK ile TYPE koruması ve BYSHARED henüz yoktur (Bölüm 15.11); onların yerini ATOMIC sayaç ve görev dönüş değerleri tutar.
' MOTORLAR: AST MIR x64
'= olay 1: 0.725
'= 6.503775062500001
'= islenen: 4
CLASS Analiz
    PUBLIC
    METHOD Duzelt(x AS F64, derinlik AS I32) AS F64
        IF derinlik <= 0 THEN RETURN x
        RETURN Duzelt((x + x / 100.0) / 2.0, derinlik - 1)
    END METHOD
END CLASS

PIPE Normalle(deger AS F64) AS F64
    RETURN deger / 100.0
END PIPE

DIM ATOMIC islenen AS I64 = 0

THREAD Denetle(kimlik AS I32) AS F64
    DIM a AS Analiz = NEW Analiz()
    DIM v AS F64
    v = a.Duzelt(kimlik * 10.0, 4)
    islenen.ADD(1)
    DELETE a
    RETURN v
END THREAD

PARALEL Toplu(ilk AS I32) AS F64
    DIM ts(3) AS TASK OF F64
    DIM i AS I32
    DIM toplam AS F64 = 0.0
    FOR i = 0 TO 3
        ts(i) = SPAWN Denetle(ilk + i)
    NEXT
    FOR i = 0 TO 3
        toplam = toplam + ts(i).JOIN()
    NEXT
    RETURN toplam
END PARALEL

EVENT Geldi(kimlik AS I32, ham AS F64)
    TRIGGER PIPE Normalle, ham
    PRINT "olay "; kimlik; ": "; CDBL(TASKOUT)
END EVENT

MAIN
    TRIGGER EVENT Geldi, 1, 72.5
    DIM b AS TASK OF F64 = SPAWN Toplu(1)
    PRINT b.JOIN()
    PRINT "islenen: "; islenen.LOAD()
END MAIN
