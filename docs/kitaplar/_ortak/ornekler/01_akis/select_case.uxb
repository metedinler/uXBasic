' KONU: SELECT CASE
' KOMUTLAR: SELECT CASE IS ELSE END
' ACIKLAMA: Bir değeri birçok olasılıkla karşılaştırır: tek değer, virgüllü liste, karşılaştırma (IS).
'= bir
'= iki-uc
'= bilinmeyen
'= bilinmeyen
'= buyuk
DIM n AS I32
FOR n = 1 TO 9 STEP 2
    SELECT CASE n
        CASE 1
            PRINT "bir"
        CASE 2, 3
            PRINT "iki-uc"
        CASE IS > 8
            PRINT "buyuk"
        CASE ELSE
            PRINT "bilinmeyen"
    END SELECT
NEXT n
