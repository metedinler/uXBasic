' KONU: SELECT CASE metinle
' KOMUTLAR: SELECT CASE ELSE END
' ACIKLAMA: SELECT CASE metin (STRING) değerlerle de çalışır.
'= meyve
'= sebze
DIM ad AS STRING
ad = "elma"
SELECT CASE ad
    CASE "elma", "armut"
        PRINT "meyve"
    CASE ELSE
        PRINT "sebze"
END SELECT
ad = "pirasa"
SELECT CASE ad
    CASE "elma", "armut"
        PRINT "meyve"
    CASE ELSE
        PRINT "sebze"
END SELECT
