' KONU: MUTEX + LOCK
' KOMUTLAR: MUTEX LOCK END
' ACIKLAMA: MUTEX birden çok deyimlik kritik bölgeyi korur; LOCK m ... END LOCK arasında tek görev çalışır.
'= 20000
DIM m AS MUTEX
DIM sayac AS I64 = 0
THREAD Isci(n AS I64) AS I64
    DIM i AS I64
    DIM gecici AS I64
    FOR i = 1 TO n
        LOCK m
            gecici = sayac
            gecici = gecici + 1
            sayac = gecici
        END LOCK
    NEXT i
    RETURN n
END THREAD
DIM g AS TASKGROUP
g.ADD(SPAWN Isci(10000))
g.ADD(SPAWN Isci(10000))
g.JOIN()
PRINT sayac
