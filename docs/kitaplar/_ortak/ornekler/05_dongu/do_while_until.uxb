' KONU: DO WHILE / DO UNTIL / LOOP WHILE / LOOP UNTIL
' KOMUTLAR: DO WHILE UNTIL LOOP
' ACIKLAMA: Koşul başta (DO WHILE/UNTIL) ya da sonda (LOOP WHILE/UNTIL) denetlenebilir.
'= a=3
'= b=3
'= c=1
'= d=3
DIM k AS I32 = 0
DO WHILE k < 3
    k = k + 1
LOOP
PRINT "a="; k
k = 0
DO UNTIL k >= 3
    k = k + 1
LOOP
PRINT "b="; k
k = 0
DO
    k = k + 1
LOOP WHILE k > 5
PRINT "c="; k
k = 0
DO
    k = k + 1
LOOP UNTIL k = 3
PRINT "d="; k
