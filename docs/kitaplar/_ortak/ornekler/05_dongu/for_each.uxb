' KONU: FOR EACH / DO EACH
' KOMUTLAR: FOR EACH IN NEXT DO LOOP
' ACIKLAMA: Bir listenin ya da dizinin her elemanını sırayla verir; ikinci değişken sıra numarasıdır (0'dan).
'= 0:10
'= 1:20
'= 2:30
'= toplam=15
DIM v AS I32
DIM i AS I32
FOR EACH v, i IN 10, 20, 30
    PRINT i; ":"; v
NEXT
DIM t AS I32 = 0
DIM u AS I32
DO EACH u IN 4, 5, 6
    t = t + u
LOOP
PRINT "toplam="; t
