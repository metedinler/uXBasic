' KONU: Kendi matematik tipinizi MAGIC ile yazmak: Gauss tamsayıları (a + bi)
' KOMUTLAR: CLASS CONSTRUCTOR MAGIC ADD MUL TOSTRING STR
' ACIKLAMA: Kütüphane tipi mekanizması gelene kadar, yeni bir matematik tipini sınıf ve MAGIC işleçleriyle bugün yazabilirsiniz. Gauss tamsayısı iki tamsayıdan oluşur; toplama ve çarpma işleçleri tanımlanır, STR() okunur gösterim verir. Nesneler NEW ve kurucuyla yaratılır; bir işleç sonucu hemen kullanılır (AST'de işleç sonuçlarını zincirlemek yanlış çalışır, G-NESNE-9).
'= (1+2i) * (3-1i) = (5+5i)
'= i * i = (-1+0i)
'= (1+2i) + (3-1i) = (4+1i)
'= normu: 50
CLASS Gauss
    PUBLIC
    DIM re AS I32
    DIM im AS I32

    CONSTRUCTOR(a AS I32, b AS I32)
        re = a
        im = b
    END CONSTRUCTOR

    MAGIC ADD(o AS Gauss) AS Gauss
        RETURN NEW Gauss(re + o.re, im + o.im)
    END MAGIC

    MAGIC MUL(o AS Gauss) AS Gauss
        RETURN NEW Gauss(re * o.re - im * o.im, re * o.im + im * o.re)
    END MAGIC

    MAGIC TOSTRING() AS STRING
        IF im < 0 THEN RETURN "(" + STR(re) + STR(im) + "i)"
        RETURN "(" + STR(re) + "+" + STR(im) + "i)"
    END MAGIC

    METHOD Norm() AS I32
        RETURN re * re + im * im
    END METHOD
END CLASS

MAIN
    DIM x AS Gauss = NEW Gauss(1, 2)
    DIM y AS Gauss = NEW Gauss(3, -1)
    DIM birim AS Gauss = NEW Gauss(0, 1)
    DIM z AS Gauss = NEW Gauss(0, 0)

    z = x * y
    PRINT "(1+2i) * (3-1i) = "; STR(z)

    z = birim * birim
    PRINT "i * i = "; STR(z)

    z = x + y
    PRINT "(1+2i) + (3-1i) = "; STR(z)

    DIM bes AS Gauss = NEW Gauss(5, 5)
    PRINT "normu: "; bes.Norm()
END MAIN
