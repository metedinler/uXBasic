' KONU: CONST / DIM / REDIM PRESERVE
' KOMUTLAR: CONST DIM REDIM PRESERVE
' ACIKLAMA: CONST değişmez değer tanımlar. REDIM PRESERVE diziyi büyütür, eski elemanları korur.
'= 3.14
'= 7 0 9
CONST PI_YAKLASIK = 3.14
PRINT PI_YAKLASIK
DIM d(0 TO 1) AS I32
d(0) = 7
REDIM PRESERVE d(0 TO 2) AS I32
d(2) = 9
PRINT d(0); " "; d(1); " "; d(2)
