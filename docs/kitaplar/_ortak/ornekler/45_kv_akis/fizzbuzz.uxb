' KONU: Klasik FizzBuzz: IF / ELSEIF zinciri
' KOMUTLAR: IF ELSEIF ELSE MOD FOR
' ACIKLAMA: 15'e kadar sayıları 3'e ve 5'e bölünebilirliğe göre yazar.
'= 1
'= 2
'= Fizz
'= 4
'= Buzz
'= Fizz
'= 7
'= 8
'= Fizz
'= Buzz
'= 11
'= Fizz
'= 13
'= 14
'= FizzBuzz
DIM i AS I32
FOR i = 1 TO 15
    IF i MOD 15 = 0 THEN
        PRINT "FizzBuzz"
    ELSEIF i MOD 3 = 0 THEN
        PRINT "Fizz"
    ELSEIF i MOD 5 = 0 THEN
        PRINT "Buzz"
    ELSE
        PRINT i
    END IF
NEXT
