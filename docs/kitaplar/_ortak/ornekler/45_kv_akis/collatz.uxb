' KONU: Collatz adımları: DO WHILE ve I64
' KOMUTLAR: DO WHILE LOOP IF MOD
' ACIKLAMA: Çift ise ikiye böl, tek ise 3n+1 yap; 1'e kaç adımda inildiğini sayar. 27 sayısı 111 adım sürer.
'= 111
DIM n AS I64 = 27
DIM adim AS I32
DO WHILE n <> 1
    IF n MOD 2 = 0 THEN
        n = n \ 2
    ELSE
        n = 3 * n + 1
    END IF
    adim += 1
LOOP
PRINT adim
