' KONU: FOR EACH ile farklı kaynaklar
' KOMUTLAR: FOR EACH LIST SET DICT dizi STRING
' ACIKLAMA: FOR EACH dizi, LIST, SET, DICT (anahtarlar) ve metin (karakter karakter) üzerinde dolaşır; ikinci değişken 0 tabanlı sıra numarasıdır.
'= dizi: 5 6 7
'= liste: elma armut
'= kume: 2
'= sozluk: a b
'= metin: 0:x 1:y
DIM a(2) AS I32
a(0) = 5
a(1) = 6
a(2) = 7
DIM v AS I32
PRINT "dizi: ";
FOR EACH v IN a
    PRINT v; " ";
NEXT
PRINT

DIM l AS LIST
LISTADD(l, "elma")
LISTADD(l, "armut")
DIM s AS STRING
PRINT "liste: ";
FOR EACH s IN l
    PRINT s; " ";
NEXT
PRINT

DIM k AS SET
SETADD(k, "p")
SETADD(k, "q")
SETADD(k, "p")
PRINT "kume: "; SETLEN(k)

DIM d AS DICT
DICTSET(d, "a", 1)
DICTSET(d, "b", 2)
PRINT "sozluk: ";
FOR EACH s IN d
    PRINT s; " ";
NEXT
PRINT

DIM m AS STRING = "xy"
DIM c AS STRING
DIM i AS I32
PRINT "metin: ";
FOR EACH c, i IN m
    PRINT i; ":"; c; " ";
NEXT
PRINT
