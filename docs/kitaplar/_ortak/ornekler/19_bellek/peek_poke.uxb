' KONU: POKE / PEEK / MEMFILL / MEMCOPY
' KOMUTLAR: POKEB POKEW POKED PEEKB PEEKW PEEKD MEMFILLB MEMCOPYB
' ACIKLAMA: Ham bellek: B=1, W=2, D=4, Q=8 bayt. MEMFILLB adres, değer, adet; MEMCOPYB HEDEF, KAYNAK, adet.
'= 65
'= 4660
'= 305419896
'= 9
DIM x AS I64 = 6000
POKEB x, 65
POKEW x + 2, 4660
POKED x + 8, 305419896
MEMFILLB x + 16, 9, 3
MEMCOPYB x + 24, x + 16, 3
PRINT PEEKB(x)
PRINT PEEKW(x + 2)
PRINT PEEKD(x + 8)
PRINT PEEKB(x + 24)
