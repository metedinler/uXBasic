' KONU: PUBLIC / PRIVATE
' KOMUTLAR: PUBLIC PRIVATE THIS
' ACIKLAMA: PRIVATE üyeler yalnız sınıfın içinden (THIS.ad) kullanılabilir.
'= 5
CLASS Kasa
    PRIVATE
    METHOD Gizli() AS I32
        RETURN 5
    END METHOD
    PUBLIC
    METHOD Ac() AS I32
        RETURN THIS.Gizli()
    END METHOD
END CLASS
DIM k AS Kasa = NEW Kasa()
PRINT k.Ac()
