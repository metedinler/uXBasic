' KONU: Yalnız seçilen dal ve yalnız gereken işlenen hesaplanır
' KOMUTLAR: ? : IFF ANDALSO ORELSE AND OR
' ACIKLAMA: ?: ve IFF yalnız seçilen dalı hesaplar; ANDALSO/ORELSE sağ işleneni gerekmedikçe hesaplamaz. AND ve OR ise iki tarafı da hesaplar (Yan işlevinin yazdığı satırdan anlaşılır).
'= hesaplandi: IFF-dogru
'= 10
'= hesaplandi: secim-dogru
'= 30
'= 0
'= hesaplandi: AND
'= 0
'= -1
'= hesaplandi: OR
'= -1
FUNCTION Yan(etiket AS STRING, deger AS I32) AS I32
    PRINT "hesaplandi: " + etiket
    RETURN deger
END FUNCTION

DIM r AS I32
r = IFF(1 = 1, Yan("IFF-dogru", 10), Yan("IFF-yanlis", 20))
PRINT r
r = (1 = 1) ? Yan("secim-dogru", 30) : Yan("secim-yanlis", 40)
PRINT r
r = (0 ANDALSO Yan("ANDALSO", 1))
PRINT r
r = (0 AND Yan("AND", 1))
PRINT r
r = (-1 ORELSE Yan("ORELSE", 1))
PRINT r
r = (-1 OR Yan("OR", 1))
PRINT r
