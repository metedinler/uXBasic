' KONU: Üçlü seçim ve boru işleci
' KOMUTLAR: ? : |> IFF
' ACIKLAMA: ?: iç içe kullanılabilir. |> bir değeri işlevden işleve taşır: 5 |> Ikile |> Artir, Artir(Ikile(5)) ile aynıdır.
'= -1
'= 13
'= negatif
FUNCTION Ikile(x AS I32) AS I32
    RETURN x * 2
END FUNCTION

FUNCTION Artir(x AS I32) AS I32
    RETURN x + 3
END FUNCTION

DIM n AS I32 = -5
PRINT n < 0 ? -1 : n > 0 ? 1 : 0
PRINT 5 |> Ikile |> Artir
PRINT IFF(n < 0, "negatif", "pozitif")
