' KONU: Orta düzey: bit kaydırma ile RGB renk paketleme
' KOMUTLAR: SHL SHR AND OR HEX
' ACIKLAMA: Üç 8 bitlik bileşeni tek 32 bitlik sayıya paketler, sonra maskeleyerek geri çözer.
'= 13132850
'= 200 100 50
'= C86432
DIM r AS U32 = 200
DIM g AS U32 = 100
DIM b AS U32 = 50
DIM renk AS U32 = (r SHL 16) OR (g SHL 8) OR b
PRINT renk
PRINT (renk SHR 16) AND 255; " "; (renk SHR 8) AND 255; " "; renk AND 255
PRINT HEX(renk)
