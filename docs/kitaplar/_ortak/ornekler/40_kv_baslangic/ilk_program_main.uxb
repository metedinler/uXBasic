' KONU: MAIN bloğu ile program giriş noktası
' KOMUTLAR: MAIN DIM FOR NEXT PRINT
' ACIKLAMA: Aynı program MAIN ... END MAIN içine alınabilir; MAIN dışındaki tanımlar (SUB/FUNCTION) önce yazılır.
'= 1
'= 4
'= 9
'= 16
SUB KareYaz(n AS I32)
    PRINT n * n
END SUB

MAIN
    DIM i AS I32
    FOR i = 1 TO 4
        KareYaz(i)
    NEXT
END MAIN
