' KONU: Nesne ataması referanstır (kopya değil)
' KOMUTLAR: NEW CLASS
' ACIKLAMA: b = a nesneyi kopyalamaz, aynı nesneye ikinci bir ad verir. Birinden yapılan değişiklik ötekinde görünür. Kopya gerekiyorsa yeni nesne oluşturup alanları tek tek kopyalarsınız.
'= 9
'= 9
'= 5 9
CLASS Kutu
    PUBLIC
    DIM v AS I32
END CLASS

DIM a AS Kutu = NEW Kutu()
DIM b AS Kutu = NEW Kutu()
b = a
b.v = 9
PRINT a.v
PRINT b.v

DIM c AS Kutu = NEW Kutu()
c.v = 5
DIM kopya AS Kutu = NEW Kutu()
kopya.v = c.v
kopya.v = 9
PRINT c.v; " "; kopya.v
