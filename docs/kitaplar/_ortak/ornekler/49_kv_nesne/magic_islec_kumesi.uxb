' KONU: MAGIC ile bölme, kalan, kaydırma ve karşılaştırma işleçleri
' KOMUTLAR: MAGIC DIV IDIV MOD SHL SHR EQ NE LT LE GT GE
' ACIKLAMA: Aritmetik MAGIC işleçleri sınıf tipli sonuç döndürür; karşılaştırma işleçleri tamsayı (doğru = -1, yanlış = 0) döndürür ve IF koşulunda doğrudan kullanılır.
'= 3
'= 3
'= 0
'= 192
'= 0
'= dogru
'= dogru
'= dogru
'= dogru
'= dogru
'= dogru
CLASS Sayi
    PUBLIC
    DIM v AS I32
    MAGIC DIV(o AS Sayi) AS Sayi
        DIM r AS Sayi = NEW Sayi()
        r.v = v \ o.v
        RETURN r
    END MAGIC
    MAGIC IDIV(o AS Sayi) AS Sayi
        DIM r AS Sayi = NEW Sayi()
        r.v = v \ o.v
        RETURN r
    END MAGIC
    MAGIC MOD(o AS Sayi) AS Sayi
        DIM r AS Sayi = NEW Sayi()
        r.v = v MOD o.v
        RETURN r
    END MAGIC
    MAGIC SHL(o AS Sayi) AS Sayi
        DIM r AS Sayi = NEW Sayi()
        r.v = v SHL o.v
        RETURN r
    END MAGIC
    MAGIC SHR(o AS Sayi) AS Sayi
        DIM r AS Sayi = NEW Sayi()
        r.v = v SHR o.v
        RETURN r
    END MAGIC
    MAGIC EQ(o AS Sayi) AS I32
        IF v = o.v THEN RETURN -1
        RETURN 0
    END MAGIC
    MAGIC NE(o AS Sayi) AS I32
        IF v <> o.v THEN RETURN -1
        RETURN 0
    END MAGIC
    MAGIC LT(o AS Sayi) AS I32
        IF v < o.v THEN RETURN -1
        RETURN 0
    END MAGIC
    MAGIC LE(o AS Sayi) AS I32
        IF v <= o.v THEN RETURN -1
        RETURN 0
    END MAGIC
    MAGIC GT(o AS Sayi) AS I32
        IF v > o.v THEN RETURN -1
        RETURN 0
    END MAGIC
    MAGIC GE(o AS Sayi) AS I32
        IF v >= o.v THEN RETURN -1
        RETURN 0
    END MAGIC
END CLASS

DIM a AS Sayi = NEW Sayi()
DIM b AS Sayi = NEW Sayi()
DIM c AS Sayi = NEW Sayi()
a.v = 12
b.v = 4
c = a / b
PRINT c.v
c = a \ b
PRINT c.v
c = a MOD b
PRINT c.v
c = a SHL b
PRINT c.v
c = a SHR b
PRINT c.v
IF a > b THEN PRINT "dogru"
IF b < a THEN PRINT "dogru"
IF a >= b THEN PRINT "dogru"
IF b <= a THEN PRINT "dogru"
IF a <> b THEN PRINT "dogru"
IF a = a THEN PRINT "dogru"
