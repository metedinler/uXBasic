' KONU: Orta düzey: kalıtım, VIRTUAL/OVERRIDE ve çok biçimlilik
' KOMUTLAR: CLASS EXTENDS VIRTUAL OVERRIDE
' ACIKLAMA: Taban tipte bir değişken, türemiş bir nesneyi tutar; çağrı nesnenin gerçek sınıfının metoduna gider. DIM satırında başlangıç değeri NEW olmalıdır; türemiş nesne sonradan atanır.
'= 12
'= 25
'= kare
'= dikdortgen
CLASS Sekil
    PUBLIC
    VIRTUAL METHOD Alan() AS I32
        RETURN 0
    END METHOD
    VIRTUAL METHOD Ad() AS STRING
        RETURN "sekil"
    END METHOD
END CLASS

CLASS Dikdortgen EXTENDS Sekil
    PUBLIC
    DIM en AS I32
    DIM boy AS I32
    OVERRIDE METHOD Alan() AS I32
        RETURN en * boy
    END METHOD
    OVERRIDE METHOD Ad() AS STRING
        RETURN "dikdortgen"
    END METHOD
END CLASS

CLASS Kare EXTENDS Dikdortgen
    PUBLIC
    OVERRIDE METHOD Alan() AS I32
        RETURN en * en
    END METHOD
    OVERRIDE METHOD Ad() AS STRING
        RETURN "kare"
    END METHOD
END CLASS

DIM d1 AS Dikdortgen = NEW Dikdortgen()
d1.en = 3
d1.boy = 4
DIM t1 AS Sekil = NEW Sekil()
t1 = d1
PRINT t1.Alan()

DIM k1 AS Kare = NEW Kare()
k1.en = 5
DIM t2 AS Sekil = NEW Sekil()
t2 = k1
PRINT t2.Alan()
PRINT t2.Ad()
PRINT t1.Ad()
