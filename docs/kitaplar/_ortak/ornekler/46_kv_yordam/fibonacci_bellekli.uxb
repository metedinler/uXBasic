' KONU: Orta düzey: bellekli özyineleme (Fibonacci)
' KOMUTLAR: FUNCTION dizi genel değişken
' ACIKLAMA: Genel bir diziyi önbellek olarak kullanır; saf özyineleme milyarlarca çağrı yaparken bellekli sürüm 40 değerini bir kez hesaplar.
'= 102334155
DIM bellek(50) AS I64

FUNCTION Fib(n AS I32) AS I64
    IF n < 2 THEN RETURN n
    IF bellek(n) <> 0 THEN RETURN bellek(n)
    bellek(n) = Fib(n - 1) + Fib(n - 2)
    RETURN bellek(n)
END FUNCTION

PRINT Fib(40)
