' KONU: Dizi parametresi ve LBOUND/UBOUND
' KOMUTLAR: FUNCTION dizi parametresi LBOUND UBOUND
' ACIKLAMA: Dizi parametresi tip[] ile bildirilir; işlev dizinin sınırlarını LBOUND/UBOUND ile okuyarak her boyutta çalışır.
'= 5
'= 2.5
FUNCTION Ortalama(a AS F64[]) AS F64
    DIM t AS F64
    DIM i AS I32
    FOR i = LBOUND(a) TO UBOUND(a)
        t += a(i)
    NEXT
    RETURN t / (UBOUND(a) - LBOUND(a) + 1)
END FUNCTION

DIM v(0 TO 3) AS F64
v(0) = 2
v(1) = 4
v(2) = 9
v(3) = 5
PRINT Ortalama(v)
DIM w(5 TO 6) AS F64
w(5) = 2
w(6) = 3
PRINT Ortalama(w)
