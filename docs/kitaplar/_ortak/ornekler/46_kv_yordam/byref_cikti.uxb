' KONU: BYREF ile birden çok sonuç döndürmek
' KOMUTLAR: BYREF BYVAL SUB
' ACIKLAMA: Bir işlev tek değer döndürür; BYREF parametre ise çağıranın değişkenini değiştirir. Böylece bölüm ve kalan birlikte döner.
'= 3 1
'= 2 9
SUB BolVeKalan(a AS I32, b AS I32, BYREF bolum AS I32, BYREF kalan AS I32)
    bolum = a \ b
    kalan = a MOD b
END SUB

SUB Takas(BYREF x AS I32, BYREF y AS I32)
    DIM gecici AS I32 = x
    x = y
    y = gecici
END SUB

DIM q AS I32
DIM r AS I32
BolVeKalan(10, 3, q, r)
PRINT q; " "; r
DIM p AS I32 = 9
DIM s AS I32 = 2
IF p > s THEN Takas(p, s)
PRINT p; " "; s
