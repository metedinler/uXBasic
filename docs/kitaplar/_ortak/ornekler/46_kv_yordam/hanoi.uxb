' KONU: Orta düzey: Hanoi kuleleri (özyineleme)
' KOMUTLAR: SUB FUNCTION RETURN
' ACIKLAMA: SUB ile hamleleri yazdırır, FUNCTION ile toplam hamle sayısını (2^n - 1) hesaplar.
'= disk 1: A -> C
'= disk 2: A -> B
'= disk 1: C -> B
'= disk 3: A -> C
'= disk 1: B -> A
'= disk 2: B -> C
'= disk 1: A -> C
'= 1023
SUB Tasi(n AS I32, kaynak AS STRING, hedef AS STRING, ara AS STRING)
    IF n = 0 THEN RETURN
    Tasi(n - 1, kaynak, ara, hedef)
    PRINT "disk "; n; ": "; kaynak; " -> "; hedef
    Tasi(n - 1, ara, hedef, kaynak)
END SUB

FUNCTION HamleSayisi(n AS I32) AS I64
    IF n = 0 THEN RETURN 0
    RETURN 2 * HamleSayisi(n - 1) + 1
END FUNCTION

Tasi(3, "A", "C", "B")
PRINT HamleSayisi(10)
