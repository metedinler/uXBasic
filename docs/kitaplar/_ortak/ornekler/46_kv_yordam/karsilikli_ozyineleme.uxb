' KONU: DECLARE ile karşılıklı özyineleme
' KOMUTLAR: DECLARE FUNCTION RETURN
' ACIKLAMA: İki işlev birbirini çağırıyorsa ilki ikincisinden önce kullanılabilsin diye imzalar DECLARE ile bildirilir. Bu örnek beş hedefte de çalışır.
'= 1
'= 0
DECLARE FUNCTION CiftMi(n AS I32) AS I32
DECLARE FUNCTION TekMi(n AS I32) AS I32

FUNCTION CiftMi(n AS I32) AS I32
    IF n = 0 THEN RETURN 1
    RETURN TekMi(n - 1)
END FUNCTION

FUNCTION TekMi(n AS I32) AS I32
    IF n = 0 THEN RETURN 0
    RETURN CiftMi(n - 1)
END FUNCTION

PRINT CiftMi(10)
PRINT CiftMi(7)
