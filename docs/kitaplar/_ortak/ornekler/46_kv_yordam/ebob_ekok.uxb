' KONU: Orta düzey: Öklid algoritması (EBOB) ve EKOK
' KOMUTLAR: FUNCTION özyineleme MOD
' ACIKLAMA: EBOB(a,b) = EBOB(b, a MOD b) kuralıyla özyinelemeli hesaplanır; EKOK = a*b / EBOB.
'= 6 144
FUNCTION Ebob(a AS I64, b AS I64) AS I64
    IF b = 0 THEN RETURN a
    RETURN Ebob(b, a MOD b)
END FUNCTION

FUNCTION Ekok(a AS I64, b AS I64) AS I64
    RETURN a * b \ Ebob(a, b)
END FUNCTION

PRINT Ebob(48, 18); " "; Ekok(48, 18)
