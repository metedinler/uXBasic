' KONU: SUB / FUNCTION / RETURN
' KOMUTLAR: SUB FUNCTION RETURN AS END
' ACIKLAMA: SUB değer döndürmez; FUNCTION döndürür. RETURN değeri verip rutinden çıkar.
'= Merhaba Ayse
'= 25
SUB Selam(ad AS STRING)
    PRINT "Merhaba " + ad
END SUB
FUNCTION Kare(n AS I32) AS I32
    RETURN n * n
END FUNCTION
Selam("Ayse")
PRINT Kare(5)
