' KONU: Dizi parametresi
' KOMUTLAR: SUB FUNCTION AS []
' ACIKLAMA: Dizi parametresi `ad AS Tip[]` biçiminde yazılır.
'= 6
FUNCTION Topla(a AS I32[]) AS I32
    DIM t AS I32 = 0
    DIM i AS I32
    FOR i = LBOUND(a) TO UBOUND(a)
        t = t + a(i)
    NEXT i
    RETURN t
END FUNCTION
DIM d(0 TO 2) AS I32
d(0) = 1
d(1) = 2
d(2) = 3
PRINT Topla(d)
