' KONU: TASKGROUP / ADD / JOIN
' KOMUTLAR: TASKGROUP ADD JOIN SPAWN
' ACIKLAMA: Birden çok görevi bir grupta toplar; JOIN hepsinin bitmesini bekler.
'= 30000
DIM ATOMIC toplam AS I64 = 0
THREAD Isci(n AS I64) AS I64
    DIM i AS I64
    FOR i = 1 TO n
        toplam.ADD(1)
    NEXT i
    RETURN n
END THREAD
DIM g AS TASKGROUP
DIM k AS I64
FOR k = 1 TO 3
    g.ADD(SPAWN Isci(10000))
NEXT k
g.JOIN()
PRINT toplam
