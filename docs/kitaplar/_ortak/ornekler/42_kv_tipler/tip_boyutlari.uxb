' KONU: Tip boyutları (SIZEOF)
' KOMUTLAR: SIZEOF PRINT
' ACIKLAMA: SIZEOF bir tipin bellekte kaç bayt yer kapladığını verir.
'= 1 1 2 2 4 4 8 8
'= 4 8 10 16
'= 1 8
PRINT SIZEOF(I8); " "; SIZEOF(U8); " "; SIZEOF(I16); " "; SIZEOF(U16); " "; SIZEOF(I32); " "; SIZEOF(U32); " "; SIZEOF(I64); " "; SIZEOF(U64)
PRINT SIZEOF(F32); " "; SIZEOF(F64); " "; SIZEOF(F80); " "; SIZEOF(F128)
PRINT SIZEOF(BOOLEAN); " "; SIZEOF(PTR)
