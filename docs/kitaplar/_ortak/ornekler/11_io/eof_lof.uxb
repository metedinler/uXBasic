' KONU: EOF / LOF
' KOMUTLAR: EOF LOF
' ACIKLAMA: LOF dosya boyutu (bayt); EOF dosya sonuna gelindi mi.
'= 3 satir
OPEN "kitap_satir.txt" FOR OUTPUT AS #1
PRINT #1, "a"
PRINT #1, "b"
PRINT #1, "c"
CLOSE #1
DIM n AS I32 = 0
DIM s AS STRING
OPEN "kitap_satir.txt" FOR INPUT AS #1
DO WHILE NOT EOF(1)
    INPUT #1, s
    n = n + 1
LOOP
CLOSE #1
PRINT n; " satir"
