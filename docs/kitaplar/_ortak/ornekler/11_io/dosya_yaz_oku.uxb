' KONU: OPEN / PRINT # / INPUT # / CLOSE
' KOMUTLAR: OPEN FOR OUTPUT INPUT AS PRINT CLOSE
' ACIKLAMA: Dosyaya yazma ve okuma. Kanal numarası `#n` ile verilir.
'= merhaba
OPEN "kitap_ornek.txt" FOR OUTPUT AS #1
PRINT #1, "merhaba"
CLOSE #1
DIM s AS STRING
OPEN "kitap_ornek.txt" FOR INPUT AS #2
INPUT #2, s
CLOSE #2
PRINT s
