' KONU: TYPE (kayıt)
' KOMUTLAR: TYPE END AS
' ACIKLAMA: Birden fazla alanı tek bir tipte toplar; diziler de kurulabilir.
'= 10 3
'= 30
TYPE NOKTA
    X AS I32
    Y AS I32
END TYPE
DIM p(0 TO 2) AS NOKTA
DIM i AS I32
FOR i = 0 TO 2
    p(i).X = (i + 1) * 10
    p(i).Y = (i + 1) * 3
NEXT i
PRINT p(0).X; " "; p(0).Y
PRINT p(2).X
