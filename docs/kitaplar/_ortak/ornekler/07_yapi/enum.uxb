' KONU: ENUM
' KOMUTLAR: ENUM END
' ACIKLAMA: Adlandırılmış tamsayı sabitleri. Üyeler `EnumAdi.UYE` biçiminde yazılır; ilk değer 0, istenirse `= n` ile verilir.
'= 0 1
'= 5
ENUM Renk
    KIRMIZI
    YESIL
END ENUM
PRINT Renk.KIRMIZI; " "; Renk.YESIL
ENUM Kod
    TAMAM = 1
    HATA = 5
END ENUM
PRINT Kod.HATA
