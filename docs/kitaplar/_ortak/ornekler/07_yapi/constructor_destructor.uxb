' KONU: CONSTRUCTOR / DESTRUCTOR / DELETE
' KOMUTLAR: CONSTRUCTOR DESTRUCTOR NEW DELETE
' ACIKLAMA: CONSTRUCTOR nesne oluşurken, DESTRUCTOR DELETE ile silinirken çalışır.
'= kuruldu
'= 5
'= silindi
CLASS Sayac
    PUBLIC
    DIM n AS I32
    CONSTRUCTOR()
        PRINT "kuruldu"
        n = 5
    END CONSTRUCTOR
    DESTRUCTOR()
        PRINT "silindi"
    END DESTRUCTOR
END CLASS
DIM s AS Sayac = NEW Sayac()
PRINT s.n
DELETE s
