' KONU: STRUCT / UNION / ABI C / PACK / OFFSETOF
' KOMUTLAR: STRUCT UNION ABI PACK SIZEOF OFFSETOF
' ACIKLAMA: STRUCT C uyumlu bellek düzeni verir; UNION alanlarını aynı bellekte üst üste tutar; PACK 1 boşluk bırakmaz.
'= 8 4
'= 8
'= 5
STRUCT Vec2 ABI C
    x AS F32
    y AS F32
END STRUCT
UNION Bitler ABI C
    tam AS U64
    ondalik AS F64
END UNION
STRUCT Paket ABI C PACK 1
    etiket AS U8
    deger AS U32
END STRUCT
PRINT SIZEOF(Vec2); " "; OFFSETOF(Vec2, "y")
PRINT SIZEOF(Bitler)
PRINT SIZEOF(Paket)
