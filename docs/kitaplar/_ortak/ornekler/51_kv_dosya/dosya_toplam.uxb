' KONU: Orta düzey: dosyaya sayı yazıp geri okuyarak toplamak
' KOMUTLAR: OPEN PRINT # INPUT # EOF CLOSE VAL
' ACIKLAMA: Beş sayıyı satır satır dosyaya yazar, dosyayı kapatıp yeniden açar. Dosyadan okunan her satır metindir; VAL ile sayıya çevrilip toplam ve en büyük değer bulunur.
'= toplam=150 enbuyuk=50
OPEN "kv_sayilar.txt" FOR OUTPUT AS #1
DIM i AS I32
FOR i = 1 TO 5
    PRINT #1, i * 10
NEXT
CLOSE #1

DIM satir AS STRING = ""
DIM n AS I32
DIM toplam AS I32
DIM enbuyuk AS I32
OPEN "kv_sayilar.txt" FOR INPUT AS #1
DO WHILE EOF(1) = 0
    INPUT #1, satir
    n = CINT(VAL(satir))
    toplam += n
    IF n > enbuyuk THEN enbuyuk = n
LOOP
CLOSE #1
PRINT "toplam="; toplam; " enbuyuk="; enbuyuk
