' KONU: Orta düzey: sistem DLL'inden işlev çağırmak (CALL DLL ve CALL API)
' KOMUTLAR: CALL DLL CDECL STDCALL API STRPTR
' ACIKLAMA: CALL(DLL, "dll", "işlev", DÖNÜŞ, ÇAĞRI_KURALI, "ARGÜMAN_TİPLERİ", argümanlar...) ile Windows'un C çalışma zamanı kütüphanesinden (ucrtbase.dll) işlev çağrılır. Argüman tipi listesi, argüman sayısıyla birebir uymalıdır. Sonuç önce değişkene alınır; böylece AST'nin izin listesi uyarısı çıktı satırına karışmaz.
'= atoi: 1235
'= pow: 1024
'= abs: 17
'= toupper: Q
'= strncmp: esit
'= llabs: 5000000000
'= tickcount: tamam
DIM a AS I32
DIM p AS F64
DIM m AS I32
DIM u AS I32
DIM k AS I32
DIM b AS I64
DIM t AS I32

a = CALL(DLL, "ucrtbase.dll", "atoi", I32, CDECL, "STRPTR", "1234") + 1
PRINT "atoi: "; a

p = CALL(DLL, "ucrtbase.dll", "pow", F64, CDECL, "F64,F64", 2.0, 10.0)
PRINT "pow: "; p

m = CALL(DLL, "ucrtbase.dll", "abs", I32, CDECL, "I32", -17)
PRINT "abs: "; m

u = CALL(DLL, "ucrtbase.dll", "toupper", I32, CDECL, "I32", ASC("q"))
PRINT "toupper: "; CHR(u)

k = CALL(DLL, "ucrtbase.dll", "strncmp", I32, CDECL, "STRPTR,STRPTR,U64", "merhaba", "merhamet", 5)
IF k = 0 THEN
    PRINT "strncmp: esit"
ELSE
    PRINT "strncmp: farkli"
END IF

b = CALL(DLL, "ucrtbase.dll", "llabs", I64, CDECL, "I64", -5000000000)
PRINT "llabs: "; b

t = CALL(API, "kernel32", "GetTickCount", I32)
IF t >= 0 THEN PRINT "tickcount: tamam"
