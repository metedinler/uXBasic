' KONU: NAMESPACE iki kez açılırsa içerik birleşir; ALIAS uzun adı kısaltır
' KOMUTLAR: NAMESPACE ALIAS USING
' ACIKLAMA: Aynı ad alanı birden çok yerde açılıp kapatılabilir; içerikleri birleşir. ALIAS bir adı çalışmadan önce metin olarak değiştirir (önişlemci aşamasında). USING işlev içinde de yazılabilir.
'= ayar toplami: 30
'= kisa ad ile kare: 49
'= using ile: 6
NAMESPACE Ayarlar
    DIM genislik AS I32
END NAMESPACE

NAMESPACE Ayarlar
    DIM yukseklik AS I32
    FUNCTION Toplam() AS I32
        RETURN genislik + yukseklik
    END FUNCTION
END NAMESPACE

NAMESPACE Cok_Uzun_Bir_Ad_Alani
    FUNCTION Kare(x AS I32) AS I32
        RETURN x * x
    END FUNCTION
END NAMESPACE
ALIAS KA = Cok_Uzun_Bir_Ad_Alani

FUNCTION IkiKati(x AS I32) AS I32
    USING Ayarlar
    RETURN x * 2
END FUNCTION

Ayarlar.genislik = 10
Ayarlar.yukseklik = 20
PRINT "ayar toplami: "; Ayarlar.Toplam()
PRINT "kisa ad ile kare: "; KA.Kare(7)
PRINT "using ile: "; IkiKati(3)
