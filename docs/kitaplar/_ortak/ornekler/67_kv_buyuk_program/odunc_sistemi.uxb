' KONU: Büyük program: kitap ödünç sistemi (kayıt dizisi, sözlük, hata yönetimi, sıralama, rapor)
' KOMUTLAR: TYPE DICT THROW TRY CATCH ASSERT SUB FUNCTION SPACE LEFT DICTSET DICTGET DICTHAS
' ACIKLAMA: Üç kitaplı küçük bir kütüphane. Kitaplar bir TYPE kayıt dizisinde tutulur (ad, stok, ödünç sayısı); ad → dizi sırası eşlemesi bir DICT'tedir; üye başına ödünç sayısı ikinci bir DICT'tedir. OduncVer ve IadeAl işlevleri kural bozulunca THROW eder; atılan değer CATCH'te alınamadığı için (G-HATA-4) hata metni genel bir değişkende (sonHata) taşınır ve Dene yordamı TRY/CATCH ile yazdırır. Üç hata türü vardır: bilinmeyen kitap, stok yok, üye başına iki kitap sınırı. Sıralama kayıt dizisinde eleman takası yerine alan alan takasla yapılır (G-VERI-1). Dizi, her çağrıdan ve ASSERT'ten önce en başta bildirilir (G-DIL-10). Kayıt dizisine yazılırken indeks bir değişkendir (G-VERI-7). Kayıt dizisi alanına yazan program JS'te yürütme anında reddedilir (G-JS-7); bu yüzden örnek AST, MIR ve x64 içindir.
' MOTORLAR: AST MIR x64
'= ayse aldi: Sefiller
'= ayse aldi: Nutuk
'= HATA: ayse en fazla 2 kitap alabilir
'= HATA: stokta yok: Nutuk
'= can aldi: Sefiller
'= HATA: kitap bulunamadi: Yok
'= ayse iade etti: Nutuk
'= can aldi: Nutuk
'= HATA: deniz iade edecek kitap yok
'= KITAP        STOK  ODUNC
'= Sefiller     0     2
'= Nutuk        0     2
'= Kasagi       3     0
'= toplam islem: 5
TYPE Kitap
    ad AS STRING
    stok AS I32
    odunc AS I32
END TYPE

DIM kitaplar(5) AS Kitap
DIM kitapSayisi AS I32 = 0
DIM indeks AS DICT
DIM uyeler AS DICT
DIM sonHata AS STRING = ""
DIM toplamIslem AS I32 = 0

SUB KitapEkle(ad AS STRING, stok AS I32)
    kitaplar(kitapSayisi).ad = ad
    kitaplar(kitapSayisi).stok = stok
    kitaplar(kitapSayisi).odunc = 0
    DICTSET(indeks, ad, kitapSayisi)
    kitapSayisi = kitapSayisi + 1
END SUB

FUNCTION KitapBul(ad AS STRING) AS I32
    IF DICTHAS(indeks, ad) = 0 THEN
        sonHata = "kitap bulunamadi: " + ad
        THROW "kitap-yok"
    END IF
    RETURN CINT(DICTGET(indeks, ad))
END FUNCTION

SUB OduncVer(uye AS STRING, ad AS STRING)
    DIM k AS I32
    DIM sayi AS I32 = 0
    k = KitapBul(ad)
    IF kitaplar(k).stok <= 0 THEN
        sonHata = "stokta yok: " + ad
        THROW "stok-yok"
    END IF
    IF DICTHAS(uyeler, uye) THEN sayi = CINT(DICTGET(uyeler, uye))
    IF sayi >= 2 THEN
        sonHata = uye + " en fazla 2 kitap alabilir"
        THROW "limit"
    END IF
    kitaplar(k).stok = kitaplar(k).stok - 1
    kitaplar(k).odunc = kitaplar(k).odunc + 1
    DICTSET(uyeler, uye, sayi + 1)
    toplamIslem = toplamIslem + 1
END SUB

SUB IadeAl(uye AS STRING, ad AS STRING)
    DIM k AS I32
    DIM sayi AS I32 = 0
    k = KitapBul(ad)
    IF DICTHAS(uyeler, uye) THEN sayi = CINT(DICTGET(uyeler, uye))
    IF sayi <= 0 THEN
        sonHata = uye + " iade edecek kitap yok"
        THROW "iade-yok"
    END IF
    kitaplar(k).stok = kitaplar(k).stok + 1
    DICTSET(uyeler, uye, sayi - 1)
    toplamIslem = toplamIslem + 1
END SUB

SUB Dene(islem AS STRING, uye AS STRING, ad AS STRING)
    TRY
        IF islem = "al" THEN
            OduncVer(uye, ad)
            PRINT uye; " aldi: "; ad
        ELSE
            IadeAl(uye, ad)
            PRINT uye; " iade etti: "; ad
        END IF
    CATCH
        PRINT "HATA: "; sonHata
    END TRY
END SUB

SUB SiralaPopulerlige()
    DIM i AS I32
    DIM j AS I32
    DIM a AS STRING
    DIM s AS I32
    DIM o AS I32
    FOR i = 0 TO kitapSayisi - 2
        FOR j = 0 TO kitapSayisi - 2 - i
            IF kitaplar(j).odunc < kitaplar(j + 1).odunc THEN
                a = kitaplar(j).ad
                s = kitaplar(j).stok
                o = kitaplar(j).odunc
                kitaplar(j).ad = kitaplar(j + 1).ad
                kitaplar(j).stok = kitaplar(j + 1).stok
                kitaplar(j).odunc = kitaplar(j + 1).odunc
                kitaplar(j + 1).ad = a
                kitaplar(j + 1).stok = s
                kitaplar(j + 1).odunc = o
            END IF
        NEXT
    NEXT
END SUB

SUB Rapor()
    DIM i AS I32
    PRINT "KITAP        STOK  ODUNC"
    FOR i = 0 TO kitapSayisi - 1
        PRINT LEFT(kitaplar(i).ad + SPACE(12), 12); " "; kitaplar(i).stok; "     "; kitaplar(i).odunc
    NEXT
END SUB

KitapEkle("Sefiller", 2)
KitapEkle("Nutuk", 1)
KitapEkle("Kasagi", 3)
Dene("al", "ayse", "Sefiller")
Dene("al", "ayse", "Nutuk")
Dene("al", "ayse", "Kasagi")
Dene("al", "can", "Nutuk")
Dene("al", "can", "Sefiller")
Dene("al", "can", "Yok")
Dene("iade", "ayse", "Nutuk")
Dene("al", "can", "Nutuk")
Dene("iade", "deniz", "Kasagi")
SiralaPopulerlige()
Rapor()
PRINT "toplam islem: "; toplamIslem
ASSERT toplamIslem = 5, "islem sayisi tutarsiz"
