' KONU: ANDALSO / ORELSE
' KOMUTLAR: ANDALSO ORELSE
' ACIKLAMA: Kısa devre: ANDALSO ilk koşul yanlışsa ikinciyi hiç denetlemez; ORELSE ilk doğruysa.
'= guvenli
'= tamam
DIM b AS I32 = 0
IF b <> 0 ANDALSO 10 \ b > 1 THEN
    PRINT "bolundu"
ELSE
    PRINT "guvenli"
END IF
IF b = 0 ORELSE 10 \ b > 1 THEN PRINT "tamam"
