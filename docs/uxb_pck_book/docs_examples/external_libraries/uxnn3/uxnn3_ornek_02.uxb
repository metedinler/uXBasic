REM Bu dış kütüphane örneği AST yorumlayıcıda sözdizimi, MIR yorumlayıcıda çağrı akışı, runtime tarafında DLL rotası açısından okunur. [074]
REM JS/WASM hedeflerinde native DLL çağrısı doğrudan çalışmayabilir; bu durumda kitapta hedef sınırı açıkça belirtilir. [075]
INCLUDE "libsx/uxnn3/uxnn3.bas"
USING uxnn3
PRINT "BASLA"
DIM h AS U64 = 0
DIM durum AS I32 = 0
DIM sayi AS I64 = 0
DIM sonuc AS F64 = 0.0
DIM metin AS STRING = "demo"
REM Fonksiyon: Rows - Verinin boyutunu, satır/sütun sayısını, eksen uzunluğunu veya eleman sayısını bildirir.
durum = Rows(h)
PRINT durum
REM Fonksiyon: InputDim - Verinin boyutunu, satır/sütun sayısını, eksen uzunluğunu veya eleman sayısını bildirir.
durum = InputDim(h)
PRINT durum
REM Fonksiyon: OutputDim - Verinin boyutunu, satır/sütun sayısını, eksen uzunluğunu veya eleman sayısını bildirir.
durum = OutputDim(h)
PRINT durum
REM Fonksiyon: XGet - Handle içinden değer, hücre, metin, tensor elemanı veya istatistik sonucunu okur.
sonuc = XGet(h, 1, 1)
PRINT sonuc
REM Fonksiyon: YGet - Handle içinden değer, hücre, metin, tensor elemanı veya istatistik sonucunu okur.
sonuc = YGet(h, 1, 1)
PRINT sonuc
REM Fonksiyon: XSet - Var olan handle içine değer, seçenek, parametre veya hücre yazar; yapılandırma ve veri doldurma adımıdır.
durum = XSet(h, 1, 1, 1.25)
PRINT durum
REM Fonksiyon: Version - Modülün veya bağlı dış runtime bileşeninin sürüm bilgisini döndürür; kurulum denetiminde ilk çağrıdır.
durum = Version()
PRINT durum
REM Fonksiyon: LastError - Dış kütüphane wrapper yüzeyinde özel bir işlem yürütür; görevi imza, parametre adları ve bağlı DLL rotasıyla birlikte değerlendirilir.
metin = LastError()
PRINT metin
REM Fonksiyon: DatasetCreate - Yeni handle/nesne/tampon/oturum oluşturur; dönen U64 değeri sonraki çağrıların merkezidir.
h = DatasetCreate(1, 1, 1)
PRINT h
REM Fonksiyon: DatasetFree - Dış runtime tarafından ayrılmış kaynakları serbest bırakır veya temizler; bellek sızıntısını önleyen kapanış adımıdır.
DatasetFree(h)
REM Fonksiyon: LoadCSV - Dosyadan veya dış kaynaktan veri/oturum açar; CSV, Parquet, model veya veritabanı gibi girdiler bu kapıdan gelir.
h = LoadCSV("demo", 1, 1, 1)
PRINT h
REM Fonksiyon: SaveCSV - Hesaplanan veya dönüştürülen veriyi dış dosyaya yazar; rapor, edge list, CSV veya Parquet çıktısı üretir.
durum = SaveCSV(h, "demo", 1)
PRINT durum
PRINT "BITTI"
