{
  "name": "uxscalar_module",
  "project_root": "../..",
  "build_dir": "build/uxscalar_module_x64",
  "output_dir": "dist/libraries/bin",
  "dll_name": "uxscalar_module.dll",
  "namespace": "uxscalar_module",
  "wrapper_bas": "libsx/uxscalar_module/uxscalar_module.bas",
  "wrapper_uxmh": "include/modules/uxscalar_module.uxmh",
  "build_program": true,
  "runtime_dependencies": [
    "uxb_runtime.dll",
    "libgcc_s_seh-1.dll",
    "libstdc++-6.dll",
    "libwinpthread-1.dll"
  ],
  "linker_flags": [
    "-Wl,--enable-auto-import"
  ],
  "exports": [
    {"public": "uxscalar_init", "internal": "uxb_fn_UXSCALAR_INIT", "return": "I32", "args": []},
    {"public": "uxscalar_add", "internal": "uxb_fn_UXSCALAR_ADD", "return": "I32", "args": [{"name": "leftValue", "type": "I32"}, {"name": "rightValue", "type": "I32"}]},
    {"public": "uxscalar_shutdown", "internal": "uxb_fn_UXSCALAR_SHUTDOWN", "return": "I32", "args": []}
  ]
}
