INCLUDE "include/modules/uxoop_module.uxmh"

MAIN
    DIM counter AS U64
    DIM dog AS U64

    ASSERT uxoop_module.uxoop_module_init() == 1

    counter = uxoop_module.uxoop_counter_create(10)
    ASSERT counter <> 0
    ASSERT uxoop_module.uxoop_counter_add(counter, 32) == 42
    ASSERT uxoop_module.uxoop_counter_get(counter) == 42
    uxoop_module.uxoop_counter_release(counter)

    dog = uxoop_module.uxoop_dog_create()
    ASSERT dog <> 0
    ASSERT uxoop_module.uxoop_animal_speak(dog) == 42
    uxoop_module.uxoop_animal_release(dog)

    ASSERT uxoop_module.uxoop_module_shutdown() == 1
    PRINT "UXOOP_MODULE_SMOKE_PASS"
END MAIN
