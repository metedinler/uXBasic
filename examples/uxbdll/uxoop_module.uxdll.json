{
  "name": "uxoop_module",
  "project_root": "../..",
  "build_dir": "build/uxoop_module_x64",
  "output_dir": "dist/libraries/bin",
  "dll_name": "uxoop_module.dll",
  "namespace": "uxoop_module",
  "wrapper_bas": "libsx/uxoop_module/uxoop_module.bas",
  "wrapper_uxmh": "include/modules/uxoop_module.uxmh",
  "build_program": true,
  "runtime_dependencies": [
    "uxb_runtime.dll",
    "libgcc_s_seh-1.dll",
    "libstdc++-6.dll",
    "libwinpthread-1.dll"
  ],
  "linker_flags": [
    "-Wl,--enable-auto-import"
  ],
  "exports": [
    {"public": "uxoop_module_init", "internal": "UXOOP_MODULE_INIT", "return": "I32", "args": []},
    {"public": "uxoop_module_shutdown", "internal": "UXOOP_MODULE_SHUTDOWN", "return": "I32", "args": []},
    {"public": "uxoop_counter_create", "internal": "UXOOP_COUNTER_CREATE", "return": "PTR", "args": [{"name": "startValue", "type": "I32"}]},
    {"public": "uxoop_counter_add", "internal": "UXOOP_COUNTER_ADD", "return": "I32", "args": [{"name": "counter", "type": "PTR"}, {"name": "delta", "type": "I32"}]},
    {"public": "uxoop_counter_get", "internal": "UXOOP_COUNTER_GET", "return": "I32", "args": [{"name": "counter", "type": "PTR"}]},
    {"public": "uxoop_counter_release", "internal": "UXOOP_COUNTER_RELEASE", "return": "VOID", "args": [{"name": "counter", "type": "PTR"}]},
    {"public": "uxoop_dog_create", "internal": "UXOOP_DOG_CREATE", "return": "PTR", "args": []},
    {"public": "uxoop_animal_speak", "internal": "UXOOP_ANIMAL_SPEAK", "return": "I32", "args": [{"name": "animal", "type": "PTR"}]},
    {"public": "uxoop_animal_release", "internal": "UXOOP_ANIMAL_RELEASE", "return": "VOID", "args": [{"name": "animal", "type": "PTR"}]}
  ]
}
