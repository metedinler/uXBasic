INCLUDE "include/modules/uxraylib.uxmh"

MAIN
    DIM playerTexture AS I32
    DIM enemyTexture AS I32
    DIM gameFont AS I32
    DIM playerX AS F64
    DIM playerY AS F64
    DIM enemyX AS F64
    DIM enemyY AS F64
    DIM cameraX AS F64
    DIM cameraY AS F64
    DIM speed AS F64
    DIM frame AS I32
    DIM hit AS I32

    playerX = 120
    playerY = 160
    enemyX = 540
    enemyY = 160
    speed = 220

    uxraylib.InitWindow(960, 540, "uXBasic Sprite Collision Game")
    uxraylib.SetTargetFPS(60)
    playerTexture = uxraylib.LoadTexture("assets/player.png")
    enemyTexture = uxraylib.LoadTexture("assets/enemy.png")
    gameFont = uxraylib.LoadFont("assets/game.ttf")

    WHILE uxraylib.WindowShouldClose() == 0
        IF uxraylib.KeyDown(uxraylib.KEY_LEFT) OR uxraylib.KeyDown(uxraylib.KEY_A) THEN
            playerX = playerX - speed * uxraylib.FrameTime()
        END IF
        IF uxraylib.KeyDown(uxraylib.KEY_RIGHT) OR uxraylib.KeyDown(uxraylib.KEY_D) THEN
            playerX = playerX + speed * uxraylib.FrameTime()
        END IF
        IF uxraylib.KeyDown(uxraylib.KEY_UP) OR uxraylib.KeyDown(uxraylib.KEY_W) THEN
            playerY = playerY - speed * uxraylib.FrameTime()
        END IF
        IF uxraylib.KeyDown(uxraylib.KEY_DOWN) OR uxraylib.KeyDown(uxraylib.KEY_S) THEN
            playerY = playerY + speed * uxraylib.FrameTime()
        END IF

        cameraX = playerX - 480
        cameraY = playerY - 270
        uxraylib.SetCameraScroll(cameraX, cameraY)
        frame = uxraylib.SpriteFrame(frame + 1, 4)
        hit = uxraylib.RectCollision(playerX, playerY, 64, 64, enemyX, enemyY, 64, 64)

        uxraylib.BeginDrawing()
        uxraylib.ClearBackground(20, 30, 48, 255)

        ' Arka plan ve platformlar dünya koordinatında, kamera ile kayar.
        uxraylib.DrawRectangle(-300, 260, 1800, 80, 45, 90, 55, 255)
        uxraylib.DrawRectangle(360, 190, 220, 25, 80, 110, 160, 255)

        IF playerTexture <> 0 THEN
            uxraylib.DrawSprite(playerTexture, frame * 32, 0, 32, 32, playerX, playerY, 2, 0)
        ELSE
            uxraylib.DrawRectangle(playerX, playerY, 64, 64, 40, 180, 255, 255)
        END IF
        IF enemyTexture <> 0 THEN
            uxraylib.DrawSprite(enemyTexture, 0, 0, 32, 32, enemyX, enemyY, 2, 0)
        ELSE
            uxraylib.DrawRectangle(enemyX, enemyY, 64, 64, 230, 80, 80, 255)
        END IF

        IF hit THEN
            uxraylib.DrawText("COLLISION!", 20, 20, 30, 255, 80, 80, 255)
        ELSE
            uxraylib.DrawText("Move: arrows or WASD", 20, 20, 24, 235, 235, 235, 255)
        END IF
        IF gameFont <> 0 THEN
            uxraylib.DrawFont(gameFont, "uXBasic Game", cameraX + 20, cameraY + 70, 28, 1, 255, 220, 90, 255)
        END IF
        uxraylib.EndDrawing()
    WEND

    IF gameFont <> 0 THEN uxraylib.UnloadFont(gameFont)
    IF enemyTexture <> 0 THEN uxraylib.UnloadTexture(enemyTexture)
    IF playerTexture <> 0 THEN uxraylib.UnloadTexture(playerTexture)
    uxraylib.CloseWindow()
END MAIN
